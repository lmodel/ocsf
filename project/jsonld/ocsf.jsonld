      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The trigger is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The job is triggered on a system boot.",
          "title": "Boot",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The job is triggered on a specific schedule. Properties should be populated with respective time bounds.",
          "title": "Schedule",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The job is triggered when the specific event occurs. The <code>properties</code> attribute should be populated with respective event sources and identifiers.",
          "title": "Event",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The job trigger is unmapped. See the <code>type</code> attribute, which contains a data source specific value.",
