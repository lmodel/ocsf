    {
      "name": "OcsfRdpActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfRdpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfRdpActivity",
      "domain_of": [
        "OcsfRdpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "RDP Activity: Unknown",
          "equals_number": 400500,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The initial RDP request.",
          "title": "RDP Activity: Initial Request",
          "equals_number": 400501,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The initial RDP response.",
          "title": "RDP Activity: Initial Response",
          "equals_number": 400502,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection request.",
          "title": "RDP Activity: Connect Request",
          "equals_number": 400503,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection response.",
          "title": "RDP Activity: Connect Response",
          "equals_number": 400504,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The TLS handshake.",
          "title": "RDP Activity: TLS Handshake",
          "equals_number": 400505,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Network traffic report.",
          "title": "RDP Activity: Traffic",
          "equals_number": 400506,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection disconnect.",
          "title": "RDP Activity: Disconnect",
          "equals_number": 400507,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection reconnect.",
          "title": "RDP Activity: Reconnect",
          "equals_number": 400508,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "RDP Activity: Other",
          "equals_number": 400599,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
