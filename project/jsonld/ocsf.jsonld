    {
      "name": "OcsfFile_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The file type ID. Note the distinction between a <code>Regular File</code> and an <code>Executable File</code>. If the distinction is not known, or not indicated by the log, use <code>Regular File</code>. In this case, it should not be assumed that a Regular File is not executable.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfFile",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfFile",
      "domain_of": [
        "OcsfFile"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Regular File",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Folder",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Character Device",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Block Device",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Local Socket",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Named Pipe",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Symbolic Link",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Executable File",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
