    {
      "name": "OcsfReputation_score_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/score_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "score",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized reputation score identifier.",
      "title": "Reputation Score ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/score_id"
      ],
      "is_a": "score_id",
      "domain": "OcsfReputation",
      "slot_uri": "https://w3id.org/lmodel/ocsf/score_id",
      "alias": "score_id",
      "owner": "OcsfReputation",
      "domain_of": [
        "OcsfReputation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "score_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The reputation score is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Long history of good behavior.",
          "title": "Very Safe",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Consistently good behavior.",
          "title": "Safe",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Reasonable history of good behavior.",
          "title": "Probably Safe",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Starting to establish a history of normal behavior.",
          "title": "Leans Safe",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "No established history of normal behavior.",
          "title": "May not be Safe",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Starting to establish a history of suspicious or risky behavior.",
          "title": "Exercise Caution",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A site with a history of suspicious or risky behavior. (spam, scam, potentially unwanted software, potentially malicious).",
          "title": "Suspicious/Risky",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Strong possibility of maliciousness.",
          "title": "Possibly Malicious",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Indicators of maliciousness.",
          "title": "Probably Malicious",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Proven evidence of maliciousness.",
          "title": "Malicious",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The reputation score is not mapped. See the <code>rep_score</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
