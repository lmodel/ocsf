    {
      "name": "OcsfMetadata_logged_time",
      "definition_uri": "https://w3id.org/lmodel/ocsf/logged_time",
      "description": "The ultimate logged time in the event pipeline - when the event reached its final destination (e.g., SIEM, data lake). If <code>loggers</code> is populated, this should match the <code>logged_time</code> of the last entry in the <code>loggers</code> array. This is distinct from <code>time</code> (when the activity occurred) and <code>processed_time</code> (when an intermediate system processed the event).",
      "title": "Logged Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
