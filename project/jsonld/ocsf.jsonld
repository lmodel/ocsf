        {
          "description": "The job is executed by the Task Scheduler on Windows.",
          "title": "Task Scheduler",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The job is executed by <code>cron</code> on Linux, macOS, or another a Unix-like OS.",
