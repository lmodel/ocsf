        "OcsfEncryptionDetails"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "algorithm_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The algorithm is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Data Encryption Standard Algorithm",
          "title": "DES",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Triple Data Encryption Standard Algorithm",
          "title": "TripleDES",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Advanced Encryption Standard Algorithm.",
          "title": "AES",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Rivest-Shamir-Adleman Algorithm",
          "title": "RSA",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Elliptic Curve Cryptography Algorithm",
          "title": "ECC",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "ShangMi Cryptographic Algorithm",
          "title": "SM2",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The algorithm is not mapped. See the <code>algorithm</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
