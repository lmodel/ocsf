      "typeof": "integer",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_mac_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfMacT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "mac_t",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_max_len",
          "value": "32",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_observable",
          "value": "3",
          "@type": "Annotation"
        }
      ],
      "description": "Media Access Control (MAC) address. For example:<br><code>18:36:F3:98:4F:9A</code>.",
      "title": "MAC Address",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
