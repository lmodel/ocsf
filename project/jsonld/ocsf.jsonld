      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfFindingEvent_status_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "status",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized finding lifecycle status identifier. Unlike the status of an activity event, which indicates the success or failure of the activity, finding status tracks the review and triage workflow: whether the finding is new, being investigated, suppressed, or resolved. Producers should set this to reflect the current state of the finding in their system (e.g., <code>1</code> for newly created findings, <code>4</code> when remediated).",
      "title": "Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_id"
      ],
      "is_a": "OcsfBaseEvent_status_id",
      "domain": "OcsfFindingEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "alias": "status_id",
      "owner": "OcsfFindingEvent",
      "domain_of": [
        "OcsfFindingEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfFindingEvent_time",
      "definition_uri": "https://w3id.org/lmodel/ocsf/time",
      "description": "The finding creation time - when the finding was first generated, not when the underlying activity occurred. For the time range of contributing events, use <code>start_time</code> and <code>end_time</code>.",
      "title": "Event Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
