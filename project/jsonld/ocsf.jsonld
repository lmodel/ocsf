      "range": "OcsfWebResource",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfWebResourcesActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "activity_id",
      "domain": "OcsfWebResourcesActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfWebResourcesActivity",
      "domain_of": [
        "OcsfWebResourcesActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were created.",
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were read / viewed.",
          "title": "Read",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were updated.",
          "title": "Update",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were deleted.",
          "title": "Delete",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A search was performed on one or more web resources.",
          "title": "Search",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were imported into an Application.",
          "title": "Import",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were exported from an Application.",
          "title": "Export",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were shared.",
          "title": "Share",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
