    {
      "name": "OcsfRelatedEvent_product_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/product_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_deprecated_since": {
          "tag": "ocsf_deprecated_since",
          "value": "1.4.0",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_superseded_by": {
