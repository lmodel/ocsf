    {
      "name": "OcsfDnsActivity_rcode_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/rcode_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "rcode",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the DNS server response code. See RFC 6895.",
      "title": "Response Code ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://datatracker.ietf.org/doc/html/rfc6895"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/rcode_id"
      ],
      "is_a": "rcode_id",
      "domain": "OcsfDnsActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/rcode_id",
      "alias": "rcode_id",
      "owner": "OcsfDnsActivity",
      "domain_of": [
        "OcsfDnsActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "rcode_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "No Error.",
          "title": "NoError",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Format Error.",
          "title": "FormError",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Server Failure.",
          "title": "ServError",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Non-Existent Domain.",
          "title": "NXDomain",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Not Implemented.",
          "title": "NotImp",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Query Refused.",
          "title": "Refused",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Name Exists when it should not.",
          "title": "YXDomain",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "RR Set Exists when it should not.",
          "title": "YXRRSet",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "RR Set that should exist does not.",
          "title": "NXRRSet",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Not Authorized or Server Not Authoritative for zone.",
          "title": "NotAuth",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Name not contained in zone.",
          "title": "NotZone",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DSO-TYPE Not Implemented.",
          "title": "DSOTYPENI",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bad EDNS OPT Version. Indicates that the client requested an EDNS version that the server does not support.",
          "title": "BADVERS",
          "equals_number": 16,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Key not recognized.",
          "title": "BADKEY",
          "equals_number": 17,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Signature out of time window.",
          "title": "BADTIME",
          "equals_number": 18,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bad TKEY Mode.",
          "title": "BADMODE",
          "equals_number": 19,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Duplicate key name.",
          "title": "BADNAME",
          "equals_number": 20,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Algorithm not supported.",
          "title": "BADALG",
          "equals_number": 21,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bad Truncation.",
          "title": "BADTRUNC",
          "equals_number": 22,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bad/missing Server Cookie.",
          "title": "BADCOOKIE",
          "equals_number": 23,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The codes deemed to be unassigned by the RFC (unassigned codes: 12-15, 24-3840, 4096-65534).",
          "title": "Unassigned",
          "equals_number": 24,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The codes deemed to be reserved by the RFC (codes: 3841-4095, 65535).",
          "title": "Reserved",
          "equals_number": 25,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The dns response code is not defined by the RFC.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
