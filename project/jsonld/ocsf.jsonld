    {
      "name": "OcsfBaseEvent_action",
      "definition_uri": "https://w3id.org/lmodel/ocsf/action",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "security_control",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized caption of 'action_id' or the source specific action.",
      "title": "Action",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/action"
      ],
      "is_a": "OcsfSecurityControlProfile_action",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/action",
      "alias": "action",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "action",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_action_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/action_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "security_control",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "action",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized action taken by a control or other policy-based system leading to an outcome or disposition.",
      "title": "Action ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/action_id"
      ],
      "is_a": "OcsfSecurityControlProfile_action_id",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/action_id",
      "alias": "action_id",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "action_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The action was unknown. The <code>disposition_id</code> attribute may still be set to a non-unknown value, for example 'Custom Action', 'Challenge'.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity was allowed. The <code>disposition_id</code> attribute should be set to a value that conforms to this action, for example 'Allowed', 'Approved', 'Delayed', 'No Action', 'Count' etc.",
          "title": "Allowed",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The attempted activity was denied. The <code>disposition_id</code> attribute should be set to a value that conforms to this action, for example 'Blocked', 'Rejected', 'Quarantined', 'Isolated', 'Dropped', 'Access Revoked, etc.",
          "title": "Denied",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity was observed, but neither explicitly allowed nor denied. This is common with IDS and EDR controls that report additional information on observed behavior such as TTPs. The <code>disposition_id</code> attribute should be set to a value that conforms to this action, for example 'Logged', 'Alert', 'Detected', 'Count', etc.",
          "title": "Observed",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity was modified, adjusted, or corrected. The <code>disposition_id</code> attribute should be set appropriately, for example 'Restored', 'Corrected', 'Delayed', 'Captcha', 'Tagged'.",
          "title": "Modified",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The action is not mapped. See the <code>action</code> attribute which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "classification",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "activity_id",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_activity_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_name",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "classification",
          "@type": "Annotation"
        }
      ],
      "description": "The event activity name, as defined by the <code>activity_id</code>. When <code>activity_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific activity label. For all other <code>activity_id</code> values, this must match the caption defined for that <code>activity_id</code> enum value.",
