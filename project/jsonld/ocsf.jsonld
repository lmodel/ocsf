      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The value type ID.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
