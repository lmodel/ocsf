    },
    {
      "name": "detection_pattern_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/detection_pattern_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "detection_pattern_type",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies the type of detection pattern used to identify the associated threat indicator.",
      "title": "Detection Pattern Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/detection_pattern_type_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/detection_pattern_type_id",
