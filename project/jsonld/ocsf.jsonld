    {
      "name": "OcsfDownloadInfo_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The download type ID. The values correspond to the five permitted values of the <code>ZoneId</code> property in the Mark of the Web metadata of a downloaded file on Windows. Note however that each numeric value is 1 greater than its <code>ZoneId</code> equivalent.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfDownloadInfo",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfDownloadInfo",
      "domain_of": [
        "OcsfDownloadInfo"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The file's download type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The file was downloaded from a server running on device.",
          "title": "Local Machine",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The file was downloaded from an intranet server.",
          "title": "Intranet",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The file was downloaded from a trusted server.",
          "title": "Trusted",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The file was downloaded from an internet server.",
          "title": "Internet",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The file was downloaded from an untrusted server.",
          "title": "Untrusted",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The file's download type is not mapped. See the <code>type</code> attribute, which contains an event source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
