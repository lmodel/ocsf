    {
      "name": "OcsfIncidentFinding_confidence",
      "definition_uri": "https://w3id.org/lmodel/ocsf/confidence",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "The confidence, normalized to the caption of the confidence_id value. In the case of 'Other', it is defined by the event source.",
      "title": "Confidence",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/confidence"
      ],
      "is_a": "OcsfSecurityControlProfile_confidence",
      "domain": "OcsfIncidentFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/confidence",
      "alias": "confidence",
      "owner": "OcsfIncidentFinding",
      "domain_of": [
        "OcsfIncidentFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "confidence",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfIncidentFinding_confidence_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/confidence_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "confidence",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the confidence level for this incident, representing a summary across all aggregated findings. It reflects the accuracy of the analytics that produced those findings. A lower confidence value indicates a wider finding scope that may produce noisy or potentially non-malicious reports. When the value is <code>99</code> (Other), the <code>confidence</code> attribute must contain the incident-specific label.",
      "title": "Confidence ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/confidence_id"
      ],
      "is_a": "OcsfSecurityControlProfile_confidence_id",
      "domain": "OcsfIncidentFinding",
