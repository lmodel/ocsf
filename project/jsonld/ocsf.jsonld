      "title": "Service Error Control",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/service_error_control"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/service_error_control",
      "owner": "OcsfWinService",
      "domain_of": [
        "OcsfWinService"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "service_error_control_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/service_error_control_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "service_error_control",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_extension",
          "value": "win",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the service error control.",
