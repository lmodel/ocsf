          "equals_number": 600603,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete a file.",
          "title": "File Hosting Activity: Delete",
          "equals_number": 600604,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Rename a file.",
          "title": "File Hosting Activity: Rename",
          "equals_number": 600605,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Copy a file.",
          "title": "File Hosting Activity: Copy",
          "equals_number": 600606,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Move a file.",
          "title": "File Hosting Activity: Move",
          "equals_number": 600607,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Restore a file.",
          "title": "File Hosting Activity: Restore",
