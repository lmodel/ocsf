      "owner": "OcsfSpan",
      "domain_of": [
        "OcsfSpan"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "message",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSpan_operation",
      "definition_uri": "https://w3id.org/lmodel/ocsf/operation",
      "description": "Describes an action performed in a span, such as API requests, database queries, or computations.",
      "title": "Operation",
