    {
      "name": "OcsfVendorAttributes_severity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/severity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "severity",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The finding severity ID, as reported by the Vendor (Finding Provider).",
      "title": "Severity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/severity_id"
      ],
      "is_a": "severity_id",
      "domain": "OcsfVendorAttributes",
      "slot_uri": "https://w3id.org/lmodel/ocsf/severity_id",
      "alias": "severity_id",
      "owner": "OcsfVendorAttributes",
      "domain_of": [
        "OcsfVendorAttributes"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "severity_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The event/finding severity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Informational message. No action required.",
          "title": "Informational",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The user decides if action is needed.",
          "title": "Low",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Action is required but the situation is not serious at this time.",
          "title": "Medium",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Action is required immediately.",
          "title": "High",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Action is required immediately and the scope is broad.",
          "title": "Critical",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An error occurred but it is too late to take remedial action.",
          "title": "Fatal",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event/finding severity is not mapped. See the <code>severity</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
