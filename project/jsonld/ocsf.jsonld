      "description": "SCIM provides a schema for representing groups, identified using the following schema URI: <code>urn:ietf:params:scim:schemas:core:2.0:Group</code> as defined in RFC 7634. This attribute will capture key-value pairs for the scheme implemented in a SCIM resource.",
      "title": "SCIM Group Schema",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://datatracker.ietf.org/doc/html/rfc7643"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/scim_group_schema"
      ],
      "is_a": "scim_group_schema",
      "domain": "OcsfScim",
      "slot_uri": "https://w3id.org/lmodel/ocsf/scim_group_schema",
      "alias": "scim_group_schema",
      "owner": "OcsfScim",
      "domain_of": [
        "OcsfScim"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "scim_group_schema",
      "range": "string",
      "recommended": true,
      "any_of": [
        {
          "range": "OcsfJsonValue",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "OcsfJsonValue",
          "multivalued": true,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScim_scim_user_schema",
      "definition_uri": "https://w3id.org/lmodel/ocsf/scim_user_schema",
      "description": "SCIM provides a resource type for user resources. The core schema for user is identified using the following schema URI: <code>urn:ietf:params:scim:schemas:core:2.0:User</code> as defined in RFC 7634. This attribute will capture key-value pairs for the scheme implemented in a SCIM resource. This object is inclusive of both the basic and Enterprise User Schema Extension.",
      "title": "SCIM User Schema",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://datatracker.ietf.org/doc/html/rfc7643"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/scim_user_schema"
      ],
      "is_a": "scim_user_schema",
      "domain": "OcsfScim",
      "slot_uri": "https://w3id.org/lmodel/ocsf/scim_user_schema",
      "alias": "scim_user_schema",
      "owner": "OcsfScim",
      "domain_of": [
        "OcsfScim"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "scim_user_schema",
      "range": "string",
      "recommended": true,
      "any_of": [
        {
          "range": "OcsfJsonValue",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "OcsfJsonValue",
          "multivalued": true,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScim_state",
      "definition_uri": "https://w3id.org/lmodel/ocsf/state",
      "description": "The provisioning state of the SCIM resource, normalized to the caption of the <code>state_id</code> value. In the case of <code>Other</code>, it is defined by the event source.",
      "title": "State",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/state"
      ],
      "is_a": "state",
      "domain": "OcsfScim",
      "slot_uri": "https://w3id.org/lmodel/ocsf/state",
      "alias": "state",
      "owner": "OcsfScim",
      "domain_of": [
        "OcsfScim"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "state",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScim_state_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "state",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized state ID of the SCIM resource to reflect its activation status.",
      "title": "State ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/state_id"
      ],
      "is_a": "state_id",
      "domain": "OcsfScim",
      "slot_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "alias": "state_id",
      "owner": "OcsfScim",
      "domain_of": [
        "OcsfScim"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "state_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The provisioning state of the SCIM resource is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The SCIM resource is Pending activation or creation.",
          "title": "Pending",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The SCIM resource is in an Active state, or otherwise enabled.",
          "title": "Active",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The SCIM resource is in a Failed state.",
          "title": "Failed",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The SCIM resource is in a Deleted state, or otherwise disabled.",
          "title": "Deleted",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The provisioning state of the SCIM resource is not mapped. See the <code>state</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScim_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/uid",
      "description": "A unique identifier for a SCIM resource as defined by the service provider.",
      "title": "Unique ID",
