      "name": "OcsfEmailActivity_direction",
      "definition_uri": "https://w3id.org/lmodel/ocsf/direction",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "The direction of the email, as defined by the <code>direction_id</code> value.",
      "title": "Direction",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/direction"
      ],
      "is_a": "direction",
