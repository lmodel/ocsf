      "domain_of": [
        "OcsfAiAgent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "uid",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAiAgent_version",
