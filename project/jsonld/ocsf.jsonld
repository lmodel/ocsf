      "definition_uri": "https://w3id.org/lmodel/ocsf/observation_point_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "observation_point",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the observation point. See specific usage.",
      "title": "Observation Point ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/observation_point_id"
      ],
      "is_a": "OcsfNetworkEvent_observation_point_id",
      "domain": "OcsfTunnelActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/observation_point_id",
      "alias": "observation_point_id",
      "owner": "OcsfTunnelActivity",
      "domain_of": [
        "OcsfTunnelActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "observation_point_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The observation point is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The source network endpoint is the observation point.",
          "title": "Source",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The destination network endpoint is the observation point.",
          "title": "Destination",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Neither the source nor destination network endpoint is the observation point. Refer to the <code>network_observation_point</code> attribute for details.",
          "title": "Neither",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Both the source and destination network endpoint are the observation point. This typically occurs in localhost or internal communications where the source and destination are the same endpoint, often resulting in a <code>connection_info.direction</code> of <code>Local</code>.",
          "title": "Both",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The observation point is not mapped. See the <code>observation_point</code> attribute for a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
