    {
      "name": "start_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/start_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "start_type",
          "@type": "Annotation"
        }
      ],
      "description": "The start type ID of a service or application.",
      "title": "Start Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/start_type_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/start_type_id",
      "owner": "OcsfStartupItem",
      "domain_of": [
        "OcsfStartupItem"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The start type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Service started automatically during system startup.",
          "title": "Auto",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Device driver started by the system loader.",
          "title": "Boot",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Started on demand. For example, by the Windows Service Control Manager when a process calls the <i>StartService</i> function.",
          "title": "On Demand",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The service is disabled, and cannot be started.",
          "title": "Disabled",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Started on all user logins.",
          "title": "All Logins",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Started on specific user logins.",
          "title": "Specific User Login",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Stared according to a schedule.",
          "title": "Scheduled",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Started when a system item, such as a file or registry key, changes.",
          "title": "System Changed",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The start type is not mapped. See the <code>start_type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
