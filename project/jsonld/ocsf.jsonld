          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "confidence",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized confidence refers to the accuracy of the analytics that produced the finding. An analytic with a low confidence means that the finding scope is wide and may create finding reports that are noisy or may not be malicious in nature.",
      "title": "Confidence ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/confidence_id"
      ],
      "is_a": "OcsfIncidentProfile_confidence_id",
      "domain": "OcsfFindingEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/confidence_id",
      "alias": "confidence_id",
      "owner": "OcsfFindingEvent",
      "domain_of": [
        "OcsfFindingEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "confidence_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The normalized confidence is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The confidence is not mapped to the defined enum values. See the <code>confidence</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
