        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "encoding",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the encoding used to represent the fingerprint bytes as the string in <code>value</code>. A verifier must decode <code>value</code> using this encoding to recover the raw hash bytes.",
      "title": "Encoding ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/encoding_id"
      ],
      "is_a": "encoding_id",
      "domain": "OcsfFingerprint",
      "slot_uri": "https://w3id.org/lmodel/ocsf/encoding_id",
      "alias": "encoding_id",
      "owner": "OcsfFingerprint",
      "domain_of": [
        "OcsfFingerprint"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "encoding_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The encoding of the fingerprint value is not known.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The fingerprint value is encoded as a lowercase or uppercase hexadecimal string.",
          "title": "Hex",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The fingerprint value is encoded using standard Base64.",
          "title": "Base64",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc4648#section-4"
          ],
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The fingerprint value is encoded using URL- and filename-safe Base64.",
          "title": "Base64URL",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc4648#section-5"
          ],
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The encoding of the fingerprint value is not mapped. See the <code>encoding</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfFingerprint_serialization",
      "definition_uri": "https://w3id.org/lmodel/ocsf/serialization",
      "description": "The canonical serialization scheme used to produce the deterministic byte sequence that was fingerprinted, normalized to the caption of <code>serialization_id</code>. In the case of <code>Other</code>, it is defined by the event source.",
      "title": "Serialization",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/serialization"
      ],
      "is_a": "serialization",
      "domain": "OcsfFingerprint",
      "slot_uri": "https://w3id.org/lmodel/ocsf/serialization",
      "alias": "serialization",
      "owner": "OcsfFingerprint",
      "domain_of": [
        "OcsfFingerprint"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "serialization",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfFingerprint_serialization_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/serialization_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "serialization",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The identifier of the normalized canonical serialization scheme used to produce the deterministic byte sequence that was fingerprinted. A verifier must apply the same scheme to reproduce the fingerprinted input. Use <code>Flat</code> where the fingerprinted data is an opaque byte sequence, such as file content, to which no canonical serialization was applied. Distinct from <code>algorithm_id</code>, which identifies how the resulting bytes were hashed.",
      "title": "Serialization ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/serialization_id"
      ],
      "is_a": "serialization_id",
      "domain": "OcsfFingerprint",
      "slot_uri": "https://w3id.org/lmodel/ocsf/serialization_id",
      "alias": "serialization_id",
      "owner": "OcsfFingerprint",
      "domain_of": [
        "OcsfFingerprint"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "serialization_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "No canonical serialization was applied; the fingerprint is computed over the data's raw byte sequence, such as the content of a disk file or any other opaque byte stream.",
          "title": "Flat",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "JSON Canonicalization Scheme - deterministic JSON serialization of the structured data prior to hashing.",
          "title": "JCS",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc8785"
          ],
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "JSON Web Signature - the JWS Signing Input, i.e. BASE64URL(protected header) '.' BASE64URL(payload).",
          "title": "JWS",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc7515"
          ],
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "CBOR Object Signing and Encryption - the CBOR Sig_structure used as the binary input.",
          "title": "COSE",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc9052"
          ],
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Dead Simple Signing Envelope - the PAE (Pre-Authentication Encoding) canonical input. Note: DSSE is a signing-envelope scheme, not a hash algorithm; the hash algorithm is carried in <code>algorithm_id</code>.",
          "title": "DSSE",
          "see_also": [
            "https://github.com/secure-systems-lab/dsse"
          ],
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Portable Executable (PE) Image Hash procedure that canonicalizes the PE structure into the byte sequence fed to the digest, excluding specified header fields and digesting sections in a defined order.",
          "title": "Authenticode",
          "see_also": [
            "https://download.microsoft.com/download/9/c/5/9c5b2167-8017-4bae-9fde-d599bac8184a/Authenticode_PE.docx"
          ],
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The procedure that describes how hashes of code and other structures form the Code Directory message that is digested.",
          "title": "Code Signing",
          "see_also": [
            "https://developer.apple.com/documentation/technotes/tn3126-inside-code-signing-hashes"
          ],
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Windows Application Package signing procedure that describes how file hashes are stored in the manifest, and how that manifest is signed.",
          "title": "App Package",
          "see_also": [
            "https://learn.microsoft.com/en-us/windows/msix/package/signing-package-overview"
          ],
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfFingerprint_value",
