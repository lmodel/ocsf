    {
      "name": "OcsfNetworkFileActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfNetworkFileActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfNetworkFileActivity",
      "domain_of": [
        "OcsfNetworkFileActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Network File Activity: Unknown",
          "equals_number": 401000,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Upload a file.",
          "title": "Network File Activity: Upload",
          "equals_number": 401001,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Download a file.",
          "title": "Network File Activity: Download",
          "equals_number": 401002,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Update a file.",
          "title": "Network File Activity: Update",
          "equals_number": 401003,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete a file.",
          "title": "Network File Activity: Delete",
          "equals_number": 401004,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Rename a file.",
          "title": "Network File Activity: Rename",
          "equals_number": 401005,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Copy a file.",
          "title": "Network File Activity: Copy",
          "equals_number": 401006,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Move a file.",
          "title": "Network File Activity: Move",
          "equals_number": 401007,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Restore a file.",
          "title": "Network File Activity: Restore",
          "equals_number": 401008,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Preview a file.",
          "title": "Network File Activity: Preview",
          "equals_number": 401009,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Lock a file.",
          "title": "Network File Activity: Lock",
          "equals_number": 401010,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Unlock a file.",
          "title": "Network File Activity: Unlock",
          "equals_number": 401011,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Share a file.",
          "title": "Network File Activity: Share",
          "equals_number": 401012,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Unshare a file.",
          "title": "Network File Activity: Unshare",
          "equals_number": 401013,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Open a file.",
          "title": "Network File Activity: Open",
          "equals_number": 401014,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mark a file or folder to sync with a computer.",
          "title": "Network File Activity: Sync",
          "equals_number": 401015,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mark a file or folder to not sync with a computer.",
          "title": "Network File Activity: Unsync",
          "equals_number": 401016,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Network File Activity: Other",
          "equals_number": 401099,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNtpActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfNtpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfNtpActivity",
      "domain_of": [
        "OcsfNtpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "Not used in standard NTP implementations.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bidirectional time exchange between devices.",
          "title": "Symmetric Active Exchange",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Device responds as a server to peers in symmetric active mode.",
          "title": "Symmetric Passive Response",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "NTP client, syncs with servers.",
          "title": "Client Synchronization",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Dedicated NTP time server, responds to clients.",
          "title": "Server Response",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Broadcast time info to network devices.",
          "title": "Broadcast",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Monitoring and control messaging.",
          "title": "Control",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Reserved - Not defined in standard NTP specifications.",
          "title": "Private Use Case",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNtpActivity_category_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/category_name",
