      ],
      "is_usage_slot": true,
      "usage_slot_name": "src_url",
      "range": "ocsf_url_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfMitigation_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/uid",
      "description": "The Mitigation ID that is associated with the attack technique. For example: <code>M1027</code>, or <code>AML.M0013</code>.",
      "title": "Unique ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
