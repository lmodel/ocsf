    {
      "name": "OcsfSshActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfSshActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfSshActivity",
      "domain_of": [
        "OcsfSshActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "SSH Activity: Unknown",
          "equals_number": 400700,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A new network connection was opened.",
          "title": "SSH Activity: Open",
          "equals_number": 400701,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The network connection was closed.",
          "title": "SSH Activity: Close",
          "equals_number": 400702,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The network connection was abnormally terminated or closed by a middle device like firewalls.",
          "title": "SSH Activity: Reset",
          "equals_number": 400703,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The network connection failed. For example a connection timeout or no route to host.",
          "title": "SSH Activity: Fail",
          "equals_number": 400704,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The network connection was refused. For example an attempt to connect to a server port which is not open.",
          "title": "SSH Activity: Refuse",
          "equals_number": 400705,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Network traffic report.",
          "title": "SSH Activity: Traffic",
          "equals_number": 400706,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A network endpoint began listening for new network connections.",
          "title": "SSH Activity: Listen",
          "equals_number": 400707,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "SSH Activity: Other",
          "equals_number": 400799,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfTunnelActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfTunnelActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfTunnelActivity",
      "domain_of": [
        "OcsfTunnelActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Open a tunnel.",
          "title": "Open",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Close a tunnel.",
          "title": "Close",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Renew a tunnel.",
          "title": "Renew",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
