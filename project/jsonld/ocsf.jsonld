      ],
      "is_usage_slot": true,
      "usage_slot_name": "url_string",
      "range": "ocsf_url_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScim_vendor_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/vendor_name",
      "description": "Name of the vendor or service provider implementing SCIM. E.g., <code>Okta</code>, <code>Auth0</code>, <code>Microsoft</code>.",
      "title": "Service Provider",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/vendor_name"
