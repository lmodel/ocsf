    {
      "name": "OcsfRoleManagement",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfRoleManagement",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "role_management",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_category",
          "value": "iam",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "ai_operation cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control",
          "@type": "Annotation"
        }
      ],
      "description": "Role Management events report lifecycle management of a role, as well as privileges, policies, credentials, and resources associated with the role. There are two ways updates to the state of a role may be expressed: Using the <code>Update</code> activity, for example when updating multiple items at one time, the <code>updated_role</code> reflects the changes made to <code>iam_role</code>. Using discrete activities, such as <code>Assign Privileges</code> the state change is expressed by the <code>privileges</code> attribute. Optionally, on success, the <code>updated_role</code> reflects the new state of the role. Roles assigned or removed from users and groups are expressed by the <code>User Management</code> and <code>Group Management</code> classes.",
      "title": "Role Management",
      "in_subset": [
        "ocsf_category_iam"
      ],
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_events_iam",
      "see_also": [
        "https://d3fend.mitre.org/event/d3f:PermissionGrantingEvent/"
      ],
      "exact_mappings": [
