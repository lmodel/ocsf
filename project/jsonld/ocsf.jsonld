    },
    {
      "name": "sender",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sender",
      "description": "The machine readable email address of the system or server that actually transmitted the email message, extracted from the email headers per RFC 5322. This differs from the <code>from</code> field, which shows the message author. The sender field is most commonly used when multiple addresses appear in the <code> from_list </code> field, or when the transmitting system is different from the message author (such as when sending on behalf of someone else).",
      "title": "Sender",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.rfc-editor.org/rfc/rfc5322"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/sender"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/sender",
      "owner": "OcsfEmail",
      "domain_of": [
        "OcsfEmail"
      ],
      "range": "ocsf_email_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "sender_mailbox",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sender_mailbox",
      "description": "The human readable email address of the system or server that actually transmitted the email message, extracted from the email headers per RFC 5322. This differs from the <code>from_mailbox</code> field, which shows the message author. The sender mailbox field is most commonly used when multiple addresses appear in the <code> from_mailboxes </code> field, or when the transmitting system is different from the message author (such as when sending on behalf of someone else).",
      "title": "Sender Mailbox",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.rfc-editor.org/rfc/rfc5322"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/sender_mailbox"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/sender_mailbox",
      "owner": "OcsfEmail",
      "domain_of": [
        "OcsfEmail"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "sensitivity",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sensitivity",
      "description": "The sensitivity of the firewall rule in the matched event. For example: HIGH.",
      "title": "Sensitivity",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/sensitivity"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/sensitivity",
      "owner": "OcsfFirewallRule",
      "domain_of": [
        "OcsfFirewallRule"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "sensor_layer",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sensor_layer",
      "description": "The normalized identifier of the sensor layer that emitted the data for the analysis. For example, use this to classify the detection surface (e.g., IPS sensor, endpoint agent, email gateway). When the type is not listed, use <code>99</code> (Other) and populate <code>sensor_layer</code> with the source-specific label.",
      "title": "Sensor Layer",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/sensor_layer"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/sensor_layer",
      "owner": "OcsfSensorInfo",
      "domain_of": [
        "OcsfSensorInfo"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "sensor_layer_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sensor_layer_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "sensor_layer",
          "@type": "Annotation"
        }
      ],
      "description": "The technology or sensor layer that the event or finding originated from. See specific usage.",
      "title": "Sensor Layer ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/sensor_layer_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/sensor_layer_id",
      "owner": "OcsfSensorInfo",
      "domain_of": [
        "OcsfSensorInfo"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The sensor layer type is Unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from a network, firewall, or IPS sensor.",
          "title": "Network",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an endpoint device or agent running on an OS.",
          "title": "Endpoint",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an email gateway or email security system.",
          "title": "Email",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an identity and access management (IAM) system or service.",
          "title": "IAM",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from a proxy server (e.g., forward or reverse proxy, web gateway).",
          "title": "Proxy",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from a cyber threat intelligence (CTI) system or by matching observables against a threat intelligence feed or report.",
          "title": "Threat Intel",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an application (e.g., web application, SaaS platform, or custom business application).",
          "title": "Application",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The sensor layer type is not mapped. See the <code>sensor_layer</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "sequence",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sequence",
      "description": "Sequence number of the event. The sequence number is a value available in some events, to make the exact ordering of events unambiguous, regardless of the event time precision.",
      "title": "Sequence Number",
