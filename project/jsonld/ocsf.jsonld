    {
      "name": "OcsfNetworkEvent_cumulative_traffic",
      "definition_uri": "https://w3id.org/lmodel/ocsf/cumulative_traffic",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "The cumulative (running total) network traffic aggregated from the start of a flow or session. Use when reporting: (1) total accumulated bytes/packets since flow initiation, (2) combined aggregation models where both incremental deltas and running totals are reported together (populate both <code>traffic</code> for the delta and this attribute for the cumulative total), or (3) final summary metrics when a long-lived connection closes. This represents the sum of all activity from flow start to the current observation, not a delta or point-in-time value.",
      "title": "Cumulative Traffic",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/cumulative_traffic"
      ],
      "is_a": "cumulative_traffic",
      "domain": "OcsfNetworkEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/cumulative_traffic",
      "alias": "cumulative_traffic",
      "owner": "OcsfNetworkEvent",
      "domain_of": [
        "OcsfNetworkEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "cumulative_traffic",
      "range": "OcsfNetworkTraffic",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
