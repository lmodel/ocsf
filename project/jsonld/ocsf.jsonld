      "name": "detection_pattern_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/detection_pattern_type",
      "description": "The detection pattern type, normalized to the caption of the detection_pattern_type_id value. In the case of 'Other', it is defined by the event source.",
      "title": "Detection Pattern",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/detection_pattern_type"
      ],
