    {
      "name": "tunnel_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/tunnel_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "tunnel_type",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier for the type of tunnel configuration, indicating the scope of traffic routed through the connection. See specific usage.",
      "title": "Tunnel Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/tunnel_type_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/tunnel_type_id",
      "owner": "OcsfTunnelActivity",
      "domain_of": [
        "OcsfTunnelActivity"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The type of tunnel configuration is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The tunnel configuration routes only specific traffic through the tunnel.",
          "title": "Split Tunnel",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The tunnel configuration routes all traffic through the tunnel.",
          "title": "Full Tunnel",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type of tunnel configuration is not defined by the event source.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
