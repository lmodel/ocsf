      "domain_of": [
        "OcsfUserManagement"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Create a user. Populate the <code>user</code> object with details of the user.",
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Update the user. The updated user details should be populated in the <code>updated_user</code> attribute.",
          "title": "Update",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete the user.",
          "title": "Delete",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Enable the user.",
          "title": "Enable",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Disable the user.",
          "title": "Disable",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Lock out the user.",
          "title": "Lock",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Unlock a previously locked out user.",
          "title": "Unlock",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An attempt to change the user's password.",
          "title": "Password Change",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An attempt to reset the user's password.",
          "title": "Password Reset",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Attach one or more IAM Policies to the user. Use <code>policies</code> as policies to be attached.",
          "title": "Attach Policies",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Detach one or more IAM Policies from the user. Use <code>policies</code> as policies to be detached.",
          "title": "Detach Policies",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Enable one or more authentication factors for the user. Use <code>auth_factors</code> as factors to be enabled.",
          "title": "Enable MFA Factors",
          "equals_number": 12,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Disable one or more authentication factors for the user. Use <code>auth_factors</code> as factors to be disabled.",
          "title": "Disable MFA Factors",
          "equals_number": 13,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign privileges to the user. Use <code>privileges</code> as privileges to be assigned.",
          "title": "Assign Privileges",
          "equals_number": 14,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove privileges from the user. Use <code>privileges</code> as privileges to be removed.",
          "title": "Remove Privileges",
          "equals_number": 15,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign one or more roles to the user. Use <code>iam_roles</code> as roles to be assigned.",
          "title": "Assign Roles",
          "equals_number": 16,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove one or more roles from the user. Use <code>iam_roles</code> as roles to be removed.",
          "title": "Remove Roles",
          "equals_number": 17,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Add credentials to a role. Use <code>programmatic_credentials</code> as credentials to be added.",
          "title": "Add Programmatic Credentials",
          "equals_number": 18,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove credentials from a role. Use <code>programmatic_credentials</code> as credentials to be removed.",
          "title": "Remove Programmatic Credentials",
          "equals_number": 19,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
