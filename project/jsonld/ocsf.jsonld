      "slot_uri": "https://w3id.org/lmodel/ocsf/algorithm",
      "alias": "algorithm",
      "owner": "OcsfDigitalSignature",
      "domain_of": [
        "OcsfDigitalSignature"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "algorithm",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDigitalSignature_algorithm_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/algorithm_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "algorithm",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The identifier of the normalized digital signature algorithm.",
      "title": "Algorithm ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/algorithm_id"
      ],
      "is_a": "algorithm_id",
      "domain": "OcsfDigitalSignature",
      "slot_uri": "https://w3id.org/lmodel/ocsf/algorithm_id",
      "alias": "algorithm_id",
      "owner": "OcsfDigitalSignature",
      "domain_of": [
        "OcsfDigitalSignature"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "algorithm_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The algorithm is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Digital Signature Algorithm (DSA).",
          "title": "DSA",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Rivest-Shamir-Adleman (RSA) Algorithm.",
          "title": "RSA",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Elliptic Curve Digital Signature Algorithm.",
          "title": "ECDSA",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Authenticode Digital Signature Algorithm.",
          "title": "Authenticode",
          "see_also": [
            "https://download.microsoft.com/download/9/c/5/9c5b2167-8017-4bae-9fde-d599bac8184a/Authenticode_PE.docx"
          ],
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Code Signing Algorithm.",
          "title": "Code Signing",
          "see_also": [
            "https://developer.apple.com/documentation/technotes/tn3126-inside-code-signing-hashes"
          ],
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Application Package Signing Algorithm.",
          "title": "App Package",
          "see_also": [
            "https://learn.microsoft.com/en-us/windows/msix/package/signing-package-overview"
          ],
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The algorithm is not mapped. See the <code>algorithm</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
