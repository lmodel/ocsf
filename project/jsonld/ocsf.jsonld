    {
      "name": "OcsfSecurityControlProfile_is_alert",
      "definition_uri": "https://w3id.org/lmodel/ocsf/is_alert",
      "annotations": [
        {
          "tag": "ocsf_profiles",
          "value": "security_control",
          "@type": "Annotation"
        }
      ],
      "description": "Indicates that the event is considered to be an alertable signal. Should be set to <code>true</code> if <code>disposition_id = Alert</code> among other dispositions, and/or <code>risk_level_id</code> or <code>severity_id</code> of the event is elevated. Not all control events will be alertable, for example if <code>disposition_id = Exonerated</code> or <code>disposition_id = Allowed</code>.",
      "title": "Alert",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/is_alert"
      ],
      "is_a": "is_alert",
      "domain": "OcsfSecurityControlProfile",
      "slot_uri": "https://w3id.org/lmodel/ocsf/is_alert",
      "alias": "is_alert",
      "owner": "OcsfSecurityControlProfile",
      "domain_of": [
        "OcsfSecurityControlProfile"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "is_alert",
      "range": "ocsf_boolean_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSecurityControlProfile_malware",
      "definition_uri": "https://w3id.org/lmodel/ocsf/malware",
