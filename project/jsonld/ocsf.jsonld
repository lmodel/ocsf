    {
      "name": "OcsfPrivilegeInfo_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized type of the privilege.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfPrivilegeInfo",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfPrivilegeInfo",
      "domain_of": [
        "OcsfPrivilegeInfo"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The privilege type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A read-type privilege that permits viewing or retrieving data. Examples: <code>s3:GetObject</code>, <code>Microsoft.Storage/storageAccounts/read</code>, <code>storage.objects.get</code>.",
          "title": "Read",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A write-type privilege that permits creating, modifying, or deleting data. Examples: <code>s3:PutObject</code>, <code>Microsoft.Storage/storageAccounts/write</code>, <code>storage.objects.create</code>.",
          "title": "Write",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An execute-type privilege that permits running operations or invoking functions. Examples: <code>lambda:InvokeFunction</code>, <code>Microsoft.Compute/virtualMachines/start/action</code>.",
          "title": "Execute",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The privilege type is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfProcessEntity_cmd_line",
