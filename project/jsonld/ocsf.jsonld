    {
      "name": "OcsfModuleActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfModuleActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfModuleActivity",
      "domain_of": [
        "OcsfModuleActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Module Activity: Unknown",
          "equals_number": 100500,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The target module was loaded.",
          "title": "Module Activity: Load",
          "see_also": [
            "https://github.com/ocsf/ocsf-docs/blob/main/faqs/schema-faq.md#when-should-i-use-a-module-activity-load-event-and-when-should-i-use-a-process-activity-inject-event"
          ],
          "equals_number": 100501,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The target module was unloaded.",
          "title": "Module Activity: Unload",
          "equals_number": 100502,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A function exported from the target module was invoked.",
          "title": "Module Activity: Invoke",
          "equals_number": 100503,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Module Activity: Other",
          "equals_number": 100599,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfPeripheralActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfPeripheralActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfPeripheralActivity",
      "domain_of": [
        "OcsfPeripheralActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A peripheral device was connected to the system.",
          "title": "Connect",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A peripheral device was disconnected from the system.",
          "title": "Disconnect",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A peripheral device was enabled on the system.",
          "title": "Enable",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A peripheral device was disabled on the system.",
          "title": "Disable",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A peripheral device was ejected from the system. This is typically used for removable media devices. Note: For <code>Mount</code> and <code>Unmount</code> events, see the <a target='_blank' href='file_activity'>File System Activity</a> event class.",
          "title": "Eject",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfPeripheralActivity_category_name",
