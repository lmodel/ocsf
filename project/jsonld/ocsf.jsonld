    {
      "name": "OcsfUserManagement",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfUserManagement",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
