    {
      "name": "OcsfTunnelActivity_tunnel_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/tunnel_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "tunnel_type",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier for the type of tunnel configuration, indicating the scope of traffic routed through the connection. Example: <code>1 (Split Tunnel)</code> or <code>2 (Full Tunnel)</code>.",
      "title": "Tunnel Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/tunnel_type_id"
      ],
