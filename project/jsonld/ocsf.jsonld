    },
    {
      "name": "OcsfAiAgent_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type",
      "description": "The agent framework, normalized to the caption of the <code>type_id</code> value.",
      "title": "Agent Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type"
      ],
