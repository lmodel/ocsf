        "OcsfMitigation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "name",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfMitigation_src_url",
      "definition_uri": "https://w3id.org/lmodel/ocsf/src_url",
      "description": "The versioned permalink of the Mitigation. For example: <code>https://attack.mitre.org/versions/v14/mitigations/M1027</code>.",
      "title": "Source URL",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
