    {
      "name": "OcsfMessageContext_ai_role_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/ai_role_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "ai_role",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "Specifies the functional role of the AI within the context of this message, such as retrieving information, assisting reasoning, executing a tool, or generating content.",
      "title": "AI Role ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/ai_role_id"
      ],
      "is_a": "ai_role_id",
      "domain": "OcsfMessageContext",
      "slot_uri": "https://w3id.org/lmodel/ocsf/ai_role_id",
      "alias": "ai_role_id",
      "owner": "OcsfMessageContext",
      "domain_of": [
        "OcsfMessageContext"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "ai_role_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "Unknown role type.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The human user initiating a request.",
          "title": "User",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The AI model generating a response.",
          "title": "Assistant",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A callable tool or API invoked by the assistant.",
          "title": "Tool",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A software agent that performs tasks with autonomy or delegated intent.",
          "title": "Agent",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The component coordinating multiple agents or tools.",
          "title": "Orchestrator",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A component that retrieves information or context from a knowledge source (e.g., vector DB, search system, or API).",
          "title": "Retriever",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Other role type not covered above.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfMessageContext_application",
