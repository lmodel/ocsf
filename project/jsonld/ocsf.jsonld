    {
      "name": "OcsfDnsActivity_opcode_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/opcode_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_suppress_checks",
          "value": "enum_convention",
          "@type": "Annotation"
        }
      ],
      "description": "The DNS opcode ID specifies the normalized query message type as defined in RFC 5395.",
      "title": "DNS Opcode ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.rfc-editor.org/rfc/rfc5395.html"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/opcode_id"
      ],
      "is_a": "opcode_id",
      "domain": "OcsfDnsActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/opcode_id",
      "alias": "opcode_id",
      "owner": "OcsfDnsActivity",
      "domain_of": [
        "OcsfDnsActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "opcode_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "Standard query",
          "title": "Query",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Inverse query, obsolete",
          "title": "Inverse Query",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Server status request",
          "title": "Status",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Reserved, not used",
          "title": "Reserved",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Zone change notification",
          "title": "Notify",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Dynamic DNS update",
          "title": "Update",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DNS Stateful Operations (DSO)",
          "title": "DSO Message",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The DNS Opcode is not defined by the RFC. See the <code>opcode</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
