      "usage_slot_name": "class_uid",
      "range": "ocsf_integer_t",
      "required": true,
      "equals_number": 4001,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNetworkActivity_dst_endpoint",
      "definition_uri": "https://w3id.org/lmodel/ocsf/dst_endpoint",
      "description": "The destination endpoint of the network activity \u2014 typically the responder. In bi-flow or asymmetric flow scenarios, this endpoint may represent the true initiator of the original communication. Use <code>initiator_id</code> to determine which endpoint actually initiated the communication.",
      "title": "Destination Endpoint",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/dst_endpoint"
      ],
      "is_a": "OcsfNetworkEvent_dst_endpoint",
      "domain": "OcsfNetworkActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/dst_endpoint",
      "alias": "dst_endpoint",
      "owner": "OcsfNetworkActivity",
      "domain_of": [
        "OcsfNetworkActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "dst_endpoint",
      "range": "OcsfNetworkEndpoint",
      "recommended": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNetworkActivity_initiator",
      "definition_uri": "https://w3id.org/lmodel/ocsf/initiator",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "The endpoint that initiated the network communication, normalized to the caption of <code>initiator_id</code>. In the case of <code>Other</code>, it is defined by the event source.",
      "title": "Initiator",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/initiator"
      ],
      "is_a": "initiator",
      "domain": "OcsfNetworkActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/initiator",
      "alias": "initiator",
      "owner": "OcsfNetworkActivity",
      "domain_of": [
        "OcsfNetworkActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "initiator",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNetworkActivity_initiator_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/initiator_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "initiator",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the endpoint that initiated the network communication. Use this field to disambiguate source and destination roles in bi-directional or asymmetric flow scenarios.",
      "title": "Initiator ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/initiator_id"
      ],
      "is_a": "initiator_id",
      "domain": "OcsfNetworkActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/initiator_id",
      "alias": "initiator_id",
      "owner": "OcsfNetworkActivity",
      "domain_of": [
        "OcsfNetworkActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "initiator_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The <code>src_endpoint</code> is the true initiator and the source/destination assignment is correct.",
          "title": "Source Endpoint",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The <code>dst_endpoint</code> is the true initiator and the source/destination assignment is reversed.",
          "title": "Destination Endpoint",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNetworkActivity_is_src_dst_assignment_known",
      "definition_uri": "https://w3id.org/lmodel/ocsf/is_src_dst_assignment_known",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_deprecated_since",
          "value": "1.9.0",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_superseded_by",
          "value": "initiator_id",
          "@type": "Annotation"
        }
      ],
      "description": "<code>true</code> denotes that <code>src_endpoint</code> and <code>dst_endpoint</code> correctly identify the initiator and responder respectively. <code>false</code> denotes that the event source has arbitrarily assigned one peer to <code>src_endpoint</code> and the other to <code>dst_endpoint</code>, in other words that initiator and responder are not being asserted. This can occur, for example, when the event source is a network appliance that has not observed the initiation of a given connection. In the absence of this attribute, interpretation of the initiator and responder is implementation-specific.",
      "title": "Source/Destination Assignment Known",
      "deprecated": "Use <code>initiator_id</code> instead, which provides richer semantics for bi-flow and asymmetric flow scenarios.",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/is_src_dst_assignment_known"
      ],
      "is_a": "is_src_dst_assignment_known",
      "domain": "OcsfNetworkActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/is_src_dst_assignment_known",
      "alias": "is_src_dst_assignment_known",
      "owner": "OcsfNetworkActivity",
      "domain_of": [
        "OcsfNetworkActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "is_src_dst_assignment_known",
      "range": "ocsf_boolean_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNetworkActivity_load_balancer",
