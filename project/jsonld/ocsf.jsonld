        }
      },
      "description": "The job trigger type, i.e. the condition that must be met for the job to perform its action.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
