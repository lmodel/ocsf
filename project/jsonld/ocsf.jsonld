      "is_usage_slot": true,
      "usage_slot_name": "vendor_name",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScim_version",
      "definition_uri": "https://w3id.org/lmodel/ocsf/version",
      "description": "SCIM protocol version supported e.g., <code>SCIM 2.0</code>.",
      "title": "SCIM Version",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/version"
      ],
      "is_a": "version",
