    {
      "name": "network_scope_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/network_scope_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "network_scope",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the endpoint\u2019s network scope. The normalized network scope identifier indicates whether the endpoint resides inside the customer\u2019s network, outside on the Internet, or if its location relative to the customer\u2019s network cannot be determined.",
      "title": "Network Scope ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/network_scope_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/network_scope_id",
      "owner": "OcsfNetworkEndpoint",
      "domain_of": [
        "OcsfNetworkEndpoint"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "Unknown whether this endpoint resides within the customer\u2019s network.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The endpoint resides inside the customer\u2019s network.",
          "title": "Internal",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The endpoint is on the Internet or otherwise external to the customer\u2019s network.",
          "title": "External",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The network scope is not mapped. See the <code>network_scope</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
