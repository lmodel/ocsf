        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "encoding",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the encoding method used to represent the packet data as a string.",
      "title": "Encoding ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/encoding_id"
      ],
