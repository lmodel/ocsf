      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_hostname_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfHostnameT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
