      "name": "OcsfWinService_service_error_control_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/service_error_control_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "service_error_control",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_extension": {
          "tag": "ocsf_extension",
          "value": "win",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the service error control.",
      "title": "Service Error Control ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/service_error_control_id"
      ],
      "is_a": "service_error_control_id",
      "domain": "OcsfWinService",
      "slot_uri": "https://w3id.org/lmodel/ocsf/service_error_control_id",
      "alias": "service_error_control_id",
      "owner": "OcsfWinService",
      "domain_of": [
        "OcsfWinService"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "service_error_control_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The service error control is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The startup program ignores the error and continues the startup operation.",
          "title": "Ignore",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The startup program logs the error in the event log but continues the startup operation.",
          "title": "Normal",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The startup program logs the error in the event log. If the last-known-good configuration is being started, the startup operation continues. Otherwise, the system is restarted with the last-known-good configuration.",
          "title": "Severe",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The startup program logs the error in the event log, if possible. If the last-known-good configuration is being started, the startup operation fails. Otherwise, the system is restarted with the last-known good configuration.",
          "title": "Critical",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The service error control is not mapped. See the <code>service_error_control</code> attribute, which contains an event source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
