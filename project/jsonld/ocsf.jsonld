    {
      "name": "OcsfIncidentProfile_confidence_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/confidence_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "incident",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "confidence",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized confidence refers to the accuracy of the analytics that produced the alert or finding. See specific usage.",
      "title": "Confidence ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/confidence_id"
      ],
      "is_a": "confidence_id",
