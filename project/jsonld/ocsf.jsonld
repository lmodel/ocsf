    {
      "name": "OcsfOsintProfile",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfOsintProfile",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "osint",
          "@type": "Annotation"
        }
      ],
      "description": "The OSINT (Open Source Intelligence) profile contains one or more indicators and associated analysis and details, such as registrar (WHOIS) information and commentary about a hostname, or information about a digital certificate and its usage within a campaign. This information can be used to further enrich a detection or finding by providing decisioning support to other analysts and engineers within the profile itself.",
      "title": "OSINT",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "exact_mappings": [
        "ocsf:OcsfOsintProfile"
      ],
      "mixin": true,
      "slots": [
        "OcsfOsintProfile_osint"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ocsf/OcsfOsintProfile",
      "@type": "ClassDefinition"
    },
    {
      "name": "OcsfRecordIntegrityProfile",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfRecordIntegrityProfile",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "record_integrity",
          "@type": "Annotation"
        }
      ],
      "description": "The Record Integrity profile adds one or more cryptographic attestations over the event itself, providing integrity, authenticity, and non-repudiation independent of any domain-specific content. It is domain-agnostic and may be applied to any event class. Each attestation is computed over a canonical serialization of the event; independent attesters over the same event each contribute a separate entry in <code>attestation_list</code>, while multiple signers of a single attestation, such as a producer plus a co-signature, notary, or witness, are carried in that attestation's <code>signatures</code> array, and a sequence of events may form a tamper-evident hash chain.",
      "title": "Record Integrity",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "exact_mappings": [
        "ocsf:OcsfRecordIntegrityProfile"
      ],
      "mixin": true,
      "slots": [
        "OcsfRecordIntegrityProfile_attestation_list"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ocsf/OcsfRecordIntegrityProfile",
      "@type": "ClassDefinition"
    },
    {
      "name": "OcsfSecurityControlProfile",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfSecurityControlProfile",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "security_control",
          "@type": "Annotation"
        }
      ],
      "description": "The attributes including disposition that represent the outcome of a security control including but not limited to access control, malware or policy violation, network proxy, intrusion detection, firewall, or data control.  The profile is intended to augment activities or findings with an outcome when a security control has observed or intervened. If the control detected a security violation, and the <code>disposition_id</code> or <code>action_id</code> is an alertable outcome or action, the <code>is_alert</code> flag may be set to <code>true</code>.",
      "title": "Security Control",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "exact_mappings": [
        "ocsf:OcsfSecurityControlProfile"
      ],
      "mixin": true,
      "slots": [
        "OcsfSecurityControlProfile_action",
        "OcsfSecurityControlProfile_action_id",
        "OcsfSecurityControlProfile_attacks",
        "OcsfSecurityControlProfile_authorizations",
        "OcsfSecurityControlProfile_confidence",
        "OcsfSecurityControlProfile_confidence_id",
        "OcsfSecurityControlProfile_confidence_score",
        "OcsfSecurityControlProfile_disposition",
        "OcsfSecurityControlProfile_disposition_id",
        "OcsfSecurityControlProfile_firewall_rule",
        "OcsfSecurityControlProfile_is_alert",
        "OcsfSecurityControlProfile_malware",
        "OcsfSecurityControlProfile_malware_scan_info",
        "OcsfSecurityControlProfile_policy",
        "OcsfSecurityControlProfile_risk_details",
        "OcsfSecurityControlProfile_risk_level",
        "OcsfSecurityControlProfile_risk_level_id",
        "OcsfSecurityControlProfile_risk_score"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ocsf/OcsfSecurityControlProfile",
      "@type": "ClassDefinition"
    },
    {
      "name": "OcsfTraceProfile",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfTraceProfile",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "trace",
          "@type": "Annotation"
        }
      ],
      "description": "The Trace Profile extends the OCSF framework to capture and standardize observability events, specifically targeting trace-level data. This profile enables integration and normalization of distributed tracing information, allowing OCSF events to retain essential trace context such as trace IDs, span relationships, and service dependencies.",
      "title": "Trace",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "exact_mappings": [
        "ocsf:OcsfTraceProfile"
      ],
      "mixin": true,
      "slots": [
        "OcsfTraceProfile_trace"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ocsf/OcsfTraceProfile",
      "@type": "ClassDefinition"
    },
    {
      "name": "OcsfEntity",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfEntity",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "_entity",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_constraints",
          "value": "{\"at_least_one\": [\"name\", \"uid\"]}",
          "@type": "Annotation"
        }
      ],
      "description": "The Entity object is an unordered collection of attributes, with a name and unique identifier. It serves as a base object that defines a set of attributes and default constraints available in all objects that extend it.",
      "title": "Entity",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
