  "classes": [
    {
      "name": "OcsfFacts",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfFacts",
      "description": "What an annotation states about an OCSF element where the metamodel has no slot for it. No data holds this class: it declares the annotation keys, and each annotated element names it through instantiates.",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "exact_mappings": [
        "ocsf:OcsfFacts"
      ],
      "abstract": true,
      "slots": [
        "ocsfFacts__ocsf_key",
        "ocsfFacts__ocsf_category",
        "ocsfFacts__ocsf_category_uid",
        "ocsfFacts__ocsf_extension",
        "ocsfFacts__ocsf_extension_uid",
        "ocsfFacts__ocsf_group",
        "ocsfFacts__ocsf_profiles",
        "ocsfFacts__ocsf_requirement",
        "ocsfFacts__ocsf_sibling",
        "ocsfFacts__ocsf_observable",
        "ocsfFacts__ocsf_source_note",
        "ocsfFacts__ocsf_suppress_checks",
        "ocsfFacts__ocsf_max_len",
        "ocsfFacts__ocsf_constraints",
        "ocsfFacts__ocsf_associations",
        "ocsfFacts__ocsf_deprecated_since",
        "ocsfFacts__ocsf_superseded_by"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ocsf_key",
          "description": "The item's key in OCSF, scoped by its extension where it has one.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_category",
          "description": "The event class's category, by OCSF's key.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_category_uid",
          "description": "The category's number, on the subset that stands for it.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_extension",
          "description": "The extension that defines the element.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_extension_uid",
          "description": "The extension's number, on the subset that stands for it.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_group",
          "description": "An attribute's group: classification, context, occurrence or primary.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_profiles",
          "description": "The profiles behind an element, by OCSF's key and space separated. An event holds an attribute that names any only if metadata.profiles lists one of them. On a class, they are every profile OCSF lists for it, its nested objects' included.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_requirement",
          "description": "OCSF's requirement on an attribute a profile brings, which applies only when the event lists the profile.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_sibling",
          "description": "The string attribute that holds the label of an enumerated one.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_observable",
          "description": "OCSF's observable type id for the element.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_source_note",
          "description": "OCSF's note on where an attribute comes from.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_suppress_checks",
          "description": "The convention checks OCSF turns off for an attribute.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_max_len",
          "description": "OCSF's longest allowed value of a data type, in characters.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_constraints",
          "description": "A class's at_least_one and just_one constraints, as JSON.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_associations",
          "description": "A class's associations between attributes, as JSON.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_deprecated_since",
          "description": "The OCSF version that deprecated the element.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ocsf_superseded_by",
          "description": "What OCSF names as the replacement, space separated.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/ocsf/OcsfFacts",
      "@type": "ClassDefinition"
    },
    {
      "name": "OcsfJsonValue",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfJsonValue",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
