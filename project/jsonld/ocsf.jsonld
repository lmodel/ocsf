        "OcsfNetworkConnectionQuery"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Network Connection Query: Unknown",
          "equals_number": 501200,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The discovered results are via a query request.",
          "title": "Network Connection Query: Query",
          "equals_number": 501201,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Network Connection Query: Other",
          "equals_number": 501299,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNetworksQuery_activity_id",
