          "annotations": {}
        }
      },
      "description": "Describes the normalized status of DNS Security Extensions (DNSSEC) for a domain.",
      "title": "DNSSEC Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
