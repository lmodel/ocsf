          "value": "file_name_t",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_observable",
          "value": "7",
          "@type": "Annotation"
        }
      ],
      "description": "File name. For example:<br><code>text-file.txt</code>.",
      "title": "File Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_file_path_t",
