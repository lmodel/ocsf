      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_message",
      "definition_uri": "https://w3id.org/lmodel/ocsf/message",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "A human-readable description of the event, as defined by the source. This should be a concise, meaningful summary suitable for display in a UI or alert notification - not a raw log line. For example: <code>\"User john_doe logged in from 10.0.0.1.\"</code> rather than a raw syslog string.",
      "title": "Message",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/message"
      ],
      "is_a": "message",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/message",
      "alias": "message",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "message",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_metadata",
      "definition_uri": "https://w3id.org/lmodel/ocsf/metadata",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "The metadata object describes the event producer, schema version, and processing information. Producers and mappers <b>must</b> populate <code>metadata.product</code> to identify the data source, and <code>metadata.version</code> to indicate the OCSF schema version used. Consumers rely on this to interpret the event correctly.",
      "title": "Metadata",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/metadata"
      ],
      "is_a": "metadata",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/metadata",
      "alias": "metadata",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "metadata",
      "range": "OcsfMetadata",
      "required": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_observables",
      "definition_uri": "https://w3id.org/lmodel/ocsf/observables",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The observables array surfaces key indicators and entities from the event or finding in a single, consistent location for downstream correlation and detection. Each entry references an attribute path within the event (e.g., <code>src_endpoint.ip</code>) along with its type and value, enabling consumers to extract IOCs without parsing the full event structure.",
      "title": "Observables",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "see_also": [
        "https://github.com/ocsf/ocsf-docs/blob/main/articles/defining-and-using-observables.md"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/observables"
      ],
      "is_a": "observables",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/observables",
      "alias": "observables",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "observables",
      "range": "OcsfObservable",
      "recommended": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_policy",
      "definition_uri": "https://w3id.org/lmodel/ocsf/policy",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "security_control",
          "@type": "Annotation"
        }
      ],
      "description": "Describes details of a policy. See specific usage.",
      "title": "Policy",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/policy"
      ],
      "is_a": "OcsfSecurityControlProfile_policy",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/policy",
      "alias": "policy",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "policy",
      "range": "OcsfPolicy",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_raw_data",
      "definition_uri": "https://w3id.org/lmodel/ocsf/raw_data",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "The original event/finding data as received from the source, before normalization into OCSF. Populate this with the verbatim log line, JSON payload, or other native format for forensic and debugging purposes. This field is not intended for structured querying - use the normalized OCSF attributes instead.",
      "title": "Raw Data",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/raw_data"
      ],
      "is_a": "raw_data",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/raw_data",
      "alias": "raw_data",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "raw_data",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_raw_data_hash",
      "definition_uri": "https://w3id.org/lmodel/ocsf/raw_data_hash",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "A fingerprint (hash) of the <code>raw_data</code> content. Use this to verify the integrity of the original event data or to deduplicate events.",
      "title": "Raw Data Hash",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/raw_data_hash"
      ],
      "is_a": "raw_data_hash",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/raw_data_hash",
      "alias": "raw_data_hash",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "raw_data_hash",
      "range": "OcsfFingerprint",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_raw_data_size",
      "definition_uri": "https://w3id.org/lmodel/ocsf/raw_data_size",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "The size of the original event data (as captured in <code>raw_data</code>) in bytes, before OCSF normalization. Useful for metering and capacity planning.",
      "title": "Raw Data Size",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/raw_data_size"
      ],
      "is_a": "raw_data_size",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/raw_data_size",
      "alias": "raw_data_size",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "raw_data_size",
      "range": "ocsf_long_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_severity",
      "definition_uri": "https://w3id.org/lmodel/ocsf/severity",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "classification",
          "@type": "Annotation"
        }
      ],
      "description": "The event/finding severity label, normalized to the caption of the <code>severity_id</code> value. When <code>severity_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific severity label. For all other values, this should match the caption defined for that <code>severity_id</code> enum value (e.g., <code>\"High\"</code> for <code>severity_id: 4</code>).",
      "title": "Severity",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/severity"
      ],
      "is_a": "severity",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/severity",
      "alias": "severity",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "severity",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_severity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/severity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "classification",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "severity",
          "@type": "Annotation"
        }
      ],
      "description": "<p>The normalized identifier of the event/finding severity.</p>The normalized severity is a measurement the effort and expense required to manage and resolve an event or incident. Smaller numerical values represent lower impact events, and larger numerical values represent higher impact events.",
      "title": "Severity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/severity_id"
      ],
      "is_a": "severity_id",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/severity_id",
      "alias": "severity_id",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "severity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event/finding severity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Informational message. No action required.",
          "title": "Informational",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The user decides if action is needed.",
          "title": "Low",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Action is required but the situation is not serious at this time.",
          "title": "Medium",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Action is required immediately.",
          "title": "High",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Action is required immediately and the scope is broad.",
          "title": "Critical",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An error occurred but it is too late to take remedial action.",
          "title": "Fatal",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event/finding severity is not mapped. See the <code>severity</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_start_time",
      "definition_uri": "https://w3id.org/lmodel/ocsf/start_time",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "occurrence",
          "@type": "Annotation"
        }
      ],
      "description": "The time of the earliest event in an aggregate (<code>count</code> &gt; 1). Do not populate for discrete, point-in-time events - use <code>time</code> alone. Subclasses such as findings may redefine this for their own time-range semantics.",
      "title": "Start Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/start_time"
      ],
      "is_a": "start_time",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/start_time",
      "alias": "start_time",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "start_time",
      "range": "ocsf_timestamp_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_start_time_dt",
      "definition_uri": "https://w3id.org/lmodel/ocsf/start_time_dt",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "occurrence",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "datetime",
          "@type": "Annotation"
        }
      ],
      "description": "The time of the earliest event in an aggregate (<code>count</code> &gt; 1). Do not populate for discrete, point-in-time events - use <code>time</code> alone. Subclasses such as findings may redefine this for their own time-range semantics.",
      "title": "Start Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/start_time_dt"
      ],
      "is_a": "start_time_dt",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/start_time_dt",
      "alias": "start_time_dt",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "start_time_dt",
      "range": "ocsf_datetime_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_status",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The event status label, normalized to the caption of the <code>status_id</code> value. When <code>status_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific status label. For all other values, this must match the caption defined for that <code>status_id</code> enum value (e.g., <code>\"Success\"</code> for <code>status_id: 1</code>).",
      "title": "Status",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status"
      ],
      "is_a": "status",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status",
      "alias": "status",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_status_code",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_code",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The source-specific status or error code as reported by the event source. For example, a Windows logon failure code (<code>0x18</code>), an HTTP response code (<code>403</code>), or an AWS API error code. This preserves the original code for detailed troubleshooting beyond what <code>status_id</code> conveys.",
      "title": "Status Code",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_code"
      ],
      "is_a": "status_code",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_code",
      "alias": "status_code",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_code",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_status_detail",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_detail",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "A human-readable description providing additional context about the event outcome. Use this to convey details that go beyond the normalized <code>status_id</code> and source-specific <code>status_code</code>, such as a failure reason or error message. For example: <code>\"Account locked after 5 failed attempts.\"</code>.",
      "title": "Status Detail",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_detail"
      ],
      "is_a": "status_detail",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_detail",
      "alias": "status_detail",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_detail",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_status_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "status",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized status of the event outcome. Use this family of attributes to convey the outcome of the activity described by the event. Producers should map their source outcome to <code>1</code> (Success) or <code>2</code> (Failure). Use <code>0</code> (Unknown) when the outcome cannot be determined, and <code>99</code> (Other) with a populated <code>status</code> string when the source value does not map cleanly.",
      "title": "Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_id"
      ],
      "is_a": "status_id",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "alias": "status_id",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity completed successfully.",
          "title": "Success",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity failed.",
          "title": "Failure",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_time",
      "definition_uri": "https://w3id.org/lmodel/ocsf/time",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "occurrence",
          "@type": "Annotation"
        }
      ],
      "description": "The primary timestamp of the event - when the activity actually occurred at the source. This does not capture when the event record was created or serialized by the source system; for event lifecycle timestamps such as ingestion and processing, use <code>metadata.logged_time</code> and <code>metadata.processed_time</code> respectively, or the equivalent attributes in the <code>metadata.loggers</code> array when recording pipeline stages. For aggregate events (<code>count</code> &gt; 1), set this to <code>start_time</code> (the earliest OCSF <code>time</code> in the aggregate) to preserve causal ordering and consistent timeline alignment. Note: finding classes redefine <code>time</code> as the finding creation time rather than the activity occurrence time. This <b>must</b> be a UTC epoch value in milliseconds (e.g., <code>1776881335332</code>). Mappers should use the most precise and authoritative timestamp available from the source.",
      "title": "Event Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/time"
      ],
      "is_a": "time",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/time",
      "alias": "time",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "time",
      "range": "ocsf_timestamp_t",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_time_dt",
      "definition_uri": "https://w3id.org/lmodel/ocsf/time_dt",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "occurrence",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "datetime",
          "@type": "Annotation"
        }
      ],
      "description": "The primary timestamp of the event - when the activity actually occurred at the source. This does not capture when the event record was created or serialized by the source system; for event lifecycle timestamps such as ingestion and processing, use <code>metadata.logged_time</code> and <code>metadata.processed_time</code> respectively, or the equivalent attributes in the <code>metadata.loggers</code> array when recording pipeline stages. For aggregate events (<code>count</code> &gt; 1), set this to <code>start_time</code> (the earliest OCSF <code>time</code> in the aggregate) to preserve causal ordering and consistent timeline alignment. Note: finding classes redefine <code>time</code> as the finding creation time rather than the activity occurrence time. This <b>must</b> be a UTC epoch value in milliseconds (e.g., <code>1776881335332</code>). Mappers should use the most precise and authoritative timestamp available from the source.",
      "title": "Event Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/time_dt"
      ],
      "is_a": "time_dt",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/time_dt",
      "alias": "time_dt",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "time_dt",
      "range": "ocsf_datetime_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_timezone_offset",
      "definition_uri": "https://w3id.org/lmodel/ocsf/timezone_offset",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "occurrence",
          "@type": "Annotation"
        }
      ],
      "description": "The number of minutes that the reported event <code>time</code> is ahead or behind UTC, in the range -1,080 to +1,080. This allows consumers to reconstruct the local time at the event source. For example, US Eastern Standard Time is <code>-300</code>. Populate this when the source provides local time zone information.",
      "title": "Timezone Offset",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/timezone_offset"
      ],
      "is_a": "timezone_offset",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/timezone_offset",
      "alias": "timezone_offset",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "timezone_offset",
      "range": "ocsf_integer_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_type_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_name",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "classification",
          "@type": "Annotation"
        }
      ],
      "description": "The event/finding type name, combining the class and activity (e.g., <code>\"Detection Finding: Create\"</code>). The value must match the <code>class_name</code> and <code>activity_name</code> joined by <code>\": \"</code>.",
      "title": "Type Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_name"
      ],
      "is_a": "type_name",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_name",
      "alias": "type_name",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_name",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "classification",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "@type": "Annotation"
        }
      ],
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "type_uid",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Base Event: Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Base Event: Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_unmapped",
      "definition_uri": "https://w3id.org/lmodel/ocsf/unmapped",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        }
      ],
      "description": "A container for source-specific attributes that do not map to any defined OCSF attribute. Use this to preserve valuable source data that would otherwise be lost during normalization. The keys and values are specific to the event source. <p><b>Note: </b>Consumers should not rely on a stable structure within this field. The preferred approach to unmapped attributes is to create a custom extension with the desired structure.</p>",
      "title": "Unmapped Data",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "see_also": [
        "https://github.com/ocsf/ocsf-docs/blob/main/faqs/schema-faq.md#when-should-i-use-the-unmapped-attribute",
        "https://github.com/ocsf/ocsf-schema/blob/main/CONTRIBUTING.md#ocsf-extensions"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/unmapped"
      ],
      "is_a": "unmapped",
      "domain": "OcsfBaseEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/unmapped",
      "alias": "unmapped",
      "owner": "OcsfBaseEvent",
      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "unmapped",
      "range": "OcsfObject",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDiscoveryEvent_category_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/category_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "category_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The category unique identifier of the event. Each event class belongs to exactly one category. Producers and mappers must set this to the category defined by the event class being used.",
      "title": "Category ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
