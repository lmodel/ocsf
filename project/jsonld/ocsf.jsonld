      "recommended": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "This restriction is currently applicable and being enforced.",
          "title": "Applicable",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "This restriction is not applicable.",
          "title": "Inapplicable",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "This restriction could not be properly evaluated due to an error.",
          "title": "Evaluation Error",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
