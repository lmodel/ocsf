    {
      "name": "OcsfAccountChange_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfAccountChange",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfAccountChange",
      "domain_of": [
        "OcsfAccountChange"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A user/role was created.",
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A user/role was enabled.",
          "title": "Enable",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An attempt was made to change a user account's password.",
          "title": "Password Change",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An attempt was made to reset a user account's password.",
          "title": "Password Reset",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A user/role was disabled.",
          "title": "Disable",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A user/role was deleted.",
          "title": "Delete",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An IAM Policy was attached to a user/role.",
          "title": "Attach Policy",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An IAM Policy was detached from a user/role.",
          "title": "Detach Policy",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A user account was locked out.",
          "title": "Lock",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more authentication factors were enabled for a user account.",
          "title": "MFA Factor Enable",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more authentication factors were disabled for a user account.",
          "title": "MFA Factor Disable",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A user account was unlocked.",
          "title": "Unlock",
          "equals_number": 12,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
