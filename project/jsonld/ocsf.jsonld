    {
      "name": "OcsfRemediationActivity_status_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "status",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized status identifier. See specific usage.",
      "title": "Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_id"
      ],
      "is_a": "OcsfBaseEvent_status_id",
      "domain": "OcsfRemediationActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "alias": "status_id",
      "owner": "OcsfRemediationActivity",
      "domain_of": [
        "OcsfRemediationActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity completed successfully.",
          "title": "Success",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity failed.",
          "title": "Failure",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The target of the remediation does not exist.",
          "title": "Does Not Exist",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The remediation was partially completed.",
          "title": "Partial",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The remediation was not supported.",
          "title": "Unsupported",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "There was an error during the remediation process.",
          "title": "Error",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfRemediationActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfRemediationActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfRemediationActivity",
      "domain_of": [
        "OcsfRemediationActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Remediation Activity: Unknown",
          "equals_number": 700100,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Creates logical or physical barriers in a system which reduces opportunities for adversaries to create further accesses.",
          "title": "Remediation Activity: Isolate",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Isolate/"
          ],
          "equals_number": 700101,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Removes an adversary or malicious resource from a device or computer network.",
          "title": "Remediation Activity: Evict",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Evict/"
          ],
          "equals_number": 700102,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Returns the system to a better state.",
          "title": "Remediation Activity: Restore",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Restore/"
          ],
          "equals_number": 700103,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Increases the opportunity cost of computer network exploitation.",
          "title": "Remediation Activity: Harden",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Harden/"
          ],
          "equals_number": 700104,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Identify adversary access to or unauthorized activity on computer networks.",
          "title": "Remediation Activity: Detect",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Detect/"
          ],
          "equals_number": 700105,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Advertise, entice, and allow potential attackers access to an observed or controlled environment.",
          "title": "Remediation Activity: Deceive",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Deceive/"
          ],
          "equals_number": 700106,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Remediation Activity: Other",
          "equals_number": 700199,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
