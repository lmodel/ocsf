    {
      "name": "OcsfDeviceHwInfo_uuid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/uuid",
      "description": "The device manufacturer assigned universally unique hardware identifier. For SMBIOS compatible devices such as those running Linux and Windows, it is the UUID member of the System Information structure in the SMBIOS information. For macOS devices, it is the Hardware UUID (also known as IOPlatformUUID in the I/O Registry).",
      "title": "UUID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.dmtf.org/standards/smbios",
        "https://linux.die.net/man/8/dmidecode",
        "https://learn.microsoft.com/en-us/windows/win32/cimwin32prov/win32-computersystemproduct",
        "https://theapplewiki.com/wiki/UDID#Mac",
        "https://github.com/apple-oss-distributions/xnu/blob/8d741a5de7ff4191bf97d57b9f54c2f6d4a15585/iokit/IOKit/IOKitKeys.h#L264-L265"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/uuid"
      ],
      "is_a": "uuid",
      "domain": "OcsfDeviceHwInfo",
      "slot_uri": "https://w3id.org/lmodel/ocsf/uuid",
      "alias": "uuid",
      "owner": "OcsfDeviceHwInfo",
      "domain_of": [
        "OcsfDeviceHwInfo"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "uuid",
      "range": "ocsf_uuid_t",
      "@type": "SlotDefinition"
    },
