      "domain_of": [
        "OcsfDeviceConfigStateChange"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "prev_security_level_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/prev_security_level_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "prev_security_level",
          "@type": "Annotation"
        }
      ],
      "description": "The previous security level of the entity",
      "title": "Previous Security Level ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/prev_security_level_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/prev_security_level_id",
      "owner": "OcsfDeviceConfigStateChange",
      "domain_of": [
        "OcsfDeviceConfigStateChange"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Secure",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "At Risk",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Compromised",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The security level is not mapped. See the <code>prev_security_level</code> attribute, which contains data source specific values.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "priority",
      "definition_uri": "https://w3id.org/lmodel/ocsf/priority",
      "description": "The priority, normalized to the caption of the priority_id value. In the case of 'Other', it is defined by the event source.",
      "title": "Priority",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/priority"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/priority",
      "owner": "OcsfIncidentFinding",
      "domain_of": [
        "OcsfIncidentProfile",
        "OcsfIncidentFinding"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "priority_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/priority_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "priority",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized priority. Priority identifies the relative importance of the incident or finding. It is a measurement of urgency.",
      "title": "Priority ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/priority_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/priority_id",
      "owner": "OcsfIncidentFinding",
      "domain_of": [
        "OcsfIncidentProfile",
        "OcsfIncidentFinding"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "No priority is assigned.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Application or personal procedure is unusable, where a workaround is available or a repair is possible.",
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Non-critical function or procedure is unusable or hard to use causing operational disruptions with no direct impact on a service's availability. A workaround is available.",
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Critical functionality or network access is interrupted, degraded or unusable, having a severe impact on services availability. No acceptable alternative is possible.",
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Interruption making a critical functionality inaccessible or a complete network interruption causing a severe impact on services availability. There is no possible alternative.",
          "title": "Critical",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The priority is not normalized.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "privileges",
      "definition_uri": "https://w3id.org/lmodel/ocsf/privileges",
