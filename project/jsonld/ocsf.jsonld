      "definition_uri": "https://w3id.org/lmodel/ocsf/auth_protocol_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "auth_protocol",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the authentication protocol used by the SSO resource.",
      "title": "Auth Protocol ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/auth_protocol_id"
      ],
