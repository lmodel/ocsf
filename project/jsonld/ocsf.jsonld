          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The permissions mask that was requested by the process.",
      "title": "Requested Permissions",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/requested_permissions"
      ],
      "is_a": "requested_permissions",
