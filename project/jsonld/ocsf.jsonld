    {
      "name": "OcsfTsig_error_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/error_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "error",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized TSIG-specific error code as defined in RFC 2845 and RFC 6895. This is independent of the DNS message header RCODE.",
      "title": "TSIG Error ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/error_id"
      ],
      "is_a": "error_id",
      "domain": "OcsfTsig",
      "slot_uri": "https://w3id.org/lmodel/ocsf/error_id",
      "alias": "error_id",
      "owner": "OcsfTsig",
      "domain_of": [
        "OcsfTsig"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "error_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "No error.",
          "title": "NoError",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "TSIG signature failure.",
          "title": "BADSIG",
          "equals_number": 16,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Key not recognized.",
          "title": "BADKEY",
          "equals_number": 17,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Signature out of time window.",
          "title": "BADTIME",
          "equals_number": 18,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The TSIG error code is not listed. See the <code>error</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
