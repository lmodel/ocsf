    {
      "name": "drive_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/drive_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "drive_type",
          "@type": "Annotation"
        }
      ],
      "description": "Identifies the type of a disk drive, i.e. fixed, removable, etc.",
      "title": "Drive Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/drive_type_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/drive_type_id",
      "owner": "OcsfFile",
      "domain_of": [
        "OcsfFile"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The drive type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The drive has removable media; for example, a floppy drive, thumb drive, or flash card reader.",
          "title": "Removable",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The drive has fixed media; for example, a hard disk drive or flash drive.",
          "title": "Fixed",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The drive is a remote (network) drive.",
          "title": "Remote",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The drive is a CD-ROM drive.",
          "title": "CD-ROM",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The drive is a RAM disk.",
          "title": "RAM Disk",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The drive type is not mapped. See the <code>drive_type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
