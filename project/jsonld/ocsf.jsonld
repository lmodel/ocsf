    {
      "name": "OcsfAuthorizeSession_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfAuthorizeSession",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfAuthorizeSession",
      "domain_of": [
        "OcsfAuthorizeSession"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign special privileges to a new logon.",
          "title": "Assign Privileges",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign special groups to a new logon.",
          "title": "Assign Groups",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign special roles to a new logon.",
          "title": "Assign Roles",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
