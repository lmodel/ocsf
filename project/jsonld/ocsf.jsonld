    {
      "name": "OcsfSbom_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The type of SBOM.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://spdx.dev/",
        "https://www.iso.org/standard/81870.html",
        "https://cyclonedx.org/",
        "https://ecma-international.org/publications-and-standards/standards/ecma-424/",
        "https://nvd.nist.gov/products/swid",
        "https://www.iso.org/standard/65666.html"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfSbom",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfSbom",
      "domain_of": [
        "OcsfSbom"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "System Package Data Exchange (SPDX\u00ae) is an open standard capable of representing systems with software components in as SBOMs (Software Bill of Materials) and other AI, data and security references supporting a range of risk management use cases. The SPDX specification is a freely available international open standard (ISO/IEC 5692:2021).",
          "title": "SPDX",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "CycloneDX is an International Standard for Bill of Materials (ECMA-424).",
          "title": "CycloneDX",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The International Organization for Standardization (ISO) and the International Electrotechnical Commission (IEC) publishes, ISO/IEC 19770-2, a standard for software identification (SWID) tags that defines a structured metadata format for describing a software product. A SWID tag document is composed of a structured set of data elements that identify the software product",
          "title": "SWID",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
