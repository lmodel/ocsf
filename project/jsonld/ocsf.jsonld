      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "log_type",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized log type identifier.",
      "title": "Log Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
