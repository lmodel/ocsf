      "owner": "OcsfIamAnalysisFinding",
      "domain_of": [
        "OcsfIamAnalysisFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "access_analysis_result",
      "range": "OcsfAccessAnalysisResult",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfIamAnalysisFinding_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
