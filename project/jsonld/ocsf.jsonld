    {
      "name": "OcsfHttpActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfHttpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfHttpActivity",
      "domain_of": [
        "OcsfHttpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "HTTP Activity: Unknown",
          "equals_number": 400200,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The CONNECT method establishes a tunnel to the server identified by the target resource.",
          "title": "HTTP Activity: Connect",
          "equals_number": 400201,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The DELETE method deletes the specified resource.",
          "title": "HTTP Activity: Delete",
          "equals_number": 400202,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The GET method requests a representation of the specified resource. Requests using GET should only retrieve data.",
          "title": "HTTP Activity: Get",
          "equals_number": 400203,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The HEAD method asks for a response identical to a GET request, but without the response body.",
          "title": "HTTP Activity: Head",
          "equals_number": 400204,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The OPTIONS method describes the communication options for the target resource.",
          "title": "HTTP Activity: Options",
          "equals_number": 400205,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The POST method submits an entity to the specified resource, often causing a change in state or side effects on the server.",
          "title": "HTTP Activity: Post",
          "equals_number": 400206,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The PUT method replaces all current representations of the target resource with the request payload.",
          "title": "HTTP Activity: Put",
          "equals_number": 400207,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The TRACE method performs a message loop-back test along the path to the target resource.",
          "title": "HTTP Activity: Trace",
          "equals_number": 400208,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The PATCH method applies partial modifications to a resource.",
          "title": "HTTP Activity: Patch",
          "equals_number": 400209,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The ACL method modifies the access control list of the specified resource.",
          "title": "HTTP Activity: ACL",
          "equals_number": 400210,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The BASELINE-CONTROL method places the specified collection resource under baseline control.",
          "title": "HTTP Activity: Baseline Control",
          "equals_number": 400211,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The BIND method adds a binding to the specified collection resource.",
