      "slot_uri": "https://w3id.org/lmodel/ocsf/table",
      "alias": "table",
      "owner": "OcsfDataSecurityFinding",
      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "table",
      "range": "OcsfTable",
      "recommended": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDataSecurityFinding_time_dt",
      "definition_uri": "https://w3id.org/lmodel/ocsf/time_dt",
      "description": "The finding creation time - when the finding was first generated, not when the underlying activity occurred. For the time range of contributing events, use <code>start_time</code> and <code>end_time</code>.",
      "title": "Event Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/time_dt"
      ],
      "is_a": "OcsfBaseEvent_time_dt",
      "domain": "OcsfDataSecurityFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/time_dt",
      "alias": "time_dt",
      "owner": "OcsfDataSecurityFinding",
      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "time_dt",
      "range": "ocsf_datetime_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDataSecurityFinding_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfDataSecurityFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfDataSecurityFinding",
      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Data Security Finding: Unknown",
          "equals_number": 200600,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A new Data Security finding is created.",
          "title": "Data Security Finding: Create",
          "equals_number": 200601,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An existing Data Security finding is updated with more information.",
          "title": "Data Security Finding: Update",
          "equals_number": 200602,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An existing Data Security finding is closed, this can be due to any resolution (e.g., True Positive, False Positive, etc.).",
          "title": "Data Security Finding: Close",
          "equals_number": 200603,
          "@type": "AnonymousSlotExpression"
        },
        {
          "annotations": [
            {
              "tag": "ocsf_deprecated_since",
              "value": "1.4.0",
              "@type": "Annotation"
            },
            {
              "tag": "ocsf_superseded_by",
              "value": "status_id",
              "@type": "Annotation"
            }
          ],
          "description": "An existing Data Security finding is suppressed due to inaccurate detection techniques or a known true negative.",
          "title": "Data Security Finding: Suppressed",
          "deprecated": "Use <code>status_id</code> attribute instead.",
          "equals_number": 200604,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Data Security Finding: Other",
          "equals_number": 200699,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDetectionFinding_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfFindingEvent_activity_id",
      "domain": "OcsfDetectionFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfDetectionFinding",
      "domain_of": [
        "OcsfDetectionFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A finding was created.",
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A finding was updated.",
          "title": "Update",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A finding was closed.",
          "title": "Close",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
