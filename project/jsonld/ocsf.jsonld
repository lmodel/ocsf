    {
      "name": "OcsfProcessActivity_injection_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/injection_type",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The process injection method, normalized to the caption of the injection_type_id value. In the case of 'Other', it is defined by the event source.",
      "title": "Injection Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/injection_type"
      ],
      "is_a": "injection_type",
