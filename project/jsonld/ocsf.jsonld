      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The job action type.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfJobAction",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfJobAction",
      "domain_of": [
        "OcsfJobAction"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The performed action is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The action fires a COM handler. When this type is used, <code>com_class_uuid</code> and <code>file</code> attributes may be populated.",
          "title": "COM Handler",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The action executes a command-line operation. When this type is used, <code>cmd_line</code> and <code>file</code> attributes may be populated.",
          "title": "Execute",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The action sends an email.",
          "title": "E-mail",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The action shows a message box with specified message and title.",
          "title": "Show Message",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The performed action is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
