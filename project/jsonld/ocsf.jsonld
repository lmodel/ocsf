    },
    {
      "name": "OcsfDnsActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfDnsActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfDnsActivity",
      "domain_of": [
        "OcsfDnsActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "DNS Activity: Unknown",
          "equals_number": 400300,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The DNS query request.",
          "title": "DNS Activity: Query",
          "equals_number": 400301,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The DNS query response.",
          "title": "DNS Activity: Response",
          "equals_number": 400302,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bidirectional DNS request and response traffic.",
          "title": "DNS Activity: Traffic",
          "equals_number": 400306,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "DNS Activity: Other",
          "equals_number": 400399,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfEmailActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfEmailActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfEmailActivity",
      "domain_of": [
        "OcsfEmailActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Send",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Receive",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Email being scanned (example: security scanning)",
          "title": "Scan",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Follow an email message as it travels through an organization. The <code>message_trace_uid</code> should be populated when selected.",
          "title": "Trace",
          "see_also": [
            "https://learn.microsoft.com/en-us/Exchange/monitoring/trace-an-email-message/message-trace-modern-eac"
          ],
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Email processed by an MTA, typically combining send, receive, and scan operations into a single activity.",
          "title": "MTA Relay",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
