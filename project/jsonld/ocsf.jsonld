    },
    {
      "name": "OcsfIncidentFinding_status_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "status",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized incident lifecycle status identifier. This tracks the incident management workflow from initial triage through resolution. Producers should set this to reflect the current state in their incident management system.",
      "title": "Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_id"
      ],
      "is_a": "OcsfBaseEvent_status_id",
      "domain": "OcsfIncidentFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "alias": "status_id",
      "owner": "OcsfIncidentFinding",
      "domain_of": [
        "OcsfIncidentFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The service desk has received the incident but has not assigned it to an agent.",
          "title": "New",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident has been assigned to an agent but has not been resolved. The agent is actively working with the user to diagnose and resolve the incident.",
          "title": "In Progress",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident requires some information or response from the user or from a third party.",
          "title": "On Hold",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The service desk has confirmed that the incident is resolved.",
          "title": "Resolved",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is resolved and no further action is necessary.",
          "title": "Closed",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfIncidentFinding_ticket",
      "definition_uri": "https://w3id.org/lmodel/ocsf/ticket",
