    },
    {
      "name": "OcsfSpan_end_time",
      "definition_uri": "https://w3id.org/lmodel/ocsf/end_time",
      "description": "The end timestamp of the span, essential for identifying latency and performance bottlenecks. Like the start time, this timestamp is normalized across the observability system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time allows for accurate duration calculations and helps observability tools track performance across services, regardless of the individual system time settings.",
      "title": "End Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/end_time"
      ],
      "is_a": "end_time",
      "domain": "OcsfSpan",
      "slot_uri": "https://w3id.org/lmodel/ocsf/end_time",
      "alias": "end_time",
      "owner": "OcsfSpan",
      "domain_of": [
        "OcsfSpan"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "end_time",
      "range": "ocsf_timestamp_t",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSpan_end_time_dt",
      "definition_uri": "https://w3id.org/lmodel/ocsf/end_time_dt",
      "annotations": [
        {
          "tag": "ocsf_profiles",
          "value": "datetime",
          "@type": "Annotation"
        }
      ],
      "description": "The end timestamp of the span, essential for identifying latency and performance bottlenecks. Like the start time, this timestamp is normalized across the observability system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time allows for accurate duration calculations and helps observability tools track performance across services, regardless of the individual system time settings.",
