    },
    {
      "name": "OcsfDiscoveryResultEvent_query_info",
      "definition_uri": "https://w3id.org/lmodel/ocsf/query_info",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The search details associated with the query request.",
      "title": "Query Info",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/query_info"
      ],
      "is_a": "query_info",
