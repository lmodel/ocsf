      "domain": "OcsfAnomalyAnalysis",
      "slot_uri": "https://w3id.org/lmodel/ocsf/analysis_targets",
      "alias": "analysis_targets",
      "owner": "OcsfAnomalyAnalysis",
      "domain_of": [
        "OcsfAnomalyAnalysis"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "analysis_targets",
      "range": "OcsfAnalysisTarget",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAnomalyAnalysis_anomalies",
      "definition_uri": "https://w3id.org/lmodel/ocsf/anomalies",
      "description": "List of detected activities that significantly deviate from the established baselines. This can include unusual access patterns, unexpected user-agents, abnormal API usage, suspicious traffic spikes, unauthorized access attempts, and other activities that may indicate potential security threats or system issues.",
      "title": "Anomalies",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/anomalies"
      ],
      "is_a": "anomalies",
      "domain": "OcsfAnomalyAnalysis",
      "slot_uri": "https://w3id.org/lmodel/ocsf/anomalies",
      "alias": "anomalies",
      "owner": "OcsfAnomalyAnalysis",
      "domain_of": [
        "OcsfAnomalyAnalysis"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "anomalies",
      "range": "OcsfAnomaly",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAnomalyAnalysis_baselines",
      "definition_uri": "https://w3id.org/lmodel/ocsf/baselines",
      "description": "List of established patterns representing normal activity that serve as reference points for anomaly detection. This includes typical user interaction patterns like common user-agents, expected API access frequencies and patterns, standard resource utilization levels, and regular traffic flows. These baselines help establish what constitutes 'normal' activity in the system.",
      "title": "Baselines",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/baselines"
      ],
