      "alias": "baselines",
      "owner": "OcsfAnomalyAnalysis",
      "domain_of": [
        "OcsfAnomalyAnalysis"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "baselines",
      "range": "OcsfBaseline",
      "recommended": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
