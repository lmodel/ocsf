    {
      "name": "OcsfRoleManagement_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfRoleManagement",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfRoleManagement",
      "domain_of": [
        "OcsfRoleManagement"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Create a role. Use <code>iam_role</code> as the role to be created.",
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Update a role. The updated role details should be populated in the <code>updated_role</code> attribute.",
          "title": "Update",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete a role. Use <code>iam_role</code> as the role to be deleted.",
          "title": "Delete",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign privileges to a role. Use <code>privileges</code> to be assigned to <code>iam_role</code>.",
          "title": "Assign Privileges",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove privileges from a role. Use <code>privileges</code> to be removed from <code>iam_role</code>.",
          "title": "Remove Privileges",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign resources to a role. Use <code>resources</code> to be assigned to <code>iam_role</code>.",
          "title": "Assign Resources",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove resources from a role. Use <code>resources</code> to be removed from <code>iam_role</code>.",
          "title": "Remove Resources",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Attach one or more policies to a role. Use <code>policies</code> to be attached to <code>iam_role</code>.",
          "title": "Attach Policies",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Detach one or more policies from a role. Use <code>policies</code> to be detached from <code>iam_role</code>.",
          "title": "Detach Policies",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
