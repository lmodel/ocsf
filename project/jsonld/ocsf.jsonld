        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "confidence",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the confidence level, reflecting the accuracy or pertinence of the OSINT indicator or analysis. A low confidence indicates that the collected information lacked sufficient detail or accuracy to fully qualify the indicator as malicious. When the value is <code>99</code> (Other), the <code>confidence</code> attribute must contain the source-specific label.",
      "title": "Confidence ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
