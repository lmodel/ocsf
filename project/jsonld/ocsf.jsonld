    {
      "name": "OcsfDigitalSignature_algorithm",
      "definition_uri": "https://w3id.org/lmodel/ocsf/algorithm",
      "description": "The digital signature algorithm used to create the signature, normalized to the caption of 'algorithm_id'. In the case of 'Other', it is defined by the event source.",
      "title": "Algorithm",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/algorithm"
      ],
      "is_a": "algorithm",
