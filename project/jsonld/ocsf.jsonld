    {
      "name": "OcsfApiActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "type_uid",
      "domain": "OcsfApiActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfApiActivity",
      "domain_of": [
        "OcsfApiActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "any_of": [
        {
          "title": "API Activity: Unknown",
          "equals_number": 600300,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The API call in the event pertains to a 'create' activity.",
          "title": "API Activity: Create",
          "equals_number": 600301,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The API call in the event pertains to a 'read' activity.",
          "title": "API Activity: Read",
          "equals_number": 600302,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The API call in the event pertains to a 'update' activity.",
          "title": "API Activity: Update",
          "equals_number": 600303,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The API call in the event pertains to a 'delete' activity.",
          "title": "API Activity: Delete",
          "equals_number": 600304,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "API Activity: Other",
          "equals_number": 600399,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfApplicationError_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "activity_id",
      "domain": "OcsfApplicationError",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfApplicationError",
      "domain_of": [
        "OcsfApplicationError"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The application has experienced an error.",
          "title": "General Error",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The application has experienced an error translating (mapping) a raw event to OCSF. Including the original raw event in the raw_data field is highly recommended.",
          "title": "Translation Error",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
