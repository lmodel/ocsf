      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/uid"
      ],
      "is_a": "uid",
      "domain": "OcsfNote",
      "slot_uri": "https://w3id.org/lmodel/ocsf/uid",
      "alias": "uid",
      "owner": "OcsfNote",
      "domain_of": [
        "OcsfNote"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "uid",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservable_event_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/event_uid",
      "description": "The unique identifier (<code>metadata.uid</code>) of the source OCSF event from which this observable was extracted. This field enables linking observables back to their originating event data when observables are stored in a separate location or system.",
      "title": "Event UID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/event_uid"
      ],
      "is_a": "event_uid",
      "domain": "OcsfObservable",
      "slot_uri": "https://w3id.org/lmodel/ocsf/event_uid",
      "alias": "event_uid",
      "owner": "OcsfObservable",
      "domain_of": [
        "OcsfObservable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "event_uid",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservable_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/name",
      "description": "The full name of the observable attribute. The <code>name</code> is a pointer/reference to an attribute within the OCSF event data. For example: <code>file.name</code>. Array attributes may be represented in one of three ways. For example: <code>resources.uid</code>, <code>resources[].uid</code>, <code>resources[0].uid</code>.",
      "title": "Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/name"
      ],
      "is_a": "name",
      "domain": "OcsfObservable",
      "slot_uri": "https://w3id.org/lmodel/ocsf/name",
      "alias": "name",
      "owner": "OcsfObservable",
      "domain_of": [
        "OcsfObservable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "name",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservable_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type",
      "description": "The observable value type name.",
      "title": "Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type"
      ],
      "is_a": "type",
      "domain": "OcsfObservable",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type",
      "alias": "type",
      "owner": "OcsfObservable",
      "domain_of": [
        "OcsfObservable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservable_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The observable value type identifier.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfObservable",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfObservable",
      "domain_of": [
        "OcsfObservable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "Unknown observable data type.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Unique name assigned to a device connected to a computer network. It may be a fully qualified domain name (FQDN). For example:<br><code>r2-d2.example.com.</code>,<br><code>mx.example.com</code>",
          "title": "Hostname",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Internet Protocol address (IP address), in either IPv4 or IPv6 format. For example:<br><code>192.168.200.24</code>, <br> <code>2001:0db8:85a3:0000:0000:8a2e:0370:7334</code>.",
          "title": "IP Address",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Media Access Control (MAC) address. For example:<br><code>18:36:F3:98:4F:9A</code>.",
          "title": "MAC Address",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>User name. For example:<br><code>john_doe</code>.",
          "title": "User Name",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Email address. For example:<br><code>john_doe@example.com</code>.",
          "title": "Email Address",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Uniform Resource Locator (URL) string. For example:<br><code>http://www.example.com/download/trouble.exe</code>.",
          "title": "URL String",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>File name. For example:<br><code>text-file.txt</code>.",
          "title": "File Name",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Fingerprint. A value, in any format, that maps an arbitrarily large data item to a much shorter string that uniquely identifies the original data. Examples include cryptographic hashing of a file, code signing, and Network Protocol Fingerprinting (NPF).<p><b>Note about name.</b> The type name <code>file_hast_t</code> and the caption &quot;Hash&quot; are used for legacy reasons. This type has been generalized from a file hash to a general fingerprint. The existing type name and caption were retained for backwards compatibility.",
          "title": "Hash",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Process name. For example:<br><code>Notepad</code>.",
          "title": "Process Name",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Resource unique identifier. For example, S3 Bucket name or EC2 Instance ID.",
          "title": "Resource UID",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>The TCP/UDP port number. For example:<br><code>80</code>,<br><code>22</code>.",
          "title": "Port",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>The subnet represented in a CIDR notation, using the format network_address/prefix_length. The network_address can be in either IPv4 or IPv6 format. The prefix length indicates the number of bits used for the network portion, and the remaining bits are available for host addresses within that subnet. For example:<br><code>192.168.1.0/24</code>,<br><code>2001:0db8:85a3:0000::/64</code>",
          "title": "Subnet",
          "equals_number": 12,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The full command line used to launch an application, service, process, or job. For example: <code>ssh user@10.0.0.10</code>. If the command line is unavailable or missing, the empty string <code>''</code> is to be used.",
          "title": "Command Line",
          "equals_number": 13,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The ISO 3166-1 Alpha-2 country code.<p><b>Note:</b> The two letter country code should be capitalized. For example: <code>US</code> or <code>CA</code>.</p>",
          "title": "Country",
          "equals_number": 14,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The process identifier, as reported by the operating system. Process ID (PID) is a number used by the operating system to uniquely identify an active process.",
          "title": "Process ID",
          "equals_number": 15,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The request header that identifies the operating system and web browser.",
          "title": "HTTP User-Agent",
          "equals_number": 16,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the CWE Object.",
          "title": "CWE Object: uid",
          "equals_number": 17,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the CVE Object.",
          "title": "CVE Object: uid",
          "equals_number": 18,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The unique identifier of the user's credential. For example, AWS Access Key ID.",
          "title": "User Credential ID",
          "equals_number": 19,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The Endpoint object describes a physical or virtual device that connects to and exchanges information with a computer network. Some examples of endpoints are mobile devices, desktop computers, virtual machines, embedded devices, and servers. Internet-of-Things devices\u2014like cameras, lighting, refrigerators, security systems, smart speakers, and thermostats\u2014are also endpoints.",
          "title": "Endpoint",
          "equals_number": 20,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The User object describes the characteristics of a user/person or a security principal.",
          "title": "User",
          "equals_number": 21,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The Email object describes the email metadata such as sender, recipients, and direction, and can include embedded URLs and files.",
          "title": "Email",
          "equals_number": 22,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The Uniform Resource Locator (URL) object describes the characteristics of a URL.",
          "title": "Uniform Resource Locator",
          "equals_number": 23,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The File object represents the metadata associated with a file stored in a computer system. It encompasses information about the file itself, including its attributes, properties, and organizational details.",
          "title": "File",
          "equals_number": 24,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The Process object describes a running instance of a launched program.",
          "title": "Process",
          "equals_number": 25,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The Geo Location object describes a geographical location, usually associated with an IP address.",
          "title": "Geo Location",
          "equals_number": 26,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The Container object describes an instance of a specific container. A container is a prepackaged, portable system image that runs isolated on an existing system using a container runtime like containerd.",
          "title": "Container",
          "equals_number": 27,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The registry key object describes a Windows registry key.",
          "title": "Registry Key",
          "equals_number": 28,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The registry value object describes a Windows registry value.",
          "title": "Registry Value",
          "equals_number": 29,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object.<br>The Fingerprint object provides detailed information about a fingerprint, which is a compact representation of data used to identify a longer piece of information, such as a public key, file content, or application implementation. It contains the algorithm or scheme and value of the fingerprint, enabling efficient and reliable identification of the associated data.",
          "title": "Fingerprint",
          "equals_number": 30,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the User Object.",
          "title": "User Object: uid",
          "equals_number": 31,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"name\" for the Group Object.",
          "title": "Group Object: name",
          "equals_number": 32,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the Group Object.",
          "title": "Group Object: uid",
          "equals_number": 33,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"name\" for the Account Object.",
          "title": "Account Object: name",
          "equals_number": 34,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the Account Object.",
          "title": "Account Object: uid",
          "equals_number": 35,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The script content, normalized to UTF-8 encoding irrespective of its original encoding. When emitting this attribute, it may be appropriate to truncate large scripts. When consuming this attribute, large scripts should be anticipated.",
          "title": "Script Content",
          "equals_number": 36,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The serial number that pertains to the object. See specific usage.",
          "title": "Serial Number",
          "equals_number": 37,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"name\" for the Resource Details Object.",
          "title": "Resource Details Object: name",
          "equals_number": 38,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the Process Entity Object.",
          "title": "Process Entity Object: uid",
          "equals_number": 39,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"subject\" for the Email Object.",
          "title": "Email Object: subject",
          "equals_number": 40,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the Email Object.",
          "title": "Email Object: uid",
          "equals_number": 41,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Attribute.<br>The email header Message-ID value, as defined by RFC 5322.",
          "title": "Message UID",
          "equals_number": 42,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"name\" for the Registry Value Object.",
          "title": "Registry Value Object: name",
          "equals_number": 43,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the Advisory Object.",
          "title": "Advisory Object: uid",
          "equals_number": 44,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>The full path to the file. For example: For example:<br><code>c:\\windows\\system32\\svchost.exe</code>.",
          "title": "File Path",
          "equals_number": 45,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Dictionary Type.<br>Full path of registry key.",
          "title": "Registry Key Path",
          "equals_number": 46,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the Device Object.",
          "title": "Device Object: uid",
          "equals_number": 47,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the Network Endpoint Object.",
          "title": "Network Endpoint Object: uid",
          "equals_number": 48,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"name\" for the IAM Role Object.",
          "title": "IAM Role Object: name",
          "equals_number": 49,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Observable by Object-Specific Attribute.<br>Object-specific attribute \"uid\" for the IAM Role Object.",
          "title": "IAM Role Object: uid",
          "equals_number": 50,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The observable data type is not mapped. See the <code>type</code> attribute, which may contain data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservable_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The OCSF event type UID (<code>type_uid</code>) of the source event that this observable was extracted from. This field enables filtering and categorizing observables by their originating event type. For example: <code>300101</code> for Network Activity (class_uid 3001) with activity_id 1.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "type_uid",
      "domain": "OcsfObservable",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfObservable",
      "domain_of": [
        "OcsfObservable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservable_value",
      "definition_uri": "https://w3id.org/lmodel/ocsf/value",
      "description": "The value associated with the observable attribute. The meaning of the value depends on the observable type.<br/>If the <code>name</code> refers to a scalar attribute, then the <code>value</code> is the value of the attribute.<br/>If the <code>name</code> refers to an object attribute, then the <code>value</code> is not populated.",
      "title": "Value",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/value"
      ],
      "is_a": "value",
      "domain": "OcsfObservable",
      "slot_uri": "https://w3id.org/lmodel/ocsf/value",
      "alias": "value",
      "owner": "OcsfObservable",
      "domain_of": [
        "OcsfObservable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "value",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservation_count",
      "definition_uri": "https://w3id.org/lmodel/ocsf/count",
      "description": "Integer representing the total number of times this specific value/event was observed across all occurrences. Helps establish prevalence and patterns.",
      "title": "Count",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/count"
      ],
      "is_a": "count",
      "domain": "OcsfObservation",
      "slot_uri": "https://w3id.org/lmodel/ocsf/count",
      "alias": "count",
      "owner": "OcsfObservation",
      "domain_of": [
        "OcsfObservation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "count",
      "range": "ocsf_integer_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservation_timespan",
      "definition_uri": "https://w3id.org/lmodel/ocsf/timespan",
      "description": "The time window when the value or event was first observed. It is used to analyze activity patterns, detect trends, or correlate events within a specific timeframe.",
      "title": "Time Span",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/timespan"
      ],
      "is_a": "timespan",
      "domain": "OcsfObservation",
      "slot_uri": "https://w3id.org/lmodel/ocsf/timespan",
      "alias": "timespan",
      "owner": "OcsfObservation",
      "domain_of": [
        "OcsfObservation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "timespan",
      "range": "OcsfTimespan",
      "recommended": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfObservation_value",
      "definition_uri": "https://w3id.org/lmodel/ocsf/value",
      "description": "The specific value, event, indicator or data point that was observed and recorded. This is the core piece of information being tracked.",
      "title": "Value",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/value"
      ],
      "is_a": "value",
      "domain": "OcsfObservation",
      "slot_uri": "https://w3id.org/lmodel/ocsf/value",
      "alias": "value",
      "owner": "OcsfObservation",
      "domain_of": [
        "OcsfObservation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "value",
      "range": "ocsf_string_t",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfOccurrenceDetails_cell_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/cell_name",
      "description": "The cell name/reference in a spreadsheet. e.g <code>A2</code>",
      "title": "Cell Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/cell_name"
      ],
      "is_a": "cell_name",
      "domain": "OcsfOccurrenceDetails",
      "slot_uri": "https://w3id.org/lmodel/ocsf/cell_name",
      "alias": "cell_name",
      "owner": "OcsfOccurrenceDetails",
      "domain_of": [
        "OcsfOccurrenceDetails"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "cell_name",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfOccurrenceDetails_column_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/column_name",
      "description": "The column name in a spreadsheet, where the information was discovered.",
      "title": "Column Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/column_name"
      ],
      "is_a": "column_name",
      "domain": "OcsfOccurrenceDetails",
      "slot_uri": "https://w3id.org/lmodel/ocsf/column_name",
      "alias": "column_name",
