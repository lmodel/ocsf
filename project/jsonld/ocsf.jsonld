      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The stratum level of the NTP server's time source, normalized to the caption of the stratum_id value.",
      "title": "Stratum",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/stratum"
      ],
      "is_a": "stratum",
      "domain": "OcsfNtpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/stratum",
      "alias": "stratum",
      "owner": "OcsfNtpActivity",
      "domain_of": [
        "OcsfNtpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "stratum",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNtpActivity_stratum_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/stratum_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "stratum",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the stratum level of an NTP server's time source, as defined in RFC 5905. Levels range from 0 to 16, with lower numbers representing higher accuracy and greater proximity to the root clock.",
      "title": "Stratum ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.rfc-editor.org/rfc/rfc5905.html"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/stratum_id"
      ],
      "is_a": "stratum_id",
      "domain": "OcsfNtpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/stratum_id",
      "alias": "stratum_id",
      "owner": "OcsfNtpActivity",
      "domain_of": [
        "OcsfNtpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "stratum_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "Unspecified or invalid.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The highest precision primary server (e.g atomic clock or GPS).",
          "title": "Primary Server",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A secondary level server (possible values: 2-15).",
          "title": "Secondary Server",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Unsynchronized",
          "equals_number": 16,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Reserved stratum (possible values: 17-255).",
          "title": "Reserved",
          "equals_number": 17,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The stratum level is not mapped. See the <code>stratum</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNtpActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfNtpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfNtpActivity",
      "domain_of": [
        "OcsfNtpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "NTP Activity: Unknown",
          "equals_number": 401300,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bidirectional time exchange between devices.",
          "title": "NTP Activity: Symmetric Active Exchange",
          "equals_number": 401301,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Device responds as a server to peers in symmetric active mode.",
          "title": "NTP Activity: Symmetric Passive Response",
          "equals_number": 401302,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "NTP client, syncs with servers.",
          "title": "NTP Activity: Client Synchronization",
          "equals_number": 401303,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Dedicated NTP time server, responds to clients.",
          "title": "NTP Activity: Server Response",
          "equals_number": 401304,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Broadcast time info to network devices.",
          "title": "NTP Activity: Broadcast",
          "equals_number": 401305,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Monitoring and control messaging.",
          "title": "NTP Activity: Control",
          "equals_number": 401306,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Reserved - Not defined in standard NTP specifications.",
          "title": "NTP Activity: Private Use Case",
          "equals_number": 401307,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped.",
          "title": "NTP Activity: Other",
          "equals_number": 401399,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
