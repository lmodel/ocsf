    },
    {
      "name": "category_ids",
      "definition_uri": "https://w3id.org/lmodel/ocsf/category_ids",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "categories",
