    {
      "name": "OcsfWebResourcesActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "type_uid",
      "domain": "OcsfWebResourcesActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfWebResourcesActivity",
      "domain_of": [
        "OcsfWebResourcesActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "any_of": [
        {
          "title": "Web Resources Activity: Unknown",
          "equals_number": 600100,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were created.",
          "title": "Web Resources Activity: Create",
          "equals_number": 600101,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were read / viewed.",
          "title": "Web Resources Activity: Read",
          "equals_number": 600102,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were updated.",
          "title": "Web Resources Activity: Update",
          "equals_number": 600103,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were deleted.",
          "title": "Web Resources Activity: Delete",
          "equals_number": 600104,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A search was performed on one or more web resources.",
          "title": "Web Resources Activity: Search",
          "equals_number": 600105,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were imported into an Application.",
          "title": "Web Resources Activity: Import",
          "equals_number": 600106,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were exported from an Application.",
          "title": "Web Resources Activity: Export",
          "equals_number": 600107,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "One or more web resources were shared.",
          "title": "Web Resources Activity: Share",
          "equals_number": 600108,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Web Resources Activity: Other",
          "equals_number": 600199,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfWebResourcesActivity_updated_web_resources",
