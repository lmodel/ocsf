    {
      "name": "OcsfAuthentication_status_detail",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_detail",
      "description": "The details about the authentication request. For example, possible details for Windows logon or logoff events are:<ul><li>Success</li><ul><li>LOGOFF_USER_INITIATED</li><li>LOGOFF_OTHER</li></ul><li>Failure</li><ul><li>USER_DOES_NOT_EXIST</li><li>INVALID_CREDENTIALS</li><li>ACCOUNT_DISABLED</li><li>ACCOUNT_LOCKED_OUT</li><li>PASSWORD_EXPIRED</li></ul></ul>",
      "title": "Status Detail",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_detail"
      ],
      "is_a": "OcsfBaseEvent_status_detail",
      "domain": "OcsfAuthentication",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_detail",
      "alias": "status_detail",
      "owner": "OcsfAuthentication",
      "domain_of": [
        "OcsfAuthentication"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_detail",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAuthentication_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfAuthentication",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfAuthentication",
      "domain_of": [
        "OcsfAuthentication"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Authentication: Unknown",
          "equals_number": 300200,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A new logon session was requested.",
          "title": "Authentication: Logon",
          "equals_number": 300201,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A logon session was terminated and no longer exists.",
          "title": "Authentication: Logoff",
          "equals_number": 300202,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A Kerberos authentication ticket (TGT) was requested.",
          "title": "Authentication: Authentication Ticket",
          "equals_number": 300203,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A Kerberos service ticket was requested.",
          "title": "Authentication: Service Ticket Request",
          "equals_number": 300204,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A Kerberos service ticket was renewed.",
          "title": "Authentication: Service Ticket Renew",
          "equals_number": 300205,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A preauthentication stage was engaged.",
          "title": "Authentication: Preauth",
          "equals_number": 300206,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A utility or service switched the user account. See the <code>account_switch_type_id</code> attribute for more details.",
          "title": "Authentication: Account Switch",
          "equals_number": 300207,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Authentication: Other",
          "equals_number": 300299,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
