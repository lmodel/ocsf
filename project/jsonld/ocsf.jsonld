      "any_of": [
        {
          "description": "The type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An application software package.",
          "title": "Application",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An operating system software package.",
          "title": "Operating System",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
