    },
    {
      "name": "OcsfIncidentFinding_comment",
      "definition_uri": "https://w3id.org/lmodel/ocsf/comment",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
