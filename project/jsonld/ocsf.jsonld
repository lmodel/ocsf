      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Arbitrary binary data.",
          "title": "REG_BINARY",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A 32-bit integer.",
          "title": "REG_DWORD",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A 32-bit integer in big-endian byte order.",
          "title": "REG_DWORD_BIG_ENDIAN",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A string containing unexpanded environment variables, e.g. <code>%USERPROFILE%\\Downloads</code>.",
          "title": "REG_EXPAND_SZ",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A string containing the target path of a symbolic link created by calling <code>RegCreateKeyEx</code> with <code>REG_OPTION_CREATE_LINK</code>.",
          "title": "REG_LINK",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A sequence of zero or more strings.",
          "title": "REG_MULTI_SZ",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A value with no declared type.",
          "title": "REG_NONE",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A 64-bit integer.",
          "title": "REG_QWORD",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "annotations": [
            {
              "tag": "ocsf_deprecated_since",
              "value": "1.6.0",
              "@type": "Annotation"
            },
            {
              "tag": "ocsf_superseded_by",
              "value": "8",
              "@type": "Annotation"
            }
          ],
          "description": "Not defined in Windows documentation and previously added to OCSF in error.",
          "title": "REG_QWORD_LITTLE_ENDIAN",
          "deprecated": "Use <code>REG_QWORD</code> instead.",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A string.",
          "title": "REG_SZ",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
