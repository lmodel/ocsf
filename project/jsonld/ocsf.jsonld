      "name": "OcsfDetectionFinding",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfDetectionFinding",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
