        },
        {
          "title": "Tethered Powered Aircraft",
          "equals_number": 13,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Ground Obstacle",
          "equals_number": 14,
          "@type": "AnonymousSlotExpression"
