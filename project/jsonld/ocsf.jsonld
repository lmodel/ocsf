      "domain_of": [
        "OcsfIncidentProfile"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "priority",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfIncidentProfile_priority_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/priority_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "incident",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "priority",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized priority. Priority identifies the relative importance of the incident or finding. It is a measurement of urgency.",
      "title": "Priority ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/priority_id"
      ],
      "is_a": "priority_id",
      "domain": "OcsfIncidentProfile",
      "slot_uri": "https://w3id.org/lmodel/ocsf/priority_id",
      "alias": "priority_id",
      "owner": "OcsfIncidentProfile",
      "domain_of": [
        "OcsfIncidentProfile"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "priority_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "No priority is assigned.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Application or personal procedure is unusable, where a workaround is available or a repair is possible.",
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Non-critical function or procedure is unusable or hard to use causing operational disruptions with no direct impact on a service's availability. A workaround is available.",
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Critical functionality or network access is interrupted, degraded or unusable, having a severe impact on services availability. No acceptable alternative is possible.",
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Interruption making a critical functionality inaccessible or a complete network interruption causing a severe impact on services availability. There is no possible alternative.",
          "title": "Critical",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The priority is not normalized.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfIncidentProfile_src_url",
      "definition_uri": "https://w3id.org/lmodel/ocsf/src_url",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "incident",
          "@type": "Annotation"
        }
      ],
      "description": "A Url link used to access the original incident.",
      "title": "Source URL",
