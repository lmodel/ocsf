    },
    {
      "name": "OcsfToken_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type",
      "description": "The type of the token, normalized to the caption of the <code>type_id</code> value. This indicates whether the token is a Client Token, API Token, or one of the protocol-specific token types.",
      "title": "Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type"
      ],
      "is_a": "type",
      "domain": "OcsfToken",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type",
      "alias": "type",
      "owner": "OcsfToken",
      "domain_of": [
        "OcsfToken"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfToken_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized token type identifier. Valid values: 0 (Unknown), 1 (Ticket Granting Ticket - Kerberos), 2 (Service Ticket - Kerberos), 3 (Identity Token - OIDC), 4 (Refresh Token - OIDC), 5 (SAML Assertion), 6 (Client Token - IdP-issued), 7 (API Token - generic API keys), 99 (Other).",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfToken",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfToken",
      "domain_of": [
        "OcsfToken"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The token type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Ticket Granting Ticket (TGT) for Kerberos.",
          "title": "Ticket Granting Ticket",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Service Ticket (ST) for Kerberos.",
          "title": "Service Ticket",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Identity (ID) Token for OIDC.",
          "title": "Identity Token",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Refresh Token for OIDC.",
          "title": "Refresh Token",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Authentication Assertion for SAML.",
          "title": "SAML Assertion",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Client Token issued by an Identity Provider (IdP) for application authentication. Use this value for IdP-issued tokens used for service-to-service authentication. Examples: Microsoft Entra ID Application Registration client secrets, Okta API tokens, Auth0 Machine-to-Machine tokens. Key characteristic: These tokens are issued by Identity Providers, not by individual services.",
          "title": "Client Token",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A generic API token or API key used for authenticating API requests. Use this value for service-specific API authentication tokens that are NOT issued by Identity Providers. Examples: REST API keys, GraphQL API keys, Stripe API keys, Twilio API keys, AWS API keys. Key characteristic: These tokens are issued by individual services/platforms, not by Identity Providers.",
          "title": "API Token",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfToken_uid",
