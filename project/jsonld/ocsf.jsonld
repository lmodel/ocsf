          "value": "product.uid",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The unique identifier of the product that reported the related event.",
      "title": "Product Identifier",
      "deprecated": "Use the <code>product.uid</code> attribute instead.",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/product_uid"
      ],
