      "name": "OcsfDevicePowerStateActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfDevicePowerStateActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfDevicePowerStateActivity",
      "domain_of": [
        "OcsfDevicePowerStateActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A power-on activity was reported for the system.",
          "title": "Power On",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A power-off activity was reported for the system, including graceful shutdowns and hard power-off events. For graceful or software-initiated shutdowns, the <code>actor</code> may be specified when known.",
          "title": "Power Off",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A sleep activity was reported for the system.",
          "title": "Sleep",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A hibernate activity was reported for the system.",
          "title": "Hibernate",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A reboot activity was reported for the system.",
          "title": "Reboot",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A wake activity was reported for the system.",
          "title": "Wake",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
