      "domain_of": [
        "OcsfSecurityControlProfile",
        "OcsfApplication",
        "OcsfDevice",
        "OcsfUser"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "risk_level_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/risk_level_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "risk_level",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_suppress_checks",
          "value": "enum_convention",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized risk level id.",
      "title": "Risk Level ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/risk_level_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/risk_level_id",
      "owner": "OcsfUser",
      "domain_of": [
        "OcsfSecurityControlProfile",
        "OcsfApplication",
        "OcsfDevice",
        "OcsfUser"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "title": "Info",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Critical",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The risk level is not mapped. See the <code>risk_level</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "risk_score",
