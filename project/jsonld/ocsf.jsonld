      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "status",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier for the ticket status.",
      "title": "Ticket Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_id"
      ],
      "is_a": "status_id",
      "domain": "OcsfTicket",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "alias": "status_id",
      "owner": "OcsfTicket",
      "domain_of": [
        "OcsfTicket"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The ticket is new and yet to be reviewed.",
          "title": "New",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The ticket is actively being worked on.",
          "title": "In Progress",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Relevant parties have been notified about the ticket.",
          "title": "Notified",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Work on the ticket is temporarily suspended.",
          "title": "On Hold",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The ticket is resolved and a solution is implemented, pending confirmation or verification from the requestor.",
          "title": "Resolved",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The ticket has been completed and closed.",
          "title": "Closed",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The ticket has been canceled and will not be processed.",
          "title": "Canceled",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The ticket was previously closed, but has been reopened.",
          "title": "Reopened",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
