          "@type": "Annotation"
        },
        {
          "tag": "ocsf_observable",
          "value": "6",
          "@type": "Annotation"
        }
      ],
      "description": "Uniform Resource Locator (URL) string. For example:<br><code>http://www.example.com/download/trouble.exe</code>.",
      "title": "URL String",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_username_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfUsernameT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
