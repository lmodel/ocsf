    },
    {
      "name": "OcsfWebResourcesActivity_web_resources_result",
      "definition_uri": "https://w3id.org/lmodel/ocsf/web_resources_result",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_deprecated_since",
          "value": "1.9.0",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_superseded_by",
          "value": "updated_web_resources",
          "@type": "Annotation"
        }
      ],
      "description": "The results of the activity on web resources. It should contain the new values of the changed attributes of the web resources.",
      "title": "Web Resources Result",
      "deprecated": "Use the <code>updated_web_resources</code> attribute instead.",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
