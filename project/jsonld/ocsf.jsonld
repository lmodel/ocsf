        },
        {
          "tag": "ocsf_sibling",
          "value": "verdict",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized verdict of an Incident.",
      "title": "Verdict ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/verdict_id"
      ],
      "is_a": "verdict_id",
