        {
          "tag": "ocsf_observable",
          "value": "10",
          "@type": "Annotation"
        }
      ],
      "description": "Resource unique identifier. For example, S3 Bucket name or EC2 Instance ID.",
      "title": "Resource UID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_string_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfStringT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "string_t",
