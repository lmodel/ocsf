      "required": true,
      "any_of": [
        {
          "title": "Email URL Activity: Unknown",
          "equals_number": 401200,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Email URL Activity: Send",
          "equals_number": 401201,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Email URL Activity: Receive",
          "equals_number": 401202,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Email URL being scanned (example: security scanning).",
          "title": "Email URL Activity: Scan",
          "equals_number": 401203,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Email URL Activity: Other",
