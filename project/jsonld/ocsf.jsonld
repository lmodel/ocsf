        "OcsfSecurityControlProfile"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "confidence",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSecurityControlProfile_confidence_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/confidence_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "security_control",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "confidence",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized confidence refers to the accuracy of the security control or alert. An analytic with a low confidence means that the alerts may be noisy or may not be malicious in nature.",
      "title": "Confidence ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/confidence_id"
      ],
      "is_a": "confidence_id",
      "domain": "OcsfSecurityControlProfile",
      "slot_uri": "https://w3id.org/lmodel/ocsf/confidence_id",
      "alias": "confidence_id",
      "owner": "OcsfSecurityControlProfile",
      "domain_of": [
        "OcsfSecurityControlProfile"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "confidence_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The normalized confidence is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The confidence is not mapped to the defined enum values. See the <code>confidence</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSecurityControlProfile_confidence_score",
