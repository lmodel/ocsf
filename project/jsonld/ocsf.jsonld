      "domain_of": [
        "OcsfAgent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "vendor_name",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAgent_version",
      "definition_uri": "https://w3id.org/lmodel/ocsf/version",
      "description": "The semantic version of the agent or sensor, e.g., <code>7.101.50.0</code>.",
      "title": "Agent Version",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
