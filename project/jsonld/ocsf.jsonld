      "alias": "file",
      "owner": "OcsfModule",
      "domain_of": [
        "OcsfModule"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "file",
      "range": "OcsfFile",
      "recommended": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfModule_function_invocation",
      "definition_uri": "https://w3id.org/lmodel/ocsf/function_invocation",
      "description": "Details about the invocation of the function given in <code>function_name</code>.",
      "title": "Function Invocation",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/function_invocation"
      ],
      "is_a": "function_invocation",
      "domain": "OcsfModule",
      "slot_uri": "https://w3id.org/lmodel/ocsf/function_invocation",
      "alias": "function_invocation",
      "owner": "OcsfModule",
      "domain_of": [
        "OcsfModule"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "function_invocation",
      "range": "OcsfFunctionInvocation",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfModule_function_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/function_name",
      "description": "The invoked function in the module. For load and unload events, this is the entry-point function of the module. The system calls the entry-point function whenever a process or thread loads or unloads the module.",
      "title": "Function Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/function_name"
      ],
      "is_a": "function_name",
      "domain": "OcsfModule",
      "slot_uri": "https://w3id.org/lmodel/ocsf/function_name",
      "alias": "function_name",
      "owner": "OcsfModule",
      "domain_of": [
        "OcsfModule"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "function_name",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfModule_load_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/load_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "load_type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier for how the module was loaded in memory.",
      "title": "Load Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/load_type_id"
      ],
      "is_a": "load_type_id",
      "domain": "OcsfModule",
      "slot_uri": "https://w3id.org/lmodel/ocsf/load_type_id",
      "alias": "load_type_id",
      "owner": "OcsfModule",
      "domain_of": [
        "OcsfModule"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "load_type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The load type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A normal module loaded by the normal windows loading mechanism i.e. LoadLibrary.",
          "title": "Standard",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A module loaded in a way avoidant of normal windows procedures. i.e. Bootstrapped Loading/Manual Dll Loading.",
          "title": "Non Standard",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A raw module in process memory that is READWRITE_EXECUTE and had a thread started in its range.",
          "title": "ShellCode",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A memory mapped file, typically created with CreatefileMapping/MapViewOfFile.",
          "title": "Mapped",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A module loaded in a non standard way. However, GetModuleFileName succeeds on this allocation.",
          "title": "NonStandard Backed",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The load type is not mapped. See the <code>load_type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfModule_start_address",
      "definition_uri": "https://w3id.org/lmodel/ocsf/start_address",
      "description": "The start address of the execution.",
      "title": "Start Address",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/start_address"
      ],
      "is_a": "start_address",
      "domain": "OcsfModule",
      "slot_uri": "https://w3id.org/lmodel/ocsf/start_address",
      "alias": "start_address",
      "owner": "OcsfModule",
      "domain_of": [
        "OcsfModule"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "start_address",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfModule_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type",
      "description": "The module type.",
      "title": "Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type"
      ],
      "is_a": "type",
      "domain": "OcsfModule",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type",
      "alias": "type",
      "owner": "OcsfModule",
      "domain_of": [
        "OcsfModule"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfNetworkConnectionInfo_boundary_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/boundary_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "boundary",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "<p>The normalized identifier of the boundary of the connection. </p><p> For cloud connections, this translates to the traffic-boundary (same VPC, through IGW, etc.). For traditional networks, this is described as Local, Internal, or External.</p>",
      "title": "Boundary ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/boundary_id"
      ],
      "is_a": "boundary_id",
      "domain": "OcsfNetworkConnectionInfo",
      "slot_uri": "https://w3id.org/lmodel/ocsf/boundary_id",
      "alias": "boundary_id",
      "owner": "OcsfNetworkConnectionInfo",
      "domain_of": [
        "OcsfNetworkConnectionInfo"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "boundary_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The connection boundary is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Local network traffic on the same endpoint.",
          "title": "Localhost",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Internal network traffic between two endpoints inside network.",
          "title": "Internal",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "External network traffic between two endpoints on the Internet or outside the network.",
          "title": "External",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through another resource in the same VPC",
          "title": "Same VPC",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through an Internet gateway or a gateway VPC endpoint",
          "title": "Internet/VPC Gateway",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through a virtual private gateway",
          "title": "Virtual Private Gateway",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through an intra-region VPC peering connection",
          "title": "Intra-region VPC",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through an inter-region VPC peering connection",
          "title": "Inter-region VPC",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through a local gateway",
          "title": "Local Gateway",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through a gateway VPC endpoint (Nitro-based instances only)",
          "title": "Gateway VPC",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Through an Internet gateway (Nitro-based instances only)",
