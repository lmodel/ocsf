      "domain_of": [
        "OcsfScript"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "hashes",
      "range": "OcsfFingerprint",
      "recommended": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScript_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/name",
      "description": "Unique identifier for the script or macro, independent of the containing file, used for tracking, auditing, and security analysis.",
      "title": "Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/name"
      ],
      "is_a": "name",
      "domain": "OcsfScript",
      "slot_uri": "https://w3id.org/lmodel/ocsf/name",
      "alias": "name",
      "owner": "OcsfScript",
      "domain_of": [
        "OcsfScript"
      ],
