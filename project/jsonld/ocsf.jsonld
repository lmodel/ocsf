      "is_usage_slot": true,
      "usage_slot_name": "traffic",
      "range": "OcsfNetworkTraffic",
      "recommended": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDhcpActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfDhcpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfDhcpActivity",
      "domain_of": [
        "OcsfDhcpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPDISCOVER",
          "title": "Discover",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPOFFER",
          "title": "Offer",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPREQUEST",
          "title": "Request",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPDECLINE",
          "title": "Decline",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPACK: The server accepts the request by sending the client a DHCP Acknowledgment message.",
          "title": "Ack",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPNAK",
          "title": "Nak",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPRELEASE: A DHCP client sends a DHCPRELEASE packet to the server to release the IP address and cancel any remaining lease.",
          "title": "Release",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPINFORM",
          "title": "Inform",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPEXPIRE: A DHCP lease expired.",
          "title": "Expire",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
