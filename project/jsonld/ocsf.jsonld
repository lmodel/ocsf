      "usage_slot_name": "injection_type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The injection type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Remote Thread",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Load Library",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Queue APC",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The injection type is not mapped. See the <code>injection_type</code> attribute, which contains a data source specific value.",
