      "slot_uri": "https://w3id.org/lmodel/ocsf/query_info",
      "alias": "query_info",
      "owner": "OcsfDiscoveryResultEvent",
      "domain_of": [
        "OcsfDiscoveryResultEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "query_info",
      "range": "OcsfQueryInfo",
      "recommended": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDiscoveryResultEvent_query_result",
      "definition_uri": "https://w3id.org/lmodel/ocsf/query_result",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The result of the query.",
      "title": "Query Result",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/query_result"
      ],
      "is_a": "query_result",
      "domain": "OcsfDiscoveryResultEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/query_result",
