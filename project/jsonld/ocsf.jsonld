    {
      "name": "OcsfFileActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfFileActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfFileActivity",
      "domain_of": [
        "OcsfFileActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to create a new file on a file system.",
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to read data from a file on a file system.",
          "title": "Read",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to write data to a file on a file system.",
          "title": "Update",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to delete a file on a file system.",
          "title": "Delete",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to rename a file on a file system.",
          "title": "Rename",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to set attributes for a file on a file system.",
          "title": "Set Attributes",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to set security for a file on a file system.",
          "title": "Set Security",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to get attributes for a file on a file system.",
          "title": "Get Attributes",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to get security for a file on a file system.",
          "title": "Get Security",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to encrypt a file on a file system.",
          "title": "Encrypt",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to decrypt a file on a file system.",
          "title": "Decrypt",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to mount a file on a file system.",
          "title": "Mount",
          "equals_number": 12,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to unmount a file from a file system.",
          "title": "Unmount",
          "equals_number": 13,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A request to create a file handle.",
          "title": "Open",
          "equals_number": 14,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
