        }
      ],
      "description": "The Website categorization identifiers.",
      "title": "Website Categorization IDs",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/category_ids"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/category_ids",
      "owner": "OcsfUrl",
      "domain_of": [
        "OcsfUrl"
      ],
      "range": "ocsf_integer_t",
      "multivalued": true,
      "any_of": [
        {
          "description": "The Domain/URL category is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Adult/Mature Content",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Pornography",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Sex Education",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Intimate Apparel/Swimsuit",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Nudity",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Extreme",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Scam/Questionable/Illegal",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Gambling",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Violence/Hate/Racism",
          "equals_number": 14,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Weapons",
          "equals_number": 15,
          "@type": "AnonymousSlotExpression"
        },
