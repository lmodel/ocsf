    {
      "name": "OcsfDatastoreActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "type_uid",
      "domain": "OcsfDatastoreActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfDatastoreActivity",
      "domain_of": [
        "OcsfDatastoreActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "any_of": [
        {
          "title": "Datastore Activity: Unknown",
          "equals_number": 600500,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Read' activity involves accessing specific data record details.",
          "title": "Datastore Activity: Read",
          "equals_number": 600501,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Update' activity pertains to modifying specific data record details.",
          "title": "Datastore Activity: Update",
          "equals_number": 600502,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Connect' activity involves establishing a connection to the datastore.",
          "title": "Datastore Activity: Connect",
          "equals_number": 600503,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Query' activity involves retrieving a filtered subset of data based on specific criteria.",
          "title": "Datastore Activity: Query",
          "equals_number": 600504,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Write' activity involves writing specific data record details.",
          "title": "Datastore Activity: Write",
          "equals_number": 600505,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Create' activity involves generating new data record details.",
          "title": "Datastore Activity: Create",
          "equals_number": 600506,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Delete' activity involves removing specific data record details.",
          "title": "Datastore Activity: Delete",
          "equals_number": 600507,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'List' activity provides an overview of existing data records.",
          "title": "Datastore Activity: List",
          "equals_number": 600508,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Encrypt' activity involves securing data by encrypting a specific data record.",
          "title": "Datastore Activity: Encrypt",
          "equals_number": 600509,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Decrypt' activity involves converting encrypted data back to its original format.",
          "title": "Datastore Activity: Decrypt",
          "equals_number": 600510,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Datastore Activity: Other",
          "equals_number": 600599,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
