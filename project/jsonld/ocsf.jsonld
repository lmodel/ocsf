      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfModule_file",
      "definition_uri": "https://w3id.org/lmodel/ocsf/file",
      "description": "The module file object.",
      "title": "File",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/file"
      ],
      "is_a": "file",
