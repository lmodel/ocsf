    {
      "name": "criticality_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/criticality_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "criticality",
          "@type": "Annotation"
        }
      ],
      "description": "Criticality or relative importance of a resource/object in question.",
      "title": "Criticality Level ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/criticality_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/criticality_id",
      "owner": "OcsfResourceDetails",
      "domain_of": [
        "OcsfResourceDetails"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The criticality level is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Minimal operational or security importance.",
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Affects localized functions or specific business processes.",
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Critical to core operations. Compromise leads to significant, but recoverable disruptions.",
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mission critical, essential to business survival. Compromise could result in catastrophic consequences.",
          "title": "Very High",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The criticality level is not mapped. See the <code>criticality</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
