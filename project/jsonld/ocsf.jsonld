    {
      "name": "OcsfDatastoreActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "activity_id",
      "domain": "OcsfDatastoreActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfDatastoreActivity",
      "domain_of": [
        "OcsfDatastoreActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Read' activity involves accessing specific data record details.",
          "title": "Read",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Update' activity pertains to modifying specific data record details.",
          "title": "Update",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Connect' activity involves establishing a connection to the datastore.",
          "title": "Connect",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Query' activity involves retrieving a filtered subset of data based on specific criteria.",
          "title": "Query",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Write' activity involves writing specific data record details.",
          "title": "Write",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Create' activity involves generating new data record details.",
          "title": "Create",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Delete' activity involves removing specific data record details.",
          "title": "Delete",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'List' activity provides an overview of existing data records.",
          "title": "List",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Encrypt' activity involves securing data by encrypting a specific data record.",
          "title": "Encrypt",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The 'Decrypt' activity involves converting encrypted data back to its original format.",
          "title": "Decrypt",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
