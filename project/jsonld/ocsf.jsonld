    {
      "name": "OcsfMitigation_countermeasures",
      "definition_uri": "https://w3id.org/lmodel/ocsf/countermeasures",
      "description": "The D3FEND countermeasures that are associated with the attack technique. For example: ATT&CK Technique <code>T1003</code> is addressed by Mitigation <code>M1027</code>, and D3FEND Technique <code>D3-OTP</code>.",
      "title": "Countermeasures",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/countermeasures"
      ],
      "is_a": "countermeasures",
      "domain": "OcsfMitigation",
      "slot_uri": "https://w3id.org/lmodel/ocsf/countermeasures",
      "alias": "countermeasures",
      "owner": "OcsfMitigation",
      "domain_of": [
        "OcsfMitigation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "countermeasures",
      "range": "OcsfD3fend",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfMitigation_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/name",
      "description": "The Mitigation name that is associated with the attack technique. For example: <code>Password Policies</code>, or <code>Code Signing</code>.",
      "title": "Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/name"
      ],
      "is_a": "OcsfEntity_name",
