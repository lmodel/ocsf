      "domain_of": [
        "OcsfOsint"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "confidence_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The normalized confidence is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The confidence is not mapped to the defined enum values. See the <code>confidence</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
