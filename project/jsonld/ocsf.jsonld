      "name": "OcsfEvidences_verdict",
      "definition_uri": "https://w3id.org/lmodel/ocsf/verdict",
      "description": "The normalized verdict of the evidence associated with the security detection.",
      "title": "Verdict",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/verdict"
      ],
      "is_a": "verdict",
