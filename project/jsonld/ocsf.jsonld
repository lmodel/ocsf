    {
      "name": "OcsfDataSecurityFinding",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfDataSecurityFinding",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "data_security_finding",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_category",
