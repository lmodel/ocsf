      "alias": "resources",
      "owner": "OcsfIamAnalysisFinding",
      "domain_of": [
        "OcsfIamAnalysisFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "resources",
      "range": "OcsfResourceDetails",
      "recommended": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfIamAnalysisFinding_start_time_dt",
      "definition_uri": "https://w3id.org/lmodel/ocsf/start_time_dt",
      "description": "The time of the earliest event or finding that contributed to this finding.",
      "title": "Start Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/start_time_dt"
      ],
