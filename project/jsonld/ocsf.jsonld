    {
      "name": "OcsfWebResourceAccessActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "type_uid",
      "domain": "OcsfWebResourceAccessActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfWebResourceAccessActivity",
      "domain_of": [
        "OcsfWebResourceAccessActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "any_of": [
        {
          "title": "Web Resource Access Activity: Unknown",
          "equals_number": 600400,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incoming request has permission to the web resource.",
          "title": "Web Resource Access Activity: Access Grant",
          "equals_number": 600401,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incoming request does not have permission to the web resource.",
          "title": "Web Resource Access Activity: Access Deny",
          "equals_number": 600402,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incoming request's access has been revoked due to security policy enforcements.",
          "title": "Web Resource Access Activity: Access Revoke",
          "equals_number": 600403,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An error occurred during processing the request.",
          "title": "Web Resource Access Activity: Access Error",
          "equals_number": 600404,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Web Resource Access Activity: Other",
          "equals_number": 600499,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfWebResourceAccessActivity_web_resources",
      "definition_uri": "https://w3id.org/lmodel/ocsf/web_resources",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
