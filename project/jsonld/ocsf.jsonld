      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfDhcpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfDhcpActivity",
      "domain_of": [
        "OcsfDhcpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "DHCP Activity: Unknown",
          "equals_number": 400400,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPDISCOVER",
          "title": "DHCP Activity: Discover",
          "equals_number": 400401,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPOFFER",
          "title": "DHCP Activity: Offer",
          "equals_number": 400402,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPREQUEST",
          "title": "DHCP Activity: Request",
          "equals_number": 400403,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPDECLINE",
          "title": "DHCP Activity: Decline",
          "equals_number": 400404,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPACK: The server accepts the request by sending the client a DHCP Acknowledgment message.",
          "title": "DHCP Activity: Ack",
          "equals_number": 400405,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPNAK",
          "title": "DHCP Activity: Nak",
          "equals_number": 400406,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPRELEASE: A DHCP client sends a DHCPRELEASE packet to the server to release the IP address and cancel any remaining lease.",
          "title": "DHCP Activity: Release",
          "equals_number": 400407,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPINFORM",
          "title": "DHCP Activity: Inform",
          "equals_number": 400408,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "DHCPEXPIRE: A DHCP lease expired.",
          "title": "DHCP Activity: Expire",
          "equals_number": 400409,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "DHCP Activity: Other",
          "equals_number": 400499,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDnsActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfDnsActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfDnsActivity",
      "domain_of": [
        "OcsfDnsActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The DNS query request.",
          "title": "Query",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The DNS query response.",
          "title": "Response",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Bidirectional DNS request and response traffic.",
          "title": "Traffic",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
