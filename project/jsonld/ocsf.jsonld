      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_suppress_checks",
          "value": "enum_convention",
          "@type": "Annotation"
        }
      ],
      "description": "The DNS opcode ID specifies the normalized query message type as defined in RFC 5395.",
      "title": "DNS Opcode ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.rfc-editor.org/rfc/rfc5395.html"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/opcode_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/opcode_id",
      "owner": "OcsfDnsActivity",
      "domain_of": [
        "OcsfDnsQuery",
        "OcsfDnsActivity"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "Standard query",
          "title": "Query",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Inverse query, obsolete",
          "title": "Inverse Query",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Server status request",
          "title": "Status",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Reserved, not used",
          "title": "Reserved",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Zone change notification",
          "title": "Notify",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Dynamic DNS update",
          "title": "Update",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
