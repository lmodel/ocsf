        "OcsfScheduledJobActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Update",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Delete",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Enable",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Disable",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Start",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
