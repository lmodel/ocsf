          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfProcessActivity_launch_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/launch_type",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "The specific type of <code>Launch</code> activity, normalized to the caption of the <code>launch_type_id</code> value. In the case of <code>Other</code> it is defined by the event source.",
      "title": "Launch Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/launch_type"
      ],
      "is_a": "launch_type",
      "domain": "OcsfProcessActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/launch_type",
      "alias": "launch_type",
      "owner": "OcsfProcessActivity",
      "domain_of": [
        "OcsfProcessActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "launch_type",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfProcessActivity_launch_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/launch_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "launch_type",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier for the specific type of <code>Launch</code> activity.",
      "title": "Launch Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.man7.org/linux/man-pages/man2/fork.2.html",
        "https://www.man7.org/linux/man-pages/man2/execve.2.html"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/launch_type_id"
      ],
      "is_a": "launch_type_id",
      "domain": "OcsfProcessActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/launch_type_id",
      "alias": "launch_type_id",
      "owner": "OcsfProcessActivity",
      "domain_of": [
        "OcsfProcessActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "launch_type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The launch type is unknown or not specified.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Denotes that the <code>Launch</code> event represents atomic creation of a new process on Windows. This launch type ID may also be used to represent both steps of Unix process creation in a single <code>Launch</code> event.",
          "title": "Spawn",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Denotes that the <code>Launch</code> event represents the \"fork\" step of Unix process creation, where a process creates a clone of itself in a parent-child relationship. WSL1 pico processes on Windows also use the 2-step Unix model.",
          "title": "Fork",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Denotes that the <code>Launch</code> event represents the \"exec\" step of Unix process creation, where a process replaces its executable image, command line, and environment. WSL1 pico processes on Windows also use the 2-step Unix model.",
          "title": "Exec",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The launch type is not mapped. See the <code>launch_type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
