      "alias": "tunnel_type_id",
      "owner": "OcsfTunnelActivity",
      "domain_of": [
        "OcsfTunnelActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "tunnel_type_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The type of tunnel configuration is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The tunnel configuration routes only specific traffic through the tunnel.",
          "title": "Split Tunnel",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The tunnel configuration routes all traffic through the tunnel.",
          "title": "Full Tunnel",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type of tunnel configuration is not defined by the event source.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfTunnelActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfTunnelActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfTunnelActivity",
      "domain_of": [
        "OcsfTunnelActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Tunnel Activity: Unknown",
          "equals_number": 401400,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Open a tunnel.",
          "title": "Tunnel Activity: Open",
          "equals_number": 401401,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Close a tunnel.",
          "title": "Tunnel Activity: Close",
          "equals_number": 401402,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Renew a tunnel.",
          "title": "Tunnel Activity: Renew",
          "equals_number": 401403,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Tunnel Activity: Other",
          "equals_number": 401499,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
