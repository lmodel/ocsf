      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_subnet_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfSubnetT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "subnet_t",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_max_len",
          "value": "42",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_observable",
          "value": "12",
          "@type": "Annotation"
        }
      ],
      "description": "The subnet represented in a CIDR notation, using the format network_address/prefix_length. The network_address can be in either IPv4 or IPv6 format. The prefix length indicates the number of bits used for the network portion, and the remaining bits are available for host addresses within that subnet. For example:<br><code>192.168.1.0/24</code>,<br><code>2001:0db8:85a3:0000::/64</code>",
      "title": "Subnet",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_timestamp_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfTimestampT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "timestamp_t",
          "@type": "Annotation"
        }
      ],
      "description": "The timestamp format is the number of milliseconds since the Epoch 01/01/1970 00:00:00 UTC. For example:<br><code>1618524549901</code>.",
      "title": "Timestamp",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_long_t",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_url_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfUrlT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
