      "domain_of": [
        "OcsfBaseEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "duration",
      "range": "ocsf_long_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfBaseEvent_end_time",
      "definition_uri": "https://w3id.org/lmodel/ocsf/end_time",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "occurrence",
          "@type": "Annotation"
        }
      ],
      "description": "The time of the most recent event in an aggregate (<code>count</code> &gt; 1). Do not populate for discrete, point-in-time events - use <code>time</code> alone. Subclasses such as findings may redefine this for their own time-range semantics.",
      "title": "End Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/end_time"
      ],
      "is_a": "end_time",
