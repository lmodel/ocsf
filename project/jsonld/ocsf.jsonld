      "title": "Patch Bulletin",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/bulletin"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/bulletin",
      "owner": "OcsfKbArticle",
      "domain_of": [
        "OcsfAdvisory",
        "OcsfKbArticle"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "bus_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/bus_type",
      "description": "The attachment bus or interface standard, normalized to the caption of the bus_type_id value. In the case of 'Other', it is defined by the event source.",
      "title": "Bus Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/bus_type"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/bus_type",
      "owner": "OcsfGpuInfo",
      "domain_of": [
        "OcsfGpuInfo"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "bus_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/bus_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "bus_type",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the attachment bus or interface standard.",
      "title": "Bus Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/bus_type_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/bus_type_id",
      "owner": "OcsfGpuInfo",
      "domain_of": [
        "OcsfGpuInfo"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The bus type is unknown or not reported.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The device is attached directly on the motherboard or SoC (often referred to as 'integrated' or 'onboard').",
          "title": "Onboard",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Peripheral Component Interconnect Express slot with 16 lanes, typically used for high\u2011bandwidth add\u2011in devices.",
          "title": "PCIe x16",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Peripheral Component Interconnect Express slot with 8 lanes; common for high\u2011performance NICs, storage controllers, and accelerators.",
          "title": "PCIe x8",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mobile PCI Express Module (MXM) Type A form factor (compact laptop/embedded GPU module).",
          "title": "MXM Type A",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mobile PCI Express Module (MXM) Type B form factor (larger laptop/embedded GPU module).",
          "title": "MXM Type B",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "M.2 (NGFF) internal module form factor/connector exposing PCIe (and/or SATA/USB) for SSDs and add\u2011in modules.",
          "title": "M.2",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Compute Express Link (CXL), an open cache\u2011coherent interconnect for processors, memory expansion, and accelerators built on the PCIe physical layer.",
          "title": "CXL",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A bus or interface standard not covered by the defined values; the exact value is reported by the event source.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "bytes",
      "definition_uri": "https://w3id.org/lmodel/ocsf/bytes",
      "description": "The total number of bytes (in and out).",
      "title": "Total Bytes",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
