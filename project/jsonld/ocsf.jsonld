      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "file_path_t",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_observable",
          "value": "45",
          "@type": "Annotation"
        }
      ],
      "description": "The full path to the file. For example: For example:<br><code>c:\\windows\\system32\\svchost.exe</code>.",
      "title": "File Path",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
