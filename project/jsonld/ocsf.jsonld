      "owner": "OcsfDiscoveryResultEvent",
      "domain_of": [
        "OcsfDiscoveryResultEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "query_result",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDiscoveryResultEvent_query_result_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/query_result_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "query_result",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the query result.",
      "title": "Query Result ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/query_result_id"
      ],
      "is_a": "query_result_id",
      "domain": "OcsfDiscoveryResultEvent",
      "slot_uri": "https://w3id.org/lmodel/ocsf/query_result_id",
      "alias": "query_result_id",
      "owner": "OcsfDiscoveryResultEvent",
      "domain_of": [
        "OcsfDiscoveryResultEvent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "query_result_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The query result is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The target was found.",
          "title": "Exists",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The target was partially found.",
          "title": "Partial",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The target was not found.",
          "title": "Does not exist",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The discovery attempt failed.",
          "title": "Error",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Discovery of the target was not supported.",
          "title": "Unsupported",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The query result is not mapped. See the <code>query_result</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAdminGroupQuery_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfAdminGroupQuery",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfAdminGroupQuery",
      "domain_of": [
        "OcsfAdminGroupQuery"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The discovered results are via a query request.",
          "title": "Query",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAdminGroupQuery_category_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/category_name",
      "description": "The event category name, as defined by category_uid value: <code>Discovery</code>.",
      "title": "Category",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/category_name"
