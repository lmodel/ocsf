          "tag": "ocsf_sibling",
          "value": "observation_point",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the observation point. See specific usage.",
      "title": "Observation Point ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/observation_point_id"
      ],
      "is_a": "OcsfNetworkEvent_observation_point_id",
      "domain": "OcsfSshActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/observation_point_id",
      "alias": "observation_point_id",
