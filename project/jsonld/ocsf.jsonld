      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScript_file",
      "definition_uri": "https://w3id.org/lmodel/ocsf/file",
      "description": "Present if this script is associated with a file. Not present in the case of a file-less script.",
      "title": "File",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/file"
      ],
