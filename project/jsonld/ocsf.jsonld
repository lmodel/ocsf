    {
      "name": "OcsfRemediationActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "Matches the countermeasure tactic. Note: the Model tactic is not supported by the OCSF Remediation event class.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfRemediationActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfRemediationActivity",
      "domain_of": [
        "OcsfRemediationActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Creates logical or physical barriers in a system which reduces opportunities for adversaries to create further accesses.",
          "title": "Isolate",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Isolate/"
          ],
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Removes an adversary or malicious resource from a device or computer network.",
          "title": "Evict",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Evict/"
          ],
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Returns the system to a better state.",
          "title": "Restore",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Restore/"
          ],
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Increases the opportunity cost of computer network exploitation.",
          "title": "Harden",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Harden/"
          ],
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Identify adversary access to or unauthorized activity on computer networks.",
          "title": "Detect",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Detect/"
          ],
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Advertise, entice, and allow potential attackers access to an observed or controlled environment.",
          "title": "Deceive",
          "see_also": [
            "https://d3fend.mitre.org/tactic/d3f:Deceive/"
          ],
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
