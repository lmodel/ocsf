      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "status",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized status identifier of the compliance check.",
      "title": "Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_id"
      ],
      "is_a": "status_id",
      "domain": "OcsfCompliance",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "alias": "status_id",
      "owner": "OcsfCompliance",
      "domain_of": [
        "OcsfCompliance"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The compliance check passed for all the evaluated resources.",
          "title": "Pass",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The compliance check did not yield a result due to missing information.",
          "title": "Warning",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The compliance check failed for at least one of the evaluated resources.",
          "title": "Fail",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
