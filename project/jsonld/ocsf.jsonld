    {
      "name": "OcsfRdpActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://docs.suricata.io/en/latest/output/eve/eve-json-format.html#event-type-rdp"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfRdpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfRdpActivity",
      "domain_of": [
        "OcsfRdpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The initial RDP request.",
          "title": "Initial Request",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The initial RDP response.",
          "title": "Initial Response",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection request.",
          "title": "Connect Request",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection response.",
          "title": "Connect Response",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The TLS handshake.",
          "title": "TLS Handshake",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Network traffic report.",
          "title": "Traffic",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection disconnect.",
          "title": "Disconnect",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An RDP connection reconnect.",
          "title": "Reconnect",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
