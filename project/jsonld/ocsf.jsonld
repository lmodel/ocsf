      "domain_of": [
        "OcsfMitigation"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "uid",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfModule_base_address",
      "definition_uri": "https://w3id.org/lmodel/ocsf/base_address",
      "description": "The memory address where the module was loaded.",
      "title": "Base Address",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/base_address"
      ],
      "is_a": "base_address",
