      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Airborne Broadcast Activity: Unknown",
          "equals_number": 800200,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "ADS-B information is being captured (collected).",
          "title": "Airborne Broadcast Activity: Capture",
          "equals_number": 800201,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "ADS-B information is being recorded, for example by a standalone transceiver.",
          "title": "Airborne Broadcast Activity: Record",
          "equals_number": 800202,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Airborne Broadcast Activity: Other",
          "equals_number": 800299,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
