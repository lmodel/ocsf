    {
      "name": "OcsfResourceDetails_criticality",
      "definition_uri": "https://w3id.org/lmodel/ocsf/criticality",
      "description": "Criticality or relative importance of this resource, normalized to the caption of <code>criticality_id</code>. In the case of Other, the value is defined by the event source.<p>Note: For versions prior to 1.9, <code>criticality_id</code> was not available and this is a source specific value.<p>",
      "title": "Criticality",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/criticality"
      ],
      "is_a": "criticality",
      "domain": "OcsfResourceDetails",
      "slot_uri": "https://w3id.org/lmodel/ocsf/criticality",
      "alias": "criticality",
      "owner": "OcsfResourceDetails",
      "domain_of": [
        "OcsfResourceDetails"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "criticality",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfResourceDetails_criticality_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/criticality_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "criticality",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier for the criticality or relative importance of this resource. Select the value that best reflects the operational and security impact if the resource were compromised or made unavailable. See the <code>criticality</code> sibling attribute for the corresponding human-readable label.",
      "title": "Criticality Level ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/criticality_id"
      ],
      "is_a": "criticality_id",
      "domain": "OcsfResourceDetails",
      "slot_uri": "https://w3id.org/lmodel/ocsf/criticality_id",
      "alias": "criticality_id",
      "owner": "OcsfResourceDetails",
      "domain_of": [
        "OcsfResourceDetails"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "criticality_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The criticality level is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Minimal operational or security importance.",
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Affects localized functions or specific business processes.",
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Critical to core operations. Compromise leads to significant, but recoverable disruptions.",
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mission critical, essential to business survival. Compromise could result in catastrophic consequences.",
          "title": "Very High",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The criticality level is not mapped. See the <code>criticality</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfResourceDetails_device",
      "definition_uri": "https://w3id.org/lmodel/ocsf/device",
      "description": "The device details when the resource type is a device \u2014 for example, a cloud compute instance, a laptop, or a network appliance. Provides structured device attributes (OS, type, hardware, agent) that the resource's scalar fields cannot represent \u2014 beyond what the <code>hostname</code> and <code>ip</code> attributes capture. The <code>device.name</code> and <code>device.uid</code> should match the <code>name</code> and <code>uid</code> of this objects; the <code>device.hostname</code> value should match the <code>hostname</code> attribute of this object. The top-level <code>hostname</code> and <code>ip</code> remain the primary identifiers for the device resource.",
      "title": "Device",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/device"
      ],
