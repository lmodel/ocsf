      "any_of": [
        {
          "title": "File Hosting Activity: Unknown",
          "equals_number": 600600,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Upload a file.",
          "title": "File Hosting Activity: Upload",
          "equals_number": 600601,
          "@type": "AnonymousSlotExpression"
        },
        {
