      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "cpu_architecture",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the CPU architecture.",
      "title": "CPU Architecture ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/cpu_architecture_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/cpu_architecture_id",
