      "owner": "OcsfNetworkFileActivity",
      "domain_of": [
        "OcsfNetworkFileActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Upload a file.",
          "title": "Upload",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Download a file.",
          "title": "Download",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Update a file.",
          "title": "Update",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete a file.",
          "title": "Delete",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Rename a file.",
          "title": "Rename",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Copy a file.",
          "title": "Copy",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Move a file.",
          "title": "Move",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Restore a file.",
          "title": "Restore",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Preview a file.",
          "title": "Preview",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Lock a file.",
          "title": "Lock",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Unlock a file.",
          "title": "Unlock",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Share a file.",
          "title": "Share",
          "equals_number": 12,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Unshare a file.",
          "title": "Unshare",
          "equals_number": 13,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Open a file.",
          "title": "Open",
          "equals_number": 14,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mark a file or folder to sync with a computer.",
          "title": "Sync",
          "equals_number": 15,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mark a file or folder to not sync with a computer.",
          "title": "Unsync",
          "equals_number": 16,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
