    {
      "name": "OcsfAnomaly_observation_parameter",
      "definition_uri": "https://w3id.org/lmodel/ocsf/observation_parameter",
      "description": "The specific parameter, metric or property where the anomaly was observed. Examples include: CPU usage percentage, API response time in milliseconds, HTTP error rate, memory utilization, network latency, transaction volume, etc. This helps identify the exact aspect of the system exhibiting anomalous behavior.",
      "title": "Observation Parameter",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/observation_parameter"
      ],
      "is_a": "observation_parameter",
      "domain": "OcsfAnomaly",
      "slot_uri": "https://w3id.org/lmodel/ocsf/observation_parameter",
      "alias": "observation_parameter",
      "owner": "OcsfAnomaly",
      "domain_of": [
        "OcsfAnomaly"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "observation_parameter",
      "range": "ocsf_string_t",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAnomaly_observation_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/observation_type",
      "description": "The type of analysis methodology used to detect the anomaly. This indicates how the anomaly was identified through different analytical approaches. Common types include: Frequency Analysis, Time Pattern Analysis, Volume Analysis, Sequence Analysis, Distribution Analysis, etc.",
      "title": "Observation Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/observation_type"
      ],
      "is_a": "observation_type",
      "domain": "OcsfAnomaly",
      "slot_uri": "https://w3id.org/lmodel/ocsf/observation_type",
      "alias": "observation_type",
      "owner": "OcsfAnomaly",
      "domain_of": [
        "OcsfAnomaly"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "observation_type",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAnomaly_observations",
      "definition_uri": "https://w3id.org/lmodel/ocsf/observations",
      "description": "Details about the observed anomaly or observations that were flagged as anomalous compared to expected baseline behavior.",
      "title": "Observations",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/observations"
      ],
      "is_a": "observations",
      "domain": "OcsfAnomaly",
      "slot_uri": "https://w3id.org/lmodel/ocsf/observations",
      "alias": "observations",
      "owner": "OcsfAnomaly",
      "domain_of": [
        "OcsfAnomaly"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "observations",
      "range": "OcsfObservation",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAnomaly_observed_pattern",
      "definition_uri": "https://w3id.org/lmodel/ocsf/observed_pattern",
      "description": "The specific pattern identified within the observation type. For Frequency Analysis, this could be 'FREQUENT', 'INFREQUENT', 'RARE', or 'UNSEEN'. For Time Pattern Analysis, this could be 'BUSINESS_HOURS', 'OFF_HOURS', or 'UNUSUAL_TIME'. For Volume Analysis, this could be 'NORMAL_VOLUME', 'HIGH_VOLUME', or 'SURGE'. The pattern values are specific to each observation type and indicate how the observed behavior relates to the baseline.",
      "title": "Observed Pattern",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/observed_pattern"
      ],
      "is_a": "observed_pattern",
      "domain": "OcsfAnomaly",
      "slot_uri": "https://w3id.org/lmodel/ocsf/observed_pattern",
      "alias": "observed_pattern",
      "owner": "OcsfAnomaly",
      "domain_of": [
        "OcsfAnomaly"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "observed_pattern",
      "range": "ocsf_string_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAnomalyAnalysis_analysis_targets",
      "definition_uri": "https://w3id.org/lmodel/ocsf/analysis_targets",
      "description": "The analysis targets define the scope of monitored activities, specifying what entities, systems or processes are analyzed for activity patterns.",
      "title": "Analysis Targets",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/analysis_targets"
      ],
