      "slot_uri": "https://w3id.org/lmodel/ocsf/auth_protocol_id",
      "alias": "auth_protocol_id",
      "owner": "OcsfSso",
      "domain_of": [
        "OcsfSso"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "auth_protocol_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The authentication protocol is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "NTLM",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Kerberos",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Digest",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "OpenID",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "SAML",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "OAUTH 2.0",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "PAP",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "CHAP",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "EAP",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "RADIUS",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Basic Authentication",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "LDAP",
          "equals_number": 12,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The authentication protocol is not mapped. See the <code>auth_protocol</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
