    },
    {
      "name": "OcsfDataSecurityFinding_start_time_dt",
      "definition_uri": "https://w3id.org/lmodel/ocsf/start_time_dt",
      "description": "The time of the earliest event or finding that contributed to this finding.",
      "title": "Start Time",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/start_time_dt"
      ],
      "is_a": "OcsfBaseEvent_start_time_dt",
      "domain": "OcsfDataSecurityFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/start_time_dt",
      "alias": "start_time_dt",
      "owner": "OcsfDataSecurityFinding",
      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "start_time_dt",
      "range": "ocsf_datetime_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDataSecurityFinding_status_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "status",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized status identifier. See specific usage.",
      "title": "Status ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/status_id"
      ],
      "is_a": "OcsfFindingEvent_status_id",
      "domain": "OcsfDataSecurityFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/status_id",
      "alias": "status_id",
      "owner": "OcsfDataSecurityFinding",
      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Finding is new and yet to be reviewed.",
          "title": "New",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Finding is under review.",
          "title": "In Progress",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Finding was reviewed, determined to be benign or a false positive and is now suppressed.",
          "title": "Suppressed",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Finding was reviewed, remediated and is now considered resolved.",
          "title": "Resolved",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Finding was archived.",
          "title": "Archived",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Finding was deleted. For example, it might have been created in error.",
          "title": "Deleted",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDataSecurityFinding_table",
      "definition_uri": "https://w3id.org/lmodel/ocsf/table",
