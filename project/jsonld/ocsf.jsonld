    {
      "name": "OcsfAuthentication",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfAuthentication",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "authentication",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_category",
          "value": "iam",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "ai_operation cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_constraints",
          "value": "{\"at_least_one\": [\"service\", \"dst_endpoint\"]}",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_associations",
          "value": "{\"actor.user\": [\"src_endpoint\"], \"dst_endpoint\": [\"user\"], \"src_endpoint\": [\"actor.user\"], \"user\": [\"dst_endpoint\"]}",
          "@type": "Annotation"
        }
      ],
      "description": "Authentication events report authentication session activities, including user attempts to log on or log off, regardless of success, as well as other key stages within the authentication process. These events are typically generated by authentication services, such as Kerberos, OIDC, or SAML, and may include information about the user, the authentication method used, and the status of the authentication attempt.",
      "title": "Authentication",
      "in_subset": [
        "ocsf_category_iam"
      ],
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_events_iam",
      "see_also": [
        "https://d3fend.mitre.org/event/d3f:AuthenticationEvent"
      ],
