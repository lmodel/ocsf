      "domain_of": [
        "OcsfOsint"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The type is not mapped.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "STIX",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "PCRE",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "SIGMA",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Snort",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Suricata",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "YARA",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The detection pattern type is not mapped. See the <code>detection_pattern_type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "detection_system",
      "definition_uri": "https://w3id.org/lmodel/ocsf/detection_system",
      "description": "The data security tool or system that the finding, detection, or alert originated from, normalized to the caption of <code>detection_system_id</code>. E.g., Endpoint, Secure Email Gateway, etc. When <code>detection_system_id</code> is <code>99</code> (Other), this attribute must contain the source-specific label.",
      "title": "Detection System",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
