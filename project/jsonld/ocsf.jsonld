          "description": "A utility like <code>sudo</code>, <code>su</code>, or equivalent was used to perform actions in the context of another user.",
          "title": "Substitute User",
          "see_also": [
            "https://www.sudo.ws/",
            "https://man7.org/linux/man-pages/man1/su.1.html",
            "https://www.unix.com/man_page/osx/1/su/"
          ],
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An API like <code>ImpersonateLoggedOnUser()</code> or equivalent was used to perform actions in the context of another user.",
          "title": "Impersonate",
          "see_also": [
            "https://learn.microsoft.com/en-us/windows/win32/api/securitybaseapi/nf-securitybaseapi-impersonateloggedonuser"
          ],
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The account switch type is not mapped. See the <code>account_switch_type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAuthentication_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfAuthentication",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfAuthentication",
      "domain_of": [
        "OcsfAuthentication"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A new logon session was requested.",
          "title": "Logon",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A logon session was terminated and no longer exists.",
          "title": "Logoff",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A Kerberos authentication ticket (TGT) was requested.",
          "title": "Authentication Ticket",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A Kerberos service ticket was requested.",
          "title": "Service Ticket Request",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A Kerberos service ticket was renewed.",
          "title": "Service Ticket Renew",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A preauthentication stage was engaged.",
          "title": "Preauth",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A utility or service switched the user account. See the <code>account_switch_type_id</code> attribute for more details.",
          "title": "Account Switch",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
