      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "algorithm",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The encryption algorithm used.",
      "title": "Encryption Algorithm ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/algorithm_id"
      ],
