      "name": "verdict",
      "definition_uri": "https://w3id.org/lmodel/ocsf/verdict",
      "description": "The verdict assigned to an Incident finding.",
      "title": "Verdict",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/verdict"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/verdict",
      "owner": "OcsfIncidentFinding",
      "domain_of": [
        "OcsfIncidentProfile",
        "OcsfEvidences",
        "OcsfIncidentFinding"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "verdict_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/verdict_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "verdict",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized verdict of an Incident.",
      "title": "Verdict ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/verdict_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/verdict_id",
      "owner": "OcsfIncidentFinding",
      "domain_of": [
        "OcsfIncidentProfile",
        "OcsfEvidences",
        "OcsfIncidentFinding"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is a false positive.",
          "title": "False Positive",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is a true positive.",
          "title": "True Positive",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident can be disregarded as it is unimportant, an error or accident.",
          "title": "Disregard",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is suspicious.",
          "title": "Suspicious",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is benign.",
          "title": "Benign",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is a test.",
          "title": "Test",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident has insufficient data to make a verdict.",
          "title": "Insufficient Data",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is a security risk.",
          "title": "Security Risk",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident remediation or required actions are managed externally.",
          "title": "Managed Externally",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incident is a duplicate.",
          "title": "Duplicate",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The type is not mapped. See the <code>type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
