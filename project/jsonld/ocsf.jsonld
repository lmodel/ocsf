        "OcsfAgent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "uid_alt",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAgent_vendor_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/vendor_name",
      "description": "The company or author who created the agent or sensor. For example: <code>Crowdstrike</code>.",
      "title": "Vendor Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/vendor_name"
      ],
      "is_a": "vendor_name",
