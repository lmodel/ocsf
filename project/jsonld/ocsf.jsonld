      "slot_uri": "https://w3id.org/lmodel/ocsf/unused_services_count",
      "alias": "unused_services_count",
      "owner": "OcsfPermissionAnalysisResult",
      "domain_of": [
        "OcsfPermissionAnalysisResult"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "unused_services_count",
      "range": "ocsf_integer_t",
      "@type": "SlotDefinition"
    },
