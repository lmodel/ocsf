    {
      "name": "OcsfIdp_state_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "state",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized state ID of the Identity Provider to reflect its configuration or activation status.",
      "title": "State ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/state_id"
      ],
      "is_a": "state_id",
      "domain": "OcsfIdp",
      "slot_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "alias": "state_id",
      "owner": "OcsfIdp",
      "domain_of": [
        "OcsfIdp"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "state_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The configuration state of the Identity Provider is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Identity Provider is in an Active state, or otherwise enabled.",
          "title": "Active",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Identity Provider is in a Suspended state.",
          "title": "Suspended",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Identity Provider is in a Deprecated state, or is otherwise disabled.",
          "title": "Deprecated",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Identity Provider is in a Deleted state.",
          "title": "Deleted",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The configuration state of the Identity Provider is not mapped. See the <code>state</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
