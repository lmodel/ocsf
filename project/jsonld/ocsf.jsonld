      "usage_slot_name": "source",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfPacket_source_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/source_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "source",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "A normalized numeric identifier that specifies how the packet was obtained or generated.",
      "title": "Source ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/source_id"
      ],
      "is_a": "source_id",
      "domain": "OcsfPacket",
      "slot_uri": "https://w3id.org/lmodel/ocsf/source_id",
      "alias": "source_id",
      "owner": "OcsfPacket",
      "domain_of": [
        "OcsfPacket"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "source_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The packet source is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet was captured directly from a network interface.",
          "title": "Wire",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet was reconstructed or derived from a stream of packets.",
          "title": "Stream",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet was generated or extracted by a protocol decoder or analysis engine.",
          "title": "Decoder",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet was captured from a physical network Test Access Point (TAP) device used for passive monitoring.",
          "title": "TAP",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet was captured from a switch Switched Port Analyzer (SPAN) or mirror port.",
          "title": "SPAN",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet was captured by a host-based agent or endpoint detection and response (EDR) sensor.",
          "title": "Endpoint",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet was captured from a virtual network interface, virtual switch, or container network.",
          "title": "Virtual",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The packet source is not mapped. Refer to the <code>source</code> field for the original source-specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
