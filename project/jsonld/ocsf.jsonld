    {
      "name": "OcsfIncidentFinding_category_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/category_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "category_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The category unique identifier of the event. Each event class belongs to exactly one category. Producers and mappers must set this to the category defined by the event class being used.",
      "title": "Category ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
