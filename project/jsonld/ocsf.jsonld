    {
      "name": "OcsfDetectionFinding_impact_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/impact_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "context",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "impact",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_source_note",
          "value": "impact value; impact level",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized impact of the incident or finding. Per NIST, this is the magnitude of harm that can be expected to result from the consequences of unauthorized disclosure, modification, destruction, or loss of information or information system availability.",
      "title": "Impact ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://doi.org/10.6028/NIST.FIPS.199",
        "https://doi.org/10.6028/NIST.FIPS.199"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/impact_id"
      ],
      "is_a": "OcsfIncidentProfile_impact_id",
      "domain": "OcsfDetectionFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/impact_id",
      "alias": "impact_id",
      "owner": "OcsfDetectionFinding",
      "domain_of": [
        "OcsfDetectionFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "impact_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The normalized impact is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The magnitude of harm is low.",
          "title": "Low",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The magnitude of harm is moderate.",
          "title": "Medium",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The magnitude of harm is high.",
          "title": "High",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The magnitude of harm is high and the scope is widespread.",
          "title": "Critical",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The impact is not mapped. See the <code>impact</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
