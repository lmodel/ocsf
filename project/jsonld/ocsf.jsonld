      "domain_of": [
        "OcsfVulnerability"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fix_coverage",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfVulnerability_fix_coverage_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/fix_coverage_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "fix_coverage",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier for fix coverage, applicable to this vulnerability. Typically useful, when there are multiple affected packages but only a subset have available fixes.",
      "title": "Fix Coverage ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/fix_coverage_id"
      ],
      "is_a": "fix_coverage_id",
      "domain": "OcsfVulnerability",
      "slot_uri": "https://w3id.org/lmodel/ocsf/fix_coverage_id",
      "alias": "fix_coverage_id",
      "owner": "OcsfVulnerability",
      "domain_of": [
        "OcsfVulnerability"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fix_coverage_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The fix coverage is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "All affected packages and components have available fixes or patches to remediate the vulnerability.",
          "title": "Complete",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Only some of the affected packages and components have available fixes or patches, while others remain vulnerable.",
          "title": "Partial",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "No fixes or patches are currently available for any of the affected packages and components.",
          "title": "None",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The fix coverage is not mapped. See the <code>fix_coverage</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
