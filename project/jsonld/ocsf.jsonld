      "@type": "SlotDefinition"
    },
    {
      "name": "developer_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/developer_uid",
      "description": "The developer ID on the certificate that signed the file.",
      "title": "Developer UID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/developer_uid"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/developer_uid",
      "owner": "OcsfDigitalSignature",
      "domain_of": [
