    {
      "name": "OcsfWinServiceActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use 0 (Unknown) when the activity cannot be determined. Use 99 (Other) when the activity does not match any defined value, in which case activity_name must be populated with the source-specific label.<br>Refer to the <code>win_service</code> attribute for details, unless any other attribute is mentioned.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "OcsfBaseEvent_activity_id",
      "domain": "OcsfWinServiceActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfWinServiceActivity",
      "domain_of": [
        "OcsfWinServiceActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A service is created, for example by calling the CreateService API.",
          "title": "Create",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A service is reconfigured, for example by calling the ChangeServiceConfig or ChangeServiceConfig2 API. Refer to <code>prev_win_service</code> and <code>win_service</code> attributes for details.",
          "title": "Reconfigure",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A stopped service is started, for example by calling the StartService API.",
          "title": "Start",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A running or paused service is stopped, for example by calling the ControlService or ControlServiceEx API.",
          "title": "Stop",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A running service is paused, for example by calling the ControlService or ControlServiceEx API.",
          "title": "Pause",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A paused service is continued, for example by calling the ControlService or ControlServiceEx API.",
          "title": "Continue",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A service is deleted, for example by calling the DeleteService API.",
          "title": "Delete",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
