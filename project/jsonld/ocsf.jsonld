      "usage_slot_name": "name",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScript_parent_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/parent_uid",
      "description": "This attribute relates a sub-script to a parent script having the matching <code>uid</code> attribute. In the case of PowerShell, sub-script execution can be identified by matching the activity correlation ID of the raw ETW events provided by the OS.",
      "title": "Parent Unique ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/parent_uid"
      ],
      "is_a": "parent_uid",
      "domain": "OcsfScript",
      "slot_uri": "https://w3id.org/lmodel/ocsf/parent_uid",
      "alias": "parent_uid",
      "owner": "OcsfScript",
      "domain_of": [
        "OcsfScript"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "parent_uid",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScript_script_content",
      "definition_uri": "https://w3id.org/lmodel/ocsf/script_content",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_observable": {
          "tag": "ocsf_observable",
          "value": "36",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The script content, normalized to UTF-8 encoding irrespective of its original encoding. When emitting this attribute, it may be appropriate to truncate large scripts. When consuming this attribute, large scripts should be anticipated.",
      "title": "Script Content",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/script_content"
      ],
      "is_a": "script_content",
      "domain": "OcsfScript",
      "slot_uri": "https://w3id.org/lmodel/ocsf/script_content",
      "alias": "script_content",
      "owner": "OcsfScript",
      "domain_of": [
        "OcsfScript"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "script_content",
      "range": "OcsfLongString",
      "required": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScript_type",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type",
      "description": "The script type, normalized to the caption of the <code>type_id</code> value. In the case of 'Other', it is defined by the event source.",
      "title": "Type",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type"
      ],
      "is_a": "type",
      "domain": "OcsfScript",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type",
      "alias": "type",
      "owner": "OcsfScript",
      "domain_of": [
        "OcsfScript"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScript_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized script type ID.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_id"
      ],
      "is_a": "type_id",
      "domain": "OcsfScript",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_id",
      "alias": "type_id",
      "owner": "OcsfScript",
      "domain_of": [
        "OcsfScript"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The script type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Windows Command Prompt",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "PowerShell",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Python",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "JavaScript",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "VBScript",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Unix Shell",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "VBA",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The script type is not mapped. See the <code>type</code> attribute which contains an event source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfScript_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/uid",
      "description": "Some script engines assign a unique ID to each individual execution of a given script. This attribute captures that unique ID. In the case of PowerShell, the unique ID corresponds to the <code>ScriptBlockId</code> in the raw ETW events provided by the OS.",
      "title": "Unique ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/uid"
      ],
      "is_a": "uid",
      "domain": "OcsfScript",
      "slot_uri": "https://w3id.org/lmodel/ocsf/uid",
      "alias": "uid",
      "owner": "OcsfScript",
      "domain_of": [
        "OcsfScript"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "uid",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSecurityState_state",
      "definition_uri": "https://w3id.org/lmodel/ocsf/state",
      "description": "The security state, normalized to the caption of the state_id value. In the case of 'Other', it is defined by the source.",
      "title": "Security State",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/state"
      ],
      "is_a": "state",
      "domain": "OcsfSecurityState",
      "slot_uri": "https://w3id.org/lmodel/ocsf/state",
      "alias": "state",
      "owner": "OcsfSecurityState",
      "domain_of": [
        "OcsfSecurityState"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "state",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSecurityState_state_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "state",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The security state of the managed entity.",
      "title": "Security State ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/state_id"
      ],
      "is_a": "state_id",
      "domain": "OcsfSecurityState",
      "slot_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "alias": "state_id",
      "owner": "OcsfSecurityState",
      "domain_of": [
        "OcsfSecurityState"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "state_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The security state is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The content is missing or outdated.",
          "title": "Missing or outdated content",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Not in compliance with the expected security policy.",
          "title": "Policy mismatch",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Isolated from the network.",
          "title": "In network quarantine",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Not protected by a security solution.",
          "title": "Protection off",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The security solution is not functioning properly.",
          "title": "Protection malfunction",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The security solution does not have a valid license.",
          "title": "Protection not licensed",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A detected threat has not been remediated.",
          "title": "Unremediated threat",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Reputation of the entity is suspicious.",
          "title": "Suspicious reputation",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A reboot is required for one or more pending actions.",
          "title": "Reboot pending",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The content is locked to a specific version.",
          "title": "Content is locked",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The entity is not installed.",
          "title": "Not installed",
          "equals_number": 11,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The system partition is writeable.",
          "title": "Writable system partition",
          "equals_number": 12,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The device has failed the SafetyNet check.",
          "title": "SafetyNet failure",
          "equals_number": 13,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The device has failed the boot verification process.",
          "title": "Failed boot verify",
          "equals_number": 14,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The execution environment has been modified.",
          "title": "Modified execution environment",
          "equals_number": 15,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The SELinux security feature has been disabled.",
          "title": "SELinux disabled",
          "equals_number": 16,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An elevated privilege shell has been detected.",
          "title": "Elevated privilege shell",
          "equals_number": 17,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The file system has been altered on an iOS device.",
          "title": "iOS file system altered",
          "equals_number": 18,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remote access is enabled.",
          "title": "Open remote access",
          "equals_number": 19,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Mobile OTA (Over The Air) updates have been disabled.",
          "title": "OTA updates disabled",
          "equals_number": 20,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The device has been modified to allow root access.",
          "title": "Rooted",
          "equals_number": 21,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Android partition has been modified.",
          "title": "Android partition modified",
          "equals_number": 22,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The entity is not compliant with the associated security policy.",
          "title": "Compliance failure",
          "equals_number": 23,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The security state is not mapped. See the <code>state</code> attribute, which contains data source specific values.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSensorInfo_sensor_layer",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sensor_layer",
      "description": "The technology or sensor layer that emitted the data, normalized to the caption of <code>sensor_layer_id</code>. When <code>sensor_layer_id</code> is <code>99</code> (Other), this attribute must contain the source-specific label.",
      "title": "Sensor Layer",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/sensor_layer"
      ],
      "is_a": "sensor_layer",
      "domain": "OcsfSensorInfo",
      "slot_uri": "https://w3id.org/lmodel/ocsf/sensor_layer",
      "alias": "sensor_layer",
      "owner": "OcsfSensorInfo",
      "domain_of": [
        "OcsfSensorInfo"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "sensor_layer",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSensorInfo_sensor_layer_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/sensor_layer_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "sensor_layer",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the sensor layer that emitted the data. For example, use this to classify the detection surface (e.g., IPS sensor, endpoint agent, email gateway). When the type is not listed, use <code>99</code> (Other) and populate <code>sensor_layer</code> with the source-specific label.",
      "title": "Sensor Layer ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/sensor_layer_id"
      ],
      "is_a": "sensor_layer_id",
      "domain": "OcsfSensorInfo",
      "slot_uri": "https://w3id.org/lmodel/ocsf/sensor_layer_id",
      "alias": "sensor_layer_id",
      "owner": "OcsfSensorInfo",
      "domain_of": [
        "OcsfSensorInfo"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "sensor_layer_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The sensor layer type is Unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from a network, firewall, or IPS sensor.",
          "title": "Network",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an endpoint device or agent running on an OS.",
          "title": "Endpoint",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an email gateway or email security system.",
          "title": "Email",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an identity and access management (IAM) system or service.",
          "title": "IAM",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from a proxy server (e.g., forward or reverse proxy, web gateway).",
          "title": "Proxy",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from a cyber threat intelligence (CTI) system or by matching observables against a threat intelligence feed or report.",
          "title": "Threat Intel",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The analyzed data is emitted by, or originates from an application (e.g., web application, SaaS platform, or custom business application).",
          "title": "Application",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The sensor layer type is not mapped. See the <code>sensor_layer</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
