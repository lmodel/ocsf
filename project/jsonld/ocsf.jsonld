      "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_port_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfPortT",
      "instantiates": [
