      "title": "Process Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_reg_key_path_t",
