      "any_of": [
        {
          "title": "Security Finding: Unknown",
          "equals_number": 200100,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A security finding was created.",
          "title": "Security Finding: Create",
          "equals_number": 200101,
