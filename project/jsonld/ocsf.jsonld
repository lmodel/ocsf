      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_resource_uid_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfResourceUidT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
