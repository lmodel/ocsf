          "@type": "Annotation"
        },
        {
          "tag": "ocsf_observable",
          "value": "4",
          "@type": "Annotation"
        }
      ],
      "description": "User name. For example:<br><code>john_doe</code>.",
      "title": "User Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "ocsf_uuid_t",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfUuidT",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "uuid_t",
          "@type": "Annotation"
        }
      ],
      "description": "128-bit universal unique identifier. For example:<br><code>123e4567-e89b-12d3-a456-42661417400</code>.",
      "title": "UUID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "typeof": "ocsf_string_t",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "OcsfDepth",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfDepth",
      "description": "The values OCSF lists for depth.",
      "title": "CVSS Depth",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "permissible_values": [
        {
          "text": "Base",
          "title": "Base"
        },
        {
          "text": "Environmental",
          "title": "Environmental"
        },
        {
          "text": "Temporal",
          "title": "Temporal"
        }
      ]
    },
    {
      "name": "OcsfHttpMethod",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfHttpMethod",
      "description": "The values OCSF lists for http_method.",
      "title": "HTTP Method",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "permissible_values": [
        {
          "text": "ACL",
          "description": "The ACL method modifies the access control list of the specified resource.",
          "title": "ACL"
        },
        {
          "text": "BASELINE-CONTROL",
          "description": "The BASELINE-CONTROL method places the specified collection resource under baseline control.",
          "title": "Baseline Control"
        },
        {
          "text": "BIND",
          "description": "The BIND method adds a binding to the specified collection resource.",
          "title": "Bind"
        },
        {
          "text": "CHECKIN",
          "description": "The CHECKIN method creates a new version from a checked-out version-controlled resource.",
          "title": "Check In"
        },
        {
          "text": "CHECKOUT",
          "description": "The CHECKOUT method prepares a version-controlled resource for modification.",
          "title": "Check Out"
        },
        {
          "text": "CONNECT",
          "description": "The CONNECT method establishes a tunnel to the server identified by the target resource.",
          "title": "Connect"
        },
        {
          "text": "COPY",
          "description": "The COPY method duplicates the specified resource.",
          "title": "Copy"
        },
        {
          "text": "DELETE",
          "description": "The DELETE method deletes the specified resource.",
          "title": "Delete"
        },
        {
          "text": "GET",
          "description": "The GET method requests a representation of the specified resource. Requests using GET should only retrieve data.",
          "title": "Get"
        },
        {
          "text": "HEAD",
          "description": "The HEAD method asks for a response identical to a GET request, but without the response body.",
          "title": "Head"
        },
        {
          "text": "LABEL",
          "description": "The LABEL method adds, sets, or removes labels on a version-controlled resource.",
          "title": "Label"
        },
        {
          "text": "LINK",
          "description": "The LINK method establishes one or more links between resources.",
          "title": "Link"
        },
        {
          "text": "LOCK",
          "description": "The LOCK method acquires or refreshes a lock on the specified resource.",
          "title": "Lock"
        },
        {
          "text": "MERGE",
          "description": "The MERGE method merges changes from another resource into the specified resource.",
          "title": "Merge"
        },
        {
          "text": "MKACTIVITY",
          "description": "The MKACTIVITY method creates a new activity resource.",
          "title": "Make Activity"
        },
        {
          "text": "MKCALENDAR",
          "description": "The MKCALENDAR method creates a new calendar collection resource.",
          "title": "Make Calendar"
        },
        {
          "text": "MKCOL",
          "description": "The MKCOL method creates a new collection resource.",
          "title": "Make Collection"
        },
        {
          "text": "MKREDIRECTREF",
          "description": "The MKREDIRECTREF method creates a new redirect reference resource.",
          "title": "Make Redirect Reference"
        },
        {
          "text": "MKWORKSPACE",
          "description": "The MKWORKSPACE method creates a new workspace resource.",
          "title": "Make Workspace"
        },
        {
          "text": "MOVE",
          "description": "The MOVE method atomically duplicates and deletes the specified resource.",
          "title": "Move"
        },
        {
          "text": "OPTIONS",
          "description": "The OPTIONS method describes the communication options for the target resource.",
          "title": "Options"
        },
        {
          "text": "ORDERPATCH",
          "description": "The ORDERPATCH method changes the ordering of members in an ordered collection.",
          "title": "Order Patch"
        },
        {
          "text": "PATCH",
          "description": "The PATCH method applies partial modifications to a resource.",
          "title": "Patch"
        },
        {
          "text": "POST",
          "description": "The POST method submits an entity to the specified resource, often causing a change in state or side effects on the server.",
          "title": "Post"
        },
        {
          "text": "PRI",
          "description": "The PRI method appears in the HTTP/2 connection preface to confirm the protocol.",
          "title": "PRI"
        },
        {
          "text": "PROPFIND",
          "description": "The PROPFIND method retrieves properties defined on the specified resource.",
          "title": "Property Find"
        },
        {
          "text": "PROPPATCH",
          "description": "The PROPPATCH method sets and/or removes properties defined on the specified resource.",
          "title": "Property Patch"
        },
        {
          "text": "PUT",
          "description": "The PUT method replaces all current representations of the target resource with the request payload.",
          "title": "Put"
        },
        {
          "text": "QUERY",
          "description": "The QUERY method performs a safe query request that can include a request body.",
          "title": "Query"
        },
        {
          "text": "REBIND",
          "description": "The REBIND method moves a binding from one collection to another.",
          "title": "Rebind"
        },
        {
          "text": "REPORT",
          "description": "The REPORT method retrieves a report about the specified resource.",
          "title": "Report"
        },
        {
          "text": "SEARCH",
          "description": "The SEARCH method searches a resource or collection using the request payload.",
          "title": "Search"
        },
        {
          "text": "TRACE",
          "description": "The TRACE method performs a message loop-back test along the path to the target resource.",
          "title": "Trace"
        },
        {
          "text": "UNBIND",
          "description": "The UNBIND method removes a binding from the specified collection resource.",
          "title": "Unbind"
        },
        {
          "text": "UNCHECKOUT",
          "description": "The UNCHECKOUT method cancels a checkout and restores the resource to its previous state.",
          "title": "Un-Check Out"
        },
        {
          "text": "UNLINK",
          "description": "The UNLINK method removes one or more links between resources.",
          "title": "Unlink"
        },
        {
          "text": "UNLOCK",
          "description": "The UNLOCK method releases a lock on the specified resource.",
          "title": "Unlock"
        },
        {
          "text": "UPDATE",
          "description": "The UPDATE method updates a version-controlled resource to match a specified version.",
          "title": "Update"
        },
        {
          "text": "UPDATEREDIRECTREF",
          "description": "The UPDATEREDIRECTREF method changes the target of a redirect reference resource.",
          "title": "Update Redirect Reference"
        },
        {
          "text": "VERSION-CONTROL",
          "description": "The VERSION-CONTROL method places the specified resource under version control.",
          "title": "Version Control"
        }
      ]
    },
    {
      "name": "OcsfTlp",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfTlp",
      "description": "The values OCSF lists for tlp.",
      "title": "Traffic Light Protocol",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "permissible_values": [
        {
          "text": "AMBER",
          "description": "TLP:AMBER is for limited disclosure, recipients can only spread this on a need-to-know basis within their organization and its clients. Note that TLP:AMBER+STRICT restricts sharing to the organization only. Sources may use TLP:AMBER when information requires support to be effectively acted upon, yet carries risk to privacy, reputation, or operations if shared outside of the organizations involved. Recipients may share TLP:AMBER information with members of their own organization and its clients, but only on a need-to-know basis to protect their organization and its clients and prevent further harm. Note: if the source wants to restrict sharing to the organization only, they must specify TLP:AMBER+STRICT.",
          "title": "TLP:AMBER"
        },
        {
          "text": "AMBER STRICT",
          "description": "TLP:AMBER is for limited disclosure, recipients can only spread this on a need-to-know basis within their organization and its clients. Note that TLP:AMBER+STRICT restricts sharing to the organization only. Sources may use TLP:AMBER when information requires support to be effectively acted upon, yet carries risk to privacy, reputation, or operations if shared outside of the organizations involved. Recipients may share TLP:AMBER information with members of their own organization and its clients, but only on a need-to-know basis to protect their organization and its clients and prevent further harm. Note: if the source wants to restrict sharing to the organization only, they must specify TLP:AMBER+STRICT.",
          "title": "TLP:AMBER+STRICT"
        },
        {
          "text": "CLEAR",
          "description": "TLP:CLEAR denotes that recipients can spread this to the world, there is no limit on disclosure. Sources may use TLP:CLEAR when information carries minimal or no foreseeable risk of misuse, in accordance with applicable rules and procedures for public release. Subject to standard copyright rules, TLP:CLEAR information may be shared without restriction.",
          "title": "TLP:CLEAR"
        },
        {
          "text": "GREEN",
          "description": "TLP:GREEN is for limited disclosure, recipients can spread this within their community. Sources may use TLP:GREEN when information is useful to increase awareness within their wider community. Recipients may share TLP:GREEN information with peers and partner organizations within their community, but not via publicly accessible channels. TLP:GREEN information may not be shared outside of the community. Note: when \u201ccommunity\u201d is not defined, assume the cybersecurity/defense community.",
          "title": "TLP:GREEN"
        },
        {
          "text": "RED",
          "description": "TLP:RED is for the eyes and ears of individual recipients only, no further disclosure. Sources may use TLP:RED when information cannot be effectively acted upon without significant risk for the privacy, reputation, or operations of the organizations involved. Recipients may therefore not share TLP:RED information with anyone else. In the context of a meeting, for example, TLP:RED information is limited to those present at the meeting.",
          "title": "TLP:RED"
        },
        {
          "text": "WHITE",
          "description": "TLP:WHITE and TLP:CLEAR may be used interchangeably, TLP:WHITE is the most up to date (as of TLP 2.0) usage.",
          "title": "TLP:WHITE"
        }
      ]
    }
  ],
