    {
      "name": "OcsfAgent_name",
      "definition_uri": "https://w3id.org/lmodel/ocsf/name",
      "description": "The name of the agent or sensor. For example: <code>AWS SSM Agent</code>.",
      "title": "Agent Name",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/name"
      ],
