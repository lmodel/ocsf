      "usage_slot_name": "action",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSecurityControlProfile_action_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/action_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_profiles",
          "value": "security_control",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "action",
          "@type": "Annotation"
        }
      ],
      "description": "The action taken by a control or other policy-based system leading to an outcome or disposition. An unknown action may still correspond to a known disposition. Refer to <code>disposition_id</code> for the outcome of the action.",
      "title": "Action ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/action_id"
      ],
      "is_a": "action_id",
      "domain": "OcsfSecurityControlProfile",
      "slot_uri": "https://w3id.org/lmodel/ocsf/action_id",
      "alias": "action_id",
      "owner": "OcsfSecurityControlProfile",
      "domain_of": [
        "OcsfSecurityControlProfile"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "action_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The action was unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The activity was allowed.",
          "title": "Allowed",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The attempted activity was denied.",
          "title": "Denied",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The action was not mapped. See the <code>action</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfSecurityControlProfile_attacks",
