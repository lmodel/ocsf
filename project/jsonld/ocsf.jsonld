    {
      "name": "OcsfRoleManagement_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfRoleManagement",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfRoleManagement",
      "domain_of": [
        "OcsfRoleManagement"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Role Management: Unknown",
          "equals_number": 300800,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Create a role. Use <code>iam_role</code> as the role to be created.",
          "title": "Role Management: Create",
          "equals_number": 300801,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Update a role. The updated role details should be populated in the <code>updated_role</code> attribute.",
          "title": "Role Management: Update",
          "equals_number": 300802,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete a role. Use <code>iam_role</code> as the role to be deleted.",
          "title": "Role Management: Delete",
          "equals_number": 300803,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign privileges to a role. Use <code>privileges</code> to be assigned to <code>iam_role</code>.",
          "title": "Role Management: Assign Privileges",
          "equals_number": 300804,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove privileges from a role. Use <code>privileges</code> to be removed from <code>iam_role</code>.",
          "title": "Role Management: Remove Privileges",
          "equals_number": 300805,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign resources to a role. Use <code>resources</code> to be assigned to <code>iam_role</code>.",
          "title": "Role Management: Assign Resources",
          "equals_number": 300806,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove resources from a role. Use <code>resources</code> to be removed from <code>iam_role</code>.",
          "title": "Role Management: Remove Resources",
          "equals_number": 300807,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Attach one or more policies to a role. Use <code>policies</code> to be attached to <code>iam_role</code>.",
          "title": "Role Management: Attach Policies",
          "equals_number": 300808,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Detach one or more policies from a role. Use <code>policies</code> to be detached from <code>iam_role</code>.",
          "title": "Role Management: Detach Policies",
          "equals_number": 300809,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Add credentials to a role. Use <code>programmatic_credentials</code> to be added to <code>iam_role</code>.",
          "title": "Role Management: Add Programmatic Credentials",
          "equals_number": 300810,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove credentials from a role. Use <code>programmatic_credentials</code> to be removed from <code>iam_role</code>.",
          "title": "Role Management: Remove Programmatic Credentials",
          "equals_number": 300811,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Role Management: Other",
          "equals_number": 300899,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfRoleManagement_updated_role",
      "definition_uri": "https://w3id.org/lmodel/ocsf/updated_role",
