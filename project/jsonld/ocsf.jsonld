      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "security_control",
          "@type": "Annotation"
        }
      ],
      "description": "Describes details about the scan job that identified malware on the target system.",
      "title": "Malware Scan Info",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/malware_scan_info"
      ],
