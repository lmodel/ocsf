      "owner": "OcsfDroneFlightsActivity",
      "domain_of": [
        "OcsfDroneFlightsActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "required": true,
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remote ID information from an Unmanned System is being captured (collected).",
          "title": "Capture",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Unmanned System activity is being recorded.",
          "title": "Record",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
