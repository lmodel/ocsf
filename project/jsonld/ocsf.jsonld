    },
    {
      "name": "OcsfGpuInfo_vram_mode_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/vram_mode_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "vram_mode",
