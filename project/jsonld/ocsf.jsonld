      "alias": "accessors",
      "owner": "OcsfAccessAnalysisResult",
      "domain_of": [
        "OcsfAccessAnalysisResult"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "accessors",
      "range": "OcsfUser",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfAccessAnalysisResult_additional_restrictions",
      "definition_uri": "https://w3id.org/lmodel/ocsf/additional_restrictions",
      "description": "Details about supplementary restrictions and guardrails that may limit the granted access, applied through additional policy types such as Resource Control Policies (RCPs) and Service Control Policies (SCPs) in AWS, or other policy constraints.",
      "title": "Additional Restrictions",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
