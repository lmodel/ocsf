      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "impact_score",
      "range": "ocsf_integer_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDataSecurityFinding_is_alert",
      "definition_uri": "https://w3id.org/lmodel/ocsf/is_alert",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "Indicates that the event is considered to be an alertable signal. For example, an <code>activity_id</code> of 'Create' could constitute an alertable signal and the value would be <code>true</code>, while 'Close' likely would not and either omit the attribute or set its value to <code>false</code>.  Note that other events with the <code>security_control</code> profile may also be deemed alertable signals and may also carry <code>is_alert = true</code> attributes.",
      "title": "Alert",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/is_alert"
      ],
      "is_a": "OcsfBaseEvent_is_alert",
      "domain": "OcsfDataSecurityFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/is_alert",
      "alias": "is_alert",
      "owner": "OcsfDataSecurityFinding",
      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "is_alert",
      "range": "ocsf_boolean_t",
      "recommended": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDataSecurityFinding_resources",
      "definition_uri": "https://w3id.org/lmodel/ocsf/resources",
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        }
      ],
      "description": "Describes details about additional resources, where classified or sensitive data is stored in, or was accessed from. <p> You can populate this object, if the specific resource type objects available in the class (<code>database, databucket, table, file</code>) aren't sufficient; OR <br> You can also choose to duplicate <code>uid, name</code> of the specific resources objects, for a consistent access to resource uids across all findings.",
      "title": "Additional Resources",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/resources"
      ],
      "is_a": "OcsfFindingEvent_resources",
      "domain": "OcsfDataSecurityFinding",
      "slot_uri": "https://w3id.org/lmodel/ocsf/resources",
      "alias": "resources",
      "owner": "OcsfDataSecurityFinding",
      "domain_of": [
        "OcsfDataSecurityFinding"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "resources",
      "range": "OcsfResourceDetails",
      "recommended": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
