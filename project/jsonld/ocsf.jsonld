        "OcsfAccessAnalysisResult_accessors",
        "OcsfAccessAnalysisResult_additional_restrictions",
        "OcsfAccessAnalysisResult_condition_keys",
        "OcsfAccessAnalysisResult_granted_privileges"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ocsf/OcsfAccessAnalysisResult",
      "@type": "ClassDefinition"
    },
    {
      "name": "OcsfAccount",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfAccount",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "account",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_constraints",
          "value": "{\"at_least_one\": [\"name\", \"uid\"]}",
          "@type": "Annotation"
        }
      ],
      "description": "The Account object contains details about the account that initiated or performed a specific activity within a system or application. Additionally, the Account object refers to logical Cloud and Software-as-a-Service (SaaS) based containers such as AWS Accounts, Azure Subscriptions, Oracle Cloud Compartments, Google Cloud Projects, and otherwise.",
      "title": "Account",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_objects",
      "see_also": [
        "https://d3fend.mitre.org/dao/artifact/d3f:UserAccount/",
        "https://d3fend.mitre.org/dao/artifact/d3f:CloudUserAccount/"
      ],
      "exact_mappings": [
        "ocsf:OcsfAccount"
      ],
      "related_mappings": [
        "d3f:CloudUserAccount",
        "d3f:UserAccount"
      ],
      "is_a": "OcsfEntity",
      "slots": [
        "OcsfEntity_uid_numeric",
        "OcsfAccount_is_disabled",
        "OcsfAccount_is_locked",
        "is_on_premises_sync_enabled",
        "OcsfAccount_labels",
        "OcsfAccount_tags",
        "OcsfAccount_type",
        "OcsfAccount_type_id",
        "OcsfAccount_name",
        "OcsfAccount_uid"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/ocsf/OcsfAccount",
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "name",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "uid",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "OcsfActor",
      "definition_uri": "https://w3id.org/lmodel/ocsf/OcsfActor",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_key",
          "value": "actor",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_profiles",
          "value": "cloud container data_classification linux/linux_users macos/macos_users",
          "@type": "Annotation"
        },
        {
