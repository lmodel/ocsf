      ],
      "is_usage_slot": true,
      "usage_slot_name": "status_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The status is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The operational status is not reported.",
          "title": "Undeclared",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Unmanned Aerial System (UAS) is grounded.",
          "title": "Ground",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Unmanned Aerial System (UAS) is airborne.",
          "title": "Airborne",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Unmanned Aerial System (UAS) is reporting an emergency status.",
          "title": "Emergency",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Unmanned Aerial System (UAS) is reporting the Remote ID beacon or device is malfunctioning or has failed.",
          "title": "Remote ID System Failure",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An ASTM Reserved status is reported.",
          "title": "Reserved",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The status is not mapped. See the <code>status</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
