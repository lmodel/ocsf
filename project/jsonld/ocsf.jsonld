    {
      "name": "OcsfGroupManagement_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfGroupManagement",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfGroupManagement",
      "domain_of": [
        "OcsfGroupManagement"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "Group Management: Unknown",
          "equals_number": 300600,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign privileges to the group. Use <code>privileges</code> as privileges to be assigned.",
          "title": "Group Management: Assign Privileges",
          "equals_number": 300601,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Revoke privileges from the group. Use <code>privileges</code> as privileges to be revoked.",
          "title": "Group Management: Revoke Privileges",
          "equals_number": 300602,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Add a user or users to the group. Use <code>users</code> for the users to be added.",
          "title": "Group Management: Add User",
          "equals_number": 300603,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove a user or users from the group. Use <code>users</code> for the users to be removed.",
          "title": "Group Management: Remove User",
          "equals_number": 300604,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete the group.",
          "title": "Group Management: Delete",
          "equals_number": 300605,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Create a group. Populate the <code>group</code> object with details of the group to be created.",
          "title": "Group Management: Create",
          "equals_number": 300606,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Add a subgroup to the group. Use <code>sub_group</code> as the subgroup to be added.",
          "title": "Group Management: Add Subgroup",
          "equals_number": 300607,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove a subgroup from the group. Use <code>sub_group</code> as the subgroup to be removed.",
          "title": "Group Management: Remove Subgroup",
          "equals_number": 300608,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Update the group. The updated group details should be populated in the <code>updated_group</code> attribute.",
          "title": "Group Management: Update",
          "equals_number": 300609,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Attach one or more IAM Policies to the group. Use <code>policies</code> as policies to be attached.",
          "title": "Group Management: Attach Policies",
          "equals_number": 300610,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Detach one or more IAM Policies from the group. Use <code>policies</code> as policies to be detached.",
          "title": "Group Management: Detach Policies",
          "equals_number": 300611,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Assign one or more roles to the group. Use <code>iam_roles</code> for the specific roles to be assigned.",
          "title": "Group Management: Assign Roles",
          "equals_number": 300612,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Remove one or more roles from the group. Use <code>iam_roles</code> for the specific roles to be removed.",
          "title": "Group Management: Remove Roles",
          "equals_number": 300613,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Group Management: Other",
          "equals_number": 300699,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
