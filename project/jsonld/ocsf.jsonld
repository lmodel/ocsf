    {
      "name": "account_switch_type_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/account_switch_type_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "account_switch_type",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the account switch method.",
      "title": "Account Switch Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/account_switch_type_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/account_switch_type_id",
      "owner": "OcsfAuthentication",
      "domain_of": [
        "OcsfAuthentication"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The account switch type is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A utility like <code>sudo</code>, <code>su</code>, or equivalent was used to perform actions in the context of another user.",
          "title": "Substitute User",
          "see_also": [
            "https://www.sudo.ws/",
            "https://man7.org/linux/man-pages/man1/su.1.html",
            "https://www.unix.com/man_page/osx/1/su/"
          ],
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An API like <code>ImpersonateLoggedOnUser()</code> or equivalent was used to perform actions in the context of another user.",
          "title": "Impersonate",
          "see_also": [
            "https://learn.microsoft.com/en-us/windows/win32/api/securitybaseapi/nf-securitybaseapi-impersonateloggedonuser"
          ],
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The account switch type is not mapped. See the <code>account_switch_type</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
