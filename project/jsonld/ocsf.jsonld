        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "class_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The unique identifier of a class. A class describes the attributes available in an event. Producers and mappers must set this to the <code>uid</code> defined in the event class definition. For example, <code>Detection Finding</code> is <code>2004</code>.",
      "title": "Class ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/class_uid"
      ],
      "is_a": "OcsfBaseEvent_class_uid",
