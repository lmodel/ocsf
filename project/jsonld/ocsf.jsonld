    {
      "name": "OcsfDnsActivity_flag_ids",
      "definition_uri": "https://w3id.org/lmodel/ocsf/flag_ids",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_group",
          "value": "primary",
          "@type": "Annotation"
        },
        {
          "tag": "ocsf_sibling",
          "value": "flags",
          "@type": "Annotation"
        }
      ],
      "description": "The list of DNS message header flag IDs. For Query events, populated from the query header (RD, CD). For Response and Traffic events, populated from the response header, which is the complete and authoritative source as it echoes all client-set flags and adds server-set flags.",
      "title": "DNS Header Flags",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/flag_ids"
      ],
      "is_a": "flag_ids",
      "domain": "OcsfDnsActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/flag_ids",
      "alias": "flag_ids",
      "owner": "OcsfDnsActivity",
      "domain_of": [
        "OcsfDnsActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "flag_ids",
      "range": "ocsf_integer_t",
      "recommended": true,
      "multivalued": true,
      "any_of": [
        {
          "description": "The flag is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The responding server is authoritative for the domain. Set by the server in responses only.",
          "title": "Authoritative Answer",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The response was truncated because it exceeded the maximum UDP message size.",
          "title": "Truncated Response",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The client requests that the server perform recursive resolution. Set by the client and echoed in the response.",
          "title": "Recursion Desired",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The server supports recursive resolution. Set by the server in responses.",
          "title": "Recursion Available",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "All data in the response has been cryptographically verified (DNSSEC). Set by the server.",
          "title": "Authentic Data",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The client requests that the server disable DNSSEC validation. Set by the client and echoed in the response.",
          "title": "Checking Disabled",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The flag is not mapped. See the <code>flags</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
