      "domain_of": [
        "OcsfGpuInfo"
      ],
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "vram_mode_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/vram_mode_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": [
        {
          "tag": "ocsf_sibling",
          "value": "vram_mode",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the video memory attachment mode.",
      "title": "VRAM Mode ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/vram_mode_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/ocsf/vram_mode_id",
      "owner": "OcsfGpuInfo",
      "domain_of": [
        "OcsfGpuInfo"
      ],
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The VRAM mode is unknown or not reported.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Video memory is allocated from system memory.",
          "title": "Shared",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Video memory is physically separate from system memory.",
          "title": "Dedicated",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "A VRAM mode not covered by the defined values; the exact value is reported by the event source.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
