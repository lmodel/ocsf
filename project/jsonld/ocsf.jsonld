    {
      "name": "OcsfFtpActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "OcsfBaseEvent_type_uid",
      "domain": "OcsfFtpActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfFtpActivity",
      "domain_of": [
        "OcsfFtpActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "required": true,
      "any_of": [
        {
          "title": "FTP Activity: Unknown",
          "equals_number": 400800,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "File upload to the FTP or SFTP site.",
          "title": "FTP Activity: Put",
          "equals_number": 400801,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "File download from the FTP or SFTP site.",
          "title": "FTP Activity: Get",
          "equals_number": 400802,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Poll directory for specific file(s) or folder(s) at the FTP or SFTP site location.",
          "title": "FTP Activity: Poll",
          "equals_number": 400803,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Delete file(s) from the FTP or SFTP site.",
          "title": "FTP Activity: Delete",
          "equals_number": 400804,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Rename the file(s) in the FTP or SFTP site.",
          "title": "FTP Activity: Rename",
          "equals_number": 400805,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "List files in a specified directory.",
          "title": "FTP Activity: List",
          "equals_number": 400806,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "FTP Activity: Other",
          "equals_number": 400899,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfHttpActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "see_also": [
        "https://www.iana.org/assignments/http-methods/http-methods.xhtml"
      ],
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
