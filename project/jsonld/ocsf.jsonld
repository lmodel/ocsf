        },
        {
          "tag": "ocsf_sibling",
          "value": "injection_type",
          "@type": "Annotation"
        }
      ],
      "description": "The normalized identifier of the process injection method.",
      "title": "Injection Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/injection_type_id"
      ],
      "is_a": "injection_type_id",
