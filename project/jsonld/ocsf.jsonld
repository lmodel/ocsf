      ],
      "is_usage_slot": true,
      "usage_slot_name": "role",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfResourceDetails_role_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/role_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "role",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the resource's role in the context of the event or finding.",
      "title": "Role ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/role_id"
      ],
      "is_a": "role_id",
      "domain": "OcsfResourceDetails",
      "slot_uri": "https://w3id.org/lmodel/ocsf/role_id",
      "alias": "role_id",
      "owner": "OcsfResourceDetails",
      "domain_of": [
        "OcsfResourceDetails"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "role_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "description": "The role is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The resource is the primary target or subject of the event/finding.",
          "title": "Target",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The resource is acting as the initiator or performer in the context of the event/finding.",
          "title": "Actor",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The resource was impacted or affected by the event/finding.",
          "title": "Affected",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The resource is related to or associated with the event/finding.",
          "title": "Related",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The role is not mapped. See the role attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
