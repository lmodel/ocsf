    {
      "name": "OcsfScanActivity_type_uid",
      "definition_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "type_name",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>.",
      "title": "Type ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/type_uid"
      ],
      "is_a": "type_uid",
      "domain": "OcsfScanActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/type_uid",
      "alias": "type_uid",
      "owner": "OcsfScanActivity",
      "domain_of": [
        "OcsfScanActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "type_uid",
      "range": "ocsf_long_t",
      "any_of": [
        {
          "title": "Scan Activity: Unknown",
          "equals_number": 600700,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan was started.",
          "title": "Scan Activity: Started",
          "equals_number": 600701,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan was completed.",
          "title": "Scan Activity: Completed",
          "equals_number": 600702,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan was cancelled.",
          "title": "Scan Activity: Cancelled",
          "equals_number": 600703,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The allocated scan time was insufficient to complete the requested scan.",
          "title": "Scan Activity: Duration Violation",
          "equals_number": 600704,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan was paused, either by the user or by program constraints (e.g. scans that are suspended during certain time intervals), and not resumed within the allotted time.",
          "title": "Scan Activity: Pause Violation",
          "equals_number": 600705,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan could not be completed due to an internal error.",
          "title": "Scan Activity: Error",
          "equals_number": 600706,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan was paused.",
          "title": "Scan Activity: Paused",
          "equals_number": 600707,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan was resumed from the pause point.",
          "title": "Scan Activity: Resumed",
          "equals_number": 600708,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The scan restarted from the beginning of the file enumeration.",
          "title": "Scan Activity: Restarted",
          "equals_number": 600709,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The user delayed the scan.",
          "title": "Scan Activity: Delayed",
          "equals_number": 600710,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Scan Activity: Other",
          "equals_number": 600799,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfWebResourceAccessActivity_activity_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "activity_name",
          "extensions": {},
          "annotations": {}
        },
        "ocsf_suppress_checks": {
          "tag": "ocsf_suppress_checks",
          "value": "sibling_convention",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label.",
      "title": "Activity ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/activity_id"
      ],
      "is_a": "activity_id",
      "domain": "OcsfWebResourceAccessActivity",
      "slot_uri": "https://w3id.org/lmodel/ocsf/activity_id",
      "alias": "activity_id",
      "owner": "OcsfWebResourceAccessActivity",
      "domain_of": [
        "OcsfWebResourceAccessActivity"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "activity_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The event activity is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incoming request has permission to the web resource.",
          "title": "Access Grant",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incoming request does not have permission to the web resource.",
          "title": "Access Deny",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The incoming request's access has been revoked due to security policy enforcements.",
          "title": "Access Revoke",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "An error occurred during processing the request.",
          "title": "Access Error",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The event activity is not mapped. See the <code>activity_name</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
