    {
      "name": "OcsfDigitalSignature_serialization",
      "definition_uri": "https://w3id.org/lmodel/ocsf/serialization",
      "description": "The canonical serialization or signing-envelope scheme used to produce the deterministic byte sequence that was signed, normalized to the caption of <code>serialization_id</code>. In the case of <code>Other</code>, it is defined by the event source.",
      "title": "Serialization",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/serialization"
      ],
      "is_a": "serialization",
      "domain": "OcsfDigitalSignature",
      "slot_uri": "https://w3id.org/lmodel/ocsf/serialization",
      "alias": "serialization",
      "owner": "OcsfDigitalSignature",
      "domain_of": [
        "OcsfDigitalSignature"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "serialization",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDigitalSignature_serialization_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/serialization_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "serialization",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The identifier of the normalized canonical serialization or signing-envelope scheme used to produce the deterministic byte sequence that was signed. A verifier must apply the same scheme to reproduce the signing input. Use <code>Flat</code> where the signed data is an opaque byte sequence, such as file content, to which no canonical serialization was applied. Distinct from <code>algorithm_id</code>, which identifies how the resulting bytes were signed; some signing formats (e.g. <code>Authenticode</code>) define their own canonicalization and populate both fields.",
      "title": "Serialization ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/serialization_id"
      ],
      "is_a": "serialization_id",
      "domain": "OcsfDigitalSignature",
      "slot_uri": "https://w3id.org/lmodel/ocsf/serialization_id",
      "alias": "serialization_id",
      "owner": "OcsfDigitalSignature",
      "domain_of": [
        "OcsfDigitalSignature"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "serialization_id",
      "range": "ocsf_integer_t",
      "recommended": true,
      "any_of": [
        {
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "No canonical serialization or signing envelope was applied; the signature is computed over the data's raw byte sequence, such as the content of a disk file or any other opaque byte stream.",
          "title": "Flat",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "JSON Canonicalization Scheme - deterministic JSON serialization of the structured data prior to signing.",
          "title": "JCS",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc8785"
          ],
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "JSON Web Signature - the JWS Signing Input, i.e. BASE64URL(protected header) '.' BASE64URL(payload).",
          "title": "JWS",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc7515"
          ],
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "CBOR Object Signing and Encryption - the CBOR Sig_structure used as the binary signing input.",
          "title": "COSE",
          "see_also": [
            "https://www.rfc-editor.org/rfc/rfc9052"
          ],
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "Dead Simple Signing Envelope - the PAE (Pre-Authentication Encoding) canonical signing input. Note: DSSE is a signing-envelope scheme, not a hash algorithm; any payload hash is carried separately in the fingerprint object.",
          "title": "DSSE",
          "see_also": [
            "https://github.com/secure-systems-lab/dsse"
          ],
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Portable Executable (PE) Image Hash procedure that canonicalizes the PE structure into the byte sequence fed to the digest, excluding specified header fields and digesting sections in a defined order. Authenticode bundles canonicalization and signing format: when used, <code>algorithm_id</code> is also set to the <code>Authenticode</code> enum value.",
          "title": "Authenticode",
          "see_also": [
            "https://download.microsoft.com/download/9/c/5/9c5b2167-8017-4bae-9fde-d599bac8184a/Authenticode_PE.docx"
          ],
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The procedure that describes how hashes of code and other structures form the Code Directory message that is signed. When used, <code>algorithm_id</code> is also set to the <code>Code Signing</code> enum value.",
          "title": "Code Signing",
          "see_also": [
            "https://developer.apple.com/documentation/technotes/tn3126-inside-code-signing-hashes"
          ],
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The Windows Application Package signing procedure that describes how file hashes are stored in the manifest, and how that manifest is signed.",
          "title": "App Package",
          "see_also": [
            "https://learn.microsoft.com/en-us/windows/msix/package/signing-package-overview"
          ],
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDigitalSignature_state",
      "definition_uri": "https://w3id.org/lmodel/ocsf/state",
      "description": "The digital signature state defines the signature state, normalized to the caption of 'state_id'. In the case of 'Other', it is defined by the event source.",
      "title": "State",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/state"
      ],
      "is_a": "state",
      "domain": "OcsfDigitalSignature",
      "slot_uri": "https://w3id.org/lmodel/ocsf/state",
      "alias": "state",
      "owner": "OcsfDigitalSignature",
      "domain_of": [
        "OcsfDigitalSignature"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "state",
      "range": "ocsf_string_t",
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDigitalSignature_state_id",
      "definition_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "instantiates": [
        "ocsf:OcsfFacts"
      ],
      "annotations": {
        "ocsf_sibling": {
          "tag": "ocsf_sibling",
          "value": "state",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The normalized identifier of the signature state.",
      "title": "State ID",
      "from_schema": "https://w3id.org/lmodel/ocsf/ocsf_core",
      "mappings": [
        "https://w3id.org/lmodel/ocsf/state_id"
      ],
      "is_a": "state_id",
      "domain": "OcsfDigitalSignature",
      "slot_uri": "https://w3id.org/lmodel/ocsf/state_id",
      "alias": "state_id",
      "owner": "OcsfDigitalSignature",
      "domain_of": [
        "OcsfDigitalSignature"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "state_id",
      "range": "ocsf_integer_t",
      "any_of": [
        {
          "description": "The state is unknown.",
          "title": "Unknown",
          "equals_number": 0,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is valid.",
          "title": "Valid",
          "equals_number": 1,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is invalid because its timestamp does not fall within the certificate's validity period.",
          "title": "Expired",
          "equals_number": 2,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is invalid due to certificate revocation.",
          "title": "Revoked",
          "equals_number": 3,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is invalid due to certificate suspension.",
          "title": "Suspended",
          "equals_number": 4,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature state is pending.",
          "title": "Pending",
          "equals_number": 5,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is invalid because the certificate is rooted in an untrusted CA or is an untrusted self-signed certificate.",
          "title": "Untrusted",
          "equals_number": 6,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is invalid because the certificate is explicitly distrusted. Note that whereas revocation is global, distrust reflects local IT/security policy.",
          "title": "Distrusted",
          "equals_number": 7,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is invalid because the certificate is not intended for code signing purposes.",
          "title": "WrongUsage",
          "equals_number": 8,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is cryptographically invalid, e.g. a mismatched digest. This indicates possible tampering.",
          "title": "Bad",
          "equals_number": 9,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The digital signature is malformed and could not be processed.",
          "title": "Broken",
          "equals_number": 10,
          "@type": "AnonymousSlotExpression"
        },
        {
          "description": "The state is not mapped. See the <code>state</code> attribute, which contains a data source specific value.",
          "title": "Other",
          "equals_number": 99,
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "OcsfDiscoveryDetails_count",
      "definition_uri": "https://w3id.org/lmodel/ocsf/count",
