ocsf:OcsfScim a sh:NodeShape ;
	rdfs:comment "The System for Cross-domain Identity Management (SCIM) Configuration object provides a structured set of attributes related to SCIM protocols used for identity provisioning and management across cloud-based platforms. It standardizes user and group provisioning details, enabling identity synchronization and lifecycle management with compatible Identity Providers (IdPs) and applications. SCIM is defined in RFC 7634." ;
	rdfs:label "SCIM" ;
	sh:closed true ;
