_:c14n5759 sh:datatype xsd:integer ;
	sh:description "The number of minutes that the reported event <code>time</code> is ahead or behind UTC, in the range -1,080 to +1,080. This allows consumers to reconstruct the local time at the event source. For example, US Eastern Standard Time is <code>-300</code>. Populate this when the source provides local time zone information." ;
	sh:maxCount 1 ;
	sh:name "Timezone Offset" ;
