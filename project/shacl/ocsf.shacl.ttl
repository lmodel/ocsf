	sh:targetClass ocsf:OcsfIamRole .
ocsf:OcsfIdentityActivityMetrics a sh:NodeShape ;
	rdfs:comment "The Identity Activity Metrics object captures usage patterns, authentication activity, credential usage and other metrics for identities across cloud and on-premises environments. Example identities include AWS IAM Users, Roles, Azure AD Principals, GCP Service Accounts, on-premises Active Directory accounts." ;
	rdfs:label "Identity Activity Metrics" ;
	sh:closed true ;
