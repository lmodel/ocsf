_:c14n1996 sh:datatype xsd:string ;
	sh:description "The start timestamp of the trace, essential for identifying latency and performance bottlenecks. Like the end time, this timestamp is normalized across the trace system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time enables accurate trace duration calculations and helps observability tools track performance across services, regardless of the individual system time settings." ;
	sh:maxCount 1 ;
	sh:name "Start Time" ;
	sh:nodeKind sh:Literal ;
	sh:order 7 ;
	sh:path ocsf:start_time_dt ;
	sh:pattern "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?([Zz]|[\\+-]\\d{2}:\\d{2})?$" .
