	sh:description "The URL object that pertains to the event or object associated to the activity that triggered the detection." ;
	sh:maxCount 1 ;
	sh:name "URL" ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 24 ;
	sh:path ocsf:url .
_:c14n4211 sh:class ocsf:OcsfDevice ;
