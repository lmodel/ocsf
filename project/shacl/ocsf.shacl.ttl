	sh:targetClass ocsf:OcsfAircraft .
ocsf:OcsfAnalysisTarget a sh:NodeShape ;
	rdfs:comment "The analysis target defines the scope of monitored activities, specifying what entity, system or process is analyzed for activity patterns." ;
	rdfs:label "Analysis Target" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4069 ;
	sh:property _:c14n5837 , _:c14n7250 ;
	sh:targetClass ocsf:OcsfAnalysisTarget .
ocsf:OcsfAnalytic a sh:NodeShape ;
	rdfs:comment "The Analytic object contains details about the analytic technique used to analyze and derive insights from the data or information that led to the creation of a finding or conclusion." ;
	rdfs:label "Analytic" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n6879 ;
	sh:property _:c14n1075 , _:c14n1275 , _:c14n1357 , _:c14n1819 , _:c14n193 , _:c14n2550 , _:c14n2654 , _:c14n4061 , _:c14n5429 , _:c14n6781 , _:c14n8033 , _:c14n8550 , _:c14n8997 ;
	sh:targetClass ocsf:OcsfAnalytic .
ocsf:OcsfAnomaly a sh:NodeShape ;
	rdfs:comment "Describes an anomaly or deviation detected in a system. Anomalies are unexpected activity patterns that could indicate potential issues needing attention." ;
	rdfs:label "Anomaly" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n1453 ;
	sh:property _:c14n1348 , _:c14n1412 , _:c14n2533 , _:c14n511 ;
	sh:targetClass ocsf:OcsfAnomaly .
ocsf:OcsfAnomalyAnalysis a sh:NodeShape ;
	rdfs:comment "Describes the analysis of activity patterns and anomalies of target entities to identify potential security threats, performance issues, or other deviations from established baselines. This includes monitoring and analyzing user interactions, API usage, resource utilization, access patterns and other measured indicators." ;
	rdfs:label "Anomaly Analysis" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4235 ;
	sh:property _:c14n5485 , _:c14n7159 , _:c14n7516 ;
	sh:targetClass ocsf:OcsfAnomalyAnalysis .
ocsf:OcsfApi a sh:NodeShape ;
	rdfs:comment "The API, or Application Programming Interface, object represents  information pertaining to an API request and response." ;
	rdfs:label "API" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4500 ;
