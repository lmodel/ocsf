_:c14n133 sh:class ocsf:OcsfMetadata ;
	sh:description "The metadata object describes the event producer, schema version, and processing information. Producers and mappers <b>must</b> populate <code>metadata.product</code> to identify the data source, and <code>metadata.version</code> to indicate the OCSF schema version used. Consumers rely on this to interpret the event correctly." ;
	sh:maxCount 1 ;
