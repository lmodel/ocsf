ocsf:OcsfUserInventory a sh:NodeShape ;
	rdfs:comment "User Inventory Info events report user inventory data that is either logged or proactively collected. For example, when collecting user information from Active Directory entries." ;
	rdfs:label "User Inventory Info" ;
	sh:closed true ;
