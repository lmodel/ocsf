	sh:targetClass ocsf:OcsfAssessment .
ocsf:OcsfAttack a sh:NodeShape ;
	rdfs:comment "The Attack object describes the tactic, technique, sub-technique & mitigation associated to an attack." ;
	rdfs:label "Attack Tactics & Techniques" ;
	sh:closed true ;
