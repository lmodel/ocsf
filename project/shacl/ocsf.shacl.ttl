_:c14n8423 sh:datatype xsd:integer ;
	sh:description "The end timestamp of the trace, essential for identifying latency and performance bottlenecks. Like the start time, this timestamp is normalized across the trace system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time allows for accurate trace duration calculations and helps observability tools track overall performance across services, regardless of the individual system time settings." ;
	sh:maxCount 1 ;
	sh:name "End Time" ;
	sh:nodeKind sh:Literal ;
	sh:order 1 ;
