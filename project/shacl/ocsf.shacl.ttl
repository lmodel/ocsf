linkml:Any a sh:NodeShape ;
	rdfs:comment "An unordered collection of attributes. It defines a set of attributes available in all objects. It can be also used as a generic object to log objects that are not otherwise defined by the schema." , "Embedded JSON value. A value can be a string, or a number, or true or false or null, or an object or an array. These structures can be nested." ;
	rdfs:label "JSON" , "Object" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n28068 , _:c14n28069 ;
	sh:targetClass linkml:Any .
ocsf:OcsfAccessAnalysisResult a sh:NodeShape ;
	rdfs:comment "The Access Analysis Result object describes access relationships and pathways between identities, resources, focusing on who can access what and through which mechanisms. This evaluates access levels (read/write/admin), access types (direct, cross-account, public, federated), and the conditions under which access is granted. Use this for resource-centric security assessments such as external access discovery, public exposure analysis, etc." ;
	rdfs:label "Access Analysis Result" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n5743 ;
	sh:property _:c14n1760 , _:c14n3041 , _:c14n4809 , _:c14n5955 , _:c14n7114 , _:c14n7199 ;
	sh:targetClass ocsf:OcsfAccessAnalysisResult .
ocsf:OcsfAccount a sh:NodeShape ;
	rdfs:comment "The Account object contains details about the account that initiated or performed a specific activity within a system or application. Additionally, the Account object refers to logical Cloud and Software-as-a-Service (SaaS) based containers such as AWS Accounts, Azure Subscriptions, Oracle Cloud Compartments, Google Cloud Projects, and otherwise." ;
	rdfs:label "Account" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n479 ;
	sh:property _:c14n1114 , _:c14n1454 , _:c14n1479 , _:c14n1677 , _:c14n6564 , _:c14n677 , _:c14n7039 , _:c14n7342 , _:c14n8171 , _:c14n8265 ;
	sh:targetClass ocsf:OcsfAccount .
ocsf:OcsfAccountChange a sh:NodeShape ;
	rdfs:comment "Account Change events report when specific user account management tasks are performed, such as a user/role being created or role assigned, changed, deleted, renamed, disabled, enabled, locked out or unlocked." ;
	rdfs:label "Account Change" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n8241 ;
	sh:property _:c14n1127 , _:c14n1367 , _:c14n1442 , _:c14n1635 , _:c14n1729 , _:c14n1982 , _:c14n2208 , _:c14n2216 , _:c14n2264 , _:c14n2285 , _:c14n2335 , _:c14n2514 , _:c14n2549 , _:c14n2955 , _:c14n3003 , _:c14n3068 , _:c14n3079 , _:c14n3155 , _:c14n3374 , _:c14n3398 , _:c14n3568 , _:c14n3603 , _:c14n3848 , _:c14n3868 , _:c14n3878 , _:c14n3880 , _:c14n3983 , _:c14n3999 , _:c14n4010 , _:c14n4195 , _:c14n4653 , _:c14n4993 , _:c14n50 , _:c14n5073 , _:c14n5419 , _:c14n5697 , _:c14n6190 , _:c14n6358 , _:c14n656 , _:c14n6680 , _:c14n6935 , _:c14n7169 , _:c14n7243 , _:c14n7276 , _:c14n7394 , _:c14n7408 , _:c14n7535 , _:c14n7629 , _:c14n7799 , _:c14n7820 , _:c14n8121 , _:c14n8292 , _:c14n830 , _:c14n8316 , _:c14n8342 , _:c14n8480 , _:c14n8815 , _:c14n8862 , _:c14n8901 , _:c14n8963 , _:c14n8964 , _:c14n8995 , _:c14n9208 , _:c14n9269 , _:c14n939 , _:c14n959 ;
	sh:targetClass ocsf:OcsfAccountChange .
ocsf:OcsfActor a sh:NodeShape ;
	rdfs:comment "The Actor object contains details about the user, role, application, service, or process that initiated or performed a specific activity. Note that Actor is not the threat actor of a campaign but may be part of a campaign. When the initiator of the activity is an autonomous AI agent, apply the <code>ai_operation</code> profile and populate <code>ai_operation.ai_agent</code> rather than describing the agent here." ;
	rdfs:label "Actor" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n9049 ;
	sh:property _:c14n1149 , _:c14n168 , _:c14n3697 , _:c14n5690 , _:c14n5885 , _:c14n5983 , _:c14n6175 , _:c14n8847 , _:c14n8899 , _:c14n8903 ;
	sh:targetClass ocsf:OcsfActor .
ocsf:OcsfAdditionalRestriction a sh:NodeShape ;
	rdfs:comment "The Additional Restriction object describes supplementary access controls and guardrails that constrain or limit granted permissions beyond the primary policy. These restrictions are typically applied through hierarchical policy frameworks, organizational controls, or conditional access mechanisms. Examples include AWS Service Control Policies (SCPs), Resource Control Policies (RCPs), Azure Management Group policies, GCP Organization policies, conditional access policies, IP restrictions, time-based constraints, and MFA requirements." ;
	rdfs:label "Additional Restriction" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n7622 ;
	sh:property _:c14n1615 , _:c14n6409 , _:c14n6969 ;
	sh:targetClass ocsf:OcsfAdditionalRestriction .
ocsf:OcsfAdminGroupQuery a sh:NodeShape ;
	rdfs:comment "Admin Group Query events report information about administrative groups." ;
	rdfs:label "Admin Group Query" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n247 ;
	sh:property _:c14n1011 , _:c14n1031 , _:c14n1314 , _:c14n1376 , _:c14n1429 , _:c14n1762 , _:c14n1893 , _:c14n2017 , _:c14n2360 , _:c14n2387 , _:c14n2513 , _:c14n2579 , _:c14n2727 , _:c14n2887 , _:c14n2917 , _:c14n3037 , _:c14n339 , _:c14n4132 , _:c14n4160 , _:c14n4204 , _:c14n4365 , _:c14n4401 , _:c14n4458 , _:c14n4532 , _:c14n4726 , _:c14n4816 , _:c14n4854 , _:c14n4886 , _:c14n5061 , _:c14n5174 , _:c14n5204 , _:c14n5311 , _:c14n5332 , _:c14n5342 , _:c14n5374 , _:c14n5653 , _:c14n5713 , _:c14n5934 , _:c14n603 , _:c14n6212 , _:c14n6614 , _:c14n6685 , _:c14n6754 , _:c14n7026 , _:c14n7068 , _:c14n7478 , _:c14n7547 , _:c14n7633 , _:c14n7762 , _:c14n7835 , _:c14n7906 , _:c14n7948 , _:c14n8022 , _:c14n8166 , _:c14n8396 , _:c14n8708 , _:c14n8746 , _:c14n8918 , _:c14n9087 , _:c14n986 ;
	sh:targetClass ocsf:OcsfAdminGroupQuery .
ocsf:OcsfAdvisory a sh:NodeShape ;
	rdfs:comment "The Advisory object represents publicly disclosed cybersecurity vulnerabilities defined in a Security advisory. e.g. <code> Microsoft KB Article</code>, <code>Apple Security Advisory</code>, or a <code>GitHub Security Advisory (GHSA)</code>" ;
	rdfs:label "Advisory" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n6795 ;
	sh:property _:c14n176 , _:c14n1808 , _:c14n2518 , _:c14n3067 , _:c14n3129 , _:c14n3226 , _:c14n3861 , _:c14n3900 , _:c14n4281 , _:c14n452 , _:c14n4810 , _:c14n5033 , _:c14n5535 , _:c14n5556 , _:c14n6322 , _:c14n778 , _:c14n7808 , _:c14n7912 , _:c14n853 , _:c14n8812 ;
	sh:targetClass ocsf:OcsfAdvisory .
ocsf:OcsfAffectedCode a sh:NodeShape ;
	rdfs:comment "The Affected Code object describes details about a code block identified as vulnerable." ;
	rdfs:label "Affected Code" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n3000 ;
	sh:property _:c14n1290 , _:c14n212 , _:c14n3853 , _:c14n4068 , _:c14n6706 , _:c14n8897 , _:c14n8948 , _:c14n9327 ;
	sh:targetClass ocsf:OcsfAffectedCode .
ocsf:OcsfAffectedPackage a sh:NodeShape ;
	rdfs:comment "The Affected Package object describes details about a software package identified as affected by a vulnerability/vulnerabilities." ;
	rdfs:label "Affected Software Package" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n757 ;
	sh:property _:c14n2117 , _:c14n2739 , _:c14n3703 , _:c14n3823 , _:c14n4403 , _:c14n5213 , _:c14n5247 , _:c14n543 , _:c14n6118 , _:c14n6565 , _:c14n6649 , _:c14n68 , _:c14n7141 , _:c14n7639 , _:c14n7662 , _:c14n7698 , _:c14n8086 , _:c14n8635 , _:c14n8646 , _:c14n8956 ;
	sh:targetClass ocsf:OcsfAffectedPackage .
ocsf:OcsfAgent a sh:NodeShape ;
	rdfs:comment "An Agent (also known as a Sensor) is typically installed on an Operating System (OS) and serves as a specialized software component that can be designed to monitor, detect, collect, archive, or take action. These activities and possible actions are defined by the upstream system controlling the Agent and its intended purpose. For instance, an Agent can include Endpoint Detection & Response (EDR) agents, backup/disaster recovery sensors, Application Performance Monitoring or profiling sensors, and similar software." ;
	rdfs:label "Agent" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4353 ;
	sh:property _:c14n2037 , _:c14n2608 , _:c14n3088 , _:c14n3138 , _:c14n7995 , _:c14n8226 , _:c14n8514 , _:c14n8857 ;
	sh:targetClass ocsf:OcsfAgent .
ocsf:OcsfAiAgent a sh:NodeShape ;
	rdfs:comment "An autonomous AI agent that performs tasks under delegated authority. Distinguished from the OCSF agent object (which describes security sensors such as EDR and DLP tools) and from human principals. An AI agent has a stable logical identity across runs and a restart-sensitive instance identity. The agent owns its model; the ai_model attribute captures which model was backing the agent at the time of action." ;
	rdfs:label "AI Agent" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n6548 ;
	sh:property _:c14n1272 , _:c14n3557 , _:c14n4367 , _:c14n5620 , _:c14n5664 , _:c14n601 , _:c14n6721 , _:c14n8824 , _:c14n979 ;
	sh:targetClass ocsf:OcsfAiAgent .
ocsf:OcsfAiModel a sh:NodeShape ;
	rdfs:comment "The AI Model object describes the characteristics of an AI/ML model. Examples include language models like GPT-4, embedding models like text-embedding-ada-002, and computer vision models like CLIP." ;
	rdfs:label "AI Model" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n481 ;
	sh:property _:c14n4784 , _:c14n4985 , _:c14n5156 , _:c14n7004 , _:c14n8421 ;
	sh:targetClass ocsf:OcsfAiModel .
ocsf:OcsfAiOperationProfile a sh:NodeShape ;
	rdfs:comment "AI-specific attributes for model operations, retrieval systems, and agent activities. e.g. model_name, total_token_counts etc." ;
	rdfs:label "AI Operation" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n4617 ;
	sh:property _:c14n1188 , _:c14n3487 , _:c14n3782 , _:c14n4436 ;
	sh:targetClass ocsf:OcsfAiOperationProfile .
ocsf:OcsfAirborneBroadcastActivity a sh:NodeShape ;
	rdfs:comment "Airborne Broadcast Activity events report the activity of any aircraft or unmanned system as reported and tracked by Automatic Dependent Surveillance - Broadcast (ADS-B) receivers. Based on the ADS-B standards described in Code of Federal Regulations (CFR) Title 14 Chapter I Subchapter F Part 91 and in other general Federal Aviation Administration (FAA) supplemental orders and guidance." ;
	rdfs:label "Airborne Broadcast Activity" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n8605 ;
	sh:property _:c14n1083 , _:c14n1150 , _:c14n1335 , _:c14n1384 , _:c14n1404 , _:c14n141 , _:c14n1569 , _:c14n1772 , _:c14n2029 , _:c14n2166 , _:c14n2281 , _:c14n2288 , _:c14n236 , _:c14n245 , _:c14n2585 , _:c14n291 , _:c14n2985 , _:c14n3040 , _:c14n3058 , _:c14n3136 , _:c14n3160 , _:c14n3352 , _:c14n3361 , _:c14n3379 , _:c14n3389 , _:c14n3426 , _:c14n3820 , _:c14n4272 , _:c14n43 , _:c14n4397 , _:c14n4511 , _:c14n4749 , _:c14n4846 , _:c14n4912 , _:c14n5144 , _:c14n5160 , _:c14n5340 , _:c14n5352 , _:c14n5477 , _:c14n5503 , _:c14n5803 , _:c14n6060 , _:c14n6134 , _:c14n6541 , _:c14n6817 , _:c14n6961 , _:c14n6988 , _:c14n6998 , _:c14n7130 , _:c14n7194 , _:c14n7259 , _:c14n728 , _:c14n7387 , _:c14n7406 , _:c14n7455 , _:c14n7888 , _:c14n820 , _:c14n8200 , _:c14n8217 , _:c14n8319 , _:c14n8554 , _:c14n8677 , _:c14n8678 , _:c14n8738 , _:c14n9102 , _:c14n9152 , _:c14n9325 ;
	sh:targetClass ocsf:OcsfAirborneBroadcastActivity .
ocsf:OcsfAircraft a sh:NodeShape ;
	rdfs:comment "The Aircraft object represents any aircraft or otherwise airborne asset such as an unmanned system, airplane, balloon, spacecraft, or otherwise. The Aircraft object is intended to normalized data captured or otherwise logged from active radar, passive radar, multi-spectral systems, or the Automatic Dependant Broadcast - Surveillance (ADS-B), and/or Mode S systems." ;
	rdfs:label "Aircraft" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n8983 ;
