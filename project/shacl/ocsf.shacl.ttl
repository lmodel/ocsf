	sh:targetClass ocsf:OcsfApi .
ocsf:OcsfApiActivity a sh:NodeShape ;
	rdfs:comment "API events describe general CRUD (Create, Read, Update, Delete) API activities, e.g. (AWS Cloudtrail)" ;
	rdfs:label "API Activity" ;
	sh:closed true ;
