_:c14n2318 sh:datatype xsd:string ;
	sh:description "The ultimate logged time in the event pipeline - when the event reached its final destination (e.g., SIEM, data lake). If <code>loggers</code> is populated, this should match the <code>logged_time</code> of the last entry in the <code>loggers</code> array. This is distinct from <code>time</code> (when the activity occurred) and <code>processed_time</code> (when an intermediate system processed the event)." ;
	sh:maxCount 1 ;
	sh:name "Logged Time" ;
	sh:nodeKind sh:Literal ;
	sh:order 14 ;
	sh:path ocsf:logged_time_dt ;
	sh:pattern "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?([Zz]|[\\+-]\\d{2}:\\d{2})?$" .
