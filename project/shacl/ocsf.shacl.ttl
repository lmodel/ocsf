ocsf:OcsfUserQuery a sh:NodeShape ;
	rdfs:comment "User Query events report user data that have been discovered, queried, polled or searched. This event differs from User Inventory as it describes the result of a targeted search by filtering a subset of user attributes." ;
	rdfs:label "User Query" ;
	sh:closed true ;
