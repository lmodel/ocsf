_:c14n4205 sh:datatype xsd:string ;
	sh:description "The availability zone within a cloud region where the resource is located. Examples include AWS availability zones (us-east-1a, us-east-1b), Azure availability zones (1, 2, 3 within a region), GCP zones (us-central1-a, us-central1-b), or Oracle Cloud availability domains (AD-1, AD-2, AD-3)." ;
	sh:maxCount 1 ;
	sh:name "Cloud Availability Zone" ;
	sh:nodeKind sh:Literal ;
	sh:order 20 ;
	sh:path ocsf:zone .
