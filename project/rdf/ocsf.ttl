	linkml:annotations _:c14n5427 , _:c14n5874 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/ai_agent"^^xsd:anyURI ;
	linkml:description "The autonomous AI agent that performed this operation. Carries model identity via <code>ai_agent.ai_model</code>. Populate when the action was performed by an agent rather than a direct model call." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile> ;
