	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/stratum_id"^^xsd:anyURI ;
	linkml:usage_slot_name "stratum_id" .
