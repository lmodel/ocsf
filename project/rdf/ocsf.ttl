	skos:prefLabel "control" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/control"^^xsd:anyURI ;
	linkml:description "A Control is a prescriptive, actionable set of specifications that strengthens device posture. The control specifies required security measures, while the specific implementation values are defined in control_parameters. E.g., CIS AWS Foundations Benchmark 1.2.0 - Control 2.1 - Ensure CloudTrail is enabled in all regions" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCompliance> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCompliance> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/control> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCompliance> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/control"^^xsd:anyURI ;
	linkml:usage_slot_name "control" .
<https://w3id.org/lmodel/ocsf/OcsfCompliance_control_parameters> dcterms:title "Control Parameters" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.aws.amazon.com/awscloudtrail/latest/APIReference/API_CreateTrail.html"^^xsd:anyURI , "https://docs.aws.amazon.com/awscloudtrail/latest/userguide/cloudtrail-log-file-validation-intro.html"^^xsd:anyURI , "https://docs.aws.amazon.com/awscloudtrail/latest/userguide/receive-cloudtrail-log-files-from-multiple-regions.html"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/control_parameters"^^xsd:anyURI ;
