<https://w3id.org/lmodel/ocsf/OcsfNtpActivity_stratum_id> dcterms:title "Stratum ID" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://www.rfc-editor.org/rfc/rfc5905.html"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/stratum_id"^^xsd:anyURI ;
