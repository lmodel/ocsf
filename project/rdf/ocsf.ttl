	linkml:slot_uri "https://w3id.org/lmodel/ocsf/opcode"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/opcode_id> dcterms:title "DNS Opcode ID" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://www.rfc-editor.org/rfc/rfc5395.html"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
