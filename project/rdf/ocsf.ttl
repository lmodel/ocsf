	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfHttpActivity> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "type_uid" .
<https://w3id.org/lmodel/ocsf/OcsfHttpCookie> dcterms:title "HTTP Cookie" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://d3fend.mitre.org/dao/artifact/d3f:SessionCookie/"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfHttpCookie"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:relatedMatch "d3f:SessionCookie"^^xsd:anyURI ;
	linkml:annotations _:c14n5317 , _:c14n5668 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfHttpCookie"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfHttpCookie"^^xsd:anyURI ;
	linkml:description "The HTTP Cookie object, also known as a web cookie or browser cookie, contains details and values pertaining to a small piece of data that a server sends to a user's web browser. This data is then stored by the browser and sent back to the server with subsequent requests, allowing the server to remember and track certain information about the user's browsing session or preferences." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
