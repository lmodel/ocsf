	skos:prefLabel "time_dt" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/time_dt"^^xsd:anyURI ;
	linkml:description "The finding creation time - when the finding was first generated, not when the underlying activity occurred. For the time range of contributing events, use <code>start_time</code> and <code>end_time</code>." ;
