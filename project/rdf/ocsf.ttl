<https://w3id.org/lmodel/ocsf/OcsfApplicationError_class_uid> dcterms:title "Class ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/class_uid"^^xsd:anyURI ;
	skos:prefLabel "class_uid" ;
	linkml:annotations _:c14n4857 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/class_uid"^^xsd:anyURI ;
	linkml:description "The unique identifier of a class. A class describes the attributes available in an event. Producers and mappers must set this to the <code>uid</code> defined in the event class definition. For example, <code>Detection Finding</code> is <code>2004</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfApplicationError> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfApplicationError> ;
	linkml:equals_number 6008 ;
