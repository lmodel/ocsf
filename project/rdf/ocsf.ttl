	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/office_location"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/opcode> dcterms:title "DNS Opcode" ;
