	linkml:annotations _:c14n4922 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/traffic"^^xsd:anyURI ;
	linkml:description "The network traffic for this observation period. Use when reporting: (1) delta values (bytes/packets transferred since the last observation), (2) instantaneous measurements at a specific point in time, or (3) standalone single-event metrics. This attribute represents a point-in-time measurement or incremental change, not a running total. For accumulated totals across multiple observations or the lifetime of a flow, use <code>cumulative_traffic</code> instead." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfNetworkEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfNetworkEvent> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/traffic> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfNetworkEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfNetworkTraffic> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/traffic"^^xsd:anyURI ;
	linkml:usage_slot_name "traffic" .
