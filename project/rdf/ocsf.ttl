	linkml:annotations _:c14n638 ;
	linkml:any_of _:c14n1766 , _:c14n1805 , _:c14n2483 , _:c14n4705 , _:c14n6094 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/activity_id"^^xsd:anyURI ;
	linkml:description "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfDetectionFinding> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDetectionFinding> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfFindingEvent_activity_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDetectionFinding> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/activity_id"^^xsd:anyURI ;
	linkml:usage_slot_name "activity_id" .
