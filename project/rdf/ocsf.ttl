<https://w3id.org/lmodel/ocsf/ocsf_bytestring_t> dcterms:title "Byte String" ;
	a linkml:TypeDefinition ;
	rdfs:seeAlso "https://www.rfc-editor.org/rfc/rfc4648.html"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1919 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfBytestringT"^^xsd:anyURI ;
	linkml:description "Base 64 encoded immutable byte sequence. Traditional Base 64 is preferred but publishers may use URL-safe Base 64 when known to be acceptable to consumers. These encodings are described in RFC 4648." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:pattern "^(?:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)|(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}==|[A-Za-z0-9_-]{3}=))?$" ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_category> a linkml:SlotDefinition ;
	linkml:description "The event class's category, by OCSF's key." .
<https://w3id.org/lmodel/ocsf/ocsf_category_application> dcterms:title "Application Activity" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n5918 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategoryApplication"^^xsd:anyURI ;
	linkml:description "Application Activity events report detailed information about the behavior of applications and services." .
<https://w3id.org/lmodel/ocsf/ocsf_category_discovery> dcterms:title "Discovery" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n5687 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategoryDiscovery"^^xsd:anyURI ;
	linkml:description "Discovery events report the existence and state of devices, files, configurations, processes, registry keys, and other objects." .
<https://w3id.org/lmodel/ocsf/ocsf_category_findings> dcterms:title "Findings" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n5992 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategoryFindings"^^xsd:anyURI ;
	linkml:description "Findings events report findings, detections, and possible resolutions of malware, anomalies, or other actions performed by security products." .
<https://w3id.org/lmodel/ocsf/ocsf_category_iam> dcterms:title "Identity & Access Management" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n3161 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategoryIam"^^xsd:anyURI ;
	linkml:description "Identity & Access Management (IAM) events relate to the supervision of the system's authentication and access control model. Examples of such events are the success or failure of authentication, granting of authority, password change, entity change, privileged use etc." .
<https://w3id.org/lmodel/ocsf/ocsf_category_network> dcterms:title "Network Activity" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n5334 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategoryNetwork"^^xsd:anyURI ;
	linkml:description "Network Activity events." .
<https://w3id.org/lmodel/ocsf/ocsf_category_remediation> dcterms:title "Remediation" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n2040 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategoryRemediation"^^xsd:anyURI ;
	linkml:description "Remediation events report the results of remediation commands targeting files, processes, and other objects." .
<https://w3id.org/lmodel/ocsf/ocsf_category_system> dcterms:title "System Activity" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n6464 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategorySystem"^^xsd:anyURI ;
	linkml:description "System Activity events." .
<https://w3id.org/lmodel/ocsf/ocsf_category_uid> a linkml:SlotDefinition ;
	linkml:description "The category's number, on the subset that stands for it." .
<https://w3id.org/lmodel/ocsf/ocsf_category_unmanned_systems> dcterms:title "Unmanned Systems" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n2727 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCategoryUnmannedSystems"^^xsd:anyURI ;
	linkml:description "Unmanned Systems events report the activity, existence, and/or state of unmanned systems for tracking, mission planning, and other related activities." .
<https://w3id.org/lmodel/ocsf/ocsf_constraints> a linkml:SlotDefinition ;
	linkml:description "A class's at_least_one and just_one constraints, as JSON." .
<https://w3id.org/lmodel/ocsf/ocsf_datetime_t> dcterms:title "Datetime" ;
	a linkml:TypeDefinition ;
	rdfs:seeAlso "https://www.rfc-editor.org/rfc/rfc3339.html"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n626 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfDatetimeT"^^xsd:anyURI ;
	linkml:description "The Internet Date/Time format as defined in RFC 3339. For example:<br><code>2024-09-10T23:20:50.520Z</code>,<br><code>2024-09-10 23:20:50.520789Z</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:pattern "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?([Zz]|[\\+-]\\d{2}:\\d{2})?$" ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_deprecated_since> a linkml:SlotDefinition ;
	linkml:description "The OCSF version that deprecated the element." .
<https://w3id.org/lmodel/ocsf/ocsf_email_t> dcterms:title "Email Address" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n510 , _:c14n6090 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfEmailT"^^xsd:anyURI ;
	linkml:description "Email address. For example:<br><code>john_doe@example.com</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:pattern "^[a-zA-Z0-9!#$%&'*+-/=?^_`{|}~.]+@[a-zA-Z0-9-]+\\.[a-zA-Z0-9-.]+$" ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_extension> a linkml:SlotDefinition ;
	linkml:description "The extension that defines the element." .
<https://w3id.org/lmodel/ocsf/ocsf_extension_linux> dcterms:title "Linux" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n2160 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfExtensionLinux"^^xsd:anyURI ;
	linkml:description "The Linux extension defines Linux specific attributes, profiles, objects, and classes." .
<https://w3id.org/lmodel/ocsf/ocsf_extension_macos> dcterms:title "macOS" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n3122 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfExtensionMacos"^^xsd:anyURI ;
	linkml:description "The macOS extension defines macOS specific attributes, profiles, objects, and classes." .
<https://w3id.org/lmodel/ocsf/ocsf_extension_uid> a linkml:SlotDefinition ;
	linkml:description "The extension's number, on the subset that stands for it." .
<https://w3id.org/lmodel/ocsf/ocsf_extension_win> dcterms:title "Windows" ;
	a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n5559 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfExtensionWin"^^xsd:anyURI ;
	linkml:description "The Windows extension defines Windows specific attributes, objects, and classes." .
<https://w3id.org/lmodel/ocsf/ocsf_file_hash_t> dcterms:title "Hash" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1736 , _:c14n2871 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfFileHashT"^^xsd:anyURI ;
	linkml:description "Fingerprint. A value, in any format, that maps an arbitrarily large data item to a much shorter string that uniquely identifies the original data. Examples include cryptographic hashing of a file, code signing, and Network Protocol Fingerprinting (NPF).<p><b>Note about name.</b> The type name <code>file_hast_t</code> and the caption &quot;Hash&quot; are used for legacy reasons. This type has been generalized from a file hash to a general fingerprint. The existing type name and caption were retained for backwards compatibility." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_file_name_t> dcterms:title "File Name" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1238 , _:c14n1565 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfFileNameT"^^xsd:anyURI ;
	linkml:description "File name. For example:<br><code>text-file.txt</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_file_path_t> dcterms:title "File Path" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n535 , _:c14n5899 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfFilePathT"^^xsd:anyURI ;
	linkml:description "The full path to the file. For example: For example:<br><code>c:\\windows\\system32\\svchost.exe</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_float_t> dcterms:title "Float" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n6065 ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfFloatT"^^xsd:anyURI ;
	linkml:description "Real floating-point value. For example:<br><code>3.14</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/float> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_group> a linkml:SlotDefinition ;
	linkml:description "An attribute's group: classification, context, occurrence or primary." .
<https://w3id.org/lmodel/ocsf/ocsf_hostname_t> dcterms:title "Hostname" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n3304 , _:c14n5562 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfHostnameT"^^xsd:anyURI ;
	linkml:description "Unique name assigned to a device connected to a computer network. It may be a fully qualified domain name (FQDN). For example:<br><code>r2-d2.example.com.</code>,<br><code>mx.example.com</code>" ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_integer_t> dcterms:title "Integer" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1532 ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfIntegerT"^^xsd:anyURI ;
	linkml:description "Signed integer value." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/integer> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_ip_t> dcterms:title "IP Address" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1493 , _:c14n23 , _:c14n954 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfIpT"^^xsd:anyURI ;
	linkml:description "Internet Protocol address (IP address), in either IPv4 or IPv6 format. For example:<br><code>192.168.200.24</code>, <br> <code>2001:0db8:85a3:0000:0000:8a2e:0370:7334</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:pattern "((^\\s*((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]).){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))\\s*$)|(^\\s*((([0-9A-Fa-f]{1,4}:){7}([0-9A-Fa-f]{1,4}|:))|(([0-9A-Fa-f]{1,4}:){6}(:[0-9A-Fa-f]{1,4}|((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3})|:))|(([0-9A-Fa-f]{1,4}:){5}(((:[0-9A-Fa-f]{1,4}){1,2})|:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3})|:))|(([0-9A-Fa-f]{1,4}:){4}(((:[0-9A-Fa-f]{1,4}){1,3})|((:[0-9A-Fa-f]{1,4})?:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){3}(((:[0-9A-Fa-f]{1,4}){1,4})|((:[0-9A-Fa-f]{1,4}){0,2}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){2}(((:[0-9A-Fa-f]{1,4}){1,5})|((:[0-9A-Fa-f]{1,4}){0,3}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){1}(((:[0-9A-Fa-f]{1,4}){1,6})|((:[0-9A-Fa-f]{1,4}){0,4}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(:(((:[0-9A-Fa-f]{1,4}){1,7})|((:[0-9A-Fa-f]{1,4}){0,5}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:)))(%.+)?\\s*$))" ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_key> a linkml:SlotDefinition ;
	linkml:description "The item's key in OCSF, scoped by its extension where it has one." .
<https://w3id.org/lmodel/ocsf/ocsf_long_t> dcterms:title "Long" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n3580 ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfLongT"^^xsd:anyURI ;
