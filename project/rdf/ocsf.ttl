	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/encoding_id"^^xsd:anyURI ;
	linkml:usage_slot_name "encoding_id" .
<https://w3id.org/lmodel/ocsf/OcsfFingerprint_serialization> dcterms:title "Serialization" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/serialization"^^xsd:anyURI ;
	skos:prefLabel "serialization" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/serialization"^^xsd:anyURI ;
	linkml:description "The canonical serialization scheme used to produce the deterministic byte sequence that was fingerprinted, normalized to the caption of <code>serialization_id</code>. In the case of <code>Other</code>, it is defined by the event source." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfFingerprint> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfFingerprint> ;
