	linkml:definition_uri "https://w3id.org/lmodel/ocsf/aerial_height"^^xsd:anyURI ;
	linkml:description "Expressed as either height above takeoff location or height above ground level (AGL) for a UAS current location. This value is provided in meters and must have a minimum resolution of 1 m. Special Values: <code>Invalid</code>, <code>No Value</code>, or <code>Unknown: -1000 m</code>." ;
