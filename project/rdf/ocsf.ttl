<https://w3id.org/lmodel/ocsf/permission_analysis_results> dcterms:title "Permission Analysis Results" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
