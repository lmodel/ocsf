	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/ou_uid"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/ou_uid"^^xsd:anyURI ;
	linkml:description "The alternate identifier for an entity's unique identifier. For example, its Active Directory OU DN or AWS OU ID." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfOrganization> ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfOrganization> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/ou_uid"^^xsd:anyURI .
