	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfNetworkActivity> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfNetworkEndpoint> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/dst_endpoint"^^xsd:anyURI ;
	linkml:usage_slot_name "dst_endpoint" .
