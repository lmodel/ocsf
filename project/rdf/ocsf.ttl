<https://w3id.org/lmodel/ocsf/OcsfFindingEvent_confidence_id> dcterms:title "Confidence ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
