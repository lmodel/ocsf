	skos:prefLabel "created_time_dt" ;
	linkml:annotations _:c14n5017 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/created_time_dt"^^xsd:anyURI ;
	linkml:description "The time when the delegation was issued by the issuing authority." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/created_time_dt> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_datetime_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/created_time_dt"^^xsd:anyURI ;
	linkml:usage_slot_name "created_time_dt" .
<https://w3id.org/lmodel/ocsf/OcsfDelegation_issuer_uid> dcterms:title "Issuer ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/issuer_uid"^^xsd:anyURI ;
	skos:prefLabel "issuer_uid" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/issuer_uid"^^xsd:anyURI ;
	linkml:description "The unique identifier of the trusted issuing authority (e.g., an OAuth authorization server, cloud STS, IAM broker, orchestration gateway, or SDK wrapper) that generated this delegation. Enables verification that delegation IDs were issued by an authorized component rather than self-asserted by the delegate." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/issuer_uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/issuer_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "issuer_uid" .
<https://w3id.org/lmodel/ocsf/OcsfDelegation_parent_uid> dcterms:title "Parent Delegation ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/parent_uid"^^xsd:anyURI ;
	skos:prefLabel "parent_uid" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/parent_uid"^^xsd:anyURI ;
	linkml:description "The delegation identifier of the parent delegation, if this delegation was created by re-delegating authority to another party (e.g., a downstream service or automated process). This creates a parent-child relationship that enables tracking the complete chain of delegation ancestry. Does not indicate that the delegate was instantiated or spawned by the parent's delegate; that relationship, if any, is tracked separately." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/parent_uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/parent_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "parent_uid" .
<https://w3id.org/lmodel/ocsf/OcsfDelegation_uid> dcterms:title "Delegation ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/uid"^^xsd:anyURI ;
	skos:prefLabel "uid" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/uid"^^xsd:anyURI ;
	linkml:description "Unique identifier for this delegation context. Must be stable across the lifetime of the delegation and generated by a trusted issuing authority (e.g., an OAuth authorization server, cloud STS, IAM broker, or orchestration gateway) rather than self-asserted by the delegate. All events executed under this delegation share this identifier." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/uid"^^xsd:anyURI ;
	linkml:usage_slot_name "uid" .
<https://w3id.org/lmodel/ocsf/OcsfDepth> dcterms:title "CVSS Depth" ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfDepth"^^xsd:anyURI ;
	linkml:description "The values OCSF lists for depth." ;
	linkml:permissible_values <https://w3id.org/lmodel/ocsf/Base> , <https://w3id.org/lmodel/ocsf/Environmental> , <https://w3id.org/lmodel/ocsf/Temporal> .
<https://w3id.org/lmodel/ocsf/OcsfDetectionFinding> dcterms:title "Detection Finding" ;
	OIO:inSubset <https://w3id.org/lmodel/ocsf/ocsf_category_findings> ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/ocsf/ocsf-docs/blob/main/articles/modeling-alerts.md"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfDetectionFinding"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_events_findings"^^xsd:anyURI ;
	linkml:annotations _:c14n1503 , _:c14n2031 , _:c14n5138 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfDetectionFinding"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfDetectionFinding"^^xsd:anyURI ;
	linkml:description "A Detection Finding describes detections or alerts generated by security products using correlation engines, detection engines or other methodologies.<br><strong>Note: </strong>If the event producer is a security control, the <code>Security Control</code> profile should be applied and its <code>attacks</code> information, if present, should be duplicated into the <code>finding_info</code> object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the <code>Incident</code> profile or aggregate the finding into an <code>Incident Finding</code>.<p><strong>Note: </strong>Findings are mutable and as such have a lifecycle, via <code>Update</code> activities. When modeling atomic alerts, you are encouraged to consider using the <code>Security Control</code> profile with the activity event associated with the alert. See the referenced article below." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfFindingEvent> ;
	linkml:slot_usage _:c14n6423 ;
