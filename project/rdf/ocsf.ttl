	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "type_uid" .
<https://w3id.org/lmodel/ocsf/OcsfSpan> dcterms:title "Span" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfSpan"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n3831 , _:c14n5807 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfSpan"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfSpan"^^xsd:anyURI ;
	linkml:description "Represents a single unit of work or operation within a distributed trace. A span typically tracks the execution of a request across a service, capturing important details such as the operation, timestamps, and status. Spans help break down the overall trace into smaller, manageable parts, enabling detailed analysis of the performance and behavior of specific operations within the system. They are crucial for understanding latency, dependencies, and bottlenecks in complex distributed systems." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n239 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfSpan_duration> , <https://w3id.org/lmodel/ocsf/OcsfSpan_end_time> , <https://w3id.org/lmodel/ocsf/OcsfSpan_end_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfSpan_message> , <https://w3id.org/lmodel/ocsf/OcsfSpan_operation> , <https://w3id.org/lmodel/ocsf/OcsfSpan_parent_uid> , <https://w3id.org/lmodel/ocsf/OcsfSpan_service> , <https://w3id.org/lmodel/ocsf/OcsfSpan_start_time> , <https://w3id.org/lmodel/ocsf/OcsfSpan_start_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfSpan_status_code> , <https://w3id.org/lmodel/ocsf/OcsfSpan_uid> .
<https://w3id.org/lmodel/ocsf/OcsfSpan_duration> dcterms:title "Duration Milliseconds" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/duration"^^xsd:anyURI ;
	skos:prefLabel "duration" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/duration"^^xsd:anyURI ;
	linkml:description "The total time, in milliseconds, that the span represents, calculated as the difference between start_time and end_time. It reflects the operation's performance and latency, independent of event timestamps, and accounts for normalized times used by observability tools to ensure consistency across distributed systems." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/duration> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/duration"^^xsd:anyURI ;
	linkml:usage_slot_name "duration" .
<https://w3id.org/lmodel/ocsf/OcsfSpan_end_time> dcterms:title "End Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/end_time"^^xsd:anyURI ;
	skos:prefLabel "end_time" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/end_time"^^xsd:anyURI ;
	linkml:description "The end timestamp of the span, essential for identifying latency and performance bottlenecks. Like the start time, this timestamp is normalized across the observability system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time allows for accurate duration calculations and helps observability tools track performance across services, regardless of the individual system time settings." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/end_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/end_time"^^xsd:anyURI ;
	linkml:usage_slot_name "end_time" .
<https://w3id.org/lmodel/ocsf/OcsfSpan_end_time_dt> dcterms:title "End Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/end_time_dt"^^xsd:anyURI ;
	skos:prefLabel "end_time_dt" ;
	linkml:annotations _:c14n3144 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/end_time_dt"^^xsd:anyURI ;
	linkml:description "The end timestamp of the span, essential for identifying latency and performance bottlenecks. Like the start time, this timestamp is normalized across the observability system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time allows for accurate duration calculations and helps observability tools track performance across services, regardless of the individual system time settings." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/end_time_dt> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_datetime_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/end_time_dt"^^xsd:anyURI ;
	linkml:usage_slot_name "end_time_dt" .
<https://w3id.org/lmodel/ocsf/OcsfSpan_message> dcterms:title "Message" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/message"^^xsd:anyURI ;
	skos:prefLabel "message" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/message"^^xsd:anyURI ;
	linkml:description "The message in a span (often referred to as a span event) serves as a way to record significant moments or occurrences during the span's lifecycle. This content typically manifests as log entries, annotations, or semi-structured events as a string, providing additional granularity and context about what happens at specific points during the execution of an operation." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/message> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/message"^^xsd:anyURI ;
	linkml:usage_slot_name "message" .
<https://w3id.org/lmodel/ocsf/OcsfSpan_operation> dcterms:title "Operation" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/operation"^^xsd:anyURI ;
	skos:prefLabel "operation" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/operation"^^xsd:anyURI ;
	linkml:description "Describes an action performed in a span, such as API requests, database queries, or computations." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/operation> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/operation"^^xsd:anyURI ;
	linkml:usage_slot_name "operation" .
<https://w3id.org/lmodel/ocsf/OcsfSpan_parent_uid> dcterms:title "Parent Unique ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
