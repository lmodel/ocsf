	linkml:annotations _:c14n2986 , _:c14n3617 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfScim"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfScim"^^xsd:anyURI ;
	linkml:description "The System for Cross-domain Identity Management (SCIM) Configuration object provides a structured set of attributes related to SCIM protocols used for identity provisioning and management across cloud-based platforms. It standardizes user and group provisioning details, enabling identity synchronization and lifecycle management with compatible Identity Providers (IdPs) and applications. SCIM is defined in RFC 7634." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n6762 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfScim_auth_protocol> , <https://w3id.org/lmodel/ocsf/OcsfScim_auth_protocol_id> , <https://w3id.org/lmodel/ocsf/OcsfScim_created_time> , <https://w3id.org/lmodel/ocsf/OcsfScim_created_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfScim_error_message> , <https://w3id.org/lmodel/ocsf/OcsfScim_is_group_provisioning_enabled> , <https://w3id.org/lmodel/ocsf/OcsfScim_is_user_provisioning_enabled> , <https://w3id.org/lmodel/ocsf/OcsfScim_last_run_time> , <https://w3id.org/lmodel/ocsf/OcsfScim_last_run_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfScim_modified_time> , <https://w3id.org/lmodel/ocsf/OcsfScim_modified_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfScim_name> , <https://w3id.org/lmodel/ocsf/OcsfScim_protocol_name> , <https://w3id.org/lmodel/ocsf/OcsfScim_rate_limit> , <https://w3id.org/lmodel/ocsf/OcsfScim_scim_group_schema> , <https://w3id.org/lmodel/ocsf/OcsfScim_scim_user_schema> , <https://w3id.org/lmodel/ocsf/OcsfScim_state> , <https://w3id.org/lmodel/ocsf/OcsfScim_state_id> , <https://w3id.org/lmodel/ocsf/OcsfScim_uid> , <https://w3id.org/lmodel/ocsf/OcsfScim_uid_alt> , <https://w3id.org/lmodel/ocsf/OcsfScim_url_string> , <https://w3id.org/lmodel/ocsf/OcsfScim_vendor_name> , <https://w3id.org/lmodel/ocsf/OcsfScim_version> .
