	linkml:description "The list of control parameters evaluated in a Compliance check. E.g., parameters for CloudTrail configuration might include <code>multiRegionTrailEnabled: true</code>, <code>logFileValidationEnabled: true</code>, and <code>requiredRegions: [us-east-1, us-west-2]</code>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCompliance> ;
