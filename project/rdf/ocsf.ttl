<https://w3id.org/lmodel/ocsf/OcsfFindingEvent_status_id> dcterms:title "Status ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/status_id"^^xsd:anyURI ;
	skos:prefLabel "status_id" ;
	linkml:annotations _:c14n1939 , _:c14n938 ;
	linkml:any_of _:c14n3870 , _:c14n4190 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/status_id"^^xsd:anyURI ;
	linkml:description "The normalized finding lifecycle status identifier. Unlike the status of an activity event, which indicates the success or failure of the activity, finding status tracks the review and triage workflow: whether the finding is new, being investigated, suppressed, or resolved. Producers should set this to reflect the current state of the finding in their system (e.g., <code>1</code> for newly created findings, <code>4</code> when remediated)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfFindingEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfFindingEvent> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfBaseEvent_status_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfFindingEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/status_id"^^xsd:anyURI ;
	linkml:usage_slot_name "status_id" .
