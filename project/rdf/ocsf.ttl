<https://w3id.org/lmodel/ocsf/OcsfDigitalSignature_serialization_id> dcterms:title "Serialization ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/serialization_id"^^xsd:anyURI ;
	skos:prefLabel "serialization_id" ;
	linkml:annotations _:c14n791 ;
	linkml:any_of _:c14n1140 , _:c14n1791 , _:c14n2730 , _:c14n2840 , _:c14n3788 , _:c14n439 , _:c14n4731 , _:c14n5542 , _:c14n5796 , _:c14n897 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/serialization_id"^^xsd:anyURI ;
	linkml:description "The identifier of the normalized canonical serialization or signing-envelope scheme used to produce the deterministic byte sequence that was signed. A verifier must apply the same scheme to reproduce the signing input. Use <code>Flat</code> where the signed data is an opaque byte sequence, such as file content, to which no canonical serialization was applied. Distinct from <code>algorithm_id</code>, which identifies how the resulting bytes were signed; some signing formats (e.g. <code>Authenticode</code>) define their own canonicalization and populate both fields." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfDigitalSignature> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDigitalSignature> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/serialization_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDigitalSignature> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/serialization_id"^^xsd:anyURI ;
	linkml:usage_slot_name "serialization_id" .
