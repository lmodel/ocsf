	linkml:definition_uri "https://w3id.org/lmodel/ocsf/tlp"^^xsd:anyURI ;
	linkml:description "The Traffic Light Protocol (TLP) was created to facilitate greater sharing of potentially sensitive information and more effective collaboration. TLP provides a simple and intuitive schema for indicating with whom potentially sensitive information can be shared." ;
