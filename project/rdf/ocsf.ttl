	linkml:description "The time when the delegation was issued by the issuing authority." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/created_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDelegation> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/created_time"^^xsd:anyURI ;
	linkml:usage_slot_name "created_time" .
<https://w3id.org/lmodel/ocsf/OcsfDelegation_created_time_dt> dcterms:title "Created Time" ;
