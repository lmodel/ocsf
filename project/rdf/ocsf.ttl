	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/uid"^^xsd:anyURI ;
	linkml:usage_slot_name "uid" .
<https://w3id.org/lmodel/ocsf/OcsfToken_zone> dcterms:title "Network Zone" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/zone"^^xsd:anyURI ;
	skos:prefLabel "zone" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/zone"^^xsd:anyURI ;
	linkml:description "The network zone or geographic region that the token or key is authorized to be used from. This may represent network-based access restrictions, geographic limitations, or other zone-based authorization policies. Examples include Okta's network zone restrictions or cloud provider region restrictions." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/zone> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/zone"^^xsd:anyURI ;
	linkml:usage_slot_name "zone" .
<https://w3id.org/lmodel/ocsf/OcsfTrace> dcterms:title "Trace" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfTrace"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n2074 , _:c14n2937 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfTrace"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfTrace"^^xsd:anyURI ;
	linkml:description "The trace object contains information about a distributed trace,  which is crucial for observability. Traces are made up of one or more spans, which are individual units of work in application activity. Traces track the journey of a request as it moves through various services in a system, capturing key details like timing, status, and dependencies at each step. Traces provide insights into system performance, helping to identify latency, bottlenecks, and issues in complex, distributed environments." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n1447 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfTrace_duration> , <https://w3id.org/lmodel/ocsf/OcsfTrace_end_time> , <https://w3id.org/lmodel/ocsf/OcsfTrace_end_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfTrace_flags> , <https://w3id.org/lmodel/ocsf/OcsfTrace_service> , <https://w3id.org/lmodel/ocsf/OcsfTrace_span> , <https://w3id.org/lmodel/ocsf/OcsfTrace_start_time> , <https://w3id.org/lmodel/ocsf/OcsfTrace_start_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfTrace_uid> .
<https://w3id.org/lmodel/ocsf/OcsfTraceProfile> dcterms:title "Trace" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfTraceProfile"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n6248 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfTraceProfile"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfTraceProfile"^^xsd:anyURI ;
	linkml:description "The Trace Profile extends the OCSF framework to capture and standardize observability events, specifically targeting trace-level data. This profile enables integration and normalization of distributed tracing information, allowing OCSF events to retain essential trace context such as trace IDs, span relationships, and service dependencies." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:mixin true ;
	linkml:slot_usage _:c14n6006 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfTraceProfile_trace> .
<https://w3id.org/lmodel/ocsf/OcsfTraceProfile_trace> dcterms:title "Trace" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/trace"^^xsd:anyURI ;
	skos:prefLabel "trace" ;
	linkml:annotations _:c14n373 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/trace"^^xsd:anyURI ;
	linkml:description "The trace object contains information about distributed traces which are critical to observability and describe how requests move through a system, capturing each step's timing and status." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTraceProfile> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTraceProfile> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/trace> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTraceProfile> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/trace"^^xsd:anyURI ;
	linkml:usage_slot_name "trace" .
<https://w3id.org/lmodel/ocsf/OcsfTrace_duration> dcterms:title "Duration Milliseconds" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/duration"^^xsd:anyURI ;
	skos:prefLabel "duration" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/duration"^^xsd:anyURI ;
	linkml:description "The total time, in milliseconds, that the trace covers, calculated as the difference between start_time and end_time. This duration helps assess the overall performance of a request as it travels across various services, and is essential for identifying latency and potential bottlenecks within the distributed system. The trace duration may differ from individual span durations due to the propagation and processing times of the trace as it spans multiple components." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/duration> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/duration"^^xsd:anyURI ;
	linkml:usage_slot_name "duration" .
<https://w3id.org/lmodel/ocsf/OcsfTrace_end_time> dcterms:title "End Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/end_time"^^xsd:anyURI ;
	skos:prefLabel "end_time" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/end_time"^^xsd:anyURI ;
	linkml:description "The end timestamp of the trace, essential for identifying latency and performance bottlenecks. Like the start time, this timestamp is normalized across the trace system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time allows for accurate trace duration calculations and helps observability tools track overall performance across services, regardless of the individual system time settings." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/end_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/end_time"^^xsd:anyURI ;
	linkml:usage_slot_name "end_time" .
<https://w3id.org/lmodel/ocsf/OcsfTrace_end_time_dt> dcterms:title "End Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/end_time_dt"^^xsd:anyURI ;
	skos:prefLabel "end_time_dt" ;
	linkml:annotations _:c14n3615 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/end_time_dt"^^xsd:anyURI ;
	linkml:description "The end timestamp of the trace, essential for identifying latency and performance bottlenecks. Like the start time, this timestamp is normalized across the trace system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time allows for accurate trace duration calculations and helps observability tools track overall performance across services, regardless of the individual system time settings." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/end_time_dt> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_datetime_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/end_time_dt"^^xsd:anyURI ;
	linkml:usage_slot_name "end_time_dt" .
<https://w3id.org/lmodel/ocsf/OcsfTrace_flags> dcterms:title "Flags" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/flags"^^xsd:anyURI ;
	skos:prefLabel "flags" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/flags"^^xsd:anyURI ;
	linkml:description "The flags associated with the trace, used to indicate specific properties or behaviors, such as whether the trace is sampled or if it has special handling. Flags help control how traces are processed, logged, and analyzed, providing valuable context for tracing and observability tools in identifying trace characteristics or specific tracking requirements." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/flags> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/flags"^^xsd:anyURI ;
	linkml:usage_slot_name "flags" .
<https://w3id.org/lmodel/ocsf/OcsfTrace_service> dcterms:title "Service" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/service"^^xsd:anyURI ;
	skos:prefLabel "service" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/service"^^xsd:anyURI ;
	linkml:description "Identifies the service or component generating the trace, helping to track and correlate the flow of requests through various parts of a distributed system. This information is essential for understanding the role and performance of specific services within the broader context of system operations and for diagnosing issues across different components." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/service> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfService> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/service"^^xsd:anyURI ;
	linkml:usage_slot_name "service" .
<https://w3id.org/lmodel/ocsf/OcsfTrace_span> dcterms:title "Span" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/span"^^xsd:anyURI ;
	skos:prefLabel "span" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/span"^^xsd:anyURI ;
	linkml:description "Represents a single unit of work or operation within a distributed trace. A span typically tracks the execution of a request across a service, capturing important details such as the operation, timestamps, and status. Spans help break down the overall trace into smaller, manageable parts, enabling detailed analysis of the performance and behavior of specific operations within the system. They are crucial for understanding latency, dependencies, and bottlenecks in complex distributed systems." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/span> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/span"^^xsd:anyURI ;
	linkml:usage_slot_name "span" .
<https://w3id.org/lmodel/ocsf/OcsfTrace_start_time> dcterms:title "Start Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/start_time"^^xsd:anyURI ;
	skos:prefLabel "start_time" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/start_time"^^xsd:anyURI ;
	linkml:description "The start timestamp of the trace, essential for identifying latency and performance bottlenecks. Like the end time, this timestamp is normalized across the trace system to ensure consistency, even when events are recorded across distributed services with unsynchronized clocks. Normalized time enables accurate trace duration calculations and helps observability tools track performance across services, regardless of the individual system time settings." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/start_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/start_time"^^xsd:anyURI ;
	linkml:usage_slot_name "start_time" .
