<https://w3id.org/lmodel/ocsf/OcsfPacket> dcterms:title "Packet" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://d3fend.mitre.org/dao/artifact/d3f:NetworkPacket/"^^xsd:anyURI , "https://d3fend.mitre.org/dao/artifact/d3f:PacketCaptureFile/"^^xsd:anyURI , "https://d3fend.mitre.org/dao/artifact/d3f:PacketLog/"^^xsd:anyURI ;
