<https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult> dcterms:title "Permission Analysis Result" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfPermissionAnalysisResult"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n1098 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult"^^xsd:anyURI ;
	linkml:description "The Permission Analysis object describes analysis results of permissions, policies directly associated with an identity (user, role, or service account). This evaluates what permissions an identity has been granted through attached policies, which privileges are actively used versus unused, and identifies potential over-privileged access. Use this for identity-centric security assessments such as privilege audits, dormant permission discovery, and least-privilege compliance analysis." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n3895 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_analyzed_privileges_count> , <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_condition_keys> , <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_granted_privileges> , <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_policy> , <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_service_privilege_analysis_list> , <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_unused_privileges_count> , <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_unused_services_count> , <https://w3id.org/lmodel/ocsf/total_potential_attacks_count> .
<https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_analyzed_privileges_count> dcterms:title "Analyzed Privileges Count" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/analyzed_privileges_count"^^xsd:anyURI ;
	skos:prefLabel "analyzed_privileges_count" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/analyzed_privileges_count"^^xsd:anyURI ;
	linkml:description "The total count of privileges that were analyzed across all services." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/analyzed_privileges_count> ;
	linkml:is_usage_slot true ;
