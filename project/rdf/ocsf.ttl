	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfTrace> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/start_time_dt> ;
