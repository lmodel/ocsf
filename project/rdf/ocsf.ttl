<https://w3id.org/lmodel/ocsf/OcsfToken_tenant_uid> dcterms:title "Tenant UID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/tenant_uid"^^xsd:anyURI ;
	skos:prefLabel "tenant_uid" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/tenant_uid"^^xsd:anyURI ;
	linkml:description "The unique identifier of the tenant or organization that owns the token or key, or the tenant context in which the token is authorized for use. This is particularly relevant in multi-tenant Identity Provider scenarios where tokens are scoped to specific tenants." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/tenant_uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/tenant_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "tenant_uid" .
<https://w3id.org/lmodel/ocsf/OcsfToken_type> dcterms:title "Type" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/type"^^xsd:anyURI ;
	skos:prefLabel "type" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/type"^^xsd:anyURI ;
	linkml:description "The type of the token, normalized to the caption of the <code>type_id</code> value. This indicates whether the token is a Client Token, API Token, or one of the protocol-specific token types." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/type> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type"^^xsd:anyURI ;
	linkml:usage_slot_name "type" .
<https://w3id.org/lmodel/ocsf/OcsfToken_type_id> dcterms:title "Type ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/type_id"^^xsd:anyURI ;
	skos:prefLabel "type_id" ;
	linkml:annotations _:c14n795 ;
	linkml:any_of _:c14n2006 , _:c14n2334 , _:c14n4353 , _:c14n4613 , _:c14n4636 , _:c14n5150 , _:c14n5244 , _:c14n5308 , _:c14n5429 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/type_id"^^xsd:anyURI ;
	linkml:description "The normalized token type identifier. Valid values: 0 (Unknown), 1 (Ticket Granting Ticket - Kerberos), 2 (Service Ticket - Kerberos), 3 (Identity Token - OIDC), 4 (Refresh Token - OIDC), 5 (SAML Assertion), 6 (Client Token - IdP-issued), 7 (API Token - generic API keys), 99 (Other)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/type_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_id"^^xsd:anyURI ;
	linkml:usage_slot_name "type_id" .
<https://w3id.org/lmodel/ocsf/OcsfToken_uid> dcterms:title "Unique ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/uid"^^xsd:anyURI ;
	skos:prefLabel "uid" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/uid"^^xsd:anyURI ;
	linkml:description "The unique ID of a token or key, if available, such as the <code>Secret ID</code> of Entra ID Application Registration Client Secrets." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfToken> ;
