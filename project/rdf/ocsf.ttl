	skos:mappingRelation "https://w3id.org/lmodel/ocsf/sensor_layer"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/sensor_layer"^^xsd:anyURI ;
	linkml:description "The normalized identifier of the sensor layer that emitted the data for the analysis. For example, use this to classify the detection surface (e.g., IPS sensor, endpoint agent, email gateway). When the type is not listed, use <code>99</code> (Other) and populate <code>sensor_layer</code> with the source-specific label." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfSensorInfo> ;
