	linkml:description "The user that owns the file/object." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAffectedCode> , <https://w3id.org/lmodel/ocsf/OcsfApplication> , <https://w3id.org/lmodel/ocsf/OcsfDatabucket> , <https://w3id.org/lmodel/ocsf/OcsfEndpoint> , <https://w3id.org/lmodel/ocsf/OcsfFile> , <https://w3id.org/lmodel/ocsf/OcsfNote> , <https://w3id.org/lmodel/ocsf/OcsfResourceDetails> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
