	linkml:is_a <https://w3id.org/lmodel/ocsf/parent_uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfSpan> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/parent_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "parent_uid" .
<https://w3id.org/lmodel/ocsf/OcsfSpan_service> dcterms:title "Service" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/service"^^xsd:anyURI ;
	skos:prefLabel "service" ;
