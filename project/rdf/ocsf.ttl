<https://w3id.org/lmodel/ocsf/OcsfCve_type> dcterms:title "Vulnerability Type" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://www.cvedetails.com/vulnerabilities-by-types.php"^^xsd:anyURI ;
