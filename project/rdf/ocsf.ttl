	linkml:definition_uri "https://w3id.org/lmodel/ocsf/network_observation_point"^^xsd:anyURI ;
	linkml:description "The network endpoint that observes or inspects network traffic as a third-party system, used when the observer is neither the source nor the destination of the communication (when <code>observation_point_id</code> = 3). Examples include network taps, span ports, inline security devices, or packet capture systems that monitor traffic between other endpoints." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfNetworkEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfNetworkEvent> ;
