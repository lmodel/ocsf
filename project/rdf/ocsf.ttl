<https://w3id.org/lmodel/ocsf/OcsfApplication> dcterms:title "Application" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://d3fend.mitre.org/dao/artifact/d3f:Application/"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfApplication"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:relatedMatch "d3f:Application"^^xsd:anyURI ;
	linkml:annotations _:c14n384 , _:c14n4954 , _:c14n931 ;
	linkml:any_of _:c14n1688 , _:c14n2569 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfApplication"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfApplication"^^xsd:anyURI ;
	linkml:description "An Application describes the details for an inventoried application as reported by an Application Security tool or other Developer-centric tooling. Applications can be defined as Kubernetes resources, Containerized resources, or application hosting-specific cloud sources such as AWS Elastic BeanStalk, AWS Lightsail, or Azure Logic Apps." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n2302 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfApplication_criticality> , <https://w3id.org/lmodel/ocsf/OcsfApplication_data> , <https://w3id.org/lmodel/ocsf/OcsfApplication_desc> , <https://w3id.org/lmodel/ocsf/OcsfApplication_group> , <https://w3id.org/lmodel/ocsf/OcsfApplication_hostname> , <https://w3id.org/lmodel/ocsf/OcsfApplication_labels> , <https://w3id.org/lmodel/ocsf/OcsfApplication_name> , <https://w3id.org/lmodel/ocsf/OcsfApplication_owner> , <https://w3id.org/lmodel/ocsf/OcsfApplication_product> , <https://w3id.org/lmodel/ocsf/OcsfApplication_region> , <https://w3id.org/lmodel/ocsf/OcsfApplication_resource_relationship> , <https://w3id.org/lmodel/ocsf/OcsfApplication_sbom> , <https://w3id.org/lmodel/ocsf/OcsfApplication_tags> , <https://w3id.org/lmodel/ocsf/OcsfApplication_type> , <https://w3id.org/lmodel/ocsf/OcsfApplication_uid> , <https://w3id.org/lmodel/ocsf/OcsfApplication_uid_alt> , <https://w3id.org/lmodel/ocsf/OcsfApplication_url> , <https://w3id.org/lmodel/ocsf/OcsfApplication_version> , <https://w3id.org/lmodel/ocsf/risk_level> , <https://w3id.org/lmodel/ocsf/risk_level_id> , <https://w3id.org/lmodel/ocsf/risk_score> .
<https://w3id.org/lmodel/ocsf/OcsfApplicationError> dcterms:title "Application Error" ;
	OIO:inSubset <https://w3id.org/lmodel/ocsf/ocsf_category_application> ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfApplicationError"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_events_application"^^xsd:anyURI ;
	linkml:annotations _:c14n2030 , _:c14n613 , _:c14n6309 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfApplicationError"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfApplicationError"^^xsd:anyURI ;
	linkml:description "Application Error events describe issues with an applications. The error message should be put in the event's <code>message</code> attribute. The <code>metadata.product</code> attribute can be used to capture the originating application information. The <code>host</code> profile can used to include the generating device information. This class is helpful for applications that generate or handle OCSF events and can also be used for errors in upstream products and services." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfApplicationEvent> ;
	linkml:slot_usage _:c14n5674 ;
