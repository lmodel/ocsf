<https://w3id.org/lmodel/ocsf/OcsfAgent> dcterms:title "Agent" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://d3fend.mitre.org/dao/artifact/d3f:Sensor/"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfAgent"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:relatedMatch "d3f:Sensor"^^xsd:anyURI ;
	linkml:annotations _:c14n1821 , _:c14n5720 ;
	linkml:any_of _:c14n3869 , _:c14n5600 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfAgent"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfAgent"^^xsd:anyURI ;
	linkml:description "An Agent (also known as a Sensor) is typically installed on an Operating System (OS) and serves as a specialized software component that can be designed to monitor, detect, collect, archive, or take action. These activities and possible actions are defined by the upstream system controlling the Agent and its intended purpose. For instance, an Agent can include Endpoint Detection & Response (EDR) agents, backup/disaster recovery sensors, Application Performance Monitoring or profiling sensors, and similar software." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n713 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfAgent_name> , <https://w3id.org/lmodel/ocsf/OcsfAgent_policies> , <https://w3id.org/lmodel/ocsf/OcsfAgent_type> , <https://w3id.org/lmodel/ocsf/OcsfAgent_type_id> , <https://w3id.org/lmodel/ocsf/OcsfAgent_uid> , <https://w3id.org/lmodel/ocsf/OcsfAgent_uid_alt> , <https://w3id.org/lmodel/ocsf/OcsfAgent_vendor_name> , <https://w3id.org/lmodel/ocsf/OcsfAgent_version> .
