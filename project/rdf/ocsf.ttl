<https://w3id.org/lmodel/ocsf/OcsfOsintInventoryInfo> dcterms:title "OSINT Inventory Info" ;
	OIO:inSubset <https://w3id.org/lmodel/ocsf/ocsf_category_discovery> ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfOsintInventoryInfo"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_events_discovery"^^xsd:anyURI ;
	linkml:annotations _:c14n2007 , _:c14n2353 , _:c14n4423 ;
