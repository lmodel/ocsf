	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfContainer> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/orchestrator"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/org> dcterms:title "Organization" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
