<https://w3id.org/lmodel/ocsf/scim> dcterms:title "SCIM" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://datatracker.ietf.org/doc/html/rfc7643"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/scim"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/scim"^^xsd:anyURI ;
	linkml:description "The System for Cross-domain Identity Management (SCIM) resource object as defined in RFC 7634 provides a structured set of attributes related to SCIM protocols used for identity provisioning and management across cloud-based platforms. It standardizes user and group provisioning details, enabling identity synchronization and lifecycle management with compatible Identity Providers (IdPs) and applications." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfIdp> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfIdp> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfScim> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/scim"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/scim_group_schema> dcterms:title "SCIM Group Schema" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://datatracker.ietf.org/doc/html/rfc7643"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/scim_group_schema"^^xsd:anyURI ;
	linkml:any_of _:c14n2615 , _:c14n844 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/scim_group_schema"^^xsd:anyURI ;
	linkml:description "SCIM provides a schema for representing groups, identified using the following schema URI: <code>urn:ietf:params:scim:schemas:core:2.0:Group</code> as defined in RFC 7634. This attribute will capture key-value pairs for the scheme implemented in a SCIM resource." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfScim> ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfScim> ;
	linkml:range <https://w3id.org/lmodel/ocsf/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/scim_group_schema"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/scim_user_schema> dcterms:title "SCIM User Schema" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://datatracker.ietf.org/doc/html/rfc7643"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/scim_user_schema"^^xsd:anyURI ;
	linkml:any_of _:c14n2384 , _:c14n3150 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/scim_user_schema"^^xsd:anyURI ;
	linkml:description "SCIM provides a resource type for user resources. The core schema for user is identified using the following schema URI: <code>urn:ietf:params:scim:schemas:core:2.0:User</code> as defined in RFC 7634. This attribute will capture key-value pairs for the scheme implemented in a SCIM resource. This object is inclusive of both the basic and Enterprise User Schema Extension." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfScim> ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfScim> ;
	linkml:range <https://w3id.org/lmodel/ocsf/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/scim_user_schema"^^xsd:anyURI .
