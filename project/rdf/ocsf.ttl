<https://w3id.org/lmodel/ocsf/OcsfScim> dcterms:title "SCIM" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://datatracker.ietf.org/doc/html/rfc7643"^^xsd:anyURI ;
