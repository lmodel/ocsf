	skos:mappingRelation "https://w3id.org/lmodel/ocsf/ou_name"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/ou_name"^^xsd:anyURI ;
	linkml:description "The name of the organizational unit, within an organization.  For example, Finance, IT, R&D" ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfOrganization> ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfOrganization> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/ou_name"^^xsd:anyURI .
