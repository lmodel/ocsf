<https://w3id.org/lmodel/ocsf/OcsfCvss_metrics> dcterms:title "Metrics" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/metrics"^^xsd:anyURI ;
	skos:prefLabel "metrics" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/metrics"^^xsd:anyURI ;
	linkml:description "The Common Vulnerability Scoring System metrics. This attribute contains information on the CVE's impact. If the CVE has been analyzed, this attribute will contain any CVSSv2 or CVSSv3 information associated with the vulnerability. For example: <code>{ {\"Access Vector\", \"Network\"}, {\"Access Complexity\", \"Low\"}, ...}</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCvss> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCvss> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/metrics> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCvss> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfMetric> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/metrics"^^xsd:anyURI ;
	linkml:usage_slot_name "metrics" .
