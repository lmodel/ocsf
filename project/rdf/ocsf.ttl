	linkml:any_of _:c14n5219 , _:c14n6126 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfAiModel"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfAiModel"^^xsd:anyURI ;
	linkml:description "The AI Model object describes the characteristics of an AI/ML model. Examples include language models like GPT-4, embedding models like text-embedding-ada-002, and computer vision models like CLIP." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfEntity> ;
