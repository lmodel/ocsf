<https://w3id.org/lmodel/ocsf/PATCH> dcterms:title "Patch" ;
	linkml:description "The PATCH method applies partial modifications to a resource." .
<https://w3id.org/lmodel/ocsf/POST> dcterms:title "Post" ;
	linkml:description "The POST method submits an entity to the specified resource, often causing a change in state or side effects on the server." .
<https://w3id.org/lmodel/ocsf/PRI> dcterms:title "PRI" ;
	linkml:description "The PRI method appears in the HTTP/2 connection preface to confirm the protocol." .
<https://w3id.org/lmodel/ocsf/PROPFIND> dcterms:title "Property Find" ;
	linkml:description "The PROPFIND method retrieves properties defined on the specified resource." .
<https://w3id.org/lmodel/ocsf/PROPPATCH> dcterms:title "Property Patch" ;
	linkml:description "The PROPPATCH method sets and/or removes properties defined on the specified resource." .
<https://w3id.org/lmodel/ocsf/PUT> dcterms:title "Put" ;
	linkml:description "The PUT method replaces all current representations of the target resource with the request payload." .
<https://w3id.org/lmodel/ocsf/QUERY> dcterms:title "Query" ;
	linkml:description "The QUERY method performs a safe query request that can include a request body." .
<https://w3id.org/lmodel/ocsf/REBIND> dcterms:title "Rebind" ;
	linkml:description "The REBIND method moves a binding from one collection to another." .
<https://w3id.org/lmodel/ocsf/RED> dcterms:title "TLP:RED" ;
	linkml:description "TLP:RED is for the eyes and ears of individual recipients only, no further disclosure. Sources may use TLP:RED when information cannot be effectively acted upon without significant risk for the privacy, reputation, or operations of the organizations involved. Recipients may therefore not share TLP:RED information with anyone else. In the context of a meeting, for example, TLP:RED information is limited to those present at the meeting." .
<https://w3id.org/lmodel/ocsf/REPORT> dcterms:title "Report" ;
	linkml:description "The REPORT method retrieves a report about the specified resource." .
<https://w3id.org/lmodel/ocsf/SEARCH> dcterms:title "Search" ;
	linkml:description "The SEARCH method searches a resource or collection using the request payload." .
<https://w3id.org/lmodel/ocsf/TRACE> dcterms:title "Trace" ;
	linkml:description "The TRACE method performs a message loop-back test along the path to the target resource." .
<https://w3id.org/lmodel/ocsf/Temporal> dcterms:title "Temporal" .
<https://w3id.org/lmodel/ocsf/UNBIND> dcterms:title "Unbind" ;
	linkml:description "The UNBIND method removes a binding from the specified collection resource." .
<https://w3id.org/lmodel/ocsf/UNCHECKOUT> dcterms:title "Un-Check Out" ;
	linkml:description "The UNCHECKOUT method cancels a checkout and restores the resource to its previous state." .
<https://w3id.org/lmodel/ocsf/UNLINK> dcterms:title "Unlink" ;
	linkml:description "The UNLINK method removes one or more links between resources." .
<https://w3id.org/lmodel/ocsf/UNLOCK> dcterms:title "Unlock" ;
	linkml:description "The UNLOCK method releases a lock on the specified resource." .
<https://w3id.org/lmodel/ocsf/UPDATE> dcterms:title "Update" ;
	linkml:description "The UPDATE method updates a version-controlled resource to match a specified version." .
<https://w3id.org/lmodel/ocsf/UPDATEREDIRECTREF> dcterms:title "Update Redirect Reference" ;
	linkml:description "The UPDATEREDIRECTREF method changes the target of a redirect reference resource." .
<https://w3id.org/lmodel/ocsf/VERSION-CONTROL> dcterms:title "Version Control" ;
	linkml:description "The VERSION-CONTROL method places the specified resource under version control." .
<https://w3id.org/lmodel/ocsf/WHITE> dcterms:title "TLP:WHITE" ;
	linkml:description "TLP:WHITE and TLP:CLEAR may be used interchangeably, TLP:WHITE is the most up to date (as of TLP 2.0) usage." .
<https://w3id.org/lmodel/ocsf/access_analysis_result> dcterms:title "Access Analysis Result" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/access_analysis_result"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/access_analysis_result"^^xsd:anyURI ;
	linkml:description "Describes access relationships and pathways between identities, resources, focusing on who can access what and through which mechanisms. This evaluates access levels (read/write/admin), access types (direct, cross-account, public, federated), and the conditions under which access is granted. Use this for resource-centric security assessments such as external access discovery, public exposure analysis, etc." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfIamAnalysisFinding> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfIamAnalysisFinding> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfAccessAnalysisResult> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/access_analysis_result"^^xsd:anyURI .
