<https://w3id.org/lmodel/ocsf/OcsfMetadata_loggers> dcterms:title "Loggers" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/loggers"^^xsd:anyURI ;
	skos:prefLabel "loggers" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/loggers"^^xsd:anyURI ;
	linkml:description "An ordered array of Logger objects describing each hop in the event pipeline between the source and its final destination. Each entry captures the logging product, device, and timestamps (<code>logged_time</code>, <code>transmit_time</code>) at that stage. The last entry's <code>logged_time</code> should match <code>metadata.logged_time</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfMetadata> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfMetadata> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/loggers> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfMetadata> ;
