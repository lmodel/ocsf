	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	linkml:description "The classification or category of the observation, indicating what kind of measurement or finding it represents. See specific usage." ;
