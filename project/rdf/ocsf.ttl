<https://w3id.org/lmodel/ocsf/OcsfIamAnalysisFinding_access_analysis_result> dcterms:title "Access Analysis Result" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/access_analysis_result"^^xsd:anyURI ;
	skos:prefLabel "access_analysis_result" ;
	linkml:annotations _:c14n3526 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/access_analysis_result"^^xsd:anyURI ;
	linkml:description "Describes access relationships and pathways between identities, resources, focusing on who can access what and through which mechanisms. This evaluates access levels (read/write/admin), access types (direct, cross-account, public, federated), and the conditions under which access is granted. Use this for resource-centric security assessments such as external access discovery, public exposure analysis, etc." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfIamAnalysisFinding> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfIamAnalysisFinding> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/access_analysis_result> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfIamAnalysisFinding> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfAccessAnalysisResult> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/access_analysis_result"^^xsd:anyURI ;
	linkml:usage_slot_name "access_analysis_result" .
