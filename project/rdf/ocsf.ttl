<https://w3id.org/lmodel/ocsf/activity_id> dcterms:title "Activity ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/activity_id"^^xsd:anyURI ;
	linkml:annotations _:c14n5078 , _:c14n6479 ;
	linkml:any_of _:c14n3745 , _:c14n6587 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/activity_id"^^xsd:anyURI ;
	linkml:description "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/activity_id"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/activity_name> dcterms:title "Activity" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/activity_name"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/activity_name"^^xsd:anyURI ;
	linkml:description "The event activity name, as defined by the <code>activity_id</code>. When <code>activity_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific activity label. For all other <code>activity_id</code> values, this must match the caption defined for that <code>activity_id</code> enum value." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/activity_name"^^xsd:anyURI .
