	linkml:annotations _:c14n1564 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/uid"^^xsd:anyURI ;
	linkml:description "The Common Vulnerabilities and Exposures unique number assigned to a specific computer vulnerability. A CVE Identifier begins with 4 digits representing the year followed by a sequence of digits that acts as a unique identifier. For example: <code>CVE-2021-12345</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCve> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCve> ;
