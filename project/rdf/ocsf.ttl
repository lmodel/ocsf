	linkml:slot_uri "https://w3id.org/lmodel/ocsf/ai_agent"^^xsd:anyURI ;
	linkml:usage_slot_name "ai_agent" .
<https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile_ai_model> dcterms:title "AI Model" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
