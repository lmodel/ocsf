	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfObservation"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfObservation"^^xsd:anyURI ;
	linkml:description "A record of an observed value or event that captures the timing and frequency of its occurrence. Used to track when values/events were first detected, last detected, and their total occurrence count." ;
