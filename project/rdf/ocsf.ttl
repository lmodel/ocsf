<https://w3id.org/lmodel/ocsf/OcsfAnomaly> dcterms:title "Anomaly" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfAnomaly"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n4703 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfAnomaly"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfAnomaly"^^xsd:anyURI ;
	linkml:description "Describes an anomaly or deviation detected in a system. Anomalies are unexpected activity patterns that could indicate potential issues needing attention." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n4725 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfAnomaly_observation_parameter> , <https://w3id.org/lmodel/ocsf/OcsfAnomaly_observation_type> , <https://w3id.org/lmodel/ocsf/OcsfAnomaly_observations> , <https://w3id.org/lmodel/ocsf/OcsfAnomaly_observed_pattern> .
<https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> dcterms:title "Anomaly Analysis" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfAnomalyAnalysis"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n3837 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis"^^xsd:anyURI ;
	linkml:description "Describes the analysis of activity patterns and anomalies of target entities to identify potential security threats, performance issues, or other deviations from established baselines. This includes monitoring and analyzing user interactions, API usage, resource utilization, access patterns and other measured indicators." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:slot_usage _:c14n4318 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis_analysis_targets> , <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis_anomalies> , <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis_baselines> .
<https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis_analysis_targets> dcterms:title "Analysis Targets" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/analysis_targets"^^xsd:anyURI ;
	skos:prefLabel "analysis_targets" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/analysis_targets"^^xsd:anyURI ;
	linkml:description "The analysis targets define the scope of monitored activities, specifying what entities, systems or processes are analyzed for activity patterns." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/analysis_targets> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfAnalysisTarget> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/analysis_targets"^^xsd:anyURI ;
	linkml:usage_slot_name "analysis_targets" .
<https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis_anomalies> dcterms:title "Anomalies" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/anomalies"^^xsd:anyURI ;
	skos:prefLabel "anomalies" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/anomalies"^^xsd:anyURI ;
	linkml:description "List of detected activities that significantly deviate from the established baselines. This can include unusual access patterns, unexpected user-agents, abnormal API usage, suspicious traffic spikes, unauthorized access attempts, and other activities that may indicate potential security threats or system issues." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/anomalies> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/anomalies"^^xsd:anyURI ;
	linkml:usage_slot_name "anomalies" .
<https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis_baselines> dcterms:title "Baselines" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/baselines"^^xsd:anyURI ;
	skos:prefLabel "baselines" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/baselines"^^xsd:anyURI ;
	linkml:description "List of established patterns representing normal activity that serve as reference points for anomaly detection. This includes typical user interaction patterns like common user-agents, expected API access frequencies and patterns, standard resource utilization levels, and regular traffic flows. These baselines help establish what constitutes 'normal' activity in the system." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/baselines> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAnomalyAnalysis> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/baselines"^^xsd:anyURI ;
	linkml:usage_slot_name "baselines" .
<https://w3id.org/lmodel/ocsf/OcsfAnomaly_observation_parameter> dcterms:title "Observation Parameter" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observation_parameter"^^xsd:anyURI ;
	skos:prefLabel "observation_parameter" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observation_parameter"^^xsd:anyURI ;
	linkml:description "The specific parameter, metric or property where the anomaly was observed. Examples include: CPU usage percentage, API response time in milliseconds, HTTP error rate, memory utilization, network latency, transaction volume, etc. This helps identify the exact aspect of the system exhibiting anomalous behavior." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observation_parameter> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observation_parameter"^^xsd:anyURI ;
	linkml:usage_slot_name "observation_parameter" .
<https://w3id.org/lmodel/ocsf/OcsfAnomaly_observation_type> dcterms:title "Observation Type" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	skos:prefLabel "observation_type" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	linkml:description "The type of analysis methodology used to detect the anomaly. This indicates how the anomaly was identified through different analytical approaches. Common types include: Frequency Analysis, Time Pattern Analysis, Volume Analysis, Sequence Analysis, Distribution Analysis, etc." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observation_type> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	linkml:usage_slot_name "observation_type" .
<https://w3id.org/lmodel/ocsf/OcsfAnomaly_observations> dcterms:title "Observations" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observations"^^xsd:anyURI ;
	skos:prefLabel "observations" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observations"^^xsd:anyURI ;
	linkml:description "Details about the observed anomaly or observations that were flagged as anomalous compared to expected baseline behavior." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observations> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfObservation> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observations"^^xsd:anyURI ;
	linkml:usage_slot_name "observations" .
<https://w3id.org/lmodel/ocsf/OcsfAnomaly_observed_pattern> dcterms:title "Observed Pattern" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observed_pattern"^^xsd:anyURI ;
	skos:prefLabel "observed_pattern" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observed_pattern"^^xsd:anyURI ;
	linkml:description "The specific pattern identified within the observation type. For Frequency Analysis, this could be 'FREQUENT', 'INFREQUENT', 'RARE', or 'UNSEEN'. For Time Pattern Analysis, this could be 'BUSINESS_HOURS', 'OFF_HOURS', or 'UNUSUAL_TIME'. For Volume Analysis, this could be 'NORMAL_VOLUME', 'HIGH_VOLUME', or 'SURGE'. The pattern values are specific to each observation type and indicate how the observed behavior relates to the baseline." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observed_pattern> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAnomaly> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observed_pattern"^^xsd:anyURI ;
	linkml:usage_slot_name "observed_pattern" .
