<https://w3id.org/lmodel/ocsf/OcsfMetadata_logged_time> dcterms:title "Logged Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/logged_time"^^xsd:anyURI ;
	skos:prefLabel "logged_time" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/logged_time"^^xsd:anyURI ;
	linkml:description "The ultimate logged time in the event pipeline - when the event reached its final destination (e.g., SIEM, data lake). If <code>loggers</code> is populated, this should match the <code>logged_time</code> of the last entry in the <code>loggers</code> array. This is distinct from <code>time</code> (when the activity occurred) and <code>processed_time</code> (when an intermediate system processed the event)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfMetadata> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfMetadata> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/logged_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfMetadata> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/logged_time"^^xsd:anyURI ;
	linkml:usage_slot_name "logged_time" .
<https://w3id.org/lmodel/ocsf/OcsfMetadata_logged_time_dt> dcterms:title "Logged Time" ;
