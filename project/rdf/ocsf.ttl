<https://w3id.org/lmodel/ocsf/OcsfGroup> dcterms:title "Group" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://d3fend.mitre.org/dao/artifact/d3f:AccessControlGroup/"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfGroup"^^xsd:anyURI ;
