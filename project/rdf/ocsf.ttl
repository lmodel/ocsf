	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "type_uid" .
<https://w3id.org/lmodel/ocsf/OcsfOsintProfile> dcterms:title "OSINT" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfOsintProfile"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n3471 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfOsintProfile"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfOsintProfile"^^xsd:anyURI ;
	linkml:description "The OSINT (Open Source Intelligence) profile contains one or more indicators and associated analysis and details, such as registrar (WHOIS) information and commentary about a hostname, or information about a digital certificate and its usage within a campaign. This information can be used to further enrich a detection or finding by providing decisioning support to other analysts and engineers within the profile itself." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:mixin true ;
	linkml:slot_usage _:c14n617 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfOsintProfile_osint> .
<https://w3id.org/lmodel/ocsf/OcsfOsintProfile_osint> dcterms:title "OSINT" ;
