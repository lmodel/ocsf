	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfSecurityControlProfile_malware> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfMalware> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/malware"^^xsd:anyURI ;
	linkml:usage_slot_name "malware" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_malware_scan_info> dcterms:title "Malware Scan Info" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
