<https://w3id.org/lmodel/ocsf/OcsfDataSecurity> dcterms:title "Data Security" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfDataSecurity"^^xsd:anyURI ;
