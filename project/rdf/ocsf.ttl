<https://w3id.org/lmodel/ocsf/OcsfNetworkActivity_initiator_id> dcterms:title "Initiator ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/initiator_id"^^xsd:anyURI ;
