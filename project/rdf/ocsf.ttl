<https://w3id.org/lmodel/ocsf/OcsfFingerprint> dcterms:title "Fingerprint" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://d3fend.mitre.org/dao/artifact/d3f:DigitalFingerprint/"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfFingerprint"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:relatedMatch "d3f:DigitalFingerprint"^^xsd:anyURI ;
	linkml:annotations _:c14n2208 , _:c14n3308 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfFingerprint"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfFingerprint"^^xsd:anyURI ;
	linkml:description "The Fingerprint object provides detailed information about a fingerprint, which is a compact representation of data used to identify a longer piece of information, such as a public key, file content, or application implementation. It contains the algorithm or scheme and value of the fingerprint, enabling efficient and reliable identification of the associated data." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n4073 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfFingerprint_algorithm> , <https://w3id.org/lmodel/ocsf/OcsfFingerprint_algorithm_id> , <https://w3id.org/lmodel/ocsf/OcsfFingerprint_encoding> , <https://w3id.org/lmodel/ocsf/OcsfFingerprint_encoding_id> , <https://w3id.org/lmodel/ocsf/OcsfFingerprint_serialization> , <https://w3id.org/lmodel/ocsf/OcsfFingerprint_serialization_id> , <https://w3id.org/lmodel/ocsf/OcsfFingerprint_value> .
