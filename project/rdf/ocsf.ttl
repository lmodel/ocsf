	linkml:definition_uri "https://w3id.org/lmodel/ocsf/os"^^xsd:anyURI ;
	linkml:description "The endpoint operating system." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAdvisory> , <https://w3id.org/lmodel/ocsf/OcsfEndpoint> , <https://w3id.org/lmodel/ocsf/OcsfKbArticle> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfKbArticle> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfOs> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/os"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/os_machine_uuid> dcterms:title "OS Machine UUID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/os_machine_uuid"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/os_machine_uuid"^^xsd:anyURI ;
	linkml:description "The operating system assigned Machine ID. In Windows, this is the value stored at the registry path: <code>HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Cryptography\\MachineGuid</code>. In Linux, this is stored in the file: <code>/etc/machine-id</code>." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfDevice> ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDevice> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_uuid_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/os_machine_uuid"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/osint> dcterms:title "OSINT" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/osint"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/osint"^^xsd:anyURI ;
	linkml:description "The OSINT (Open Source Intelligence) object contains details related to an indicator such as the indicator itself, related indicators, geolocation, registrar information, subdomains, analyst commentary, and other contextual information. This information can be used to further enrich a detection or finding by providing decisioning support to other analysts and engineers." ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfOsintProfile> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfOsintProfile> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfOsint> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/osint"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ou_name> dcterms:title "Org Unit Name" ;
