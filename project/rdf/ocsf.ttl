	linkml:mixin true ;
	linkml:slot_usage _:c14n664 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile_ai_agent> , <https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile_ai_model> , <https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile_delegation> , <https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile_message_context> .
<https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile_ai_agent> dcterms:title "AI Agent" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/ai_agent"^^xsd:anyURI ;
