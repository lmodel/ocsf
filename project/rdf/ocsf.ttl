	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfOsintInventoryInfo"^^xsd:anyURI ;
	linkml:description "OSINT Inventory Info events report open source intelligence or threat intelligence inventory data that is either logged or proactively collected. For example, when collecting OSINT information from Threat Intelligence Platforms (TIPs) or Extended Detection and Response (XDR) platforms, or collecting data from OSINT or other generic threat intelligence and enrichment feeds such as APIs and datastores." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
