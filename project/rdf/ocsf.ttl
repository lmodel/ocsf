	linkml:typeof <https://w3id.org/lmodel/ocsf/integer> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_mac_t> dcterms:title "MAC Address" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n4209 , _:c14n5049 , _:c14n581 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfMacT"^^xsd:anyURI ;
	linkml:description "Media Access Control (MAC) address. For example:<br><code>18:36:F3:98:4F:9A</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:pattern "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$" ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_max_len> a linkml:SlotDefinition ;
	linkml:description "OCSF's longest allowed value of a data type, in characters." .
<https://w3id.org/lmodel/ocsf/ocsf_observable> a linkml:SlotDefinition ;
	linkml:description "OCSF's observable type id for the element." .
<https://w3id.org/lmodel/ocsf/ocsf_port_t> dcterms:title "Port" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n3461 , _:c14n389 ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfPortT"^^xsd:anyURI ;
	linkml:description "The TCP/UDP port number. For example:<br><code>80</code>,<br><code>22</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:maximum_value "65535"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_process_name_t> dcterms:title "Process Name" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n269 , _:c14n5670 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfProcessNameT"^^xsd:anyURI ;
