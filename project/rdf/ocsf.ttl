	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfFingerprint> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/serialization"^^xsd:anyURI ;
	linkml:usage_slot_name "serialization" .
<https://w3id.org/lmodel/ocsf/OcsfFingerprint_serialization_id> dcterms:title "Serialization ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/serialization_id"^^xsd:anyURI ;
	skos:prefLabel "serialization_id" ;
	linkml:annotations _:c14n1499 ;
	linkml:any_of _:c14n1040 , _:c14n1518 , _:c14n1959 , _:c14n3925 , _:c14n4402 , _:c14n4916 , _:c14n5711 , _:c14n6064 , _:c14n6140 , _:c14n6495 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/serialization_id"^^xsd:anyURI ;
	linkml:description "The identifier of the normalized canonical serialization scheme used to produce the deterministic byte sequence that was fingerprinted. A verifier must apply the same scheme to reproduce the fingerprinted input. Use <code>Flat</code> where the fingerprinted data is an opaque byte sequence, such as file content, to which no canonical serialization was applied. Distinct from <code>algorithm_id</code>, which identifies how the resulting bytes were hashed." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfFingerprint> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfFingerprint> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/serialization_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfFingerprint> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/serialization_id"^^xsd:anyURI ;
	linkml:usage_slot_name "serialization_id" .
<https://w3id.org/lmodel/ocsf/OcsfFingerprint_value> dcterms:title "Value" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/value"^^xsd:anyURI ;
	skos:prefLabel "value" ;
