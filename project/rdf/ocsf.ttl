<https://w3id.org/lmodel/ocsf/agent> dcterms:title "Agent" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/agent"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/agent"^^xsd:anyURI ;
	linkml:description "An Agent (also known as a Sensor) is typically installed on an Operating System (OS) and serves as a specialized software component that can be designed to monitor, detect, collect, archive, or take action. These activities and possible actions are defined by the upstream system controlling the Agent and its intended purpose. For instance, an Agent can include Endpoint Detection & Response (EDR) agents, backup/disaster recovery sensors, Application Performance Monitoring or profiling sensors, and similar software." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfAgent> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/agent"^^xsd:anyURI .
