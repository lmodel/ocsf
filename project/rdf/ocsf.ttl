	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfDceRpc> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/opnum"^^xsd:anyURI .
