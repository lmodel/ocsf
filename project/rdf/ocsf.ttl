	linkml:description "Detailed information about the policy document that defines this restriction, including policy metadata, type, scope, and the specific rules or conditions that implement the access control." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAdditionalRestriction> ;
