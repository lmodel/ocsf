	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_profiles> a linkml:SlotDefinition ;
	linkml:description "The profiles behind an element, by OCSF's key and space separated. An event holds an attribute that names any only if metadata.profiles lists one of them. On a class, they are every profile OCSF lists for it, its nested objects' included." .
<https://w3id.org/lmodel/ocsf/ocsf_reg_key_path_t> dcterms:title "Registry Key Path" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1575 , _:c14n719 , _:c14n804 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfRegKeyPathT"^^xsd:anyURI ;
	linkml:description "Full path of registry key." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_requirement> a linkml:SlotDefinition ;
	linkml:description "OCSF's requirement on an attribute a profile brings, which applies only when the event lists the profile." .
<https://w3id.org/lmodel/ocsf/ocsf_resource_uid_t> dcterms:title "Resource UID" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n418 , _:c14n6059 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfResourceUidT"^^xsd:anyURI ;
	linkml:description "Resource unique identifier. For example, S3 Bucket name or EC2 Instance ID." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_sibling> a linkml:SlotDefinition ;
	linkml:description "The string attribute that holds the label of an enumerated one." .
<https://w3id.org/lmodel/ocsf/ocsf_source_note> a linkml:SlotDefinition ;
	linkml:description "OCSF's note on where an attribute comes from." .
<https://w3id.org/lmodel/ocsf/ocsf_string_t> dcterms:title "String" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n105 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfStringT"^^xsd:anyURI ;
	linkml:description "UTF-8 encoded byte sequence." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_subnet_t> dcterms:title "Subnet" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1185 , _:c14n2715 , _:c14n3713 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfSubnetT"^^xsd:anyURI ;
	linkml:description "The subnet represented in a CIDR notation, using the format network_address/prefix_length. The network_address can be in either IPv4 or IPv6 format. The prefix length indicates the number of bits used for the network portion, and the remaining bits are available for host addresses within that subnet. For example:<br><code>192.168.1.0/24</code>,<br><code>2001:0db8:85a3:0000::/64</code>" ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_superseded_by> a linkml:SlotDefinition ;
	linkml:description "What OCSF names as the replacement, space separated." .
<https://w3id.org/lmodel/ocsf/ocsf_suppress_checks> a linkml:SlotDefinition ;
	linkml:description "The convention checks OCSF turns off for an attribute." .
<https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> dcterms:title "Timestamp" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n4096 ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfTimestampT"^^xsd:anyURI ;
	linkml:description "The timestamp format is the number of milliseconds since the Epoch 01/01/1970 00:00:00 UTC. For example:<br><code>1618524549901</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_url_t> dcterms:title "URL String" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n4207 , _:c14n5818 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfUrlT"^^xsd:anyURI ;
	linkml:description "Uniform Resource Locator (URL) string. For example:<br><code>http://www.example.com/download/trouble.exe</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_username_t> dcterms:title "User Name" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n1201 , _:c14n3215 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfUsernameT"^^xsd:anyURI ;
	linkml:description "User name. For example:<br><code>john_doe</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/ocsf_uuid_t> dcterms:title "UUID" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n4993 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfUuidT"^^xsd:anyURI ;
	linkml:description "128-bit universal unique identifier. For example:<br><code>123e4567-e89b-12d3-a456-42661417400</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:pattern "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" ;
	linkml:typeof <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/office_location> dcterms:title "Office Location" ;
	a linkml:SlotDefinition ;
