<https://w3id.org/lmodel/ocsf/OcsfToken> dcterms:title "Token" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfToken"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n2970 , _:c14n4651 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfToken"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfToken"^^xsd:anyURI ;
	linkml:description "The Token object is the base object for representing tokens, API keys, and authentication credentials used across different contexts. This object provides common attributes for all token types, including protocol-specific authentication tokens (Kerberos, OIDC, SAML) and API/client tokens used for service authentication. When to use this object: Use the base <code>token</code> object directly in API activity events to represent API tokens, client tokens, or API keys used to authenticate API requests. Examples include: Okta API tokens, Microsoft Entra ID Application Registration client secrets, Stripe API keys, AWS API keys. When NOT to use this object: Do NOT use the base <code>token</code> object for protocol-specific authentication tokens in authentication events - use <code>authentication_token</code> instead (which extends this object). Do NOT use <code>token</code> for tracking credential lifecycle and usage patterns - use <code>programmatic_credential</code> instead." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n2250 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfToken_created_time> , <https://w3id.org/lmodel/ocsf/OcsfToken_created_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfToken_expiration_time> , <https://w3id.org/lmodel/ocsf/OcsfToken_expiration_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfToken_is_renewable> , <https://w3id.org/lmodel/ocsf/OcsfToken_modified_time> , <https://w3id.org/lmodel/ocsf/OcsfToken_modified_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfToken_name> , <https://w3id.org/lmodel/ocsf/OcsfToken_tenant_uid> , <https://w3id.org/lmodel/ocsf/OcsfToken_type> , <https://w3id.org/lmodel/ocsf/OcsfToken_type_id> , <https://w3id.org/lmodel/ocsf/OcsfToken_uid> , <https://w3id.org/lmodel/ocsf/OcsfToken_zone> .
