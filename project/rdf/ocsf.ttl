	skos:prefLabel "malware_scan_info" ;
	linkml:annotations _:c14n242 , _:c14n2725 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/malware_scan_info"^^xsd:anyURI ;
	linkml:description "Describes details about the scan job that identified malware on the target system." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfSecurityControlProfile_malware_scan_info> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfMalwareScanInfo> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/malware_scan_info"^^xsd:anyURI ;
	linkml:usage_slot_name "malware_scan_info" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_message> dcterms:title "Message" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/message"^^xsd:anyURI ;
	skos:prefLabel "message" ;
	linkml:annotations _:c14n3437 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/message"^^xsd:anyURI ;
	linkml:description "A human-readable description of the event, as defined by the source. This should be a concise, meaningful summary suitable for display in a UI or alert notification - not a raw log line. For example: <code>\"User john_doe logged in from 10.0.0.1.\"</code> rather than a raw syslog string." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/message> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/message"^^xsd:anyURI ;
	linkml:usage_slot_name "message" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_metadata> dcterms:title "Metadata" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/metadata"^^xsd:anyURI ;
	skos:prefLabel "metadata" ;
	linkml:annotations _:c14n1849 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/metadata"^^xsd:anyURI ;
	linkml:description "The metadata object describes the event producer, schema version, and processing information. Producers and mappers <b>must</b> populate <code>metadata.product</code> to identify the data source, and <code>metadata.version</code> to indicate the OCSF schema version used. Consumers rely on this to interpret the event correctly." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/metadata> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfMetadata> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/metadata"^^xsd:anyURI ;
	linkml:usage_slot_name "metadata" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_observables> dcterms:title "Observables" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/ocsf/ocsf-docs/blob/main/articles/defining-and-using-observables.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observables"^^xsd:anyURI ;
	skos:prefLabel "observables" ;
	linkml:annotations _:c14n1316 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observables"^^xsd:anyURI ;
	linkml:description "The observables array surfaces key indicators and entities from the event or finding in a single, consistent location for downstream correlation and detection. Each entry references an attribute path within the event (e.g., <code>src_endpoint.ip</code>) along with its type and value, enabling consumers to extract IOCs without parsing the full event structure." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observables> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfObservable> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observables"^^xsd:anyURI ;
	linkml:usage_slot_name "observables" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_policy> dcterms:title "Policy" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/policy"^^xsd:anyURI ;
	skos:prefLabel "policy" ;
	linkml:annotations _:c14n4368 , _:c14n6509 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/policy"^^xsd:anyURI ;
	linkml:description "Describes details of a policy. See specific usage." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfSecurityControlProfile_policy> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfPolicy> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/policy"^^xsd:anyURI ;
	linkml:usage_slot_name "policy" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_raw_data> dcterms:title "Raw Data" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/raw_data"^^xsd:anyURI ;
	skos:prefLabel "raw_data" ;
	linkml:annotations _:c14n2213 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/raw_data"^^xsd:anyURI ;
	linkml:description "The original event/finding data as received from the source, before normalization into OCSF. Populate this with the verbatim log line, JSON payload, or other native format for forensic and debugging purposes. This field is not intended for structured querying - use the normalized OCSF attributes instead." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/raw_data> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/raw_data"^^xsd:anyURI ;
	linkml:usage_slot_name "raw_data" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_raw_data_hash> dcterms:title "Raw Data Hash" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/raw_data_hash"^^xsd:anyURI ;
	skos:prefLabel "raw_data_hash" ;
	linkml:annotations _:c14n6633 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/raw_data_hash"^^xsd:anyURI ;
	linkml:description "A fingerprint (hash) of the <code>raw_data</code> content. Use this to verify the integrity of the original event data or to deduplicate events." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/raw_data_hash> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfFingerprint> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/raw_data_hash"^^xsd:anyURI ;
	linkml:usage_slot_name "raw_data_hash" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_raw_data_size> dcterms:title "Raw Data Size" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/raw_data_size"^^xsd:anyURI ;
	skos:prefLabel "raw_data_size" ;
	linkml:annotations _:c14n4480 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/raw_data_size"^^xsd:anyURI ;
	linkml:description "The size of the original event data (as captured in <code>raw_data</code>) in bytes, before OCSF normalization. Useful for metering and capacity planning." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/raw_data_size> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/raw_data_size"^^xsd:anyURI ;
	linkml:usage_slot_name "raw_data_size" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_severity> dcterms:title "Severity" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/severity"^^xsd:anyURI ;
	skos:prefLabel "severity" ;
	linkml:annotations _:c14n5557 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/severity"^^xsd:anyURI ;
	linkml:description "The event/finding severity label, normalized to the caption of the <code>severity_id</code> value. When <code>severity_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific severity label. For all other values, this should match the caption defined for that <code>severity_id</code> enum value (e.g., <code>\"High\"</code> for <code>severity_id: 4</code>)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/severity> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/severity"^^xsd:anyURI ;
	linkml:usage_slot_name "severity" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_severity_id> dcterms:title "Severity ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/severity_id"^^xsd:anyURI ;
	skos:prefLabel "severity_id" ;
	linkml:annotations _:c14n2315 , _:c14n886 ;
	linkml:any_of _:c14n1069 , _:c14n2745 , _:c14n3123 , _:c14n3173 , _:c14n4105 , _:c14n4139 , _:c14n5937 , _:c14n6442 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/severity_id"^^xsd:anyURI ;
	linkml:description "<p>The normalized identifier of the event/finding severity.</p>The normalized severity is a measurement the effort and expense required to manage and resolve an event or incident. Smaller numerical values represent lower impact events, and larger numerical values represent higher impact events." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/severity_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/severity_id"^^xsd:anyURI ;
	linkml:usage_slot_name "severity_id" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_start_time> dcterms:title "Start Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/start_time"^^xsd:anyURI ;
	skos:prefLabel "start_time" ;
	linkml:annotations _:c14n2413 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/start_time"^^xsd:anyURI ;
	linkml:description "The time of the earliest event in an aggregate (<code>count</code> &gt; 1). Do not populate for discrete, point-in-time events - use <code>time</code> alone. Subclasses such as findings may redefine this for their own time-range semantics." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/start_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/start_time"^^xsd:anyURI ;
	linkml:usage_slot_name "start_time" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_start_time_dt> dcterms:title "Start Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/start_time_dt"^^xsd:anyURI ;
	skos:prefLabel "start_time_dt" ;
	linkml:annotations _:c14n1368 , _:c14n1437 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/start_time_dt"^^xsd:anyURI ;
	linkml:description "The time of the earliest event in an aggregate (<code>count</code> &gt; 1). Do not populate for discrete, point-in-time events - use <code>time</code> alone. Subclasses such as findings may redefine this for their own time-range semantics." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/start_time_dt> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_datetime_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/start_time_dt"^^xsd:anyURI ;
	linkml:usage_slot_name "start_time_dt" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_status> dcterms:title "Status" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/status"^^xsd:anyURI ;
	skos:prefLabel "status" ;
	linkml:annotations _:c14n3801 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/status"^^xsd:anyURI ;
	linkml:description "The event status label, normalized to the caption of the <code>status_id</code> value. When <code>status_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific status label. For all other values, this must match the caption defined for that <code>status_id</code> enum value (e.g., <code>\"Success\"</code> for <code>status_id: 1</code>)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/status> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/status"^^xsd:anyURI ;
	linkml:usage_slot_name "status" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_status_code> dcterms:title "Status Code" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/status_code"^^xsd:anyURI ;
	skos:prefLabel "status_code" ;
	linkml:annotations _:c14n2515 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/status_code"^^xsd:anyURI ;
	linkml:description "The source-specific status or error code as reported by the event source. For example, a Windows logon failure code (<code>0x18</code>), an HTTP response code (<code>403</code>), or an AWS API error code. This preserves the original code for detailed troubleshooting beyond what <code>status_id</code> conveys." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/status_code> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/status_code"^^xsd:anyURI ;
	linkml:usage_slot_name "status_code" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_status_detail> dcterms:title "Status Detail" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/status_detail"^^xsd:anyURI ;
	skos:prefLabel "status_detail" ;
	linkml:annotations _:c14n5595 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/status_detail"^^xsd:anyURI ;
	linkml:description "A human-readable description providing additional context about the event outcome. Use this to convey details that go beyond the normalized <code>status_id</code> and source-specific <code>status_code</code>, such as a failure reason or error message. For example: <code>\"Account locked after 5 failed attempts.\"</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/status_detail> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/status_detail"^^xsd:anyURI ;
	linkml:usage_slot_name "status_detail" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_status_id> dcterms:title "Status ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/status_id"^^xsd:anyURI ;
	skos:prefLabel "status_id" ;
	linkml:annotations _:c14n2661 , _:c14n4181 ;
	linkml:any_of _:c14n2733 , _:c14n5689 , _:c14n584 , _:c14n627 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/status_id"^^xsd:anyURI ;
	linkml:description "The normalized status of the event outcome. Use this family of attributes to convey the outcome of the activity described by the event. Producers should map their source outcome to <code>1</code> (Success) or <code>2</code> (Failure). Use <code>0</code> (Unknown) when the outcome cannot be determined, and <code>99</code> (Other) with a populated <code>status</code> string when the source value does not map cleanly." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/status_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/status_id"^^xsd:anyURI ;
	linkml:usage_slot_name "status_id" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_time> dcterms:title "Event Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/time"^^xsd:anyURI ;
	skos:prefLabel "time" ;
	linkml:annotations _:c14n2606 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/time"^^xsd:anyURI ;
	linkml:description "The primary timestamp of the event - when the activity actually occurred at the source. This does not capture when the event record was created or serialized by the source system; for event lifecycle timestamps such as ingestion and processing, use <code>metadata.logged_time</code> and <code>metadata.processed_time</code> respectively, or the equivalent attributes in the <code>metadata.loggers</code> array when recording pipeline stages. For aggregate events (<code>count</code> &gt; 1), set this to <code>start_time</code> (the earliest OCSF <code>time</code> in the aggregate) to preserve causal ordering and consistent timeline alignment. Note: finding classes redefine <code>time</code> as the finding creation time rather than the activity occurrence time. This <b>must</b> be a UTC epoch value in milliseconds (e.g., <code>1776881335332</code>). Mappers should use the most precise and authoritative timestamp available from the source." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/time"^^xsd:anyURI ;
	linkml:usage_slot_name "time" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_time_dt> dcterms:title "Event Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/time_dt"^^xsd:anyURI ;
	skos:prefLabel "time_dt" ;
	linkml:annotations _:c14n1351 , _:c14n4043 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/time_dt"^^xsd:anyURI ;
	linkml:description "The primary timestamp of the event - when the activity actually occurred at the source. This does not capture when the event record was created or serialized by the source system; for event lifecycle timestamps such as ingestion and processing, use <code>metadata.logged_time</code> and <code>metadata.processed_time</code> respectively, or the equivalent attributes in the <code>metadata.loggers</code> array when recording pipeline stages. For aggregate events (<code>count</code> &gt; 1), set this to <code>start_time</code> (the earliest OCSF <code>time</code> in the aggregate) to preserve causal ordering and consistent timeline alignment. Note: finding classes redefine <code>time</code> as the finding creation time rather than the activity occurrence time. This <b>must</b> be a UTC epoch value in milliseconds (e.g., <code>1776881335332</code>). Mappers should use the most precise and authoritative timestamp available from the source." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/time_dt> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_datetime_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/time_dt"^^xsd:anyURI ;
	linkml:usage_slot_name "time_dt" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_timezone_offset> dcterms:title "Timezone Offset" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/timezone_offset"^^xsd:anyURI ;
	skos:prefLabel "timezone_offset" ;
	linkml:annotations _:c14n6008 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/timezone_offset"^^xsd:anyURI ;
	linkml:description "The number of minutes that the reported event <code>time</code> is ahead or behind UTC, in the range -1,080 to +1,080. This allows consumers to reconstruct the local time at the event source. For example, US Eastern Standard Time is <code>-300</code>. Populate this when the source provides local time zone information." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/timezone_offset> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/timezone_offset"^^xsd:anyURI ;
	linkml:usage_slot_name "timezone_offset" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_type_name> dcterms:title "Type Name" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/type_name"^^xsd:anyURI ;
	skos:prefLabel "type_name" ;
	linkml:annotations _:c14n1814 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/type_name"^^xsd:anyURI ;
	linkml:description "The event/finding type name, combining the class and activity (e.g., <code>\"Detection Finding: Create\"</code>). The value must match the <code>class_name</code> and <code>activity_name</code> joined by <code>\": \"</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/type_name> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_name"^^xsd:anyURI ;
	linkml:usage_slot_name "type_name" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_type_uid> dcterms:title "Type ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	skos:prefLabel "type_uid" ;
	linkml:annotations _:c14n2231 , _:c14n3354 ;
	linkml:any_of _:c14n3841 , _:c14n569 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:description "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/type_uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "type_uid" .
<https://w3id.org/lmodel/ocsf/OcsfBaseEvent_unmapped> dcterms:title "Unmapped Data" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/ocsf/ocsf-docs/blob/main/faqs/schema-faq.md#when-should-i-use-the-unmapped-attribute"^^xsd:anyURI , "https://github.com/ocsf/ocsf-schema/blob/main/CONTRIBUTING.md#ocsf-extensions"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/unmapped"^^xsd:anyURI ;
	skos:prefLabel "unmapped" ;
	linkml:annotations _:c14n450 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/unmapped"^^xsd:anyURI ;
	linkml:description "A container for source-specific attributes that do not map to any defined OCSF attribute. Use this to preserve valuable source data that would otherwise be lost during normalization. The keys and values are specific to the event source. <p><b>Note: </b>Consumers should not rely on a stable structure within this field. The preferred approach to unmapped attributes is to create a custom extension with the desired structure.</p>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/unmapped> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseEvent> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfObject> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/unmapped"^^xsd:anyURI ;
	linkml:usage_slot_name "unmapped" .
<https://w3id.org/lmodel/ocsf/OcsfBaseline> dcterms:title "Baseline" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfBaseline"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n1089 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfBaseline"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfBaseline"^^xsd:anyURI ;
	linkml:description "Describes the baseline or expected behavior of a system, service, or component based on historical observations and measurements. It establishes reference points for comparison to detect anomalies, trends, and deviations from typical patterns." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n3602 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfBaseline_observation_parameter> , <https://w3id.org/lmodel/ocsf/OcsfBaseline_observation_type> , <https://w3id.org/lmodel/ocsf/OcsfBaseline_observations> , <https://w3id.org/lmodel/ocsf/OcsfBaseline_observed_pattern> .
<https://w3id.org/lmodel/ocsf/OcsfBaseline_observation_parameter> dcterms:title "Observation Parameter" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observation_parameter"^^xsd:anyURI ;
	skos:prefLabel "observation_parameter" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observation_parameter"^^xsd:anyURI ;
	linkml:description "The specific parameter or property being monitored. Examples include: CPU usage percentage, API response time in milliseconds, HTTP error rate, memory utilization, network latency, transaction volume, etc." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observation_parameter> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observation_parameter"^^xsd:anyURI ;
	linkml:usage_slot_name "observation_parameter" .
<https://w3id.org/lmodel/ocsf/OcsfBaseline_observation_type> dcterms:title "Observation Type" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	skos:prefLabel "observation_type" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	linkml:description "The type of analysis being performed to establish baseline behavior. Common types include: Frequency Analysis, Time Pattern Analysis, Volume Analysis, Sequence Analysis, Distribution Analysis, etc." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observation_type> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observation_type"^^xsd:anyURI ;
	linkml:usage_slot_name "observation_type" .
<https://w3id.org/lmodel/ocsf/OcsfBaseline_observations> dcterms:title "Observations" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observations"^^xsd:anyURI ;
	skos:prefLabel "observations" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observations"^^xsd:anyURI ;
	linkml:description "Collection of actual measured values, data points and observations recorded for this baseline." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observations> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfObservation> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observations"^^xsd:anyURI ;
	linkml:usage_slot_name "observations" .
<https://w3id.org/lmodel/ocsf/OcsfBaseline_observed_pattern> dcterms:title "Observed Pattern" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/observed_pattern"^^xsd:anyURI ;
	skos:prefLabel "observed_pattern" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/observed_pattern"^^xsd:anyURI ;
	linkml:description "The specific pattern identified within the observation type. For Frequency Analysis, this could be 'FREQUENT', 'INFREQUENT', 'RARE', or 'UNSEEN'. For Time Pattern Analysis, this could be 'BUSINESS_HOURS', 'OFF_HOURS', or 'UNUSUAL_TIME'. For Volume Analysis, this could be 'NORMAL_VOLUME', 'HIGH_VOLUME', or 'SURGE'. The pattern values are specific to each observation type and indicate the baseline behavior." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/observed_pattern> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfBaseline> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/observed_pattern"^^xsd:anyURI ;
	linkml:usage_slot_name "observed_pattern" .
<https://w3id.org/lmodel/ocsf/OcsfCampaign> dcterms:title "Campaign" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfCampaign"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n1399 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfCampaign"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCampaign"^^xsd:anyURI ;
	linkml:description "Campaign represent organized efforts by threat actors to achieve malicious objectives over a period, often characterized by shared tactics, techniques, and procedures (TTPs)." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n989 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfCampaign_name> .
<https://w3id.org/lmodel/ocsf/OcsfCampaign_name> dcterms:title "Name" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/name"^^xsd:anyURI ;
	skos:prefLabel "name" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/name"^^xsd:anyURI ;
	linkml:description "The name of a specific campaign associated with a cyber threat." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCampaign> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCampaign> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/name> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCampaign> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/name"^^xsd:anyURI ;
	linkml:usage_slot_name "name" .
<https://w3id.org/lmodel/ocsf/OcsfCertificate> dcterms:title "Digital Certificate" ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://d3fend.mitre.org/dao/artifact/d3f:Certificate/"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfCertificate"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:relatedMatch "d3f:Certificate"^^xsd:anyURI ;
	linkml:annotations _:c14n1902 , _:c14n4912 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfCertificate"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCertificate"^^xsd:anyURI ;
	linkml:description "The Digital Certificate, also known as a Public Key Certificate, object contains information about the ownership and usage of a public key. It serves as a means to establish trust in the authenticity and integrity of the public key and the associated entity." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n2676 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfCertificate_created_time> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_created_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_expiration_time> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_expiration_time_dt> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_fingerprints> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_is_self_signed> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_issuer> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_serial_number> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_subject> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_uid> , <https://w3id.org/lmodel/ocsf/OcsfCertificate_version> , <https://w3id.org/lmodel/ocsf/sans> .
<https://w3id.org/lmodel/ocsf/OcsfCertificate_created_time> dcterms:title "Created Time" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/created_time"^^xsd:anyURI ;
	skos:prefLabel "created_time" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/created_time"^^xsd:anyURI ;
	linkml:description "The time when the certificate was created." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCertificate> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCertificate> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/created_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCertificate> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/created_time"^^xsd:anyURI ;
	linkml:usage_slot_name "created_time" .
<https://w3id.org/lmodel/ocsf/OcsfCertificate_created_time_dt> dcterms:title "Created Time" ;
