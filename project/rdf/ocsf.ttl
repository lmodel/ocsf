<https://w3id.org/lmodel/ocsf/OcsfIncidentFinding_confidence_id> dcterms:title "Confidence ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/confidence_id"^^xsd:anyURI ;
	skos:prefLabel "confidence_id" ;
	linkml:annotations _:c14n2755 , _:c14n5654 ;
	linkml:any_of _:c14n1242 , _:c14n2506 , _:c14n2741 , _:c14n5356 , _:c14n5735 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/confidence_id"^^xsd:anyURI ;
	linkml:description "The normalized identifier of the confidence level for this incident, representing a summary across all aggregated findings. It reflects the accuracy of the analytics that produced those findings. A lower confidence value indicates a wider finding scope that may produce noisy or potentially non-malicious reports. When the value is <code>99</code> (Other), the <code>confidence</code> attribute must contain the incident-specific label." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfIncidentFinding> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfIncidentFinding> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfSecurityControlProfile_confidence_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfIncidentFinding> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/confidence_id"^^xsd:anyURI ;
	linkml:usage_slot_name "confidence_id" .
<https://w3id.org/lmodel/ocsf/OcsfIncidentFinding_confidence_score> dcterms:title "Confidence Score" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/confidence_score"^^xsd:anyURI ;
	skos:prefLabel "confidence_score" ;
	linkml:annotations _:c14n5041 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/confidence_score"^^xsd:anyURI ;
	linkml:description "The confidence score assigned to the incident by the system or analyst, expressed on a source-specific numeric scale. This score provides finer-grained confidence information than the categorical <code>confidence_id</code> value. When <code>confidence_id</code> is <code>99</code> (Other), the <code>confidence</code> attribute should reflect the same assessment if both are populated." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfIncidentFinding> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfIncidentFinding> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfSecurityControlProfile_confidence_score> ;
