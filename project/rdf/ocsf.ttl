	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_boolean_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/is_alert"^^xsd:anyURI ;
	linkml:usage_slot_name "is_alert" .
