	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/confidence_score"^^xsd:anyURI ;
	linkml:usage_slot_name "confidence_score" .
