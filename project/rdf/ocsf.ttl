<https://w3id.org/lmodel/ocsf/OcsfCompliance_control> dcterms:title "Security Control" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.aws.amazon.com/awscloudtrail/latest/userguide/cloudtrail-user-guide.html"^^xsd:anyURI , "https://www.cisecurity.org/benchmark/amazon_web_services"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
