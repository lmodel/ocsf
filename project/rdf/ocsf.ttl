<https://w3id.org/lmodel/ocsf/OcsfResourceDetails_device> dcterms:title "Device" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/device"^^xsd:anyURI ;
	skos:prefLabel "device" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/device"^^xsd:anyURI ;
	linkml:description "The device details when the resource type is a device — for example, a cloud compute instance, a laptop, or a network appliance. Provides structured device attributes (OS, type, hardware, agent) that the resource's scalar fields cannot represent — beyond what the <code>hostname</code> and <code>ip</code> attributes capture. The <code>device.name</code> and <code>device.uid</code> should match the <code>name</code> and <code>uid</code> of this objects; the <code>device.hostname</code> value should match the <code>hostname</code> attribute of this object. The top-level <code>hostname</code> and <code>ip</code> remain the primary identifiers for the device resource." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfResourceDetails> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfResourceDetails> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/device> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfResourceDetails> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfDevice> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/device"^^xsd:anyURI ;
	linkml:usage_slot_name "device" .
