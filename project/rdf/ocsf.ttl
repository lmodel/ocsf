<https://w3id.org/lmodel/ocsf/OcsfAiAgent> dcterms:title "AI Agent" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfAiAgent"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n4498 , _:c14n6192 , _:c14n686 ;
	linkml:any_of _:c14n5634 , _:c14n5834 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfAiAgent"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfAiAgent"^^xsd:anyURI ;
	linkml:description "An autonomous AI agent that performs tasks under delegated authority. Distinguished from the OCSF agent object (which describes security sensors such as EDR and DLP tools) and from human principals. An AI agent has a stable logical identity across runs and a restart-sensitive instance identity. The agent owns its model; the ai_model attribute captures which model was backing the agent at the time of action." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfEntity> ;
	linkml:slot_usage _:c14n6440 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfAiAgent_ai_model> , <https://w3id.org/lmodel/ocsf/OcsfAiAgent_charter> , <https://w3id.org/lmodel/ocsf/OcsfAiAgent_instance_uid> , <https://w3id.org/lmodel/ocsf/OcsfAiAgent_name> , <https://w3id.org/lmodel/ocsf/OcsfAiAgent_type> , <https://w3id.org/lmodel/ocsf/OcsfAiAgent_type_id> , <https://w3id.org/lmodel/ocsf/OcsfAiAgent_uid> , <https://w3id.org/lmodel/ocsf/OcsfAiAgent_version> , <https://w3id.org/lmodel/ocsf/OcsfEntity_uid_numeric> .
<https://w3id.org/lmodel/ocsf/OcsfAiAgent_ai_model> dcterms:title "AI Model" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
