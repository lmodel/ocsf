	linkml:definition_uri "https://w3id.org/lmodel/ocsf/stratum_id"^^xsd:anyURI ;
	linkml:description "The normalized identifier of the stratum level of an NTP server's time source, as defined in RFC 5905. Levels range from 0 to 16, with lower numbers representing higher accuracy and greater proximity to the root clock." ;
