	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfDnsSection"^^xsd:anyURI ;
	linkml:description "The DNS Section object represents a DNS message section that carries supplementary resource records alongside an optional TSIG record. It is used for both the client Additional section (<code>query_additional</code>) and the server Additional section (<code>response_additional</code>) of a DNS message. A DNS message has at most one TSIG record, which authenticates the entire message." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n3591 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfDnsSection_records> , <https://w3id.org/lmodel/ocsf/OcsfDnsSection_tsig> .
