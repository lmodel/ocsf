	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/opcode_id"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/open_mask> dcterms:title "Open Mask" ;
	a linkml:SlotDefinition ;
