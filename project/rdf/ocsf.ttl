	linkml:description "Criticality or relative importance of this resource, normalized to the caption of <code>criticality_id</code>. In the case of Other, the value is defined by the event source.<p>Note: For versions prior to 1.9, <code>criticality_id</code> was not available and this is a source specific value.<p>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfResourceDetails> ;
