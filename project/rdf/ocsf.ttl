	skos:prefLabel "created_time" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/created_time"^^xsd:anyURI ;
	linkml:description "The time that the authentication token was created or issued. This corresponds to the token issuance time, such as the <code>iat</code> (issued at) claim in OIDC tokens, the issue instant in SAML assertions, or the ticket start time in Kerberos tickets." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfAuthenticationToken> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfAuthenticationToken> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfToken_created_time> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAuthenticationToken> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_timestamp_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/created_time"^^xsd:anyURI ;
	linkml:usage_slot_name "created_time" .
