<https://w3id.org/lmodel/ocsf/OcsfCloudResourcesInventoryInfo_type_uid> dcterms:title "Type ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	skos:prefLabel "type_uid" ;
	linkml:annotations _:c14n4435 ;
	linkml:any_of _:c14n3732 , _:c14n3787 , _:c14n4605 , _:c14n6728 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:description "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCloudResourcesInventoryInfo> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCloudResourcesInventoryInfo> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfBaseEvent_type_uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCloudResourcesInventoryInfo> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "type_uid" .
<https://w3id.org/lmodel/ocsf/OcsfCloud_account> dcterms:title "Account" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/account"^^xsd:anyURI ;
	skos:prefLabel "account" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/account"^^xsd:anyURI ;
	linkml:description "The Account object containing details about the cloud account, subscription, or billing unit where the event or finding was created. This object includes properties such as the account name, unique identifier, type, labels, and tags.<br/><br/><strong>Examples:</strong><ul><li><strong>AWS:</strong> Account object with <code>name</code>, <code>uid</code> (Account ID), <code>type</code>, and other account properties</li><li><strong>Azure:</strong> Subscription object with <code>name</code>, <code>uid</code> (Subscription ID), <code>type</code>, and subscription metadata</li><li><strong>GCP:</strong> Project object with <code>name</code>, <code>uid</code> (Project ID), <code>type</code>, and project attributes</li><li><strong>Oracle Cloud:</strong> Compartment object with <code>name</code>, <code>uid</code> (Tenancy OCID), <code>type</code>, and compartment details</li></ul>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/account> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfAccount> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/account"^^xsd:anyURI ;
	linkml:usage_slot_name "account" .
<https://w3id.org/lmodel/ocsf/OcsfCloud_cloud_partition> dcterms:title "Cloud Partition" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/cloud_partition"^^xsd:anyURI ;
	skos:prefLabel "cloud_partition" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/cloud_partition"^^xsd:anyURI ;
	linkml:description "The logical grouping or isolated segment within a cloud provider's infrastructure where the event or finding was created, often used for compliance, governance, or regional separation.<br/><br/><strong>Examples:</strong><ul><li><strong>AWS:</strong> Partition where the event occurred (<code>aws</code>, <code>aws-cn</code>, <code>aws-us-gov</code>)</li><li><strong>Azure:</strong> Cloud environment where the event occurred (<code>AzureCloud</code>, <code>AzureUSGovernment</code>, <code>AzureChinaCloud</code>)</li></ul>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/cloud_partition> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/cloud_partition"^^xsd:anyURI ;
	linkml:usage_slot_name "cloud_partition" .
<https://w3id.org/lmodel/ocsf/OcsfCloud_org> dcterms:title "Organization" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/org"^^xsd:anyURI ;
	skos:prefLabel "org" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/org"^^xsd:anyURI ;
	linkml:description "The Organization object containing details about the organizational unit or management structure that governs the account, subscription, or project where the event or finding was created. This object includes properties such as the organization name, unique identifier, type, and other organizational metadata.<br/><br/><strong>Examples:</strong><ul><li><strong>AWS:</strong> Organization object with <code>name</code>, <code>uid</code> (Organization ID), <code>type</code>, and other organizational properties</li><li><strong>Azure:</strong> Management Group object with <code>name</code>, <code>uid</code> (Management Group ID), <code>type</code>, and management group metadata</li><li><strong>GCP:</strong> Organization object with <code>name</code>, <code>uid</code> (Organization ID), <code>type</code>, and organizational attributes</li><li><strong>Oracle Cloud:</strong> Tenancy object with <code>name</code>, <code>uid</code> (Tenancy OCID), <code>type</code>, and tenancy details</li></ul>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/org> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfOrganization> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/org"^^xsd:anyURI ;
	linkml:usage_slot_name "org" .
<https://w3id.org/lmodel/ocsf/OcsfCloud_provider> dcterms:title "Cloud Provider" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/provider"^^xsd:anyURI ;
	skos:prefLabel "provider" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/provider"^^xsd:anyURI ;
	linkml:description "The unique name of the Cloud services provider where the event or finding was created. Examples include AWS, Azure, GCP (Google Cloud Platform), Oracle Cloud, IBM Cloud, Alibaba Cloud, or other public, private, or hybrid cloud providers." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/provider> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/provider"^^xsd:anyURI ;
	linkml:usage_slot_name "provider" .
<https://w3id.org/lmodel/ocsf/OcsfCloud_region> dcterms:title "Region" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/region"^^xsd:anyURI ;
	skos:prefLabel "region" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/region"^^xsd:anyURI ;
	linkml:description "The cloud region where the event or finding was created, as defined by the cloud provider.<br/><br/><strong>Examples:</strong><ul><li><strong>AWS:</strong> Region where the event occurred (<code>us-east-1</code>, <code>eu-west-1</code>)</li><li><strong>Azure:</strong> Region where the event occurred (<code>East US</code>, <code>West Europe</code>)</li><li><strong>GCP:</strong> Region where the event occurred (<code>us-central1</code>, <code>europe-west1</code>)</li><li><strong>Oracle Cloud:</strong> Region where the event occurred (<code>us-ashburn-1</code>, <code>uk-london-1</code>)</li></ul>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/region> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/region"^^xsd:anyURI ;
	linkml:usage_slot_name "region" .
<https://w3id.org/lmodel/ocsf/OcsfCloud_zone> dcterms:title "Cloud Availability Zone" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/zone"^^xsd:anyURI ;
	skos:prefLabel "zone" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/zone"^^xsd:anyURI ;
	linkml:description "The availability zone in the cloud region where the event or finding was created, as defined by the cloud provider.<br/><br/><strong>Examples:</strong><ul><li><strong>AWS:</strong> Availability zone where the event occurred (<code>us-east-1a</code>, <code>us-east-1b</code>)</li><li><strong>Azure:</strong> Availability zone where the event occurred (<code>1</code>, <code>2</code>, <code>3</code> within a region)</li><li><strong>GCP:</strong> Availability zone where the event occurred (<code>us-central1-a</code>, <code>us-central1-b</code>)</li><li><strong>Oracle Cloud:</strong> Availability zone where the event occurred (<code>AD-1</code>, <code>AD-2</code>, <code>AD-3</code>)</li></ul>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/zone> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCloud> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/zone"^^xsd:anyURI ;
	linkml:usage_slot_name "zone" .
<https://w3id.org/lmodel/ocsf/OcsfCompliance> dcterms:title "Compliance" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfCompliance"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n314 , _:c14n3755 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfCompliance"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCompliance"^^xsd:anyURI ;
	linkml:description "The Compliance object contains information about Industry and Regulatory Framework standards, controls and requirements or details about custom assessments utilized in a compliance evaluation. Standards define broad security frameworks, controls represent specific security requirements within those frameworks, and checks are the testable verification points used to determine if controls are properly implemented." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n1083 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfCompliance_assessments> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_category> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_checks> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_compliance_references> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_compliance_standards> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_control> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_control_parameters> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_desc> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_requirements> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_standards> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_status> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_status_code> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_status_detail> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_status_details> , <https://w3id.org/lmodel/ocsf/OcsfCompliance_status_id> .
<https://w3id.org/lmodel/ocsf/OcsfComplianceFinding> dcterms:title "Compliance Finding" ;
	OIO:inSubset <https://w3id.org/lmodel/ocsf/ocsf_category_findings> ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfComplianceFinding"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_events_findings"^^xsd:anyURI ;
	linkml:annotations _:c14n2737 , _:c14n284 , _:c14n5498 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfComplianceFinding"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfComplianceFinding"^^xsd:anyURI ;
	linkml:description "Compliance Finding events describe results of evaluations performed against resources, to check compliance with various Industry Frameworks or Security Standards such as <code>NIST SP 800-53, CIS AWS Foundations Benchmark v1.4.0, ISO/IEC 27001</code> etc. Note: if the event producer is a security control, the <code>security_control</code> profile should be applied and its <code>attacks</code> information, if present, should be duplicated into the <code>finding_info</code> object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the <code>incident</code> profile or aggregate this finding into an <code>Incident Finding</code>." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
