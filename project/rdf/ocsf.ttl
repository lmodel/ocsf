<https://w3id.org/lmodel/ocsf/OcsfApi_token> dcterms:title "Token" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/token"^^xsd:anyURI ;
	skos:prefLabel "token" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/token"^^xsd:anyURI ;
	linkml:description "The API or client token used to authenticate or authorize the API request. This attribute contains the base <code>token</code> object that represents: (1) IdP-issued client tokens (type_id: 6) such as Okta API tokens or Microsoft Entra ID Application Registration client secrets, or (2) generic API tokens/keys (type_id: 7) used for SaaS application authentication. Use this attribute when the API request was authenticated using a token that should be tracked as part of the API activity event. Note: Protocol-specific authentication tokens (Kerberos, OIDC, SAML) should be represented using <code>authentication_token</code> in authentication events, not in API activity events." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfApi> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfApi> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/token> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfApi> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfToken> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/token"^^xsd:anyURI ;
	linkml:usage_slot_name "token" .
