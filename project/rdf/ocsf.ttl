	linkml:range <https://w3id.org/lmodel/ocsf/OcsfNetworkEndpoint> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/network_observation_point"^^xsd:anyURI ;
	linkml:usage_slot_name "network_observation_point" .
