<https://w3id.org/lmodel/ocsf/OcsfPacket_sequence_number> dcterms:title "Sequence Number" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/sequence_number"^^xsd:anyURI ;
	skos:prefLabel "sequence_number" ;
