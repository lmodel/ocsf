<https://w3id.org/lmodel/ocsf/OcsfComplianceFinding_type_uid> dcterms:title "Type ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	skos:prefLabel "type_uid" ;
	linkml:annotations _:c14n1667 ;
	linkml:any_of _:c14n2186 , _:c14n2757 , _:c14n4615 , _:c14n4990 , _:c14n6130 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:description "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfComplianceFinding> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfComplianceFinding> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfBaseEvent_type_uid> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfComplianceFinding> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_long_t> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/type_uid"^^xsd:anyURI ;
	linkml:usage_slot_name "type_uid" .
