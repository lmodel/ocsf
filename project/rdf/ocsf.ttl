	rdfs:seeAlso "https://www.lockheedmartin.com/en-us/capabilities/cyber/cyber-kill-chain.html"^^xsd:anyURI ;
	skos:exactMatch "ocsf:OcsfKillChainPhase"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
