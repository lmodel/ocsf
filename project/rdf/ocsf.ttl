	skos:prefLabel "malware" ;
	linkml:annotations _:c14n5098 , _:c14n5418 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/malware"^^xsd:anyURI ;
	linkml:description "A list of Malware objects, describing details about the identified malware." ;
