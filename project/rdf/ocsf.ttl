	linkml:slot_uri "https://w3id.org/lmodel/ocsf/analyzed_privileges_count"^^xsd:anyURI ;
	linkml:usage_slot_name "analyzed_privileges_count" .
<https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult_condition_keys> dcterms:title "Condition Keys" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/condition_keys"^^xsd:anyURI ;
	skos:prefLabel "condition_keys" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/condition_keys"^^xsd:anyURI ;
	linkml:description "The condition keys and their values that were evaluated during policy analysis, including contextual constraints that affect permission grants. These conditions define when and how permissions are applied. Examples: <code>aws:SourceIp:1.2.3.4</code>, <code>aws:RequestedRegion:us-east-1</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfPermissionAnalysisResult> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/condition_keys> ;
