	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfAttestation> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfDigitalSignature> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/signatures"^^xsd:anyURI ;
	linkml:usage_slot_name "signatures" .
