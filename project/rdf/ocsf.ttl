<https://w3id.org/lmodel/ocsf/OcsfCheck> dcterms:title "Check" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfCheck"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n3889 , _:c14n5950 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfCheck"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfCheck"^^xsd:anyURI ;
	linkml:description "The check object defines a specific, testable compliance verification point that evaluates a target device against a standard, framework, or custom requirement. While checks are typically associated with formal standards (like CIS, NIST, or ISO), they can also represent custom or organizational requirements. When mapped to controls, checks can evaluate specific control_parameters to determine compliance status, but neither the control mapping nor control_parameters are required for a valid check." ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/OcsfObjectBase> ;
	linkml:slot_usage _:c14n6132 ;
	linkml:slots <https://w3id.org/lmodel/ocsf/OcsfCheck_desc> , <https://w3id.org/lmodel/ocsf/OcsfCheck_name> , <https://w3id.org/lmodel/ocsf/OcsfCheck_resource> , <https://w3id.org/lmodel/ocsf/OcsfCheck_severity> , <https://w3id.org/lmodel/ocsf/OcsfCheck_severity_id> , <https://w3id.org/lmodel/ocsf/OcsfCheck_standards> , <https://w3id.org/lmodel/ocsf/OcsfCheck_status> , <https://w3id.org/lmodel/ocsf/OcsfCheck_status_id> , <https://w3id.org/lmodel/ocsf/OcsfCheck_uid> , <https://w3id.org/lmodel/ocsf/OcsfCheck_version> .
<https://w3id.org/lmodel/ocsf/OcsfCheck_desc> dcterms:title "Description" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://public.cyber.mil/stigs/downloads"^^xsd:anyURI , "https://www.cisecurity.org/cis-benchmarks"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/desc"^^xsd:anyURI ;
	skos:prefLabel "desc" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/desc"^^xsd:anyURI ;
	linkml:description "The detailed description of the compliance check, explaining the security requirement, vulnerability, or configuration being assessed. For example, CIS: <code>The cramfs filesystem type is a compressed read-only Linux filesystem. Removing support for unneeded filesystem types reduces the local attack surface.</code> or DISA STIG: <code>Unauthorized access to the information system by foreign entities may result in loss or compromise of data.</code>" ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/desc> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/desc"^^xsd:anyURI ;
	linkml:usage_slot_name "desc" .
<https://w3id.org/lmodel/ocsf/OcsfCheck_name> dcterms:title "Name" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://public.cyber.mil/stigs/downloads"^^xsd:anyURI , "https://www.cisecurity.org/cis-benchmarks"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/name"^^xsd:anyURI ;
	skos:prefLabel "name" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/name"^^xsd:anyURI ;
	linkml:description "The name or title of the compliance check. For example, CIS: <code>Ensure mounting of cramfs filesystems is disabled</code> or DISA STIG: <code>The Ubuntu operating system must implement DoD-approved encryption to protect the confidentiality of remote access sessions</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/name> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/name"^^xsd:anyURI ;
	linkml:usage_slot_name "name" .
<https://w3id.org/lmodel/ocsf/OcsfCheck_resource> dcterms:title "Resource" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/resource"^^xsd:anyURI ;
	skos:prefLabel "resource" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/resource"^^xsd:anyURI ;
	linkml:description "Describes details about the resource that this check evaluated." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/resource> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:range <https://w3id.org/lmodel/ocsf/OcsfResourceDetails> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/resource"^^xsd:anyURI ;
	linkml:usage_slot_name "resource" .
<https://w3id.org/lmodel/ocsf/OcsfCheck_severity> dcterms:title "Severity" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://public.cyber.mil/stigs"^^xsd:anyURI , "https://www.cisecurity.org/cis-benchmarks"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/severity"^^xsd:anyURI ;
	skos:prefLabel "severity" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/severity"^^xsd:anyURI ;
	linkml:description "The severity level as defined in the source document. For example CIS Benchmarks, valid values are: <code>Level 1</code> (security-forward, essential settings), <code>Level 2</code> (security-focused environment, more restrictive), or <code>Scored/Not Scored</code> (whether compliance can be automatically checked). For DISA STIG, valid values are: <code>CAT I</code> (maps to severity_id 5/Critical), <code>CAT II</code> (maps to severity_id 4/High), or <code>CAT III</code> (maps to severity_id 3/Medium)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/severity> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/severity"^^xsd:anyURI ;
	linkml:usage_slot_name "severity" .
<https://w3id.org/lmodel/ocsf/OcsfCheck_severity_id> dcterms:title "Severity ID" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/severity_id"^^xsd:anyURI ;
	skos:prefLabel "severity_id" ;
	linkml:annotations _:c14n5503 ;
	linkml:any_of _:c14n1486 , _:c14n2019 , _:c14n2402 , _:c14n2864 , _:c14n3394 , _:c14n5663 , _:c14n6109 , _:c14n6807 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/severity_id"^^xsd:anyURI ;
	linkml:description "The normalized severity identifier that maps severity levels to standard severity levels. For example CIS Benchmark: <code>Level 2</code> maps to <code>4</code> (High), <code>Level 1</code> maps to <code>3</code> (Medium). For DISA STIG: <code>CAT I</code> maps to <code>5</code> (Critical), <code>CAT II</code> maps to <code>4</code> (High), and <code>CAT III</code> maps to <code>3</code> (Medium)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:instantiates "ocsf:OcsfFacts"^^xsd:anyURI ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/severity_id> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_integer_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/severity_id"^^xsd:anyURI ;
	linkml:usage_slot_name "severity_id" .
<https://w3id.org/lmodel/ocsf/OcsfCheck_standards> dcterms:title "Compliance Standards: List" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/publications/detail/sp/800-53/rev-5/final"^^xsd:anyURI , "https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html"^^xsd:anyURI , "https://www.iso.org/standard/54534.html"^^xsd:anyURI , "https://www.pcisecuritystandards.org/document_library"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/standards"^^xsd:anyURI ;
	skos:prefLabel "standards" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/standards"^^xsd:anyURI ;
	linkml:description "The regulatory or industry standard this check is associated with. E.g., <code>PCI DSS 3.2.1</code>, <code>HIPAA Security Rule</code>, <code>NIST SP 800-53 Rev. 5</code>, or <code>ISO/IEC 27001:2013</code>." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:is_a <https://w3id.org/lmodel/ocsf/standards> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_string_t> ;
	linkml:recommended true ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/standards"^^xsd:anyURI ;
	linkml:usage_slot_name "standards" .
<https://w3id.org/lmodel/ocsf/OcsfCheck_status> dcterms:title "Status" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "https://public.cyber.mil/stigs/srg-stig-tools/"^^xsd:anyURI , "https://www.cisecurity.org/cis-benchmarks"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/ocsf/status"^^xsd:anyURI ;
	skos:prefLabel "status" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/status"^^xsd:anyURI ;
	linkml:description "The resultant status of the compliance check normalized to the caption of the <code>status_id</code> value. For example, CIS Benchmark: <code>Pass</code> when all requirements are met, <code>Fail</code> when requirements are not met, or DISA STIG: <code>NotAFinding</code> (maps to status_id 1/Pass), <code>Open</code> (maps to status_id 3/Fail)." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfCheck> ;
