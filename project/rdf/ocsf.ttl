	skos:prefLabel "opnum" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/opnum"^^xsd:anyURI ;
	linkml:description "An operation number used to identify a specific remote procedure call (RPC) method or a method in an interface." ;
