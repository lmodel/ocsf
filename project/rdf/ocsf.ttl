	linkml:annotations _:c14n3490 , _:c14n6218 ;
	linkml:any_of _:c14n3121 , _:c14n3945 , _:c14n494 , _:c14n5287 ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/initiator_id"^^xsd:anyURI ;
	linkml:description "The normalized identifier of the endpoint that initiated the network communication. Use this field to disambiguate source and destination roles in bi-directional or asymmetric flow scenarios." ;
	linkml:domain <https://w3id.org/lmodel/ocsf/OcsfNetworkActivity> ;
