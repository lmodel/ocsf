	linkml:domain_of <https://w3id.org/lmodel/ocsf/OcsfCvss> ;
	linkml:owner <https://w3id.org/lmodel/ocsf/OcsfCvss> ;
	linkml:range <https://w3id.org/lmodel/ocsf/ocsf_float_t> ;
	linkml:slot_uri "https://w3id.org/lmodel/ocsf/overall_score"^^xsd:anyURI .
<https://w3id.org/lmodel/ocsf/owner> dcterms:title "Owner" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
