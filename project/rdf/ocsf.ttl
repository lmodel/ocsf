<https://w3id.org/lmodel/ocsf/ocsf_boolean_t> dcterms:title "Boolean" ;
	a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_core"^^xsd:anyURI ;
	linkml:annotations _:c14n4148 ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfBooleanT"^^xsd:anyURI ;
