<https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile> dcterms:title "AI Operation" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "ocsf:OcsfAiOperationProfile"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/ocsf/ocsf_objects"^^xsd:anyURI ;
	linkml:annotations _:c14n6044 ;
	linkml:class_uri "https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/ocsf/OcsfAiOperationProfile"^^xsd:anyURI ;
	linkml:description "AI-specific attributes for model operations, retrieval systems, and agent activities. e.g. model_name, total_token_counts etc." ;
