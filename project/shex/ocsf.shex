          <related_analytics> @<OcsfAnalytic> * ;
          <sensor_info_list> @<OcsfSensorInfo> * ;
          <state> @<OcsfStringT> ? ;
          <state_id> @<OcsfIntegerT> ? ;
          <type> @<OcsfStringT> ? ;
          <type_id> @<OcsfIntegerT> ;
          <version> @<OcsfStringT> ? ;
          <name> @<OcsfStringT> ? ;
          <uid> @<OcsfStringT> ?
       ) ;
       rdf:type [ <OcsfAnalytic> ] ?
    )
}

