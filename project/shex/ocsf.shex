          <baselines> @<OcsfBaseline> *
       ) ;
       rdf:type [ <OcsfAnomalyAnalysis> ] ?
    )
}

<OcsfApi> CLOSED {
    (  $<OcsfApi_tes> (  &<OcsfObjectBase_tes> ;
          rdf:type [ <OcsfObjectBase> ] ? ;
          <group> @<OcsfGroup> ? ;
          <operation> @<OcsfStringT> ;
          <request> @<OcsfRequest> ? ;
          <response> @<OcsfResponse> ? ;
          <service> @<OcsfService> ? ;
          <token> @<OcsfToken> ? ;
          <version> @<OcsfStringT> ?
       ) ;
       rdf:type [ <OcsfApi> ] ?
