}

<OcsfApiActivity> CLOSED {
    (  $<OcsfApiActivity_tes> (  &<OcsfApplicationEvent_tes> ;
          rdf:type [ <OcsfApplicationEvent> ] ? ;
          &<OcsfTraceProfile_tes> ;
          rdf:type [ <OcsfTraceProfile> ] ? ;
          <dst_endpoint> @<OcsfNetworkEndpoint> ? ;
          <http_request> @<OcsfHttpRequest> ? ;
          <http_response> @<OcsfHttpResponse> ? ;
          <resources> @<OcsfResourceDetails> * ;
          <src_endpoint> @<OcsfNetworkEndpoint> ;
          <activity_id> @<OcsfIntegerT> ? ;
          <actor> @<OcsfActor> ;
          <api> @<OcsfApi> ;
          <category_name> @<OcsfStringT> ? ;
          <class_name> @<OcsfStringT> ? ;
          <class_uid> @<OcsfIntegerT> ? ;
          <trace> @<OcsfTrace> ? ;
          <type_uid> @<OcsfLongT> ?
       ) ;
       rdf:type [ <OcsfApiActivity> ] ?
    )
}

<OcsfApplication> CLOSED {
    (  $<OcsfApplication_tes> (  &<OcsfObjectBase_tes> ;
          rdf:type [ <OcsfObjectBase> ] ? ;
