<OcsfBaseEvent>  (
    CLOSED {
       (  $<OcsfBaseEvent_tes> (  &<OcsfCloudProfile_tes> ;
             rdf:type [ <OcsfCloudProfile> ] ? ;
             &<OcsfDatetimeProfile_tes> ;
             rdf:type [ <OcsfDatetimeProfile> ] ? ;
             &<OcsfHostProfile_tes> ;
             rdf:type [ <OcsfHostProfile> ] ? ;
             &<OcsfOsintProfile_tes> ;
             rdf:type [ <OcsfOsintProfile> ] ? ;
             &<OcsfRecordIntegrityProfile_tes> ;
             rdf:type [ <OcsfRecordIntegrityProfile> ] ? ;
             &<OcsfSecurityControlProfile_tes> ;
             rdf:type [ <OcsfSecurityControlProfile> ] ? ;
             <activity_id> @<OcsfIntegerT> ;
             <activity_name> @<OcsfStringT> ? ;
             <category_name> @<OcsfStringT> ? ;
             <category_uid> @<OcsfIntegerT> ;
             <class_name> @<OcsfStringT> ? ;
             <class_uid> @<OcsfIntegerT> ;
             <count> @<OcsfIntegerT> ? ;
             <duration> @<OcsfLongT> ? ;
             <end_time> @<OcsfTimestampT> ? ;
             <end_time_dt> @<OcsfDatetimeT> ? ;
             <enrichments> @<OcsfEnrichment> * ;
             <message> @<OcsfStringT> ? ;
             <metadata> @<OcsfMetadata> ;
             <observables> @<OcsfObservable> * ;
             <raw_data> @<OcsfStringT> ? ;
             <raw_data_hash> @<OcsfFingerprint> ? ;
             <raw_data_size> @<OcsfLongT> ? ;
             <severity> @<OcsfStringT> ? ;
             <severity_id> @<OcsfIntegerT> ;
             <start_time> @<OcsfTimestampT> ? ;
             <start_time_dt> @<OcsfDatetimeT> ? ;
             <status> @<OcsfStringT> ? ;
             <status_code> @<OcsfStringT> ? ;
             <status_detail> @<OcsfStringT> ? ;
             <status_id> @<OcsfIntegerT> ? ;
             <time> @<OcsfTimestampT> ;
             <time_dt> @<OcsfDatetimeT> ? ;
             <timezone_offset> @<OcsfIntegerT> ? ;
             <type_name> @<OcsfStringT> ? ;
             <type_uid> @<OcsfLongT> ;
             <unmapped> @<OcsfObject> ? ;
             <action> @<OcsfStringT> ? ;
             <action_id> @<OcsfIntegerT> ? ;
             <actor> @<OcsfActor> ? ;
             <attacks> @<OcsfAttack> * ;
             <authorizations> @<OcsfAuthorization> * ;
             <device> @<OcsfDevice> ? ;
             <disposition> @<OcsfStringT> ? ;
             <disposition_id> @<OcsfIntegerT> ? ;
             <firewall_rule> @<OcsfFirewallRule> ? ;
             <is_alert> @<OcsfBooleanT> ? ;
             <malware> @<OcsfMalware> * ;
             <malware_scan_info> @<OcsfMalwareScanInfo> ? ;
             <policy> @<OcsfPolicy> ? ;
             <api> @<OcsfApi> ? ;
             <cloud> @<OcsfCloud> ? ;
             <osint> @<OcsfOsint> * ;
             <attestation_list> @<OcsfAttestation> * ;
             <confidence> @<OcsfStringT> ? ;
             <confidence_id> @<OcsfIntegerT> ? ;
             <confidence_score> @<OcsfIntegerT> ? ;
             <risk_details> @<OcsfStringT> ? ;
             <risk_level> @<OcsfStringT> ? ;
             <risk_level_id> @<OcsfIntegerT> ? ;
             <risk_score> @<OcsfIntegerT> ?
          ) ;
          rdf:type [ <OcsfBaseEvent> ] ?
       )
    } OR @<OcsfApplicationEvent> OR @<OcsfDiscoveryEvent> OR @<OcsfDiscoveryResultEvent> OR @<OcsfEmailActivity> OR
    @<OcsfEmailFileActivity> OR @<OcsfEmailUrlActivity> OR @<OcsfFindingEvent> OR @<OcsfIamEvent> OR @<OcsfIncidentFinding> OR
    @<OcsfNetworkEvent> OR @<OcsfRemediationActivity> OR @<OcsfSecurityFinding> OR @<OcsfSystemEvent> OR
    @<OcsfUnmannedSystemsEvent>
)

