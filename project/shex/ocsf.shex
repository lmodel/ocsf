<OcsfApplicationError> CLOSED {
    (  $<OcsfApplicationError_tes> (  &<OcsfApplicationEvent_tes> ;
          rdf:type [ <OcsfApplicationEvent> ] ? ;
          <activity_id> @<OcsfIntegerT> ? ;
          <category_name> @<OcsfStringT> ? ;
          <class_name> @<OcsfStringT> ? ;
          <class_uid> @<OcsfIntegerT> ? ;
          <message> @<OcsfStringT> ? ;
          <type_uid> @<OcsfLongT> ?
       ) ;
       rdf:type [ <OcsfApplicationError> ] ?
    )
}

<OcsfApplicationEvent>  (
    @<OcsfApiActivity> OR @<OcsfApplicationError> OR @<OcsfApplicationLifecycle> OR @<OcsfDatastoreActivity> OR @<OcsfFileHosting>
    OR @<OcsfScanActivity> OR @<OcsfWebResourceAccessActivity> OR @<OcsfWebResourcesActivity>
)

<OcsfApplicationEvent_struct> {
    (  $<OcsfApplicationEvent_tes> (  &<OcsfBaseEvent_tes> ;
          rdf:type [ <OcsfBaseEvent> ] ? ;
          &<OcsfAiOperationProfile_tes> ;
          rdf:type [ <OcsfAiOperationProfile> ] ? ;
          <category_uid> @<OcsfIntegerT> ? ;
          <ai_agent> @<OcsfAiAgent> ? ;
          <ai_model> @<OcsfAiModel> ? ;
          <delegation> @<OcsfDelegation> ? ;
          <message_context> @<OcsfMessageContext> ?
       ) ;
       rdf:type [ <OcsfApplicationEvent> ] ?
    )
}

<OcsfApplicationLifecycle> CLOSED {
    (  $<OcsfApplicationLifecycle_tes> (  &<OcsfApplicationEvent_tes> ;
          rdf:type [ <OcsfApplicationEvent> ] ? ;
          <app> @<OcsfProduct> ? ;
          <application> @<OcsfApplication> ? ;
          <activity_id> @<OcsfIntegerT> ? ;
          <category_name> @<OcsfStringT> ? ;
          <class_name> @<OcsfStringT> ? ;
          <class_uid> @<OcsfIntegerT> ? ;
          <type_uid> @<OcsfLongT> ?
       ) ;
       rdf:type [ <OcsfApplicationLifecycle> ] ?
    )
}

