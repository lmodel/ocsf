    (  $<OcsfAnomaly_tes> (  &<OcsfObjectBase_tes> ;
          rdf:type [ <OcsfObjectBase> ] ? ;
          <observation_parameter> @<OcsfStringT> ;
          <observation_type> @<OcsfStringT> ? ;
          <observations> @<OcsfObservation> + ;
          <observed_pattern> @<OcsfStringT> ?
       ) ;
       rdf:type [ <OcsfAnomaly> ] ?
    )
}

<OcsfAnomalyAnalysis> CLOSED {
    (  $<OcsfAnomalyAnalysis_tes> (  <analysis_targets> @<OcsfAnalysisTarget> + ;
