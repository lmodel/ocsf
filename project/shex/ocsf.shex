<OcsfObjectBase>  (
    @<OcsfAccessAnalysisResult> OR @<OcsfActor> OR @<OcsfAdditionalRestriction> OR @<OcsfAdvisory> OR @<OcsfAffectedCode> OR
    @<OcsfAgent> OR @<OcsfAnomaly> OR @<OcsfApi> OR @<OcsfApplication> OR @<OcsfAttack> OR @<OcsfAttestation> OR @<OcsfAuthFactor>
    OR @<OcsfAuthorization> OR @<OcsfAutonomousSystem> OR @<OcsfBaseline> OR @<OcsfCampaign> OR @<OcsfCertificate> OR @<OcsfCheck>
    OR @<OcsfCisBenchmark> OR @<OcsfCisBenchmarkResult> OR @<OcsfCisControl> OR @<OcsfCisCsc> OR @<OcsfClassifierDetails> OR
    @<OcsfClipboard> OR @<OcsfClipboardItem> OR @<OcsfCloud> OR @<OcsfCompliance> OR @<OcsfContainer> OR @<OcsfCpuInfo> OR
    @<OcsfCve> OR @<OcsfCvss> OR @<OcsfCwe> OR @<OcsfD3fend> OR @<OcsfDataClassification> OR @<OcsfDceRpc> OR @<OcsfDelegation> OR
    @<OcsfDeviceHwInfo> OR @<OcsfDigitalSignature> OR @<OcsfDiscoveryDetails> OR @<OcsfDisplay> OR @<OcsfDnsQuery> OR
    @<OcsfDnsResourceRecord> OR @<OcsfDnsSection> OR @<OcsfDomainContact> OR @<OcsfDownloadInfo> OR @<OcsfEmail> OR
    @<OcsfEmailAuth> OR @<OcsfEncryptionDetails> OR @<OcsfEndpointConnection> OR @<OcsfEnrichment> OR @<OcsfEntity> OR
    @<OcsfEnvironmentVariable> OR @<OcsfEpss> OR @<OcsfFinding> OR @<OcsfFindingInfo> OR @<OcsfFingerprint> OR
    @<OcsfFunctionInvocation> OR @<OcsfGpuInfo> OR @<OcsfHassh> OR @<OcsfHttpCookie> OR @<OcsfHttpHeader> OR @<OcsfHttpRequest> OR
    @<OcsfHttpResponse> OR @<OcsfIdentityActivityMetrics> OR @<OcsfJa4Fingerprint> OR @<OcsfJob> OR @<OcsfKbArticle> OR
    @<OcsfKernel> OR @<OcsfKernelDriver> OR @<OcsfKeyValueObject> OR @<OcsfKeyboardInfo> OR @<OcsfKillChainPhase> OR
    @<OcsfLdapPerson> OR @<OcsfLocation> OR @<OcsfLongString> OR @<OcsfMetadata> OR @<OcsfMetric> OR @<OcsfModule> OR
    @<OcsfNetworkConnectionInfo> OR @<OcsfNetworkTraffic> OR @<OcsfNode> OR @<OcsfNote> OR @<OcsfObservable> OR @<OcsfObservation>
    OR @<OcsfOccurrenceDetails> OR @<OcsfOs> OR @<OcsfOsint> OR @<OcsfPackage> OR @<OcsfPacket> OR @<OcsfParameter> OR
    @<OcsfPermissionAnalysisResult> OR @<OcsfPortInfo> OR @<OcsfPrevEvent> OR @<OcsfPrivilegeAttackInfo> OR @<OcsfPrivilegeInfo> OR
    @<OcsfProgrammaticCredential> OR @<OcsfRelatedEvent> OR @<OcsfRemediation> OR @<OcsfReputation> OR @<OcsfRequest> OR
    @<OcsfResponse> OR @<OcsfRpcInterface> OR @<OcsfSan> OR @<OcsfSbom> OR @<OcsfScim> OR @<OcsfScript> OR @<OcsfSecurityState> OR
    @<OcsfServicePrivilegeAnalysis> OR @<OcsfSession> OR @<OcsfSoftwareComponent> OR @<OcsfSpan> OR @<OcsfSso> OR
    @<OcsfThreatActor> OR @<OcsfTicket> OR @<OcsfTimespan> OR @<OcsfTls> OR @<OcsfTlsExtension> OR @<OcsfToken> OR @<OcsfTrace> OR
    @<OcsfTsig> OR @<OcsfUrl> OR @<OcsfVendorAttributes> OR @<OcsfVulnerability> OR @<OcsfWhois> OR @<OcsfWinRegKey> OR
    @<OcsfWinRegValue>
)

