<OcsfAirborneBroadcastActivity> CLOSED {
    (  $<OcsfAirborneBroadcastActivity_tes> (  &<OcsfUnmannedSystemsEvent_tes> ;
          rdf:type [ <OcsfUnmannedSystemsEvent> ] ? ;
          <aircraft> @<OcsfAircraft> ? ;
          <protocol_name> @<OcsfStringT> ? ;
          <rssi> @<OcsfIntegerT> ? ;
          <unmanned_aerial_system> @<OcsfUnmannedAerialSystem> ;
          <unmanned_system_operating_area> @<OcsfUnmannedSystemOperatingArea> ? ;
          <unmanned_system_operator> @<OcsfUser> ;
          <activity_id> @<OcsfIntegerT> ;
          <category_name> @<OcsfStringT> ? ;
          <class_name> @<OcsfStringT> ? ;
          <class_uid> @<OcsfIntegerT> ;
          <dst_endpoint> @<OcsfNetworkEndpoint> ? ;
          <src_endpoint> @<OcsfNetworkEndpoint> ? ;
          <traffic> @<OcsfNetworkTraffic> ? ;
          <type_uid> @<OcsfLongT>
       ) ;
       rdf:type [ <OcsfAirborneBroadcastActivity> ] ?
    )
}

<OcsfAircraft>  (
    CLOSED {
       (  $<OcsfAircraft_tes> (  &<OcsfEntity_tes> ;
             rdf:type [ <OcsfEntity> ] ? ;
             <location> @<OcsfLocation> ? ;
             <model> @<OcsfStringT> ? ;
             <serial_number> @<OcsfStringT> ? ;
             <speed> @<OcsfStringT> ? ;
             <speed_accuracy> @<OcsfStringT> ? ;
             <track_direction> @<OcsfStringT> ? ;
             <uid_alt> @<OcsfStringT> ? ;
             <vertical_speed> @<OcsfStringT> ? ;
             <name> @<OcsfStringT> ? ;
             <uid> @<OcsfStringT> ?
          ) ;
          rdf:type [ <OcsfAircraft> ] ?
       )
    } OR @<OcsfUnmannedAerialSystem>
)

