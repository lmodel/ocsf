ocsf:kerberos_flags dcterms:title "Kerberos Flags" ;
	a owl:DatatypeProperty ;
	rdfs:label "kerberos_flags" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://learn.microsoft.com/en-us/previous-versions/windows/it-pro/windows-10/security/threat-protection/auditing/event-4769> , <https://www.rfc-editor.org/rfc/rfc4120#section-5.2.8> ;
	skos:definition "A bitmask, either in hexadecimal or decimal form, which encodes various attributes or permissions associated with a Kerberos ticket. These flags delineate specific characteristics of the ticket, such as its renewability or forwardability." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:kernel dcterms:title "Kernel" ;
	a owl:ObjectProperty ;
	rdfs:label "kernel" ;
