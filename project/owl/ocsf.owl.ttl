ocsf:startup_item dcterms:title "Startup Item" ;
	a owl:ObjectProperty ;
	rdfs:label "startup_item" ;
	rdfs:range ocsf:OcsfStartupItem ;
	skos:definition "The startup item object describes an application component that has associated startup criteria and configurations." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:state dcterms:title "State" ;
	a owl:DatatypeProperty ;
	rdfs:label "state" ;
	rdfs:range xsd:string ;
	skos:definition "The state of the event or object, normalized to the caption of the state_id value. In the case of 'Other', it is defined by the event source. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:state_id dcterms:title "State ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "state_id" ;
	rdfs:range _:c14n5087 ;
	skos:definition "The normalized state ID of the event or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "state" .
ocsf:status dcterms:title "Status" ;
	a owl:DatatypeProperty ;
	rdfs:label "status" ;
	rdfs:range xsd:string ;
	skos:definition "The status label, normalized to the caption of the <code>status_id</code> value. When <code>status_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain a source-specific status label. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:status_code dcterms:title "Status Code" ;
	a owl:DatatypeProperty ;
	rdfs:label "status_code" ;
	rdfs:range xsd:string ;
	skos:definition "The source-specific status or error code. This preserves the original code for detailed troubleshooting beyond what <code>status_id</code> conveys. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:status_detail dcterms:title "Status Detail" ;
	a owl:DatatypeProperty ;
	rdfs:label "status_detail" ;
	rdfs:range xsd:string ;
	skos:definition "Additional context about the outcome, beyond the normalized <code>status_id</code> and source-specific <code>status_code</code>. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:status_details dcterms:title "Status Details" ;
	a owl:DatatypeProperty ;
	rdfs:label "status_details" ;
	rdfs:range xsd:string ;
	skos:definition "A list of descriptions providing additional context about the outcome. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:status_id dcterms:title "Status ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "status_id" ;
	rdfs:range _:c14n3071 ;
	skos:definition "The normalized status identifier. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "status" .
ocsf:storage_class dcterms:title "Storage Class" ;
	a owl:DatatypeProperty ;
	rdfs:label "storage_class" ;
	rdfs:range xsd:string ;
	skos:definition "The storage class of the entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:stratum dcterms:title "Stratum" ;
	a owl:DatatypeProperty ;
	rdfs:label "stratum" ;
	rdfs:range xsd:string ;
	skos:definition "The stratum level of the NTP server's time source, normalized to the caption of the stratum_id value." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:stratum_id dcterms:title "Stratum ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "stratum_id" ;
	rdfs:range _:c14n685 ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5905.html> ;
	skos:definition "The normalized identifier of the stratum level of an NTP server's time source, as defined in RFC 5905. Levels range from 0 to 16, with lower numbers representing higher accuracy and greater proximity to the root clock." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "stratum" .
ocsf:string_data dcterms:title "String Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "string_data" ;
	rdfs:range xsd:string ;
	skos:definition "The item's data if it can be represented as a UTF-8 string." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sub_technique dcterms:title "MITRE Sub-technique" ;
	a owl:ObjectProperty ;
	rdfs:label "sub_technique" ;
	rdfs:range ocsf:OcsfSubTechnique ;
	rdfs:seeAlso <https://atlas.mitre.org/matrices/ATLAS> , <https://attack.mitre.org> ;
	skos:definition "The Sub-technique object describes the MITRE ATT&CK® or ATLAS™ Sub-technique ID and/or name associated to an attack." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:subdomain dcterms:title "Subdomain" ;
	a owl:DatatypeProperty ;
	rdfs:label "subdomain" ;
	rdfs:range xsd:string ;
	skos:definition "The subdomain portion of the URL. For example: <code>sub</code> in <code>https://sub.example.com</code> or <code>sub2.sub1</code> in <code>https://sub2.sub1.example.com</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:subdomains dcterms:title "Subdomains" ;
	a owl:DatatypeProperty ;
	rdfs:label "subdomains" ;
	rdfs:range xsd:string ;
	skos:definition "An array of subdomain strings. Can be used to collect several subdomains such as those from Domain Generation Algorithms (DGAs)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:subgroup dcterms:title "Subgroup" ;
	a owl:ObjectProperty ;
	rdfs:label "subgroup" ;
	rdfs:range ocsf:OcsfGroup ;
	skos:definition "A subgroup that was added to or removed from the group." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:subject dcterms:title "Subject Details" ;
	a owl:DatatypeProperty ;
	rdfs:label "subject" ;
	rdfs:range xsd:string ;
	skos:definition "The identifier of the subject. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:subnet dcterms:title "Subnet" ;
	a owl:DatatypeProperty ;
	rdfs:label "subnet" ;
	rdfs:range xsd:string ;
	skos:definition "The subnet mask." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:subnet_prefix dcterms:title "Subnet Prefix Length" ;
	a owl:DatatypeProperty ;
	rdfs:label "subnet_prefix" ;
	rdfs:range xsd:integer ;
	skos:definition "The subnet prefix length determines the number of bits used to represent the network part of the IP address. The remaining bits are reserved for identifying individual hosts within that subnet." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:subnet_uid dcterms:title "Subnet UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "subnet_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of a virtual subnet." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:supporting_data dcterms:title "Supporting Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "supporting_data" ;
	rdfs:range _:c14n3856 ;
	skos:definition "Additional data supporting a finding as provided by security tool" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:surname dcterms:title "Surname" ;
	a owl:DatatypeProperty ;
	rdfs:label "surname" ;
	rdfs:range xsd:string ;
	skos:definition "The last or family name for the user." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:svc_name dcterms:title "Service Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "svc_name" ;
	rdfs:range xsd:string ;
	skos:definition "The service name in service-to-service connections. For example, AWS VPC logs the pkt-src-aws-service and pkt-dst-aws-service fields identify the connection is coming from or going to an AWS service." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:system_call dcterms:title "System Call" ;
	a owl:DatatypeProperty ;
	rdfs:label "system_call" ;
	rdfs:range xsd:string ;
	skos:definition "The system call that was invoked." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:table dcterms:title "Table" ;
	a owl:ObjectProperty ;
	rdfs:label "table" ;
	rdfs:range ocsf:OcsfTable ;
	skos:definition "The table object represents a table within a structured relational database or datastore, which contains columns and rows of data that are able to be create, updated, deleted and queried." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:tactic dcterms:title "MITRE Tactic" ;
	a owl:ObjectProperty ;
	rdfs:label "tactic" ;
	rdfs:range ocsf:OcsfTactic ;
	rdfs:seeAlso <https://atlas.mitre.org/matrices/ATLAS> , <https://attack.mitre.org> ;
	skos:definition "The Tactic object describes the Tactic ID and/or name associated to an attack." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:tactics dcterms:title "Tactics" ;
	a owl:ObjectProperty ;
	rdfs:label "tactics" ;
	rdfs:range ocsf:OcsfTactic ;
	rdfs:seeAlso <https://attack.mitre.org/wiki/ATT&CK_Matrix> ;
	skos:definition "The Tactics associated with the attack technique." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.1.0" ;
	ocsf:ocsf_superseded_by "tactic" .
ocsf:tag dcterms:title "Image Tag" ;
	a owl:DatatypeProperty ;
	rdfs:label "tag" ;
	rdfs:range xsd:string ;
	skos:definition "The image tag. For example: <code>1.11-alpine</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.4.0" ;
	ocsf:ocsf_superseded_by "labels tags" .
ocsf:tags dcterms:title "Tags" ;
	a owl:ObjectProperty ;
	rdfs:label "tags" ;
	rdfs:range ocsf:OcsfKeyValueObject ;
	skos:definition "The list of tags; <code>{key:value}</code> pairs attached to an entity. A Tag may be used to categorize, filter, and search for entities. For e.g. <code>\"Environment\": \"Production\"</code>, <code>\"Owner\": \"007\"</code>. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:target dcterms:title "Target" ;
	a owl:DatatypeProperty ;
	rdfs:label "target" ;
	rdfs:range xsd:string ;
	skos:definition "The target of the event or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tcp_flags dcterms:title "TCP Flags" ;
	a owl:DatatypeProperty ;
	rdfs:label "tcp_flags" ;
	rdfs:range xsd:integer ;
	skos:definition "The network connection TCP header flags (i.e., control bits)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tcp_state_id dcterms:title "TCP State ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "tcp_state_id" ;
	rdfs:range _:c14n5863 ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc9293> ;
	skos:definition "The state of the TCP socket for the network connection." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:technique dcterms:title "MITRE Technique" ;
	a owl:ObjectProperty ;
	rdfs:label "technique" ;
	rdfs:range ocsf:OcsfTechnique ;
	rdfs:seeAlso <https://atlas.mitre.org/matrices/ATLAS> , <https://attack.mitre.org> ;
	skos:definition "The Technique object describes the MITRE ATT&CK® or ATLAS™ Technique ID and/or name associated to an attack." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:tenant_uid dcterms:title "Tenant UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "tenant_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique tenant identifier." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:terminal dcterms:title "Terminal" ;
	a owl:DatatypeProperty ;
	rdfs:label "terminal" ;
	rdfs:range xsd:string ;
	skos:definition "The Pseudo Terminal. Ex: the tty or pts value." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:terminated_time dcterms:title "Terminated Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "terminated_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The time when the entity was terminated. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:terminated_time_dt dcterms:title "Terminated Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "terminated_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The time when the entity was terminated. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:threat_actor dcterms:title "Threat Actor" ;
	a owl:ObjectProperty ;
	rdfs:label "threat_actor" ;
	rdfs:range ocsf:OcsfThreatActor ;
	rdfs:seeAlso <https://stixproject.github.io/data-model/1.2/ta/ThreatActorType/> ;
	skos:definition "A threat actor is an individual or group that conducts malicious cyber activities, often with financial, political, or ideological motives." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:ticket dcterms:title "Ticket" ;
	a owl:ObjectProperty ;
	rdfs:label "ticket" ;
	rdfs:range ocsf:OcsfTicket ;
	skos:definition "The linked ticket in the ticketing system." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:tickets dcterms:title "Tickets" ;
	a owl:ObjectProperty ;
	rdfs:label "tickets" ;
	rdfs:range ocsf:OcsfTicket ;
	skos:definition "The associated ticket(s) in the ticketing system. Each ticket contains details like ticket ID, status, etc." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:tid dcterms:title "Thread ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "tid" ;
	rdfs:range xsd:integer ;
	skos:definition "The identifier of the thread associated with the event, as returned by the operating system." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.6.0" ;
	ocsf:ocsf_superseded_by "ptid" .
ocsf:time dcterms:title "Event Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "time" ;
	rdfs:range xsd:integer ;
	skos:definition "The normalized event occurrence time. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:time_dt dcterms:title "Event Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The normalized event occurrence time. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:timespan dcterms:title "Time Span" ;
	a owl:ObjectProperty ;
	rdfs:label "timespan" ;
	rdfs:range ocsf:OcsfTimespan ;
	skos:definition "The Time Span object represents different time period durations. If a timespan is fractional, i.e. crosses one period, e.g. a week and 3 days, more than one may be populated since each member is of integral type. In that case <code>type_id</code> if present should be set to <code>Other.</code><P>A timespan may also be defined by its time interval boundaries, <code>start_time</code> and <code>end_time</code>." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:timezone_offset dcterms:title "Timezone Offset" ;
	a owl:DatatypeProperty ;
	rdfs:label "timezone_offset" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of minutes that the reported event <code>time</code> is ahead or behind UTC, in the range -1,080 to +1,080. This allows consumers to reconstruct the local time at the event source. For example, US Eastern Standard Time is <code>-300</code>. Populate this when the source provides local time zone information." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:title dcterms:title "Title" ;
	a owl:DatatypeProperty ;
	rdfs:label "title" ;
	rdfs:range xsd:string ;
	skos:definition "The title of an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tlp dcterms:title "Traffic Light Protocol" ;
	a owl:DatatypeProperty ;
	rdfs:label "tlp" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.first.org/tlp/> ;
	skos:definition "The Traffic Light Protocol (TLP) was created to facilitate greater sharing of potentially sensitive information and more effective collaboration. TLP provides a simple and intuitive schema for indicating with whom potentially sensitive information can be shared." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tls dcterms:title "TLS" ;
	a owl:ObjectProperty ;
	rdfs:label "tls" ;
	rdfs:range ocsf:OcsfTls ;
	skos:definition "The Transport Layer Security (TLS) attributes." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:tls_extension_list dcterms:title "TLS Extension List" ;
	a owl:ObjectProperty ;
	rdfs:label "tls_extension_list" ;
	rdfs:range ocsf:OcsfTlsExtension ;
	skos:definition "The list of TLS extensions." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:to dcterms:title "To" ;
	a owl:DatatypeProperty ;
	rdfs:label "to" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The machine-readable email header To values, as defined by RFC 5322. For example <code>example.user@usersdomain.com</code>" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:to_mailboxes dcterms:title "To Mailboxes" ;
	a owl:DatatypeProperty ;
	rdfs:label "to_mailboxes" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322#section-3.4> ;
	skos:definition "The human-readable email header To Mailbox values. For example <code>'Example User &lt;example.user@usersdomain.com&gt;'</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:token dcterms:title "Token" ;
	a owl:ObjectProperty ;
	rdfs:label "token" ;
	rdfs:range ocsf:OcsfToken ;
	skos:definition "The Token object is the base object for representing tokens, API keys, and authentication credentials. This object provides common attributes for all token types and can be used directly in API activity events to represent API tokens (type_id: 7) or client tokens (type_id: 6) such as Okta API tokens or Microsoft Entra ID Application Registration client secrets. The base <code>token</code> object is also extended by <code>authentication_token</code> for protocol-specific authentication tokens in authentication events. Note: Use <code>authentication_token</code> (which extends <code>token</code>) for protocol-specific authentication tokens (Kerberos, OIDC, SAML) in authentication events, and <code>programmatic_credential</code> for tracking credential lifecycle and usage patterns." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:total dcterms:title "Total" ;
	a owl:DatatypeProperty ;
	rdfs:label "total" ;
	rdfs:range xsd:integer ;
	skos:definition "The total number of items. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:total_potential_attacks_count dcterms:title "Total Potential Attacks Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "total_potential_attacks_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The total count of privilege-to-attack technique mappings identified across all analyzed privileges." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:total_queued_duration dcterms:title "Total Queued Duration" ;
	a owl:ObjectProperty ;
	rdfs:label "total_queued_duration" ;
	rdfs:range ocsf:OcsfTimespan ;
	skos:definition "The amount of time an event spent in a queue awaiting processing." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:total_tokens dcterms:title "Total Tokens" ;
	a owl:DatatypeProperty ;
	rdfs:label "total_tokens" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of tokens used for this message (prompt + completion)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:trace dcterms:title "Trace" ;
	a owl:ObjectProperty ;
	rdfs:label "trace" ;
	rdfs:range ocsf:OcsfTrace ;
	skos:definition "The information about the trace. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:track_direction dcterms:title "Track Direction" ;
	a owl:DatatypeProperty ;
	rdfs:label "track_direction" ;
	rdfs:range xsd:string ;
	skos:definition "Direction of flight expressed as a “True North-based” ground track angle. This value is provided in clockwise degrees with a minimum resolution of 1 degree. If aircraft is not moving horizontally, use the “Unknown” value" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:traffic dcterms:title "Traffic" ;
	a owl:ObjectProperty ;
	rdfs:label "traffic" ;
	rdfs:range ocsf:OcsfNetworkTraffic ;
	skos:definition "The network traffic refers to the amount of data moving across a network at a given point of time. Intended to be used alongside Network Connection." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:traits dcterms:title "Traits" ;
	a owl:ObjectProperty ;
	rdfs:label "traits" ;
	rdfs:range ocsf:OcsfTrait ;
	skos:definition "The traits that describe characteristics, features of an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:transaction_id dcterms:title "Transaction ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "transaction_id" ;
	rdfs:range xsd:integer ;
	skos:definition "The identifier of a transaction. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:transaction_uid dcterms:title "Transaction UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "transaction_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of the transaction." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:transformation_info_list dcterms:title "Transformation Info" ;
	a owl:ObjectProperty ;
	rdfs:label "transformation_info_list" ;
	rdfs:range ocsf:OcsfTransformationInfo ;
	skos:definition "An array of transformation info that describes the mappings or transforms applied to the data." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:transmit_time dcterms:title "Transmission Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "transmit_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The event transmission time from one device to another.  See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:transmit_time_dt dcterms:title "Transmission Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "transmit_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The event transmission time from one device to another.  See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tree_uid dcterms:title "Tree UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "tree_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The tree id is a unique SMB identifier which represents an open connection to a share." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tsig dcterms:title "TSIG" ;
	a owl:ObjectProperty ;
	rdfs:label "tsig" ;
	rdfs:range ocsf:OcsfTsig ;
	skos:definition "The TSIG (Transaction Signature) record used to authenticate the DNS message. See RFC 2845." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:ttl dcterms:title "TTL" ;
	a owl:DatatypeProperty ;
	rdfs:label "ttl" ;
	rdfs:range xsd:integer ;
	skos:definition "The time interval that the resource record may be cached. Zero value means that the resource record can only be used for the transaction in progress, and should not be cached." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tunnel_interface dcterms:title "Interface" ;
	a owl:ObjectProperty ;
	rdfs:label "tunnel_interface" ;
	rdfs:range ocsf:OcsfNetworkInterface ;
	skos:definition "The information about the tunnel interface. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:tunnel_type dcterms:title "Tunnel Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "tunnel_type" ;
	rdfs:range xsd:string ;
	skos:definition "The type of tunnel configuration, normalized to the caption of the <code>tunnel_type_id</code> value, indicating the scope of traffic routed through the connection. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:tunnel_type_id dcterms:title "Tunnel Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "tunnel_type_id" ;
	rdfs:range _:c14n4659 ;
	skos:definition "The normalized identifier for the type of tunnel configuration, indicating the scope of traffic routed through the connection. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "tunnel_type" .
ocsf:type dcterms:title "Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "type" ;
	rdfs:range xsd:string ;
	skos:definition "The type of an object or value, normalized to the caption of the type_id value. In the case of 'Other', it is defined by the event source. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:type_id dcterms:title "Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "type_id" ;
	rdfs:range _:c14n6883 ;
	skos:definition "The normalized type identifier of an object. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "type" .
ocsf:type_name dcterms:title "Type Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "type_name" ;
	rdfs:range xsd:string ;
	skos:definition "The event/finding type name, combining the class and activity (e.g., <code>\"Detection Finding: Create\"</code>). The value must match the <code>class_name</code> and <code>activity_name</code> joined by <code>\": \"</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:type_uid dcterms:title "Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "type_uid" ;
	rdfs:range xsd:integer ;
	skos:definition "The event/finding type ID. It identifies the event's semantics and structure. Producers and mappers <b>must</b> compute this as <code>class_uid * 100 + activity_id</code>. It uniquely identifies the combination of event class and activity across the entire schema. For example, <code>Detection Finding: Create</code> is <code>200401</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "type_name" .
ocsf:types dcterms:title "Types" ;
	a owl:DatatypeProperty ;
	rdfs:label "types" ;
	rdfs:range xsd:string ;
	skos:definition "The type/s of an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:udid dcterms:title "Unique Device Identifier" ;
	a owl:DatatypeProperty ;
	rdfs:label "udid" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://theapplewiki.com/wiki/UDID> ;
	skos:definition "The Apple assigned Unique Device Identifier (UDID). For iOS, iPadOS, tvOS, watchOS and visionOS devices, this is the UDID. For macOS devices, it is the Provisioning UDID. For example: <code>00008020-008D4548007B4F26</code>" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:uid dcterms:title "Unique ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:uid_alt dcterms:title "Alternate ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "uid_alt" ;
	rdfs:range xsd:string ;
	skos:definition "The alternate unique identifier. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:uid_numeric dcterms:title "Numeric Unique ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "uid_numeric" ;
	rdfs:range xsd:integer ;
	skos:definition "The unique identifier in numeric form. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:unique_malware_count dcterms:title "Unique Malware Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "unique_malware_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of unique malware detected during a scan. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:unmanned_aerial_system dcterms:title "Unmanned Aerial System" ;
	a owl:ObjectProperty ;
	rdfs:label "unmanned_aerial_system" ;
	rdfs:range ocsf:OcsfUnmannedAerialSystem ;
	rdfs:seeAlso <https://cdn.standards.iteh.ai/samples/112830/71297057ac42432880a203654f213709/ASTM-F3411-22a.pdf> ;
	skos:definition "The Unmanned Aerial System object describes the characteristics, Position Location Information (PLI), and other metadata of Unmanned Aerial Systems (UAS) and other unmanned and drone systems used in Remote ID. Remote ID is defined in the Standard Specification for Remote ID and Tracking (ASTM Designation: F3411-22a)." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:unmanned_system_operating_area dcterms:title "UAS Operating Area" ;
	a owl:ObjectProperty ;
	rdfs:label "unmanned_system_operating_area" ;
	rdfs:range ocsf:OcsfUnmannedSystemOperatingArea ;
	skos:definition "The UAS Operating Area object describes details about a precise area of operations for a UAS flight or mission." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:unmanned_system_operator dcterms:title "Unmanned Systems Operator" ;
	a owl:ObjectProperty ;
	rdfs:label "unmanned_system_operator" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The human or machine operator of an Unmanned System." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:unmapped dcterms:title "Unmapped Data" ;
	a owl:ObjectProperty ;
	rdfs:label "unmapped" ;
	rdfs:range ocsf:OcsfObject ;
	rdfs:seeAlso <https://github.com/ocsf/ocsf-docs/blob/main/faqs/schema-faq.md#when-should-i-use-the-unmapped-attribute> , <https://github.com/ocsf/ocsf-schema/blob/main/CONTRIBUTING.md#ocsf-extensions> ;
	skos:definition "A container for source-specific attributes that do not map to any defined OCSF attribute. Use this to preserve valuable source data that would otherwise be lost during normalization. The keys and values are specific to the event source. <p><b>Note: </b>Consumers should not rely on a stable structure within this field. The preferred approach to unmapped attributes is to create a custom extension with the desired structure.</p>" ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:untruncated_size dcterms:title "Untruncated Size" ;
	a owl:DatatypeProperty ;
	rdfs:label "untruncated_size" ;
	rdfs:range xsd:integer ;
	skos:definition "The size in bytes of an attribute before truncation. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:unused_privileges_count dcterms:title "Unused Privileges Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "unused_privileges_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of unused Privileges. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:unused_services_count dcterms:title "Unused Services Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "unused_services_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of unused services. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:updated_entity dcterms:title "Updated Entity" ;
	a owl:ObjectProperty ;
	rdfs:label "updated_entity" ;
	rdfs:range ocsf:OcsfManagedEntity ;
	skos:definition "The updated entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:updated_group dcterms:title "Updated Group" ;
	a owl:ObjectProperty ;
	rdfs:label "updated_group" ;
	rdfs:range ocsf:OcsfGroup ;
	skos:definition "The updated group. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:updated_job dcterms:title "Updated Job" ;
	a owl:ObjectProperty ;
	rdfs:label "updated_job" ;
	rdfs:range ocsf:OcsfJob ;
	skos:definition "The updated job. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:updated_resources dcterms:title "Updated Resources" ;
	a owl:ObjectProperty ;
	rdfs:label "updated_resources" ;
	rdfs:range ocsf:OcsfResourceDetails ;
	skos:definition "The updated resources. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:updated_role dcterms:title "Updated Role" ;
	a owl:ObjectProperty ;
	rdfs:label "updated_role" ;
	rdfs:range ocsf:OcsfIamRole ;
	skos:definition "The updated role. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:updated_user dcterms:title "Updated User" ;
	a owl:ObjectProperty ;
	rdfs:label "updated_user" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The updated user. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:updated_web_resources dcterms:title "Updated Web Resources" ;
	a owl:ObjectProperty ;
	rdfs:label "updated_web_resources" ;
	rdfs:range ocsf:OcsfWebResource ;
	skos:definition "The updated web resources. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:uploaded_time dcterms:title "Uploaded Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "uploaded_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The timestamp at which an entity was uploaded. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:uploaded_time_dt dcterms:title "Uploaded Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "uploaded_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The timestamp at which an entity was uploaded. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:uri dcterms:title "URI" ;
	a owl:DatatypeProperty ;
	rdfs:label "uri" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc3986> ;
	skos:definition "A Uniform Resource Identifier (URI) is a string of characters that identifies a resource on the Internet. URIs can identify physical resources, like webpages and documents. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:url dcterms:title "URL" ;
	a owl:ObjectProperty ;
	rdfs:label "url" ;
	rdfs:range ocsf:OcsfUrl ;
	skos:definition "The URL object that pertains to the event or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:url_string dcterms:title "URL String" ;
	a owl:DatatypeProperty ;
	rdfs:label "url_string" ;
	rdfs:range xsd:string ;
	skos:definition "The URL string. See RFC 1738. For example: <code>http://www.example.com/download/trouble.exe</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:urls dcterms:title "URLs" ;
	a owl:ObjectProperty ;
	rdfs:label "urls" ;
	rdfs:range ocsf:OcsfUrl ;
	skos:definition "The URLs that pertain to the event or object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:user dcterms:title "User" ;
	a owl:ObjectProperty ;
	rdfs:label "user" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The user that pertains to the event or object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:user_agent dcterms:title "HTTP User-Agent" ;
	a owl:DatatypeProperty ;
	rdfs:label "user_agent" ;
	rdfs:range xsd:string ;
	skos:definition "The request header that identifies the operating system and web browser." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_observable "16" .
ocsf:user_result dcterms:title "User Result" ;
	a owl:ObjectProperty ;
	rdfs:label "user_result" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The result of the user account change. It should contain the new values of the changed attributes." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_superseded_by "updated_user" .
ocsf:users dcterms:title "Users" ;
	a owl:ObjectProperty ;
	rdfs:label "users" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The users that pertain to the event or object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:uuid dcterms:title "UUID" ;
	a owl:DatatypeProperty ;
	rdfs:label "uuid" ;
	rdfs:range xsd:string ;
	skos:definition "The universally unique identifier. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:value dcterms:title "Value" ;
	a owl:DatatypeProperty ;
	rdfs:label "value" ;
	rdfs:range xsd:string ;
	skos:definition "The value associated to an attribute. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:values dcterms:title "Values" ;
	a owl:DatatypeProperty ;
	rdfs:label "values" ;
	rdfs:range xsd:string ;
	skos:definition "An array of values associated to an attribute. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vector_string dcterms:title "Vector String" ;
	a owl:DatatypeProperty ;
	rdfs:label "vector_string" ;
	rdfs:range xsd:string ;
	skos:definition "The CVSS vector string is a text representation of a set of CVSS metrics. It is commonly used to record or transfer CVSS metric information in a concise form. For example: <code>3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:H</code>." ;
	skos:exactMatch cve:vectorString ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vendor_attributes dcterms:title "Vendor Attributes" ;
	a owl:ObjectProperty ;
	rdfs:label "vendor_attributes" ;
	rdfs:range ocsf:OcsfVendorAttributes ;
	skos:definition "The Vendor Attributes object can be used to represent values of attributes populated by the Vendor/Finding Provider. It can help distinguish between the vendor-provided values and consumer-updated values, of key attributes like <code>severity_id</code>.<br>The original finding producer should not populate this object. It should be populated by consuming systems that support data mutability." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:vendor_id_list dcterms:title "Vendor ID List" ;
	a owl:DatatypeProperty ;
	rdfs:label "vendor_id_list" ;
	rdfs:range xsd:string ;
	skos:definition "The list of vendor IDs. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vendor_name dcterms:title "Vendor Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "vendor_name" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the vendor. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:verdict dcterms:title "Verdict" ;
	a owl:DatatypeProperty ;
	rdfs:label "verdict" ;
	rdfs:range xsd:string ;
	skos:definition "The verdict assigned to an Incident finding." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:verdict_id dcterms:title "Verdict ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "verdict_id" ;
	rdfs:range _:c14n3570 ;
	skos:definition "The normalized verdict of an Incident." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "verdict" .
ocsf:version dcterms:title "Version" ;
	a owl:DatatypeProperty ;
	rdfs:label "version" ;
	rdfs:range xsd:string ;
	skos:definition "The version that pertains to the event or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vertical_speed dcterms:title "Vertical Speed" ;
	a owl:DatatypeProperty ;
	rdfs:label "vertical_speed" ;
	rdfs:range xsd:string ;
	skos:definition "Vertical speed upward relative to the WGS-84 datum, measured in meters per second. Special Values: <code>Invalid</code>, <code>No Value</code>, or <code>Unknown: 63 m/s</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vlan_uid dcterms:title "VLAN" ;
	a owl:DatatypeProperty ;
	rdfs:label "vlan_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The Virtual LAN identifier." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:volume dcterms:title "Volume" ;
	a owl:DatatypeProperty ;
	rdfs:label "volume" ;
	rdfs:range xsd:string ;
	skos:definition "The volume on the storage device where the file is located. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vpc_uid dcterms:title "VPC UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "vpc_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of the Virtual Private Cloud (VPC)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vram_mode dcterms:title "VRAM Mode" ;
	a owl:DatatypeProperty ;
	rdfs:label "vram_mode" ;
	rdfs:range xsd:string ;
	skos:definition "The video memory attachment mode, indicating how the VRAM hardware is integrated with the system (e.g., shared or dedicated), normalized to the caption of the vram_mode_id value. For 'Other', the exact attachment mode is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vram_mode_id dcterms:title "VRAM Mode ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "vram_mode_id" ;
	rdfs:range _:c14n2864 ;
	skos:definition "The normalized identifier of the video memory attachment mode." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "vram_mode" .
ocsf:vram_size dcterms:title "VRAM Size" ;
	a owl:DatatypeProperty ;
	rdfs:label "vram_size" ;
	rdfs:range xsd:integer ;
	skos:definition "The total amount of installed video RAM." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:vulnerabilities dcterms:title "Vulnerabilities" ;
	a owl:ObjectProperty ;
	rdfs:label "vulnerabilities" ;
	rdfs:range ocsf:OcsfVulnerability ;
	skos:definition "This object describes vulnerabilities reported in a security finding." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:vulnerability dcterms:title "Vulnerability" ;
	a owl:ObjectProperty ;
	rdfs:label "vulnerability" ;
	rdfs:range ocsf:OcsfVulnerability ;
	skos:definition "The vulnerability object describes details related to the observed vulnerability" ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:web_resources dcterms:title "Web Resources" ;
	a owl:ObjectProperty ;
	rdfs:label "web_resources" ;
	rdfs:range ocsf:OcsfWebResource ;
	skos:definition "Describes details about web resources that were affected by an activity/event." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:web_resources_result dcterms:title "Web Resources Result" ;
	a owl:ObjectProperty ;
	rdfs:label "web_resources_result" ;
	rdfs:range ocsf:OcsfWebResource ;
	skos:definition "The results of the activity on web resources. It should contain the new values of the changed attributes of the web resources." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_superseded_by "updated_web_resources" .
ocsf:whois dcterms:title "WHOIS" ;
	a owl:ObjectProperty ;
	rdfs:label "whois" ;
	rdfs:range ocsf:OcsfWhois ;
	skos:definition "The resources of a WHOIS record for a given domain. This can include domain names, IP address blocks, autonomous system information, and/or contact and registration information for a domain." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:win_resource dcterms:title "Windows Resource" ;
	a owl:ObjectProperty ;
	rdfs:label "win_resource" ;
	rdfs:range ocsf:OcsfWinResource ;
	skos:definition "The Windows resource object that was accessed, such as a mutant or timer." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_extension "win" .
ocsf:win_service dcterms:title "Windows Service" ;
	a owl:ObjectProperty ;
	rdfs:label "win_service" ;
	rdfs:range ocsf:OcsfWinService ;
	skos:definition "The Windows service. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_extension "win" .
ocsf:working_directory dcterms:title "Working Directory" ;
	a owl:DatatypeProperty ;
	rdfs:label "working_directory" ;
	rdfs:range xsd:string ;
	skos:definition "The working directory of a process." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:write_count dcterms:title "Write Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "write_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The write count. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:x_forwarded_for dcterms:title "X-Forwarded-For" ;
	a owl:DatatypeProperty ;
	rdfs:label "x_forwarded_for" ;
	rdfs:range xsd:string ;
	skos:definition "The X-Forwarded-For header identifying the originating IP address(es) of a client connecting to a web server through an HTTP proxy or a load balancer." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:x_originating_ip dcterms:title "X-Originating-IP" ;
	a owl:DatatypeProperty ;
	rdfs:label "x_originating_ip" ;
	rdfs:range xsd:string ;
	skos:definition "The X-Originating-IP header identifying the emails originating IP address(es)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:xattributes dcterms:title "Extended Attributes" ;
	a owl:ObjectProperty ;
	rdfs:label "xattributes" ;
	rdfs:range ocsf:OcsfObject ;
	skos:definition "Attributes not present in the schema that extend the class or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
