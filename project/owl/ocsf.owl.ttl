ocsf:cpu_architecture_id dcterms:title "CPU Architecture ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "cpu_architecture_id" ;
	rdfs:range _:c14n9096 ;
	skos:definition "The normalized identifier of the CPU architecture." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "cpu_architecture" .
ocsf:cpu_bits dcterms:title "CPU Bits" ;
	a owl:DatatypeProperty ;
	rdfs:label "cpu_bits" ;
	rdfs:range xsd:integer ;
	skos:definition "The cpu architecture, the number of bits used for addressing in memory. For example: <code>32</code> or <code>64</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:cpu_cores dcterms:title "CPU Cores" ;
	a owl:DatatypeProperty ;
	rdfs:label "cpu_cores" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of processor cores in all installed processors. For Example: <code>42</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_superseded_by "cpu_info_list[*].cores" .
ocsf:cpu_count dcterms:title "CPU Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "cpu_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of physical processors on a system. For example: <code>1</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:cpu_info_list dcterms:title "CPU Information" ;
	a owl:ObjectProperty ;
	rdfs:label "cpu_info_list" ;
	rdfs:range ocsf:OcsfCpuInfo ;
	skos:definition "An array of objects, each describing a physical CPU package installed in the device." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:cpu_speed dcterms:title "Processor Speed" ;
	a owl:DatatypeProperty ;
	rdfs:label "cpu_speed" ;
	rdfs:range xsd:integer ;
	skos:definition "The speed of the processor in Mhz. For Example: <code>4200</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_superseded_by "cpu_info_list[*].speed_mhz" .
ocsf:cpu_type dcterms:title "Processor Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "cpu_type" ;
	rdfs:range xsd:string ;
	skos:definition "The processor type. For example: <code>x86 Family 6 Model 37 Stepping 5</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_superseded_by "cpu_info_list[*].model cpu_info_list[*].vendor_name" .
ocsf:create_mask dcterms:title "Create Mask" ;
	a owl:DatatypeProperty ;
	rdfs:label "create_mask" ;
	rdfs:range xsd:string ;
	skos:definition "The original Windows mask that is required to create the object." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:created_time dcterms:title "Created Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "created_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The time when the object was created. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:created_time_dt dcterms:title "Created Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "created_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The time when the object was created. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:creator dcterms:title "Creator" ;
	a owl:ObjectProperty ;
	rdfs:label "creator" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The user that created the object associated with event. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:credential_uid dcterms:title "User Credential ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "credential_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of the user's credential. For example, AWS Access Key ID." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_observable "19" .
ocsf:criticality dcterms:title "Criticality" ;
	a owl:DatatypeProperty ;
	rdfs:label "criticality" ;
	rdfs:range xsd:string ;
	skos:definition "Criticality or relative importance of a resource/object in question, normalized to the caption of <code>criticality_id</code>. In the case of Other, the value is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:criticality_id dcterms:title "Criticality Level ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "criticality_id" ;
	rdfs:range _:c14n1879 ;
	skos:definition "Criticality or relative importance of a resource/object in question." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "criticality" .
ocsf:cumulative_traffic dcterms:title "Cumulative Traffic" ;
	a owl:ObjectProperty ;
	rdfs:label "cumulative_traffic" ;
	rdfs:range ocsf:OcsfNetworkTraffic ;
	skos:definition "The cumulative network traffic. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:customer_uid dcterms:title "Customer UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "customer_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique customer identifier." ;
	skos:inScheme ocsf:ocsf_core ;
