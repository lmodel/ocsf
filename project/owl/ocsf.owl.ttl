ocsf:module dcterms:title "Module" ;
	a owl:ObjectProperty ;
	rdfs:label "module" ;
	rdfs:range ocsf:OcsfModule ;
	skos:definition "The module that pertains to the event." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:name dcterms:title "Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "name" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:name_servers dcterms:title "Name Servers" ;
	a owl:DatatypeProperty ;
	rdfs:label "name_servers" ;
	rdfs:range xsd:string ;
	skos:definition "A collection of name servers related to a domain registration or other record." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:namespace dcterms:title "Namespace" ;
	a owl:DatatypeProperty ;
	rdfs:label "namespace" ;
	rdfs:range xsd:string ;
	skos:definition "The namespace is useful in merger or acquisition situations. For example, when similar entities exist that you need to keep separate." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:namespace_pid dcterms:title "Namespace PID" ;
	a owl:DatatypeProperty ;
	rdfs:label "namespace_pid" ;
	rdfs:range xsd:integer ;
	skos:definition "If running under a process namespace (such as in a container), the process identifier within that process namespace." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:network_driver dcterms:title "Network Driver" ;
	a owl:DatatypeProperty ;
	rdfs:label "network_driver" ;
	rdfs:range xsd:string ;
	skos:definition "The network driver used by the container. For example, bridge, overlay, host, none, etc." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:network_endpoint dcterms:title "Network Endpoint" ;
	a owl:ObjectProperty ;
	rdfs:label "network_endpoint" ;
	rdfs:range ocsf:OcsfNetworkEndpoint ;
	skos:definition "The Network Endpoint object describes characteristics of a network endpoint. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:network_interfaces dcterms:title "Network Interfaces" ;
	a owl:ObjectProperty ;
	rdfs:label "network_interfaces" ;
	rdfs:range ocsf:OcsfNetworkInterface ;
	skos:definition "The physical or virtual network interfaces that are associated with the device, one for each unique MAC address/IP address/hostname/name combination.<p><b>Note:</b> The first element of the array is the network information that pertains to the event.</p>" ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:network_observation_point dcterms:title "Network Observation Point" ;
	a owl:ObjectProperty ;
	rdfs:label "network_observation_point" ;
	rdfs:range ocsf:OcsfNetworkEndpoint ;
	skos:definition "The network endpoint that observes or inspects network traffic as a third-party system, used when the observer is neither the source nor the destination of the communication. Examples include network taps, span ports, inline security devices, or packet capture systems." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:network_scope dcterms:title "Network Scope" ;
	a owl:DatatypeProperty ;
	rdfs:label "network_scope" ;
	rdfs:range xsd:string ;
	skos:definition "Indicates whether the endpoint resides inside the customer’s network, outside on the Internet, or if its location relative to the customer’s network cannot be determined. The value is normalized to the caption of the <code>network_scope_id</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:network_scope_id dcterms:title "Network Scope ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "network_scope_id" ;
	rdfs:range _:c14n8333 ;
	skos:definition "The normalized identifier of the endpoint’s network scope. The normalized network scope identifier indicates whether the endpoint resides inside the customer’s network, outside on the Internet, or if its location relative to the customer’s network cannot be determined." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "network_scope" .
ocsf:next_run_time dcterms:title "Next Run" ;
	a owl:DatatypeProperty ;
	rdfs:label "next_run_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The next run time. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:next_run_time_dt dcterms:title "Next Run" ;
	a owl:DatatypeProperty ;
	rdfs:label "next_run_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The next run time. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:nist dcterms:title "NIST List" ;
	a owl:DatatypeProperty ;
	rdfs:label "nist" ;
	rdfs:range xsd:string ;
	skos:definition "The NIST Cybersecurity Framework recommendations for managing the cybersecurity risk." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:nodes dcterms:title "Nodes" ;
	a owl:ObjectProperty ;
	rdfs:label "nodes" ;
	rdfs:range ocsf:OcsfNode ;
	skos:definition "The list of node objects that are part of the graph." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:notes dcterms:title "Notes" ;
	a owl:ObjectProperty ;
	rdfs:label "notes" ;
	rdfs:range ocsf:OcsfNote ;
	skos:definition "Additional notes related to the event or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:num_detections dcterms:title "Detections" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_detections" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of detections." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_files dcterms:title "Scanned Files" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_files" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of files scanned." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_folders dcterms:title "Scanned Folders" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_folders" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of folders scanned." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_infected dcterms:title "Number of Infected Entities" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_infected" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of infected entities. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_network_items dcterms:title "Scanned Network Items" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_network_items" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of network items scanned." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_processes dcterms:title "Scanned Processes" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_processes" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of processes scanned." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_registry_items dcterms:title "Scanned Registry Items" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_registry_items" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of registry items scanned." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_resolutions dcterms:title "Resolutions" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_resolutions" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of items that were resolved." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_skipped_items dcterms:title "Skipped" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_skipped_items" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of skipped items." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_trusted_items dcterms:title "Trusted" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_trusted_items" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of trusted items." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_violations dcterms:title "Violations" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_violations" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of times the policy or rule was violated." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:num_volumes dcterms:title "Number of Volumes" ;
	a owl:DatatypeProperty ;
	rdfs:label "num_volumes" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of volumes in the storage device. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:number dcterms:title "Number" ;
	a owl:DatatypeProperty ;
	rdfs:label "number" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of the entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:observables dcterms:title "Observables" ;
	a owl:ObjectProperty ;
	rdfs:label "observables" ;
	rdfs:range ocsf:OcsfObservable ;
	rdfs:seeAlso <https://github.com/ocsf/ocsf-docs/blob/main/articles/defining-and-using-observables.md> ;
	skos:definition "The observables array surfaces key indicators and entities from the event or finding in a single, consistent location for downstream correlation and detection. Each entry references an attribute path within the event (e.g., <code>src_endpoint.ip</code>) along with its type and value, enabling consumers to extract IOCs without parsing the full event structure." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:observation_parameter dcterms:title "Observation Parameter" ;
	a owl:DatatypeProperty ;
	rdfs:label "observation_parameter" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the parameter being analyzed or monitored. This generally identifies the specific characteristic or property being measured. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:observation_point dcterms:title "Observation Point" ;
	a owl:DatatypeProperty ;
	rdfs:label "observation_point" ;
	rdfs:range xsd:string ;
	skos:definition "The normalized observation point value. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:observation_point_id dcterms:title "Observation Point ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "observation_point_id" ;
	rdfs:range _:c14n4086 ;
	skos:definition "The normalized identifier of the observation point. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "observation_point" .
ocsf:observation_type dcterms:title "Observation Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "observation_type" ;
	rdfs:range xsd:string ;
	skos:definition "The classification or category of the observation, indicating what kind of measurement or finding it represents. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:observations dcterms:title "Observations" ;
	a owl:ObjectProperty ;
	rdfs:label "observations" ;
	rdfs:range ocsf:OcsfObservation ;
	skos:definition "A list of individual observations or measurements collected during analysis. Each observation captures a specific data point. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:observed_pattern dcterms:title "Observed Pattern" ;
	a owl:DatatypeProperty ;
	rdfs:label "observed_pattern" ;
	rdfs:range xsd:string ;
	skos:definition "A detected pattern or trend identified in the analyzed data, describing recurring activities or characteristics." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:occurrence_details dcterms:title "Occurrence Details" ;
	a owl:ObjectProperty ;
	rdfs:label "occurrence_details" ;
	rdfs:range ocsf:OcsfOccurrenceDetails ;
	skos:definition "Details about where in the target entity the specified information was discovered. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:occurrences dcterms:title "Occurrences" ;
	a owl:ObjectProperty ;
	rdfs:label "occurrences" ;
	rdfs:range ocsf:OcsfOccurrenceDetails ;
	skos:definition "A list of <code>occurrence_details</code> objects, each describing where in the target entity the specified information was discovered. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:ocsf_associations a owl:DatatypeProperty ;
	rdfs:label "ocsf_associations" ;
	skos:definition "A class's associations between attributes, as JSON." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_category a owl:DatatypeProperty ;
	rdfs:label "ocsf_category" ;
	skos:definition "The event class's category, by OCSF's key." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_category_uid a owl:DatatypeProperty ;
	rdfs:label "ocsf_category_uid" ;
	skos:definition "The category's number, on the subset that stands for it." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_constraints a owl:DatatypeProperty ;
	rdfs:label "ocsf_constraints" ;
	skos:definition "A class's at_least_one and just_one constraints, as JSON." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_deprecated_since a owl:DatatypeProperty ;
	rdfs:label "ocsf_deprecated_since" ;
	skos:definition "The OCSF version that deprecated the element." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_extension a owl:DatatypeProperty ;
	rdfs:label "ocsf_extension" ;
	skos:definition "The extension that defines the element." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_extension_uid a owl:DatatypeProperty ;
	rdfs:label "ocsf_extension_uid" ;
	skos:definition "The extension's number, on the subset that stands for it." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_group a owl:DatatypeProperty ;
	rdfs:label "ocsf_group" ;
	skos:definition "An attribute's group: classification, context, occurrence or primary." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_key a owl:DatatypeProperty ;
	rdfs:label "ocsf_key" ;
	skos:definition "The item's key in OCSF, scoped by its extension where it has one." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_max_len a owl:DatatypeProperty ;
	rdfs:label "ocsf_max_len" ;
	skos:definition "OCSF's longest allowed value of a data type, in characters." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_observable a owl:DatatypeProperty ;
	rdfs:label "ocsf_observable" ;
	skos:definition "OCSF's observable type id for the element." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_profiles a owl:DatatypeProperty ;
	rdfs:label "ocsf_profiles" ;
	skos:definition "The profiles behind an element, by OCSF's key and space separated. An event holds an attribute that names any only if metadata.profiles lists one of them. On a class, they are every profile OCSF lists for it, its nested objects' included." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_requirement a owl:DatatypeProperty ;
	rdfs:label "ocsf_requirement" ;
	skos:definition "OCSF's requirement on an attribute a profile brings, which applies only when the event lists the profile." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_sibling a owl:DatatypeProperty ;
	rdfs:label "ocsf_sibling" ;
	skos:definition "The string attribute that holds the label of an enumerated one." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_source_note a owl:DatatypeProperty ;
	rdfs:label "ocsf_source_note" ;
	skos:definition "OCSF's note on where an attribute comes from." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_superseded_by a owl:DatatypeProperty ;
	rdfs:label "ocsf_superseded_by" ;
	skos:definition "What OCSF names as the replacement, space separated." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ocsf_suppress_checks a owl:DatatypeProperty ;
	rdfs:label "ocsf_suppress_checks" ;
	skos:definition "The convention checks OCSF turns off for an attribute." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:office_location dcterms:title "Office Location" ;
	a owl:DatatypeProperty ;
	rdfs:label "office_location" ;
	rdfs:range xsd:string ;
	skos:definition "The primary office location associated with the user. This could be any string and isn't a specific address. For example, <code>South East Virtual</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:opcode dcterms:title "DNS Opcode" ;
	a owl:DatatypeProperty ;
	rdfs:label "opcode" ;
	rdfs:range xsd:string ;
	skos:definition "The DNS opcode specifies the type of the query message." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:opcode_id dcterms:title "DNS Opcode ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "opcode_id" ;
	rdfs:range _:c14n2700 ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5395.html> ;
	skos:definition "The DNS opcode ID specifies the normalized query message type as defined in RFC 5395." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_suppress_checks "enum_convention" .
ocsf:open_mask dcterms:title "Open Mask" ;
	a owl:DatatypeProperty ;
	rdfs:label "open_mask" ;
	rdfs:range xsd:integer ;
	skos:definition "The Windows options needed to open a registry key." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:open_ports dcterms:title "Open Ports" ;
	a owl:ObjectProperty ;
	rdfs:label "open_ports" ;
	rdfs:range ocsf:OcsfPortInfo ;
	skos:definition "The list of open ports on a network interface, including port numbers and associated protocol information." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:open_type dcterms:title "Open Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "open_type" ;
	rdfs:range xsd:string ;
	skos:definition "The file open type." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:operation dcterms:title "Operation" ;
	a owl:DatatypeProperty ;
	rdfs:label "operation" ;
	rdfs:range xsd:string ;
	skos:definition "Verb/Operation associated with the request" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:opnum dcterms:title "Opnum" ;
	a owl:DatatypeProperty ;
	rdfs:label "opnum" ;
	rdfs:range xsd:integer ;
	skos:definition "An operation number used to identify a specific remote procedure call (RPC) method or a method in an interface." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:orchestrator dcterms:title "Orchestrator" ;
	a owl:DatatypeProperty ;
	rdfs:label "orchestrator" ;
	rdfs:range xsd:string ;
	skos:definition "The orchestrator managing the container, such as ECS, EKS, K8s, or OpenShift." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:org dcterms:title "Organization" ;
	a owl:ObjectProperty ;
	rdfs:label "org" ;
	rdfs:range ocsf:OcsfOrganization ;
	skos:definition "Organization and org unit relevant to the event or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:original_event_uid dcterms:title "Original Event ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "original_event_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier assigned to the event in its original logging system before transformation to OCSF format. This field preserves the source system's native event identifier, enabling traceability back to the raw log entry. For example, a Windows Event Record ID, a syslog message ID, a Splunk _cd value, or a database transaction log sequence number." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:original_time dcterms:title "Original Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "original_time" ;
	rdfs:range xsd:string ;
	skos:definition "The original event time as reported by the event source, preserved as a pass-through string in its native format (e.g., Syslog timestamp, Windows event time). This is not normalized to <code>timestamp_t</code> - the normalized equivalent is the base event <code>time</code> attribute. Omit if the event is generated rather than collected via logs." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:os dcterms:title "OS" ;
	a owl:ObjectProperty ;
	rdfs:label "os" ;
	rdfs:range ocsf:OcsfOs ;
	skos:definition "The endpoint operating system." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:os_machine_uuid dcterms:title "OS Machine UUID" ;
	a owl:DatatypeProperty ;
	rdfs:label "os_machine_uuid" ;
	rdfs:range xsd:string ;
	skos:definition "The operating system assigned Machine ID. In Windows, this is the value stored at the registry path: <code>HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Cryptography\\MachineGuid</code>. In Linux, this is stored in the file: <code>/etc/machine-id</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:osint dcterms:title "OSINT" ;
	a owl:ObjectProperty ;
	rdfs:label "osint" ;
	rdfs:range ocsf:OcsfOsint ;
	skos:definition "The OSINT (Open Source Intelligence) object contains details related to an indicator such as the indicator itself, related indicators, geolocation, registrar information, subdomains, analyst commentary, and other contextual information. This information can be used to further enrich a detection or finding by providing decisioning support to other analysts and engineers." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:ou_name dcterms:title "Org Unit Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "ou_name" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the organizational unit, within an organization.  For example, Finance, IT, R&D" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ou_uid dcterms:title "Org Unit ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "ou_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The alternate identifier for an entity's unique identifier. For example, its Active Directory OU DN or AWS OU ID." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:overall_score dcterms:title "Overall Score" ;
	a owl:DatatypeProperty ;
	rdfs:label "overall_score" ;
	rdfs:range xsd:float ;
	skos:definition "The overall score as reported by the event source. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:owner dcterms:title "Owner" ;
	a owl:ObjectProperty ;
	rdfs:label "owner" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The user that owns the file/object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:package dcterms:title "Software Package" ;
	a owl:ObjectProperty ;
	rdfs:label "package" ;
	rdfs:range ocsf:OcsfPackage ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:SoftwarePackage/> ;
	skos:definition "The Software Package object describes details about a software package." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:package_manager dcterms:title "Package Manager" ;
	a owl:DatatypeProperty ;
	rdfs:label "package_manager" ;
	rdfs:range xsd:string ;
	skos:definition "The software packager manager utilized to manage a package on a system, e.g. npm, yum, dpkg etc." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:package_manager_url dcterms:title "Package Manager URL" ;
	a owl:DatatypeProperty ;
	rdfs:label "package_manager_url" ;
	rdfs:range xsd:string ;
	skos:definition "The URL of the package or library at the package manager, or the specific URL or URI of an internal package manager link such as <code>AWS CodeArtifact</code> or <code>Artifactory</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:packages dcterms:title "Software Packages" ;
	a owl:ObjectProperty ;
	rdfs:label "packages" ;
	rdfs:range ocsf:OcsfPackage ;
	skos:definition "List of vulnerable packages as identified by the security product" ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.1.0" ;
	ocsf:ocsf_superseded_by "affected_packages" .
ocsf:packet dcterms:title "Packet" ;
	a owl:ObjectProperty ;
	rdfs:label "packet" ;
	rdfs:range ocsf:OcsfPacket ;
	skos:definition "The packet object describes a single captured network packet and its associated metadata." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:packet_list dcterms:title "Packets" ;
	a owl:ObjectProperty ;
	rdfs:label "packet_list" ;
	rdfs:range ocsf:OcsfPacket ;
	skos:definition "The list of packet objects describing captured network packets." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:packet_uid dcterms:title "Packet UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "packet_uid" ;
	rdfs:range xsd:integer ;
	skos:definition "The packet identifier assigned by the protocol." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:packets dcterms:title "Total Packets" ;
	a owl:DatatypeProperty ;
	rdfs:label "packets" ;
	rdfs:range xsd:integer ;
	skos:definition "The total number of packets (in and out)." ;
