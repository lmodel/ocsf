ocsf:cve dcterms:title "CVE" ;
	a owl:ObjectProperty ;
	rdfs:label "cve" ;
	rdfs:range ocsf:OcsfCve ;
	rdfs:seeAlso <https://cve.mitre.org/> ;
	skos:definition "The Common Vulnerabilities and Exposures identifier for a vulnerability." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:cves dcterms:title "CVE List" ;
	a owl:ObjectProperty ;
	rdfs:label "cves" ;
	rdfs:range ocsf:OcsfCve ;
	rdfs:seeAlso <https://cve.mitre.org/> ;
	skos:definition "List of Common Vulnerabilities and Exposures identifiers." ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch cve:cveId .
ocsf:cvss dcterms:title "CVSS Score" ;
	a owl:ObjectProperty ;
	rdfs:label "cvss" ;
	rdfs:range ocsf:OcsfCvss ;
	rdfs:seeAlso <https://www.first.org/cvss/> ;
	skos:definition "The CVSS object details Common Vulnerability Scoring System scores from the advisory that are related to the vulnerability." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:cwe dcterms:title "CWE" ;
	a owl:ObjectProperty ;
	rdfs:label "cwe" ;
	rdfs:range ocsf:OcsfCwe ;
	rdfs:seeAlso <https://cwe.mitre.org/> ;
	skos:definition "The CWE object represents a weakness in a software system that can be exploited by a threat actor to perform an attack. The CWE object is based on the Common Weakness Enumeration (CWE) catalog." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:cwe_uid dcterms:title "CWE UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "cwe_uid" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://cwe.mitre.org/> ;
	skos:closeMatch cve:cweId ;
	skos:definition "The Common Weakness Enumeration (CWE) unique identifier. For example: <code>CWE-787</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	skos:relatedMatch kev_catalog:cwes ;
	ocsf:ocsf_deprecated_since "1.1.0" ;
	ocsf:ocsf_superseded_by "related_cwes[*].uid" .
ocsf:cwe_url dcterms:title "CWE URL" ;
	a owl:DatatypeProperty ;
	rdfs:label "cwe_url" ;
	rdfs:range xsd:string ;
	skos:definition "Common Weakness Enumeration (CWE) definition URL. For example: <code>https://cwe.mitre.org/data/definitions/787.html</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.1.0" ;
	ocsf:ocsf_superseded_by "related_cwes[*].src_url" .
ocsf:d3f_tactic dcterms:title "MITRE D3FEND™ Tactic" ;
	a owl:ObjectProperty ;
	rdfs:label "d3f_tactic" ;
	rdfs:range ocsf:OcsfD3fTactic ;
	rdfs:seeAlso <https://d3fend.mitre.org> ;
	skos:definition "The D3FEND Tactic object describes the defensive tactic name associated with a countermeasure." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:d3f_technique dcterms:title "MITRE D3FEND™ Technique" ;
	a owl:ObjectProperty ;
	rdfs:label "d3f_technique" ;
	rdfs:range ocsf:OcsfD3fTechnique ;
	rdfs:seeAlso <https://d3fend.mitre.org> ;
	skos:definition "The D3FEND Technique object describes the defensive technique ID and/or name associated with a countermeasure." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:data dcterms:title "Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "data" ;
	rdfs:range _:c14n2811 ;
	skos:definition "The additional data that is associated with the event or object. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:data_classification dcterms:title "Data Classification" ;
	a owl:ObjectProperty ;
	rdfs:label "data_classification" ;
	rdfs:range ocsf:OcsfDataClassification ;
	skos:definition "The Data Classification object includes information about data classification levels and data category types." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:data_classifications dcterms:title "Data Classification" ;
	a owl:ObjectProperty ;
	rdfs:label "data_classifications" ;
	rdfs:range ocsf:OcsfDataClassification ;
	skos:definition "A list of Data Classification objects, that include information about data classification levels and data category types, identified by a classifier." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:data_lifecycle_state dcterms:title "Data Lifecycle State" ;
	a owl:DatatypeProperty ;
	rdfs:label "data_lifecycle_state" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the stage or state that the data was in. E.g., Data-at-Rest, Data-in-Transit, etc." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:data_lifecycle_state_id dcterms:title "Data Lifecycle State ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "data_lifecycle_state_id" ;
	rdfs:range _:c14n8692 ;
	skos:definition "The stage or state that the data was in when it was assessed or scanned by a data security tool." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "data_lifecycle_state" .
ocsf:data_security dcterms:title "Data Security" ;
	a owl:ObjectProperty ;
	rdfs:label "data_security" ;
	rdfs:range ocsf:OcsfDataSecurity ;
	skos:definition "The Data Security object describes the characteristics, techniques and content of a Data Loss Prevention (DLP), Data Loss Detection (DLD), Data Classification, or similar tools' finding, alert, or detection mechanism(s)." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:data_sources dcterms:title "Data Sources" ;
	a owl:DatatypeProperty ;
	rdfs:label "data_sources" ;
	rdfs:range xsd:string ;
	skos:definition "A list of data sources utilized in generation of the finding." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:database dcterms:title "Database" ;
	a owl:ObjectProperty ;
	rdfs:label "database" ;
	rdfs:range ocsf:OcsfDatabase ;
	skos:definition "The database object is used for databases which are typically datastore services that contain an organized collection of structured and unstructured data or a types of data." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:databucket dcterms:title "Databucket" ;
	a owl:ObjectProperty ;
	rdfs:label "databucket" ;
	rdfs:range ocsf:OcsfDatabucket ;
	skos:definition "The data bucket object is a basic container that holds data, typically organized through the use of data partitions." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:dce_rpc dcterms:title "Distributed Computing Environment/Remote Procedure Call (DCE/RPC)" ;
	a owl:ObjectProperty ;
	rdfs:label "dce_rpc" ;
	rdfs:range ocsf:OcsfDceRpc ;
	skos:definition "The DCE/RPC object describes the remote procedure call system for distributed computing environments." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:debug dcterms:title "Debug Information" ;
	a owl:DatatypeProperty ;
	rdfs:label "debug" ;
	rdfs:range xsd:string ;
	skos:definition "Debug information about non-fatal issues with this OCSF event. Each issue is a line in this string array." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:decision dcterms:title "Authorization Decision/Outcome" ;
	a owl:DatatypeProperty ;
	rdfs:label "decision" ;
	rdfs:range xsd:string ;
	skos:definition "Decision/outcome of the authorization mechanism (e.g. Approved, Denied)" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:delay dcterms:title "Root Delay" ;
	a owl:DatatypeProperty ;
	rdfs:label "delay" ;
	rdfs:range xsd:integer ;
	skos:definition "The total round-trip delay to the reference clock in milliseconds." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:delegation dcterms:title "Delegation" ;
	a owl:ObjectProperty ;
	rdfs:label "delegation" ;
	rdfs:range ocsf:OcsfDelegation ;
	skos:definition "A durable authorization context issued by a principal to a delegate (e.g., an application, automated process, service account, or AI agent), representing delegated authority to act on the principal's behalf. Independent of any single event, trace, or session, enabling correlation of actions performed under the same delegated authority." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:deleted_time dcterms:title "Deleted Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "deleted_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The timestamp when the user was deleted. In Active Directory (AD), when a user is deleted they are moved to a temporary container and then removed after 30 days. So, this field can be populated even after a user is deleted for the next 30 days." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:deleted_time_dt dcterms:title "Deleted Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "deleted_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The timestamp when the user was deleted. In Active Directory (AD), when a user is deleted they are moved to a temporary container and then removed after 30 days. So, this field can be populated even after a user is deleted for the next 30 days." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:delivered_to dcterms:title "Delivered To" ;
	a owl:DatatypeProperty ;
	rdfs:label "delivered_to" ;
	rdfs:range xsd:string ;
	skos:definition "The machine-readable <strong>Delivered-To</strong> email header field. For example <code>example.user@usersdomain.com</code>" ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.4.0" ;
	ocsf:ocsf_superseded_by "delivered_to_list" .
ocsf:delivered_to_list dcterms:title "Delivered To List" ;
	a owl:DatatypeProperty ;
	rdfs:label "delivered_to_list" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9228> ;
	skos:definition "The machine-readable <strong>Delivered-To</strong> email header values. For example <code>example.user@usersdomain.com</code>" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:department dcterms:title "Department" ;
	a owl:DatatypeProperty ;
	rdfs:label "department" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the department or organizational unit where the entity is assigned or belongs. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:dependency_chain dcterms:title "Dependency Chain" ;
	a owl:DatatypeProperty ;
	rdfs:label "dependency_chain" ;
	rdfs:range xsd:string ;
	skos:definition "Information about the chain of dependencies related to the issue as reported by an Application Security or Vulnerability Management tool. E.g., <code>serverless-offline -> @serverless/utils -> memoizee -> es5-ext</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:depth dcterms:title "CVSS Depth" ;
	a owl:ObjectProperty ;
	rdfs:label "depth" ;
	rdfs:range ocsf:OcsfDepth ;
	skos:definition "The CVSS depth represents a depth of the equation used to calculate CVSS score." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:desc dcterms:title "Description" ;
	a owl:DatatypeProperty ;
	rdfs:label "desc" ;
	rdfs:range xsd:string ;
	skos:definition "The description that pertains to the object or event. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:desktop_display dcterms:title "Desktop Display" ;
	a owl:ObjectProperty ;
	rdfs:label "desktop_display" ;
	rdfs:range ocsf:OcsfDisplay ;
	skos:definition "The desktop display affiliated with the event" ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:details dcterms:title "Details" ;
	a owl:DatatypeProperty ;
	rdfs:label "details" ;
	rdfs:range xsd:string ;
	skos:definition "Details of an entity. See specific usage" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:detection_pattern dcterms:title "Detection Pattern" ;
	a owl:DatatypeProperty ;
	rdfs:label "detection_pattern" ;
	rdfs:range xsd:string ;
	skos:definition "Specific pattern, algorithm, fingerprint, or model used for detection." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:detection_pattern_type dcterms:title "Detection Pattern" ;
	a owl:DatatypeProperty ;
	rdfs:label "detection_pattern_type" ;
	rdfs:range xsd:string ;
	skos:definition "The detection pattern type, normalized to the caption of the detection_pattern_type_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:detection_pattern_type_id dcterms:title "Detection Pattern Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "detection_pattern_type_id" ;
	rdfs:range _:c14n7614 ;
	skos:definition "Specifies the type of detection pattern used to identify the associated threat indicator." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "detection_pattern_type" .
ocsf:detection_system dcterms:title "Detection System" ;
	a owl:DatatypeProperty ;
	rdfs:label "detection_system" ;
	rdfs:range xsd:string ;
	skos:definition "The data security tool or system that the finding, detection, or alert originated from, normalized to the caption of <code>detection_system_id</code>. E.g., Endpoint, Secure Email Gateway, etc. When <code>detection_system_id</code> is <code>99</code> (Other), this attribute must contain the source-specific label." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:detection_system_id dcterms:title "Detection System ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "detection_system_id" ;
	rdfs:range _:c14n10538 ;
	skos:definition "The normalized identifier of the data security tool or system type from which the finding, detection, or alert originated. When the type is not listed, use <code>99</code> (Other) and populate <code>detection_system</code> with the source-specific label." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "detection_system" .
ocsf:detection_uid dcterms:title "Detection UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "detection_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The associated unique detection event identifier. For example: detection response events include the <b>Detection ID</b> of the original event." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:developer_uid dcterms:title "Developer UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "developer_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The developer ID on the certificate that signed the file." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:device dcterms:title "Device" ;
	a owl:ObjectProperty ;
	rdfs:label "device" ;
	rdfs:range ocsf:OcsfDevice ;
	skos:definition "An addressable device, computer system or host." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:devices dcterms:title "Devices" ;
	a owl:ObjectProperty ;
	rdfs:label "devices" ;
	rdfs:range ocsf:OcsfDevice ;
	skos:definition "The object describes details related to the list of devices." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:dialect dcterms:title "Dialect" ;
	a owl:DatatypeProperty ;
	rdfs:label "dialect" ;
	rdfs:range xsd:string ;
	skos:definition "The negotiated protocol dialect." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:digest dcterms:title "Message Digest" ;
	a owl:ObjectProperty ;
	rdfs:label "digest" ;
	rdfs:range ocsf:OcsfFingerprint ;
	skos:definition "The message digest attribute contains the fixed length message hash representation and the corresponding hashing algorithm information." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:direction dcterms:title "Direction" ;
	a owl:DatatypeProperty ;
	rdfs:label "direction" ;
	rdfs:range xsd:string ;
	skos:definition "The direction of the initiated connection, traffic, or email, normalized to the caption of the direction_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:direction_id dcterms:title "Direction ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "direction_id" ;
	rdfs:range _:c14n3188 ;
	skos:definition "The normalized identifier of the direction of the initiated connection, traffic, or email." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "direction" .
ocsf:discovery_details dcterms:title "Discovery Details" ;
	a owl:ObjectProperty ;
	rdfs:label "discovery_details" ;
	rdfs:range ocsf:OcsfDiscoveryDetails ;
	skos:definition "A collection of <code>Discovery Details</code> objects. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:dispersion dcterms:title "Root Dispersion" ;
	a owl:DatatypeProperty ;
	rdfs:label "dispersion" ;
	rdfs:range xsd:integer ;
	skos:definition "The dispersion in the NTP protocol is the estimated time error or uncertainty relative to the reference clock in milliseconds." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:display_name dcterms:title "Display Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "display_name" ;
	rdfs:range xsd:string ;
	skos:definition "The display name. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:disposition dcterms:title "Disposition" ;
	a owl:DatatypeProperty ;
	rdfs:label "disposition" ;
	rdfs:range xsd:string ;
	skos:definition "The disposition name, normalized to the caption of the disposition_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:disposition_id dcterms:title "Disposition ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "disposition_id" ;
	rdfs:range _:c14n2659 ;
	skos:definition "Describes the outcome or action taken by a security control, such as access control checks, malware detections or various types of policy violations." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "disposition" .
ocsf:dkim dcterms:title "DKIM Status" ;
	a owl:DatatypeProperty ;
	rdfs:label "dkim" ;
	rdfs:range xsd:string ;
	skos:definition "The DomainKeys Identified Mail (DKIM) status of the email." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:dkim_domain dcterms:title "DKIM Domain" ;
	a owl:DatatypeProperty ;
	rdfs:label "dkim_domain" ;
	rdfs:range xsd:string ;
	skos:definition "The DomainKeys Identified Mail (DKIM) signing domain of the email." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:dkim_signature dcterms:title "DKIM Signature" ;
	a owl:DatatypeProperty ;
	rdfs:label "dkim_signature" ;
	rdfs:range xsd:string ;
	skos:definition "The DomainKeys Identified Mail (DKIM) signature used by the sending/receiving system." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:dmarc dcterms:title "DMARC Status" ;
	a owl:DatatypeProperty ;
