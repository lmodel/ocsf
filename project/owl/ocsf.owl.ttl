	rdfs:subClassOf ocsf:OcsfDataClassification , _:c14n10375 , _:c14n11005 , _:c14n1299 , _:c14n1450 , _:c14n2225 , _:c14n2483 , _:c14n3122 , _:c14n3657 , _:c14n3741 , _:c14n3885 , _:c14n4604 , _:c14n5270 , _:c14n5463 , _:c14n6129 , _:c14n6718 , _:c14n7048 , _:c14n7194 , _:c14n7382 , _:c14n8228 , _:c14n9067 , _:c14n9354 , _:c14n9845 ;
