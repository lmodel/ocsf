	ocsf:ocsf_profiles "ai_operation cloud container data_classification datetime host linux/linux_users load_balancer macos/macos_users network_proxy osint record_integrity security_control" .
ocsf:OcsfUnmannedAerialSystem dcterms:title "Unmanned Aerial System" ;
