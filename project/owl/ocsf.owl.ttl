ocsf:size dcterms:title "Size" ;
	a owl:DatatypeProperty ;
	rdfs:label "size" ;
	rdfs:range xsd:integer ;
	skos:definition "The size of data, in bytes." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:smtp_from dcterms:title "SMTP From" ;
