	skos:definition "The OSINT (Open Source Intelligence) object contains details related to an indicator such as the indicator itself, related indicators, geolocation, registrar information, subdomains, analyst commentary, and other contextual information. This information can be used to further enrich a detection or finding by providing decisioning support to other analysts and engineers." ;
	skos:exactMatch ocsf:OcsfOsint ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "osint" ;
	ocsf:ocsf_profiles "container data_classification datetime" .
ocsf:OcsfOsintInventoryInfo dcterms:title "OSINT Inventory Info" ;
	a owl:Class ;
	rdfs:label "OcsfOsintInventoryInfo" ;
	rdfs:subClassOf ocsf:OcsfDiscoveryEvent , _:c14n10365 , _:c14n1100 , _:c14n1541 , _:c14n1610 , _:c14n1844 , _:c14n2275 , _:c14n2554 , _:c14n2665 , _:c14n2703 , _:c14n2709 , _:c14n2973 , _:c14n4768 , _:c14n4953 , _:c14n5647 , _:c14n6242 , _:c14n6537 , _:c14n6585 , _:c14n664 , _:c14n6646 , _:c14n9916 ;
	skos:definition "OSINT Inventory Info events report open source intelligence or threat intelligence inventory data that is either logged or proactively collected. For example, when collecting OSINT information from Threat Intelligence Platforms (TIPs) or Extended Detection and Response (XDR) platforms, or collecting data from OSINT or other generic threat intelligence and enrichment feeds such as APIs and datastores." ;
	skos:exactMatch ocsf:OcsfOsintInventoryInfo ;
	skos:inScheme ocsf:ocsf_events_discovery ;
	ocsf:ocsf_category "discovery" ;
	ocsf:ocsf_key "osint_inventory_info" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfOsintProfile dcterms:title "OSINT" ;
	a owl:Class ;
	rdfs:label "OcsfOsintProfile" ;
	rdfs:subClassOf _:c14n2082 , _:c14n6220 ;
	skos:definition "The OSINT (Open Source Intelligence) profile contains one or more indicators and associated analysis and details, such as registrar (WHOIS) information and commentary about a hostname, or information about a digital certificate and its usage within a campaign. This information can be used to further enrich a detection or finding by providing decisioning support to other analysts and engineers within the profile itself." ;
	skos:exactMatch ocsf:OcsfOsintProfile ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "osint" .
