	ocsf:ocsf_key "vulnerability" ;
	ocsf:ocsf_profiles "container data_classification datetime" .
ocsf:OcsfVulnerabilityFinding dcterms:title "Vulnerability Finding" ;
	a owl:Class ;
	rdfs:label "OcsfVulnerabilityFinding" ;
	rdfs:subClassOf ocsf:OcsfFindingEvent , _:c14n10370 , _:c14n10982 , _:c14n122 , _:c14n1601 , _:c14n2048 , _:c14n2053 , _:c14n2472 , _:c14n2738 , _:c14n2992 , _:c14n3438 , _:c14n3600 , _:c14n4427 , _:c14n4477 , _:c14n453 , _:c14n4930 , _:c14n5381 , _:c14n5907 , _:c14n6110 , _:c14n6246 , _:c14n7234 , _:c14n7266 , _:c14n7333 , _:c14n7485 , _:c14n7841 , _:c14n8070 , _:c14n8074 , _:c14n811 , _:c14n8132 , _:c14n815 , _:c14n820 , _:c14n834 , _:c14n8610 , _:c14n8715 , _:c14n8784 , _:c14n8818 , _:c14n9338 , _:c14n9785 ;
	skos:definition "The Vulnerability Finding event is a notification about weakness in an information system, system security procedures, internal controls, or implementation that could be exploited or triggered by a threat source. Note: if the event producer is a security control, the <code>security_control</code> profile should be applied and its <code>attacks</code> information, if present, should be duplicated into the <code>finding_info</code> object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the <code>incident</code> profile  or aggregate this finding into an <code>Incident Finding</code>." ;
	skos:exactMatch ocsf:OcsfVulnerabilityFinding ;
	skos:inScheme ocsf:ocsf_events_findings ;
	ocsf:ocsf_category "findings" ;
	ocsf:ocsf_key "vulnerability_finding" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host incident linux/linux_users macos/macos_users osint record_integrity security_control" .
