	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:ServiceApplication/> ;
	rdfs:subClassOf ocsf:OcsfService , _:c14n10074 , _:c14n10144 , _:c14n10327 , _:c14n10536 , _:c14n1054 , _:c14n1667 , _:c14n1789 , _:c14n1848 , _:c14n1917 , _:c14n202 , _:c14n2055 , _:c14n2350 , _:c14n258 , _:c14n2751 , _:c14n299 , _:c14n3028 , _:c14n3433 , _:c14n3761 , _:c14n3829 , _:c14n4144 , _:c14n448 , _:c14n4924 , _:c14n5005 , _:c14n5236 , _:c14n5251 , _:c14n5482 , _:c14n5938 , _:c14n6073 , _:c14n6083 , _:c14n6124 , _:c14n6234 , _:c14n6350 , _:c14n6681 , _:c14n6721 , _:c14n7185 , _:c14n7450 , _:c14n7811 , _:c14n8058 , _:c14n8172 , _:c14n825 , _:c14n9008 , _:c14n9039 , _:c14n9155 , _:c14n9237 , _:c14n9350 , _:c14n9374 , _:c14n9609 , _:c14n985 ;
