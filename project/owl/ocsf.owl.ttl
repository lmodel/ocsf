ocsf:OcsfCloud dcterms:title "Cloud" ;
	a owl:Class ;
	rdfs:label "OcsfCloud" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10021 , _:c14n1062 , _:c14n1140 , _:c14n1223 , _:c14n1463 , _:c14n1529 , _:c14n2195 , _:c14n2216 , _:c14n2524 , _:c14n3569 , _:c14n373 , _:c14n3897 , _:c14n4624 , _:c14n4901 , _:c14n5184 , _:c14n5873 , _:c14n6192 , _:c14n7412 , _:c14n8772 , _:c14n8844 , _:c14n8891 ;
	skos:definition "The Cloud object describes the cloud computing environment where an event or finding originated. It provides comprehensive context about the cloud infrastructure, including the cloud service provider, account or subscription details, organizational structure, geographic regions, availability zones, and logical partitions." ;
	skos:exactMatch ocsf:OcsfCloud ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "cloud" .
