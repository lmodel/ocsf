ocsf:access_analysis_result dcterms:title "Access Analysis Result" ;
	a owl:ObjectProperty ;
	rdfs:label "access_analysis_result" ;
	rdfs:range ocsf:OcsfAccessAnalysisResult ;
	skos:definition "Describes access relationships and pathways between identities, resources, focusing on who can access what and through which mechanisms. This evaluates access levels (read/write/admin), access types (direct, cross-account, public, federated), and the conditions under which access is granted. Use this for resource-centric security assessments such as external access discovery, public exposure analysis, etc." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:access_level dcterms:title "Access Level" ;
	a owl:DatatypeProperty ;
	rdfs:label "access_level" ;
	rdfs:range xsd:string ;
	skos:definition "The access level of an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:access_list dcterms:title "Access List" ;
	a owl:DatatypeProperty ;
	rdfs:label "access_list" ;
	rdfs:range xsd:string ;
	skos:definition "The list of requested access rights." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:access_mask dcterms:title "Access Mask" ;
	a owl:DatatypeProperty ;
	rdfs:label "access_mask" ;
	rdfs:range xsd:integer ;
	skos:definition "The access mask in a platform-native format." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:access_result dcterms:title "Access Check Result" ;
	a owl:DatatypeProperty ;
	rdfs:label "access_result" ;
	rdfs:range _:c14n9298 ;
	skos:definition "The list of access check results." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:access_type dcterms:title "Access Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "access_type" ;
	rdfs:range xsd:string ;
	skos:definition "The type or category of access being granted to the identity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:accessed_time dcterms:title "Accessed Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "accessed_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The time when the file was last accessed." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:accessed_time_dt dcterms:title "Accessed Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "accessed_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The time when the file was last accessed." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:accessor dcterms:title "Accessor" ;
	a owl:ObjectProperty ;
	rdfs:label "accessor" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The name of the user who last accessed the object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:accessors dcterms:title "Accessors" ;
	a owl:ObjectProperty ;
	rdfs:label "accessors" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "A list of users who have access to an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:account dcterms:title "Account" ;
	a owl:ObjectProperty ;
	rdfs:label "account" ;
	rdfs:range ocsf:OcsfAccount ;
	skos:definition "The account object describes details about the account that was the source or target of the activity. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:account_switch_type dcterms:title "Account Switch Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "account_switch_type" ;
	rdfs:range xsd:string ;
	skos:definition "The account switch method, normalized to the caption of the account_switch_type_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:account_switch_type_id dcterms:title "Account Switch Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "account_switch_type_id" ;
	rdfs:range _:c14n1512 ;
	skos:definition "The normalized identifier of the account switch method." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "account_switch_type" .
ocsf:ack_reason dcterms:title "Acknowledgement Reason" ;
	a owl:DatatypeProperty ;
	rdfs:label "ack_reason" ;
	rdfs:range xsd:integer ;
	skos:definition "An integer that provides a reason code or additional information about the acknowledgment result." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ack_result dcterms:title "Acknowledgement Result" ;
	a owl:DatatypeProperty ;
	rdfs:label "ack_result" ;
	rdfs:range xsd:integer ;
	skos:definition "An integer that denotes the acknowledgment result of the DCE/RPC call." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:action dcterms:title "Action" ;
	a owl:DatatypeProperty ;
	rdfs:label "action" ;
	rdfs:range xsd:string ;
	skos:definition "The normalized caption of 'action_id' or the source specific action." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:action_id dcterms:title "Action ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "action_id" ;
	rdfs:range _:c14n9614 ;
	skos:definition "The normalized action taken by a control or other policy-based system leading to an outcome or disposition." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "action" .
ocsf:activity_id dcterms:title "Activity ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "activity_id" ;
	rdfs:range _:c14n10859 ;
	skos:definition "The normalized identifier of the activity that triggered the event. Each event class defines its own set of activity values. Use <code>0</code> (Unknown) when the activity cannot be determined. Use <code>99</code> (Other) when the activity does not match any defined value, in which case <code>activity_name</code> must be populated with the source-specific label." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "activity_name" ;
	ocsf:ocsf_suppress_checks "sibling_convention" .
ocsf:activity_name dcterms:title "Activity" ;
	a owl:DatatypeProperty ;
	rdfs:label "activity_name" ;
	rdfs:range xsd:string ;
	skos:definition "The event activity name, as defined by the <code>activity_id</code>. When <code>activity_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific activity label. For all other <code>activity_id</code> values, this must match the caption defined for that <code>activity_id</code> enum value." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:actor dcterms:title "Actor" ;
	a owl:ObjectProperty ;
	rdfs:label "actor" ;
	rdfs:range ocsf:OcsfActor ;
	skos:definition "The actor object describes details about the user/role/process that was the source of the activity. Note that this is not the threat actor of a campaign but may be part of a campaign." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:actual_permissions dcterms:title "Actual Permissions" ;
	a owl:DatatypeProperty ;
	rdfs:label "actual_permissions" ;
	rdfs:range xsd:integer ;
	skos:definition "The permissions that were granted in a platform-native format. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:additional_restrictions dcterms:title "Additional Restrictions" ;
	a owl:ObjectProperty ;
	rdfs:label "additional_restrictions" ;
	rdfs:range ocsf:OcsfAdditionalRestriction ;
	skos:definition "The supplementary restrictions that may apply to an entity, by the virtue of a policy. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:advisory dcterms:title "Security Advisory" ;
	a owl:ObjectProperty ;
	rdfs:label "advisory" ;
	rdfs:range ocsf:OcsfAdvisory ;
	skos:definition "Detail about the security advisory, that is used to publicly disclose cybersecurity vulnerabilities by a vendor." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:aerial_height dcterms:title "Aerial Height" ;
	a owl:DatatypeProperty ;
	rdfs:label "aerial_height" ;
	rdfs:range xsd:string ;
	skos:definition "Expressed as either height above takeoff location or height above ground level (AGL) for a UAS current location. This value is provided in meters and must have a minimum resolution of 1 m. Special Values: <code>Invalid</code>, <code>No Value</code>, or <code>Unknown: -1000 m</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:affected_code dcterms:title "Affected Code" ;
	a owl:ObjectProperty ;
	rdfs:label "affected_code" ;
	rdfs:range ocsf:OcsfAffectedCode ;
	skos:definition "List of Affected Code objects that describe details about code blocks identified as vulnerable." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:affected_packages dcterms:title "Affected Software Packages" ;
	a owl:ObjectProperty ;
	rdfs:label "affected_packages" ;
	rdfs:range ocsf:OcsfAffectedPackage ;
	skos:definition "List of software packages identified as affected by a vulnerability/vulnerabilities." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:agent dcterms:title "Agent" ;
	a owl:ObjectProperty ;
	rdfs:label "agent" ;
	rdfs:range ocsf:OcsfAgent ;
	skos:definition "An Agent (also known as a Sensor) is typically installed on an Operating System (OS) and serves as a specialized software component that can be designed to monitor, detect, collect, archive, or take action. These activities and possible actions are defined by the upstream system controlling the Agent and its intended purpose. For instance, an Agent can include Endpoint Detection & Response (EDR) agents, backup/disaster recovery sensors, Application Performance Monitoring or profiling sensors, and similar software." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:agent_list dcterms:title "Agent List" ;
	a owl:ObjectProperty ;
	rdfs:label "agent_list" ;
	rdfs:range ocsf:OcsfAgent ;
	skos:definition "A list of <code>agent</code> objects associated with a device, endpoint, or resource." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:ai_agent dcterms:title "AI Agent" ;
	a owl:ObjectProperty ;
	rdfs:label "ai_agent" ;
	rdfs:range ocsf:OcsfAiAgent ;
	skos:definition "An autonomous AI agent that performs tasks under delegated authority. Distinguished from the OCSF <code>agent</code> object, which describes security sensors such as EDR and DLP tools." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:ai_model dcterms:title "AI Model" ;
	a owl:ObjectProperty ;
	rdfs:label "ai_model" ;
	rdfs:range ocsf:OcsfAiModel ;
	skos:definition "The AI Model object describes the characteristics of an AI/ML model. Examples include language models like GPT-4, embedding models like text-embedding-ada-002, and computer vision models like CLIP." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:ai_provider dcterms:title "AI Provider" ;
	a owl:DatatypeProperty ;
	rdfs:label "ai_provider" ;
	rdfs:range xsd:string ;
	skos:definition "AI service provider or organization name." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ai_role dcterms:title "AI Role" ;
	a owl:DatatypeProperty ;
	rdfs:label "ai_role" ;
	rdfs:range xsd:string ;
	skos:definition "The normalized caption of the <code>ai_role_id</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ai_role_id dcterms:title "AI Role ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "ai_role_id" ;
	rdfs:range xsd:integer ;
	skos:definition "The originator or target role of the message." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "ai_role" .
ocsf:aircraft dcterms:title "Aircraft" ;
	a owl:ObjectProperty ;
	rdfs:label "aircraft" ;
	rdfs:range ocsf:OcsfAircraft ;
	skos:definition "The Aircraft object represents any aircraft or otherwise airborne asset such as an unmanned system, airplane, balloon, spacecraft, or otherwise. The Aircraft object is intended to normalized data captured or otherwise logged from active radar, passive radar, multi-spectral systems, or the Automatic Dependant Broadcast - Surveillance (ADS-B), and/or Mode S systems." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:alert dcterms:title "Client TLS Alert" ;
	a owl:DatatypeProperty ;
	rdfs:label "alert" ;
	rdfs:range xsd:integer ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc2246> ;
	skos:definition "The integer value of a TLS alert per the TLS specification." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:algorithm dcterms:title "Algorithm" ;
	a owl:DatatypeProperty ;
	rdfs:label "algorithm" ;
	rdfs:range xsd:string ;
	skos:definition "The applicable algorithm, normalized to the caption of 'algorithm_id'. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:algorithm_id dcterms:title "Algorithm ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "algorithm_id" ;
	rdfs:range _:c14n3577 ;
	skos:definition "The normalized identifier of the algorithm. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "algorithm" .
ocsf:all_privileges_unused dcterms:title "All Privileges Unused" ;
	a owl:DatatypeProperty ;
	rdfs:label "all_privileges_unused" ;
	rdfs:range xsd:boolean ;
	skos:definition "Indicates whether all privileges in a set, list, collection or group are unused. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:altitude_ceiling dcterms:title "Altitude Ceiling" ;
	a owl:DatatypeProperty ;
	rdfs:label "altitude_ceiling" ;
	rdfs:range xsd:string ;
	skos:definition "Maximum altitude (WGS-84 HAE) for a group or an Intent-Based Network Participant. Measured in meters. Special Values: <code>Invalid</code>, <code>No Value</code>, or <code>Unknown: -1000 m</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:altitude_floor dcterms:title "Altitude Floor" ;
	a owl:DatatypeProperty ;
	rdfs:label "altitude_floor" ;
	rdfs:range xsd:string ;
	skos:definition "Minimum altitude (WGS-84 HAE) for a group or an Intent-Based Network Participant. Measured in meters. Special Values: <code>Invalid</code>, <code>No Value</code>, or <code>Unknown: -1000 m</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:analysis_targets dcterms:title "Analysis Targets" ;
	a owl:ObjectProperty ;
	rdfs:label "analysis_targets" ;
	rdfs:range ocsf:OcsfAnalysisTarget ;
	skos:definition "The specific dimensions, components, or aspects of the system that are the targets of the analysis. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:analytic dcterms:title "Analytic" ;
	a owl:ObjectProperty ;
	rdfs:label "analytic" ;
	rdfs:range ocsf:OcsfAnalytic ;
	skos:definition "The analytic technique used to analyze and derive insights from the data or information that led to the finding or conclusion." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:analyzed_privileges_count dcterms:title "Analyzed Privileges Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "analyzed_privileges_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The total count of privileges that were analyzed. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ancestry dcterms:title "Ancestry" ;
	a owl:ObjectProperty ;
	rdfs:label "ancestry" ;
	rdfs:range ocsf:OcsfProcessEntity ;
	rdfs:seeAlso <https://github.com/ocsf/ocsf-docs/blob/main/articles/representing-process-parentage.md> ;
	skos:definition "An array of Process Entities describing the extended parentage of this process object. Direct parent information should be expressed through the <code>parent_process</code> attribute. The first array element is the direct parent of this process object. Subsequent list elements go up the process parentage hierarchy. That is, the array is sorted from newest to oldest process. It is recommended to only populate this field for the top-level process object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:anomalies dcterms:title "Anomalies" ;
	a owl:ObjectProperty ;
	rdfs:label "anomalies" ;
	rdfs:range ocsf:OcsfAnomaly ;
	skos:definition "A list of detected anomalies or deviations from expected behavior patterns. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:anomaly_analyses dcterms:title "Anomaly Analyses" ;
	a owl:ObjectProperty ;
	rdfs:label "anomaly_analyses" ;
	rdfs:range ocsf:OcsfAnomalyAnalysis ;
	skos:definition "A list of anomaly analysis results that examine and characterize patterns of activity or usage over time to identify normal vs abnormal activities. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:answers dcterms:title "DNS Answer" ;
	a owl:ObjectProperty ;
	rdfs:label "answers" ;
	rdfs:range ocsf:OcsfDnsAnswer ;
	skos:definition "The Domain Name System (DNS) answers." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:api dcterms:title "API Details" ;
	a owl:ObjectProperty ;
	rdfs:label "api" ;
	rdfs:range ocsf:OcsfApi ;
	skos:definition "Describes details about a typical API (Application Programming Interface) call." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:app dcterms:title "Application" ;
	a owl:ObjectProperty ;
	rdfs:label "app" ;
	rdfs:range ocsf:OcsfProduct ;
	skos:definition "The application that reported the event." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_superseded_by "application" .
ocsf:app_name dcterms:title "Application Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "app_name" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the application associated with the event or object." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:app_protocol_name dcterms:title "Application Protocol Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "app_protocol_name" ;
	rdfs:range xsd:string ;
	skos:definition "The application protocol name. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:app_uid dcterms:title "Application ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "app_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique ID of the application associated with the event or object." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:application dcterms:title "Application" ;
	a owl:ObjectProperty ;
	rdfs:label "application" ;
	rdfs:range ocsf:OcsfApplication ;
	skos:definition "An Application describes the details for an inventoried application as reported by an Application Security tool or other Developer-centric tooling. Applications can be defined as Kubernetes resources, Containerized resources, or application hosting-specific cloud sources such as AWS Elastic BeanStalk, AWS Lightsail, or Azure Logic Apps." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:applications dcterms:title "Applications" ;
	a owl:ObjectProperty ;
	rdfs:label "applications" ;
	rdfs:range ocsf:OcsfApplication ;
	skos:definition "A list of application objects. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:architecture dcterms:title "Architecture" ;
	a owl:DatatypeProperty ;
	rdfs:label "architecture" ;
	rdfs:range xsd:string ;
	skos:definition "Architecture is a shorthand name describing the type of computer hardware the packaged software is meant to run on." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:args dcterms:title "HTTP Arguments" ;
	a owl:DatatypeProperty ;
	rdfs:label "args" ;
	rdfs:range xsd:string ;
	skos:definition "The arguments sent along with the HTTP request." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:assessment dcterms:title "Assessment" ;
	a owl:ObjectProperty ;
	rdfs:label "assessment" ;
	rdfs:range ocsf:OcsfAssessment ;
	skos:definition "The Assessment object describes a point-in-time assessment, check, or evaluation of a specific configuration or signal against an asset, entity, person, or otherwise. For example, this can encapsulate <code>os_signals</code> from CrowdStrike Falcon Zero Trust Assessments, or account for <code>Datastore</code> configurations from Cyera." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:assessments dcterms:title "Assessments" ;
	a owl:ObjectProperty ;
	rdfs:label "assessments" ;
	rdfs:range ocsf:OcsfAssessment ;
	skos:definition "A list of <code>assessment</code> objects. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:assignee dcterms:title "Assignee" ;
	a owl:ObjectProperty ;
	rdfs:label "assignee" ;
	rdfs:range ocsf:OcsfUser ;
	skos:definition "The details of the user assigned to an Incident." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:assignee_group dcterms:title "Assignee Group" ;
	a owl:ObjectProperty ;
	rdfs:label "assignee_group" ;
	rdfs:range ocsf:OcsfGroup ;
	skos:definition "The details of the group assigned to an Incident." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:attack dcterms:title "MITRE ATT&CK® Details" ;
	a owl:ObjectProperty ;
	rdfs:label "attack" ;
	rdfs:range ocsf:OcsfAttack ;
	skos:definition "The MITRE ATT&CK® object describing the tactic, technique, and sub-technique." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:attack_graph dcterms:title "Attack Graph" ;
	a owl:ObjectProperty ;
	rdfs:label "attack_graph" ;
	rdfs:range ocsf:OcsfGraph ;
	rdfs:seeAlso <https://learn.microsoft.com/en-us/azure/defender-for-cloud/how-to-manage-attack-path> , <https://www.sentinelone.com/cybersecurity-101/cybersecurity/attack-path-analysis/> ;
	skos:definition "An Attack Graph describes possible routes an attacker could take through an environment. It describes relationships between resources and their findings, such as malware detections, vulnerabilities, misconfigurations, and other security actions." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:attacks dcterms:title "MITRE ATT&CK® and ATLAS™ Details" ;
	a owl:ObjectProperty ;
	rdfs:label "attacks" ;
	rdfs:range ocsf:OcsfAttack ;
	rdfs:seeAlso <https://atlas.mitre.org/matrices/ATLAS> , <https://attack.mitre.org> ;
	skos:definition "An array of MITRE ATT&CK® objects describing identified tactics, techniques & sub-techniques. The objects are compatible with MITRE ATLAS™ tactics, techniques & sub-techniques." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:attempt dcterms:title "Attempt" ;
	a owl:DatatypeProperty ;
	rdfs:label "attempt" ;
	rdfs:range xsd:integer ;
	skos:definition "The delivery attempt." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:attestation_list dcterms:title "Attestation List" ;
	a owl:ObjectProperty ;
	rdfs:label "attestation_list" ;
	rdfs:range ocsf:OcsfAttestation ;
	skos:definition "One or more cryptographic <code>attestation</code> objects over an event, each providing integrity, authenticity, and non-repudiation. Independent attesters over the same event — for example a producer at write time and a downstream processor at ingest — each contribute a separate attestation, distinct from co-signers on a single attestation, which share its <code>signatures</code> array. Carried on the <code>record_integrity</code> profile; the object itself is domain-agnostic." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:attributes dcterms:title "Attributes" ;
	a owl:DatatypeProperty ;
	rdfs:label "attributes" ;
	rdfs:range xsd:integer ;
	skos:definition "The bitmask value that represents the file attributes." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:auid dcterms:title "Audit User ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "auid" ;
	rdfs:range xsd:integer ;
	skos:definition "The audit user assigned at login by the audit subsystem." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:auth_factors dcterms:title "Authentication Factors" ;
	a owl:ObjectProperty ;
	rdfs:label "auth_factors" ;
	rdfs:range ocsf:OcsfAuthFactor ;
	skos:definition "Describes a category of methods used for identity verification. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:auth_protocol dcterms:title "Auth Protocol" ;
	a owl:DatatypeProperty ;
	rdfs:label "auth_protocol" ;
	rdfs:range xsd:string ;
	skos:definition "The authentication protocol as defined by the caption of <code>auth_protocol_id</code>. In the case of <code>Other</code>, it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:auth_protocol_id dcterms:title "Auth Protocol ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "auth_protocol_id" ;
	rdfs:range _:c14n7215 ;
	skos:definition "The normalized identifier of the authentication protocol used to create the user session." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "auth_protocol" .
ocsf:auth_type dcterms:title "Authentication Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "auth_type" ;
	rdfs:range xsd:string ;
	skos:definition "The agreed upon authentication type, normalized to the caption of 'auth_type_id'. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:auth_type_id dcterms:title "Authentication Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "auth_type_id" ;
	rdfs:range _:c14n3474 ;
	skos:definition "The normalized identifier of the agreed upon authentication type. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "auth_type" .
ocsf:authentication_token dcterms:title "Authentication Token" ;
	a owl:ObjectProperty ;
	rdfs:label "authentication_token" ;
	rdfs:range ocsf:OcsfAuthenticationToken ;
	skos:definition "The authentication token, ticket, or assertion. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:author dcterms:title "Author" ;
	a owl:DatatypeProperty ;
	rdfs:label "author" ;
	rdfs:range xsd:string ;
	skos:definition "The author(s) who published the software component." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:authority dcterms:title "DNS Authority Section" ;
	a owl:ObjectProperty ;
	rdfs:label "authority" ;
	rdfs:range ocsf:OcsfDnsResourceRecord ;
	skos:definition "The DNS Authority section resource records. Contains NS records pointing to authoritative name servers, or a SOA record for negative responses (NXDOMAIN)." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:authority_uid dcterms:title "Authority ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "authority_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of the authority that produced an attestation. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:authorizations dcterms:title "Authorization Information" ;
	a owl:ObjectProperty ;
	rdfs:label "authorizations" ;
	rdfs:range ocsf:OcsfAuthorization ;
	skos:definition "Provides details about an authorization, such as authorization outcome, and any associated policies related to the activity/event." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:autonomous_system dcterms:title "Autonomous System" ;
	a owl:ObjectProperty ;
	rdfs:label "autonomous_system" ;
	rdfs:range ocsf:OcsfAutonomousSystem ;
	skos:definition "The Autonomous System details associated with an IP address." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:autoscale_uid dcterms:title "Autoscale UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "autoscale_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of the cloud autoscale configuration." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:avg_timespan dcterms:title "Average Timespan" ;
	a owl:ObjectProperty ;
	rdfs:label "avg_timespan" ;
	rdfs:range ocsf:OcsfTimespan ;
	skos:definition "The average time span of an activity." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:banner dcterms:title "Protocol Banner" ;
	a owl:DatatypeProperty ;
	rdfs:label "banner" ;
	rdfs:range xsd:string ;
	skos:definition "The initial connection response that a messaging server receives after it connects to an email server." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:base_address dcterms:title "Base Address" ;
	a owl:DatatypeProperty ;
	rdfs:label "base_address" ;
	rdfs:range xsd:string ;
	skos:definition "The memory address where the module was loaded." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:base_score dcterms:title "Base Score" ;
	a owl:DatatypeProperty ;
	rdfs:label "base_score" ;
	rdfs:range xsd:float ;
	skos:definition "The base score as reported by the event source. See specific usage." ;
	skos:exactMatch cve:baseScore ;
	skos:inScheme ocsf:ocsf_core .
ocsf:baselines dcterms:title "Baselines" ;
	a owl:ObjectProperty ;
	rdfs:label "baselines" ;
	rdfs:range ocsf:OcsfBaseline ;
	skos:definition "A list of baseline measurements or normal behavior patterns used as reference points for comparison and anomaly detection. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:bcc dcterms:title "Bcc" ;
	a owl:DatatypeProperty ;
	rdfs:label "bcc" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The machine-readable email header Bcc values, as defined by RFC 5322. For example <code>example.user@usersdomain.com</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bcc_mailboxes dcterms:title "Bcc Mailboxes" ;
	a owl:DatatypeProperty ;
	rdfs:label "bcc_mailboxes" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322#section-3.4> ;
	skos:definition "The human-readable email header Bcc Mailbox values. For example <code>'Example User &lt;example.user@usersdomain.com&gt;'</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:binary_data dcterms:title "Binary Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "binary_data" ;
	rdfs:range xsd:string ;
	skos:definition "The item's data in binary form." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bios_date dcterms:title "BIOS Date" ;
	a owl:DatatypeProperty ;
	rdfs:label "bios_date" ;
	rdfs:range xsd:string ;
	skos:definition "The BIOS date. For example: <code>03/31/16</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bios_manufacturer dcterms:title "BIOS Manufacturer" ;
	a owl:DatatypeProperty ;
	rdfs:label "bios_manufacturer" ;
	rdfs:range xsd:string ;
	skos:definition "The BIOS manufacturer. For example: <code>LENOVO</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bios_ver dcterms:title "BIOS Version" ;
	a owl:DatatypeProperty ;
	rdfs:label "bios_ver" ;
	rdfs:range xsd:string ;
	skos:definition "The BIOS version. For example: <code>LENOVO G5ETA2WW (2.62)</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:body_length dcterms:title "Body Length not including header" ;
	a owl:DatatypeProperty ;
	rdfs:label "body_length" ;
	rdfs:range xsd:integer ;
	skos:definition "The actual length of the HTTP response/request body, in number of bytes, independent of a potentially existing Content-Length header." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:boot_time dcterms:title "Boot Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "boot_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The time when the system was booted." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:boot_time_dt dcterms:title "Boot Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "boot_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The time when the system was booted." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:boot_uid dcterms:title "Boot UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "boot_uid" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://docs.kernel.org/admin-guide/sysctl/kernel.html#random> ;
	skos:definition "A unique identifier of the device that changes after every reboot. For example, the value of <code>/proc/sys/kernel/random/boot_id</code> from Linux's procfs." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:boundary dcterms:title "Boundary" ;
	a owl:DatatypeProperty ;
	rdfs:label "boundary" ;
	rdfs:range xsd:string ;
	skos:definition "The boundary of the connection, normalized to the caption of 'boundary_id'. In the case of 'Other', it is defined by the event source. <p> For cloud connections, this translates to the traffic-boundary(same VPC, through IGW, etc.). For traditional networks, this is described as Local, Internal, or External.</p>" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:boundary_id dcterms:title "Boundary ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "boundary_id" ;
	rdfs:range _:c14n6515 ;
	skos:definition "<p>The normalized identifier of the boundary of the connection. </p><p> For cloud connections, this translates to the traffic-boundary (same VPC, through IGW, etc.). For traditional networks, this is described as Local, Internal, or External.</p>" ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "boundary" .
ocsf:build dcterms:title "OS Build" ;
	a owl:DatatypeProperty ;
	rdfs:label "build" ;
	rdfs:range xsd:string ;
	skos:definition "The operating system build number." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bulletin dcterms:title "Patch Bulletin" ;
	a owl:DatatypeProperty ;
	rdfs:label "bulletin" ;
	rdfs:range xsd:string ;
	skos:definition "The vendor bulletin identifier." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bus_type dcterms:title "Bus Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "bus_type" ;
	rdfs:range xsd:string ;
	skos:definition "The attachment bus or interface standard, normalized to the caption of the bus_type_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bus_type_id dcterms:title "Bus Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "bus_type_id" ;
	rdfs:range _:c14n6297 ;
	skos:definition "The normalized identifier of the attachment bus or interface standard." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "bus_type" .
ocsf:bytes dcterms:title "Total Bytes" ;
	a owl:DatatypeProperty ;
	rdfs:label "bytes" ;
	rdfs:range xsd:integer ;
	skos:definition "The total number of bytes (in and out)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bytes_in dcterms:title "Bytes In" ;
	a owl:DatatypeProperty ;
	rdfs:label "bytes_in" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of bytes sent from the destination to the source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bytes_missed dcterms:title "Bytes Missed" ;
	a owl:DatatypeProperty ;
	rdfs:label "bytes_missed" ;
	rdfs:range xsd:integer ;
	skos:definition "Indicates the number of bytes missed, which is representative of packet loss." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:bytes_out dcterms:title "Bytes Out" ;
	a owl:DatatypeProperty ;
	rdfs:label "bytes_out" ;
	rdfs:range xsd:integer ;
	skos:definition "The number of bytes sent from the source to the destination." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:campaign dcterms:title "Campaign" ;
	a owl:ObjectProperty ;
	rdfs:label "campaign" ;
	rdfs:range ocsf:OcsfCampaign ;
	skos:definition "The campaign object describes details about the campaign that was the source of the activity." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:capabilities dcterms:title "Capabilities" ;
	a owl:DatatypeProperty ;
	rdfs:label "capabilities" ;
	rdfs:range xsd:string ;
	skos:definition "A list of RDP capabilities." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:caption dcterms:title "Caption" ;
	a owl:DatatypeProperty ;
	rdfs:label "caption" ;
	rdfs:range xsd:string ;
	skos:definition "A short description or caption of the device. For example: <code>Scanner 1</code> or <code>Database Manager</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:categories dcterms:title "Website Categorization" ;
	a owl:DatatypeProperty ;
	rdfs:label "categories" ;
	rdfs:range xsd:string ;
	skos:definition "The Website categorization names, as defined by <code>category_ids</code> enum values." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:category dcterms:title "Category" ;
	a owl:DatatypeProperty ;
	rdfs:label "category" ;
	rdfs:range xsd:string ;
	skos:definition "The object category, normalized to the caption of <code>category_id</code>. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:category_id dcterms:title "Category ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "category_id" ;
	rdfs:range xsd:integer ;
	skos:definition "The normalized identifier of the object category. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "category" .
ocsf:category_ids dcterms:title "Website Categorization IDs" ;
	a owl:DatatypeProperty ;
	rdfs:label "category_ids" ;
	rdfs:range _:c14n10190 ;
	skos:definition "The Website categorization identifiers." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "categories" .
ocsf:category_name dcterms:title "Category" ;
	a owl:DatatypeProperty ;
	rdfs:label "category_name" ;
	rdfs:range xsd:string ;
	skos:definition "The event category name, as defined by the <code>category_uid</code> value. The value must match the caption defined for the corresponding <code>category_uid</code> enum value (e.g., <code>\"Findings\"</code> for <code>category_uid: 2</code>)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:category_uid dcterms:title "Category ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "category_uid" ;
	rdfs:range xsd:integer ;
	skos:definition "The category unique identifier of the event. Each event class belongs to exactly one category. Producers and mappers must set this to the category defined by the event class being used." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "category_name" .
ocsf:cc dcterms:title "Cc" ;
	a owl:DatatypeProperty ;
	rdfs:label "cc" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The machine-readable email header Cc values, as defined by RFC 5322. For example <code>example.user@usersdomain.com</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:cc_mailboxes dcterms:title "Cc Mailboxes" ;
	a owl:DatatypeProperty ;
	rdfs:label "cc_mailboxes" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322#section-3.4> ;
	skos:definition "The human-readable email header Cc Mailbox values. For example <code>'Example User &lt;example.user@usersdomain.com&gt;'</code>." ;
	skos:inScheme ocsf:ocsf_core .
