	skos:exactMatch ocsf:OcsfCloudProfile ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "cloud" .
ocsf:OcsfCloudResourcesInventoryInfo dcterms:title "Cloud Resources Inventory Info" ;
	a owl:Class ;
	rdfs:label "OcsfCloudResourcesInventoryInfo" ;
	rdfs:subClassOf ocsf:OcsfDiscoveryEvent , _:c14n10087 , _:c14n10095 , _:c14n10597 , _:c14n10858 , _:c14n1141 , _:c14n1406 , _:c14n1758 , _:c14n1855 , _:c14n1998 , _:c14n2136 , _:c14n2653 , _:c14n2924 , _:c14n3241 , _:c14n3381 , _:c14n3716 , _:c14n3884 , _:c14n3892 , _:c14n4157 , _:c14n43 , _:c14n4360 , _:c14n461 , _:c14n5342 , _:c14n5462 , _:c14n5842 , _:c14n622 , _:c14n6408 , _:c14n6472 , _:c14n696 , _:c14n70 , _:c14n7399 , _:c14n8109 , _:c14n8316 , _:c14n8382 , _:c14n8404 , _:c14n8771 , _:c14n933 , _:c14n960 , _:c14n9739 , _:c14n9955 ;
	skos:definition "Cloud Resources Inventory Info events report cloud asset inventory data. This data can be either logged or proactively collected. For example, use this event class when creating an inventory of cloud resource information from a Configuration Management Database (CMDB), Cyber Asset Attack Surface Management (CAASM), direct public cloud service provider APIs, Software-as-a-Service (SaaS) APIs, or otherwise." ;
	skos:exactMatch ocsf:OcsfCloudResourcesInventoryInfo ;
	skos:inScheme ocsf:ocsf_events_discovery ;
	ocsf:ocsf_category "discovery" ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"cloud\", \"container\", \"database\", \"databucket\", \"idp\", \"resources\", \"table\"]}" ;
	ocsf:ocsf_key "cloud_resources_inventory_info" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfCompliance dcterms:title "Compliance" ;
	a owl:Class ;
	rdfs:label "OcsfCompliance" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10226 , _:c14n10712 , _:c14n10782 , _:c14n10854 , _:c14n1338 , _:c14n158 , _:c14n1830 , _:c14n1936 , _:c14n2011 , _:c14n2397 , _:c14n2510 , _:c14n252 , _:c14n2587 , _:c14n2770 , _:c14n2855 , _:c14n3159 , _:c14n3495 , _:c14n3681 , _:c14n4173 , _:c14n4862 , _:c14n4875 , _:c14n5262 , _:c14n5303 , _:c14n5305 , _:c14n5607 , _:c14n5724 , _:c14n5827 , _:c14n5931 , _:c14n631 , _:c14n6467 , _:c14n7511 , _:c14n7705 , _:c14n8387 , _:c14n8709 , _:c14n8895 , _:c14n9400 , _:c14n942 ;
	skos:definition "The Compliance object contains information about Industry and Regulatory Framework standards, controls and requirements or details about custom assessments utilized in a compliance evaluation. Standards define broad security frameworks, controls represent specific security requirements within those frameworks, and checks are the testable verification points used to determine if controls are properly implemented." ;
	skos:exactMatch ocsf:OcsfCompliance ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "compliance" ;
	ocsf:ocsf_profiles "cloud container data_classification" .
ocsf:OcsfComplianceFinding dcterms:title "Compliance Finding" ;
	a owl:Class ;
	rdfs:label "OcsfComplianceFinding" ;
	rdfs:subClassOf ocsf:OcsfFindingEvent , _:c14n10145 , _:c14n10493 , _:c14n10922 , _:c14n10975 , _:c14n10990 , _:c14n116 , _:c14n1259 , _:c14n1263 , _:c14n1637 , _:c14n1854 , _:c14n2283 , _:c14n2296 , _:c14n2478 , _:c14n248 , _:c14n2746 , _:c14n2941 , _:c14n3150 , _:c14n3837 , _:c14n3849 , _:c14n4015 , _:c14n4073 , _:c14n4635 , _:c14n4717 , _:c14n5102 , _:c14n5213 , _:c14n5338 , _:c14n5383 , _:c14n541 , _:c14n5677 , _:c14n5818 , _:c14n5968 , _:c14n6315 , _:c14n6604 , _:c14n6636 , _:c14n6641 , _:c14n6976 , _:c14n7071 , _:c14n725 , _:c14n7327 , _:c14n7802 , _:c14n8762 , _:c14n9518 , _:c14n9815 ;
	skos:definition "Compliance Finding events describe results of evaluations performed against resources, to check compliance with various Industry Frameworks or Security Standards such as <code>NIST SP 800-53, CIS AWS Foundations Benchmark v1.4.0, ISO/IEC 27001</code> etc. Note: if the event producer is a security control, the <code>security_control</code> profile should be applied and its <code>attacks</code> information, if present, should be duplicated into the <code>finding_info</code> object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the <code>incident</code> profile or aggregate this finding into an <code>Incident Finding</code>." ;
	skos:exactMatch ocsf:OcsfComplianceFinding ;
	skos:inScheme ocsf:ocsf_events_findings ;
	ocsf:ocsf_category "findings" ;
	ocsf:ocsf_key "compliance_finding" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host incident linux/linux_users macos/macos_users osint record_integrity security_control" .
