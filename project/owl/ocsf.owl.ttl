	skos:definition "The event class name, as defined by the <code>class_uid</code> value. The value must match the caption defined for the corresponding <code>class_uid</code> (e.g., <code>\"Detection Finding\"</code> for <code>class_uid: 2004</code>)." ;
	skos:inScheme ocsf:ocsf_core .
