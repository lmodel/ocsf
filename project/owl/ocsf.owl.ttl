ocsf:OcsfDetectionFinding dcterms:title "Detection Finding" ;
	a owl:Class ;
	rdfs:label "OcsfDetectionFinding" ;
	rdfs:seeAlso <https://github.com/ocsf/ocsf-docs/blob/main/articles/modeling-alerts.md> ;
	rdfs:subClassOf ocsf:OcsfFindingEvent , _:c14n10046 , _:c14n10055 , _:c14n10162 , _:c14n10165 , _:c14n10300 , _:c14n10361 , _:c14n10377 , _:c14n10576 , _:c14n10752 , _:c14n1113 , _:c14n1295 , _:c14n134 , _:c14n140 , _:c14n1410 , _:c14n1419 , _:c14n1422 , _:c14n1446 , _:c14n1568 , _:c14n1835 , _:c14n2014 , _:c14n2019 , _:c14n2101 , _:c14n2427 , _:c14n2559 , _:c14n2656 , _:c14n3205 , _:c14n3532 , _:c14n355 , _:c14n357 , _:c14n3618 , _:c14n3673 , _:c14n3724 , _:c14n4104 , _:c14n411 , _:c14n4111 , _:c14n4293 , _:c14n4438 , _:c14n4528 , _:c14n4634 , _:c14n4734 , _:c14n490 , _:c14n5055 , _:c14n5488 , _:c14n5500 , _:c14n5672 , _:c14n5730 , _:c14n6331 , _:c14n6378 , _:c14n6475 , _:c14n6594 , _:c14n660 , _:c14n6697 , _:c14n7146 , _:c14n7212 , _:c14n7386 , _:c14n7736 , _:c14n8031 , _:c14n8119 , _:c14n8274 , _:c14n838 , _:c14n8398 , _:c14n8497 , _:c14n856 , _:c14n8647 , _:c14n8800 , _:c14n8902 , _:c14n8959 , _:c14n8994 , _:c14n914 , _:c14n9927 ;
	skos:definition "A Detection Finding describes detections or alerts generated by security products using correlation engines, detection engines or other methodologies.<br><strong>Note: </strong>If the event producer is a security control, the <code>Security Control</code> profile should be applied and its <code>attacks</code> information, if present, should be duplicated into the <code>finding_info</code> object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the <code>Incident</code> profile or aggregate the finding into an <code>Incident Finding</code>.<p><strong>Note: </strong>Findings are mutable and as such have a lifecycle, via <code>Update</code> activities. When modeling atomic alerts, you are encouraged to consider using the <code>Security Control</code> profile with the activity event associated with the alert. See the referenced article below." ;
	skos:exactMatch ocsf:OcsfDetectionFinding ;
	skos:inScheme ocsf:ocsf_events_findings ;
	ocsf:ocsf_category "findings" ;
	ocsf:ocsf_key "detection_finding" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host incident linux/linux_users macos/macos_users osint record_integrity security_control" .
