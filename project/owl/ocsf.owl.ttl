	rdfs:range xsd:string ;
	skos:definition "The name of the cell. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:certificate dcterms:title "Certificate" ;
	a owl:ObjectProperty ;
	rdfs:label "certificate" ;
	rdfs:range ocsf:OcsfCertificate ;
	skos:definition "The certificate object containing information about the digital certificate." ;
