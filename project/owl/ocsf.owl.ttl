ocsf:OcsfPacket dcterms:title "Packet" ;
	a owl:Class ;
	rdfs:label "OcsfPacket" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:NetworkPacket/> , <https://d3fend.mitre.org/dao/artifact/d3f:PacketCaptureFile/> , <https://d3fend.mitre.org/dao/artifact/d3f:PacketLog/> ;
