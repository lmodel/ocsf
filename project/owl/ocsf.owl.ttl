ocsf:OcsfHttpRequest dcterms:title "HTTP Request" ;
	a owl:Class ;
	rdfs:label "OcsfHttpRequest" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:OutboundInternetNetworkTraffic/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10444 , _:c14n10537 , _:c14n1068 , _:c14n10831 , _:c14n1839 , _:c14n1911 , _:c14n2268 , _:c14n2313 , _:c14n236 , _:c14n2504 , _:c14n2787 , _:c14n2789 , _:c14n3258 , _:c14n3445 , _:c14n3546 , _:c14n3671 , _:c14n41 , _:c14n4590 , _:c14n4996 , _:c14n5054 , _:c14n6054 , _:c14n6134 , _:c14n6206 , _:c14n6599 , _:c14n8343 , _:c14n8389 , _:c14n8667 , _:c14n9074 , _:c14n9236 , _:c14n958 , _:c14n9667 ;
	skos:definition "The HTTP Request object represents the attributes of a request made to a web server. It encapsulates the details and metadata associated with an HTTP request, including the request method, headers, URL, query parameters, body content, and other relevant information." ;
	skos:exactMatch ocsf:OcsfHttpRequest ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:OutboundInternetNetworkTraffic , d3f:OutboundInternetWebTraffic ;
	ocsf:ocsf_key "http_request" .
ocsf:OcsfHttpResponse dcterms:title "HTTP Response" ;
	a owl:Class ;
	rdfs:label "OcsfHttpResponse" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:InboundInternetNetworkTraffic/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n1174 , _:c14n1186 , _:c14n1489 , _:c14n2123 , _:c14n4115 , _:c14n5021 , _:c14n5114 , _:c14n5637 , _:c14n5728 , _:c14n5739 , _:c14n6466 , _:c14n6494 , _:c14n6633 , _:c14n6970 , _:c14n7225 , _:c14n7261 , _:c14n7400 , _:c14n7621 , _:c14n7840 , _:c14n79 , _:c14n8285 , _:c14n8459 , _:c14n9651 ;
	skos:definition "The HTTP Response object contains detailed information about the response sent from a web server to the requester. It encompasses attributes and metadata that describe the response status, headers, body content, and other relevant information." ;
	skos:exactMatch ocsf:OcsfHttpResponse ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:InboundInternetNetworkTraffic , d3f:InboundInternetWebTraffic ;
	ocsf:ocsf_key "http_response" .
ocsf:OcsfIamAnalysisFinding dcterms:title "IAM Analysis Finding" ;
	a owl:Class ;
	rdfs:label "OcsfIamAnalysisFinding" ;
	rdfs:subClassOf ocsf:OcsfFindingEvent , _:c14n10636 , _:c14n1082 , _:c14n142 , _:c14n1430 , _:c14n1484 , _:c14n1559 , _:c14n1690 , _:c14n1837 , _:c14n1944 , _:c14n2203 , _:c14n2371 , _:c14n2443 , _:c14n26 , _:c14n2645 , _:c14n2948 , _:c14n2987 , _:c14n3019 , _:c14n3685 , _:c14n3866 , _:c14n39 , _:c14n3906 , _:c14n3970 , _:c14n4093 , _:c14n4236 , _:c14n4405 , _:c14n4463 , _:c14n4714 , _:c14n5211 , _:c14n532 , _:c14n5682 , _:c14n6516 , _:c14n6930 , _:c14n7023 , _:c14n727 , _:c14n7291 , _:c14n7483 , _:c14n7528 , _:c14n761 , _:c14n7779 , _:c14n7839 , _:c14n7910 , _:c14n8116 , _:c14n8547 , _:c14n9027 , _:c14n9062 , _:c14n9307 , _:c14n9420 , _:c14n9543 , _:c14n9953 ;
	skos:definition "This finding represents an IAM analysis result, which evaluates IAM policies, access patterns, and IAM configurations for potential security risks. The analysis can focus on either an identity (user, role, service account) or a resource to assess permissions, access patterns, and security posture within the IAM domain. <br><strong>Note:</strong> Use <code>permission_analysis_results</code> for identity-centric analysis (evaluating what an identity can do) and <code>access_analysis_result</code> for resource-centric analysis (evaluating who can access a resource). These complement each other for comprehensive IAM security assessment.<br><strong>Note:</strong> If the Finding is an incident, i.e. requires incident workflow, also apply the <code>incident</code> profile or aggregate this finding into an <code>Incident Finding</code>." ;
	skos:exactMatch ocsf:OcsfIamAnalysisFinding ;
	skos:inScheme ocsf:ocsf_events_findings ;
	ocsf:ocsf_category "findings" ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"access_analysis_result\", \"applications\", \"identity_activity_metrics\", \"permission_analysis_results\"]}" ;
	ocsf:ocsf_key "iam_analysis_finding" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host incident linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfIamEvent dcterms:title "Identity & Access Management" ;
	a owl:Class ;
	rdfs:label "OcsfIamEvent" ;
	rdfs:subClassOf ocsf:OcsfAiOperationProfile , ocsf:OcsfBaseEvent , _:c14n10254 , _:c14n1085 , _:c14n1707 , _:c14n193 , _:c14n2065 , _:c14n2768 , _:c14n3216 , _:c14n3872 , _:c14n419 , _:c14n4576 , _:c14n4955 , _:c14n4999 , _:c14n7272 , _:c14n7945 , _:c14n9144 , _:c14n9398 ;
	skos:definition "The Identity & Access Management event is a generic event that defines a set of attributes available in the access control events. As a generic event, it could be used to log events that are not otherwise defined by the IAM category." ;
	skos:exactMatch ocsf:OcsfIamEvent ;
	skos:inScheme ocsf:ocsf_events_iam ;
	ocsf:ocsf_category "iam" ;
	ocsf:ocsf_key "iam" ;
	ocsf:ocsf_profiles "ai_operation" .
ocsf:OcsfIamRole dcterms:title "IAM Role" ;
	a owl:Class ;
	rdfs:label "OcsfIamRole" ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n10872 , _:c14n147 , _:c14n1983 , _:c14n2589 , _:c14n2826 , _:c14n2906 , _:c14n3043 , _:c14n3114 , _:c14n3491 , _:c14n4001 , _:c14n4335 , _:c14n4710 , _:c14n4755 , _:c14n4821 , _:c14n4920 , _:c14n5271 , _:c14n5527 , _:c14n5588 , _:c14n6826 , _:c14n7368 , _:c14n8562 , _:c14n883 , _:c14n8864 , _:c14n917 ;
	skos:definition "The IAM Role object describes permission characteristics (or privileges) associated with a user or group of users as security principals against one or more resources. In some cases only the name or ID of the role is known hence other attributes are optional. In some systems a user or group of users can have multiple roles, imparting the union of privileges to the principal. In some systems the role can serve as a temporary security principal without its own credentials on behalf of the actual security principal." ;
	skos:exactMatch ocsf:OcsfIamRole ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "iam_role" ;
	ocsf:ocsf_profiles "cloud container data_classification" .
ocsf:OcsfIdentityActivityMetrics dcterms:title "Identity Activity Metrics" ;
	a owl:Class ;
	rdfs:label "OcsfIdentityActivityMetrics" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10655 , _:c14n10989 , _:c14n1438 , _:c14n1614 , _:c14n3064 , _:c14n3119 , _:c14n4520 , _:c14n5302 , _:c14n6 , _:c14n6177 , _:c14n6406 , _:c14n6469 , _:c14n6481 , _:c14n6700 , _:c14n7406 , _:c14n7564 , _:c14n7747 , _:c14n7789 , _:c14n7897 , _:c14n8373 , _:c14n8493 , _:c14n8761 , _:c14n9530 , _:c14n969 , _:c14n972 , _:c14n9818 ;
	skos:definition "The Identity Activity Metrics object captures usage patterns, authentication activity, credential usage and other metrics for identities across cloud and on-premises environments. Example identities include AWS IAM Users, Roles, Azure AD Principals, GCP Service Accounts, on-premises Active Directory accounts." ;
	skos:exactMatch ocsf:OcsfIdentityActivityMetrics ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "identity_activity_metrics" ;
	ocsf:ocsf_profiles "datetime" .
ocsf:OcsfIdp dcterms:title "Identity Provider" ;
	a owl:Class ;
	rdfs:label "OcsfIdp" ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n2096 , _:c14n2375 , _:c14n2585 , _:c14n2631 , _:c14n2666 , _:c14n2728 , _:c14n2920 , _:c14n3499 , _:c14n3501 , _:c14n3561 , _:c14n3717 , _:c14n3744 , _:c14n3954 , _:c14n4022 , _:c14n4079 , _:c14n4194 , _:c14n4243 , _:c14n4779 , _:c14n4841 , _:c14n4918 , _:c14n4972 , _:c14n5269 , _:c14n5649 , _:c14n5899 , _:c14n6010 , _:c14n6422 , _:c14n6483 , _:c14n6610 , _:c14n6809 , _:c14n6949 , _:c14n6961 , _:c14n7210 , _:c14n7921 , _:c14n8105 , _:c14n8179 , _:c14n8658 , _:c14n8686 , _:c14n913 , _:c14n9304 , _:c14n9412 , _:c14n9533 , _:c14n9974 ;
	skos:definition "The Identity Provider object contains detailed information about a provider responsible for creating, maintaining, and managing identity information while offering authentication services to applications. An Identity Provider (IdP) serves as a trusted authority that verifies the identity of users and issues authentication tokens or assertions to enable secure access to applications or services." ;
	skos:exactMatch ocsf:OcsfIdp ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "idp" ;
	ocsf:ocsf_profiles "container" .
ocsf:OcsfImage dcterms:title "Image" ;
	a owl:Class ;
	rdfs:label "OcsfImage" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:ContainerImage/> ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n10291 , _:c14n10533 , _:c14n10617 , _:c14n10747 , _:c14n1898 , _:c14n3912 , _:c14n4696 , _:c14n520 , _:c14n5416 , _:c14n5630 , _:c14n6216 , _:c14n8338 , _:c14n8388 , _:c14n8641 , _:c14n8828 , _:c14n9109 ;
	skos:definition "The Image object provides a description of a specific Virtual Machine (VM) or Container image." ;
	skos:exactMatch ocsf:OcsfImage ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:ContainerImage ;
	ocsf:ocsf_key "image" .
ocsf:OcsfIncidentFinding dcterms:title "Incident Finding" ;
	a owl:Class ;
	rdfs:label "OcsfIncidentFinding" ;
	rdfs:subClassOf ocsf:OcsfBaseEvent , _:c14n1027 , _:c14n1030 , _:c14n10302 , _:c14n10333 , _:c14n10396 , _:c14n10467 , _:c14n10482 , _:c14n10546 , _:c14n10601 , _:c14n1073 , _:c14n10876 , _:c14n10904 , _:c14n1170 , _:c14n1344 , _:c14n1349 , _:c14n1413 , _:c14n1753 , _:c14n1880 , _:c14n1922 , _:c14n1933 , _:c14n1958 , _:c14n2006 , _:c14n2030 , _:c14n213 , _:c14n221 , _:c14n2299 , _:c14n2412 , _:c14n2453 , _:c14n255 , _:c14n2609 , _:c14n2722 , _:c14n2821 , _:c14n2880 , _:c14n3314 , _:c14n3316 , _:c14n3329 , _:c14n3364 , _:c14n3378 , _:c14n3380 , _:c14n3534 , _:c14n3581 , _:c14n3710 , _:c14n3812 , _:c14n3934 , _:c14n4185 , _:c14n4328 , _:c14n4418 , _:c14n4470 , _:c14n4474 , _:c14n4492 , _:c14n4530 , _:c14n4808 , _:c14n4824 , _:c14n5141 , _:c14n5272 , _:c14n5430 , _:c14n5449 , _:c14n5459 , _:c14n5478 , _:c14n5571 , _:c14n5595 , _:c14n5603 , _:c14n5706 , _:c14n5736 , _:c14n5930 , _:c14n612 , _:c14n6221 , _:c14n6238 , _:c14n6305 , _:c14n6410 , _:c14n6482 , _:c14n6714 , _:c14n672 , _:c14n689 , _:c14n713 , _:c14n7315 , _:c14n7387 , _:c14n7515 , _:c14n7576 , _:c14n7610 , _:c14n7656 , _:c14n7824 , _:c14n7859 , _:c14n7889 , _:c14n7896 , _:c14n7986 , _:c14n8057 , _:c14n8085 , _:c14n8111 , _:c14n8213 , _:c14n8317 , _:c14n8346 , _:c14n8444 , _:c14n8445 , _:c14n857 , _:c14n8597 , _:c14n8628 , _:c14n8848 , _:c14n9003 , _:c14n9312 , _:c14n9362 , _:c14n9435 , _:c14n9575 , _:c14n9635 , _:c14n9663 , _:c14n986 , _:c14n995 , _:c14n9980 ;
	skos:definition "An Incident Finding reports the creation, update, or closure of security incidents as a result of detections and/or analytics. <br><strong>Note: </strong><code>Incident Finding</code> implicitly includes the <code>incident</code> profile and it should be added to the <code>metadata.profiles[]</code> array." ;
	skos:exactMatch ocsf:OcsfIncidentFinding ;
