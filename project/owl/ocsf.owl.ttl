ocsf:interface_name dcterms:title "Network Interface Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "interface_name" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the network interface (e.g. eth2)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:interface_uid dcterms:title "Network Interface ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "interface_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of the network interface." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:intermediate_ips dcterms:title "Intermediate IP Addresses" ;
	a owl:DatatypeProperty ;
	rdfs:label "intermediate_ips" ;
	rdfs:range xsd:string ;
	skos:definition "The intermediate IP Addresses. For example, the IP addresses in the HTTP X-Forwarded-For header." ;
