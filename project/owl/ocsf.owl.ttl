	rdfs:subClassOf ocsf:OcsfIamEvent , _:c14n10266 , _:c14n10294 , _:c14n10357 , _:c14n1270 , _:c14n1393 , _:c14n1400 , _:c14n1447 , _:c14n1717 , _:c14n198 , _:c14n2301 , _:c14n2433 , _:c14n2556 , _:c14n2718 , _:c14n3990 , _:c14n4139 , _:c14n4513 , _:c14n5096 , _:c14n5281 , _:c14n545 , _:c14n6029 , _:c14n6195 , _:c14n6935 , _:c14n7049 , _:c14n7084 , _:c14n7105 , _:c14n7224 , _:c14n7244 , _:c14n7557 , _:c14n801 , _:c14n8704 , _:c14n8737 , _:c14n8787 , _:c14n948 , _:c14n9583 ;
	skos:definition "Authorize Session events report privileges, groups or roles assigned to a new user session, usually at login time." ;
	skos:exactMatch ocsf:OcsfAuthorizeSession ;
	skos:inScheme ocsf:ocsf_events_iam ;
	skos:relatedMatch d3f:AuthorizationEvent ;
	ocsf:ocsf_associations "{\"session\": [\"user\"], \"user\": [\"session\"]}" ;
	ocsf:ocsf_category "iam" ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"privileges\", \"groups\", \"iam_roles\"]}" ;
	ocsf:ocsf_key "authorize_session" ;
	ocsf:ocsf_profiles "ai_operation cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfAutonomousSystem dcterms:title "Autonomous System" ;
	a owl:Class ;
	rdfs:label "OcsfAutonomousSystem" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10314 , _:c14n10425 , _:c14n1147 , _:c14n2477 , _:c14n3818 , _:c14n68 , _:c14n9744 ;
	skos:definition "An autonomous system (AS) is a collection of connected Internet Protocol (IP) routing prefixes under the control of one or more network operators on behalf of a single administrative entity or domain that presents a common, clearly defined routing policy to the internet." ;
	skos:exactMatch ocsf:OcsfAutonomousSystem ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"number\", \"name\"]}" ;
	ocsf:ocsf_key "autonomous_system" .
