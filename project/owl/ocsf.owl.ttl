ocsf:OcsfSpan dcterms:title "Span" ;
	a owl:Class ;
	rdfs:label "OcsfSpan" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n1011 , _:c14n10369 , _:c14n1042 , _:c14n10455 , _:c14n1195 , _:c14n1721 , _:c14n1799 , _:c14n1959 , _:c14n3075 , _:c14n3259 , _:c14n334 , _:c14n3515 , _:c14n3846 , _:c14n4208 , _:c14n4661 , _:c14n5107 , _:c14n5279 , _:c14n5367 , _:c14n5483 , _:c14n5879 , _:c14n5964 , _:c14n6314 , _:c14n6342 , _:c14n6522 , _:c14n7379 , _:c14n789 , _:c14n7907 , _:c14n8259 , _:c14n8596 , _:c14n91 , _:c14n9271 , _:c14n9273 , _:c14n9549 ;
	skos:definition "Represents a single unit of work or operation within a distributed trace. A span typically tracks the execution of a request across a service, capturing important details such as the operation, timestamps, and status. Spans help break down the overall trace into smaller, manageable parts, enabling detailed analysis of the performance and behavior of specific operations within the system. They are crucial for understanding latency, dependencies, and bottlenecks in complex distributed systems." ;
	skos:exactMatch ocsf:OcsfSpan ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "span" ;
	ocsf:ocsf_profiles "datetime" .
