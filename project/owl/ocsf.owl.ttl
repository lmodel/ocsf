ocsf:OcsfGroup dcterms:title "Group" ;
	a owl:Class ;
	rdfs:label "OcsfGroup" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:AccessControlGroup/> ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n10037 , _:c14n10353 , _:c14n10496 , _:c14n10524 , _:c14n2473 , _:c14n3134 , _:c14n3193 , _:c14n3631 , _:c14n4462 , _:c14n5026 , _:c14n5356 , _:c14n5397 , _:c14n6980 , _:c14n7448 , _:c14n7844 , _:c14n8616 , _:c14n8972 , _:c14n9070 , _:c14n9421 , _:c14n9677 , _:c14n9790 ;
	skos:definition "The Group object represents a collection or association of entities, such as users, policies, or devices. It serves as a logical grouping mechanism to organize and manage entities with similar characteristics or permissions within a system or organization, including but not limited to purposes of access control." ;
	skos:exactMatch ocsf:OcsfGroup ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:AccessControlGroup ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "group" .
ocsf:OcsfGroupManagement dcterms:title "Group Management" ;
	a owl:Class ;
	rdfs:label "OcsfGroupManagement" ;
	rdfs:seeAlso <https://d3fend.mitre.org/event/d3f:GroupManagementEvent/> ;
	rdfs:subClassOf ocsf:OcsfIamEvent , _:c14n10204 , _:c14n10588 , _:c14n10681 , _:c14n10744 , _:c14n10867 , _:c14n10911 , _:c14n1616 , _:c14n1644 , _:c14n167 , _:c14n1800 , _:c14n209 , _:c14n2370 , _:c14n2917 , _:c14n3105 , _:c14n3173 , _:c14n3196 , _:c14n3416 , _:c14n3821 , _:c14n3874 , _:c14n4691 , _:c14n4870 , _:c14n5164 , _:c14n5315 , _:c14n5344 , _:c14n5695 , _:c14n5837 , _:c14n6666 , _:c14n7001 , _:c14n7099 , _:c14n7282 , _:c14n7475 , _:c14n7561 , _:c14n7766 , _:c14n8439 , _:c14n8476 , _:c14n8758 , _:c14n9061 , _:c14n9141 , _:c14n9305 , _:c14n9542 ;
	skos:definition "Group Management events report lifecycle management of a group, as well as privileges, roles, and resources associated with the group. There are two ways updates to the state of a group may be expressed: Using the <code>Update</code> activity, for example when updating multiple items at one time, the <code>updated_group</code> reflects the changes made to <code>group</code>. Using discrete activities, such as <code>Assign Privileges</code> the state change is expressed by the <code>privileges</code> attribute. Optionally, on success, the <code>updated_group</code> reflects the new state of the group." ;
	skos:exactMatch ocsf:OcsfGroupManagement ;
	skos:inScheme ocsf:ocsf_events_iam ;
	skos:relatedMatch d3f:GroupManagementEvent ;
	ocsf:ocsf_category "iam" ;
	ocsf:ocsf_key "group_management" ;
	ocsf:ocsf_profiles "ai_operation cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfHassh dcterms:title "HASSH" ;
	a owl:Class ;
	rdfs:label "OcsfHassh" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n1494 , _:c14n2133 , _:c14n8483 , _:c14n8534 , _:c14n8993 , _:c14n9572 ;
	skos:definition "The HASSH object contains SSH network fingerprinting values for specific client/server implementations. It provides a standardized way of identifying and categorizing SSH connections based on their unique characteristics and behavior." ;
	skos:exactMatch ocsf:OcsfHassh ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "hassh" .
ocsf:OcsfHostProfile dcterms:title "Host" ;
	a owl:Class ;
	rdfs:label "OcsfHostProfile" ;
	rdfs:subClassOf _:c14n10193 , _:c14n1836 , _:c14n3141 , _:c14n4582 , _:c14n6275 , _:c14n9185 ;
	skos:definition "Adds host and actor context to event classes. Apply this profile when the event originates from or is observed on a specific host or device, and when the initiating user, process, or service is known. All event classes include this profile by default through the base event." ;
	skos:exactMatch ocsf:OcsfHostProfile ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "host" .
