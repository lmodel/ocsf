	a owl:DatatypeProperty ;
	rdfs:label "class_uid" ;
	rdfs:range xsd:integer ;
	skos:definition "The unique identifier of a class. A class describes the attributes available in an event. Producers and mappers must set this to the <code>uid</code> defined in the event class definition. For example, <code>Detection Finding</code> is <code>2004</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "class_name" .
