	rdfs:label "purl" ;
	rdfs:range xsd:string ;
	skos:definition "A purl is a URL string used to identify and locate a software package in a mostly universal and uniform way across programming languages, package managers, packaging conventions, tools, APIs and databases." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:query dcterms:title "DNS Query" ;
	a owl:ObjectProperty ;
	rdfs:label "query" ;
	rdfs:range ocsf:OcsfDnsQuery ;
	skos:definition "The Domain Name System (DNS) query." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:query_additional dcterms:title "DNS Query Additional Section" ;
	a owl:ObjectProperty ;
	rdfs:label "query_additional" ;
	rdfs:range ocsf:OcsfDnsSection ;
	skos:definition "The Additional section of the DNS query message sent by the client, containing supplementary resource records and an optional TSIG record. A DNS message has at most one TSIG record; for a transaction with both query and response, the query TSIG is in <code>query_additional.tsig</code> and the response TSIG is in <code>response_additional.tsig</code>." ;
	skos:inScheme ocsf:ocsf_objects .
