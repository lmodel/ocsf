ocsf:OcsfApplicationSecurityPostureFinding dcterms:title "Application Security Posture Finding" ;
	a owl:Class ;
	rdfs:label "OcsfApplicationSecurityPostureFinding" ;
	rdfs:subClassOf ocsf:OcsfFindingEvent , _:c14n10139 , _:c14n10579 , _:c14n10945 , _:c14n1111 , _:c14n1358 , _:c14n1519 , _:c14n1591 , _:c14n1754 , _:c14n1781 , _:c14n3473 , _:c14n3630 , _:c14n3782 , _:c14n4116 , _:c14n4120 , _:c14n4289 , _:c14n4382 , _:c14n47 , _:c14n4797 , _:c14n5188 , _:c14n5470 , _:c14n5502 , _:c14n5878 , _:c14n5915 , _:c14n6093 , _:c14n6413 , _:c14n6544 , _:c14n6664 , _:c14n675 , _:c14n6999 , _:c14n7 , _:c14n7423 , _:c14n7668 , _:c14n7782 , _:c14n7862 , _:c14n8135 , _:c14n8194 , _:c14n836 , _:c14n881 , _:c14n9017 , _:c14n9054 , _:c14n9132 , _:c14n9255 , _:c14n9678 , _:c14n9747 ;
	skos:definition "The Application Security Posture Finding event is a notification about any bug, defect, deficiency, exploit, vulnerability, weakness or any other issue with software and related systems. Application Security Posture Findings typically involve reporting on the greater context including compliance, impacted resources, remediation guidance, specific code defects, and/or vulnerability metadata. Application Security Posture Findings can be reported by Threat & Vulnerability Management (TVM) tools, Application Security Posture Management (ASPM) tools, or other similar tools. Note: if the event producer is a security control, the <code>security_control</code> profile should be applied and its <code>attacks</code> information, if present, should be duplicated into the <code>finding_info</code> object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the <code>incident</code> profile or aggregate this finding into an <code>Incident Finding</code>." ;
	skos:exactMatch ocsf:OcsfApplicationSecurityPostureFinding ;
	skos:inScheme ocsf:ocsf_events_findings ;
	ocsf:ocsf_category "findings" ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"application\", \"compliance\", \"remediation\", \"vulnerabilities\"]}" ;
	ocsf:ocsf_key "application_security_posture_finding" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host incident linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfAssessment dcterms:title "Assessment" ;
	a owl:Class ;
	rdfs:label "OcsfAssessment" ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n1778 , _:c14n1811 , _:c14n2399 , _:c14n2819 , _:c14n332 , _:c14n3661 , _:c14n3816 , _:c14n4485 , _:c14n4593 , _:c14n4766 , _:c14n5001 , _:c14n5518 , _:c14n60 , _:c14n6965 , _:c14n7033 , _:c14n715 , _:c14n7985 , _:c14n8327 , _:c14n8795 ;
	skos:definition "The Assessment object describes a point-in-time assessment, check, or evaluation of a specific configuration or signal against an asset, entity, person, or otherwise. For example, this can encapsulate <code>os_signals</code> from CrowdStrike Falcon Zero Trust Assessments, or account for <code>Datastore</code> configurations from Cyera, or capture details of Microsoft Intune configuration policies." ;
	skos:exactMatch ocsf:OcsfAssessment ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "assessment" .
ocsf:OcsfAttack dcterms:title "Attack Tactics & Techniques" ;
	a owl:Class ;
	rdfs:label "OcsfAttack" ;
	rdfs:seeAlso <https://atlas.mitre.org/matrices/ATLAS> , <https://attack.mitre.org> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n2251 , _:c14n2492 , _:c14n2900 , _:c14n2986 , _:c14n3209 , _:c14n3246 , _:c14n4044 , _:c14n5078 , _:c14n5275 , _:c14n5321 , _:c14n5703 , _:c14n6387 , _:c14n6595 , _:c14n8900 , _:c14n8925 , _:c14n9191 , _:c14n9500 , _:c14n9879 ;
	skos:definition "The Attack object describes the tactic, technique, sub-technique & mitigation associated to an attack." ;
	skos:exactMatch ocsf:OcsfAttack ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"tactic\", \"technique\", \"sub_technique\"]}" ;
	ocsf:ocsf_key "attack" .
ocsf:OcsfAttestation dcterms:title "Attestation" ;
	a owl:Class ;
	rdfs:label "OcsfAttestation" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10863 , _:c14n1324 , _:c14n1536 , _:c14n1658 , _:c14n2285 , _:c14n2685 , _:c14n3168 , _:c14n3182 , _:c14n3373 , _:c14n4058 , _:c14n5544 , _:c14n5965 , _:c14n6026 , _:c14n638 , _:c14n6642 , _:c14n7019 , _:c14n7570 , _:c14n9216 ;
	skos:definition "A cryptographic attestation that an event has not been altered since it was produced and was produced by the holder of a verifiable identity, providing integrity, authenticity, and non-repudiation. The attestation is computed over a canonical serialization of the event: the entire event, including the attestation's own <code>authority_uid</code>, <code>chain_uid</code>, and <code>prev_event</code> attributes, and excluding only the attestation's <code>fingerprint</code> and <code>signatures</code>. Because <code>prev_event</code> is inside the serialized content, deleting or altering an event in a chain breaks the fingerprint and signatures of the event that references it. An attestation may carry more than one signature (for example, a co-signature, notary, or witness over the same event). The verifiable identity is a technical credential, such as a key or certificate, and is not an attribution of any person, organization, or state." ;
	skos:exactMatch ocsf:OcsfAttestation ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"fingerprint\", \"signatures\"]}" ;
	ocsf:ocsf_key "attestation" .
ocsf:OcsfAuthFactor dcterms:title "Authentication Factor" ;
	a owl:Class ;
	rdfs:label "OcsfAuthFactor" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10060 , _:c14n10082 , _:c14n10283 , _:c14n10652 , _:c14n10723 , _:c14n1173 , _:c14n1679 , _:c14n2580 , _:c14n2670 , _:c14n293 , _:c14n3023 , _:c14n3220 , _:c14n328 , _:c14n3776 , _:c14n3873 , _:c14n3880 , _:c14n4134 , _:c14n50 , _:c14n5076 , _:c14n5365 , _:c14n5778 , _:c14n6570 , _:c14n8035 , _:c14n8170 , _:c14n8200 , _:c14n9998 ;
	skos:definition "An Authentication Factor object describes a category of methods used for identity verification in an authentication attempt." ;
	skos:exactMatch ocsf:OcsfAuthFactor ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "auth_factor" ;
	ocsf:ocsf_profiles "container" .
ocsf:OcsfAuthentication dcterms:title "Authentication" ;
	a owl:Class ;
	rdfs:label "OcsfAuthentication" ;
	rdfs:seeAlso <https://d3fend.mitre.org/event/d3f:AuthenticationEvent> ;
	rdfs:subClassOf ocsf:OcsfIamEvent , _:c14n10201 , _:c14n10258 , _:c14n10282 , _:c14n10340 , _:c14n10471 , _:c14n10602 , _:c14n10635 , _:c14n10769 , _:c14n10882 , _:c14n10889 , _:c14n11029 , _:c14n1182 , _:c14n1530 , _:c14n1885 , _:c14n2003 , _:c14n2017 , _:c14n2818 , _:c14n3129 , _:c14n3235 , _:c14n3333 , _:c14n3563 , _:c14n4016 , _:c14n4109 , _:c14n4419 , _:c14n4512 , _:c14n4703 , _:c14n5104 , _:c14n525 , _:c14n5428 , _:c14n5619 , _:c14n5762 , _:c14n5991 , _:c14n6013 , _:c14n6046 , _:c14n6075 , _:c14n6186 , _:c14n6213 , _:c14n6306 , _:c14n6337 , _:c14n6637 , _:c14n6674 , _:c14n6773 , _:c14n6878 , _:c14n6916 , _:c14n6933 , _:c14n7094 , _:c14n724 , _:c14n7294 , _:c14n7435 , _:c14n7473 , _:c14n7525 , _:c14n7619 , _:c14n7653 , _:c14n7723 , _:c14n7894 , _:c14n7991 , _:c14n8113 , _:c14n8253 , _:c14n8736 , _:c14n8885 , _:c14n8901 , _:c14n8931 , _:c14n8960 , _:c14n9040 , _:c14n9047 , _:c14n9066 , _:c14n9258 , _:c14n9593 , _:c14n974 , _:c14n9752 , _:c14n997 , _:c14n9979 ;
	skos:definition "Authentication events report authentication session activities, including user attempts to log on or log off, regardless of success, as well as other key stages within the authentication process. These events are typically generated by authentication services, such as Kerberos, OIDC, or SAML, and may include information about the user, the authentication method used, and the status of the authentication attempt." ;
	skos:exactMatch ocsf:OcsfAuthentication ;
	skos:inScheme ocsf:ocsf_events_iam ;
	skos:relatedMatch d3f:AuthenticationEvent ;
	ocsf:ocsf_associations "{\"actor.user\": [\"src_endpoint\"], \"dst_endpoint\": [\"user\"], \"src_endpoint\": [\"actor.user\"], \"user\": [\"dst_endpoint\"]}" ;
	ocsf:ocsf_category "iam" ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"service\", \"dst_endpoint\"]}" ;
	ocsf:ocsf_key "authentication" ;
	ocsf:ocsf_profiles "ai_operation cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfAuthenticationToken dcterms:title "Authentication Token" ;
	a owl:Class ;
	rdfs:label "OcsfAuthenticationToken" ;
	rdfs:subClassOf ocsf:OcsfToken , _:c14n10003 , _:c14n10822 , _:c14n1979 , _:c14n2298 , _:c14n2372 , _:c14n2765 , _:c14n3900 , _:c14n4008 , _:c14n4088 , _:c14n439 , _:c14n4880 , _:c14n5080 , _:c14n5298 , _:c14n5680 , _:c14n6004 , _:c14n6254 , _:c14n6805 , _:c14n6812 , _:c14n7102 , _:c14n7520 , _:c14n7647 , _:c14n8128 , _:c14n9013 , _:c14n9337 , _:c14n9538 , _:c14n9638 , _:c14n9880 ;
	skos:definition "The Authentication Token object extends the base <code>token</code> object and represents standardized authentication tokens, tickets, or assertions that conform to established authentication protocols such as Kerberos, OIDC, and SAML. This object inherits all attributes from <code>token</code> and adds protocol-specific attributes (e.g., <code>kerberos_flags</code>, <code>encryption_details</code>) for authentication events. Use this object in authentication events to represent protocol-specific tokens: Kerberos Ticket Granting Tickets (TGT) and Service Tickets (ST), OIDC Identity Tokens and Refresh Tokens, and SAML Assertions. These tokens are issued by authentication servers and identity providers and carry protocol-specific metadata, lifecycle information, and security attributes defined by their respective specifications. When to use this object: Use <code>authentication_token</code> when representing protocol-specific authentication tokens (type_id values 1-5: Kerberos TGT/ST, OIDC ID/Refresh tokens, SAML assertions) in authentication events. When NOT to use this object: Do NOT use <code>authentication_token</code> for API tokens or client tokens (type_id values 6-7) used in API activity events - use the base <code>token</code> object instead. Do NOT use <code>authentication_token</code> for generic API keys - use the base <code>token</code> object instead." ;
	skos:exactMatch ocsf:OcsfAuthenticationToken ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "authentication_token" ;
	ocsf:ocsf_profiles "datetime" .
ocsf:OcsfAuthorization dcterms:title "Authorization Result" ;
	a owl:Class ;
	rdfs:label "OcsfAuthorization" ;
