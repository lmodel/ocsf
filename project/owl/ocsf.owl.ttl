	a owl:DatatypeProperty ;
	rdfs:label "query_language" ;
	rdfs:range xsd:string ;
	skos:definition "The query language, normalized to the caption of the <code>query_language_id</code> value. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:query_language_id dcterms:title "Query Language ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_language_id" ;
	rdfs:range _:c14n1462 ;
	skos:definition "The normalized identifier of the query language. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "query_language" .
ocsf:query_result dcterms:title "Query Result" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_result" ;
	rdfs:range xsd:string ;
	skos:definition "The result of the query." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:query_result_id dcterms:title "Query Result ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_result_id" ;
	rdfs:range _:c14n6845 ;
	skos:definition "The normalized identifier of the query result." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "query_result" .
ocsf:query_string dcterms:title "HTTP Query String" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_string" ;
	rdfs:range xsd:string ;
	skos:definition "The query portion of the URL. For example: the query portion of the URL <code>http://www.example.com/search?q=bad&sort=date</code> is <code>q=bad&sort=date</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:query_time dcterms:title "Query Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The Domain Name System (DNS) query time." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:query_time_dt dcterms:title "Query Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The Domain Name System (DNS) query time." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:query_type dcterms:title "Query Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_type" ;
	rdfs:range xsd:string ;
	skos:definition "The normalized caption of query_type_id or the source-specific query type." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:query_type_id dcterms:title "Query Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "query_type_id" ;
	rdfs:range _:c14n9671 ;
	skos:definition "The normalized type of system query performed against a device or system component." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "query_type" .
ocsf:radius dcterms:title "Radius" ;
	a owl:DatatypeProperty ;
	rdfs:label "radius" ;
	rdfs:range xsd:string ;
	skos:definition "Farthest horizontal distance from the reported location at which any UA in a group may be located (meters). Also allows defining the area where an Intent-Based Network Participant operation is taking place. Default: 0 m." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:ram_size dcterms:title "RAM Size" ;
	a owl:DatatypeProperty ;
	rdfs:label "ram_size" ;
	rdfs:range xsd:integer ;
	skos:definition "The total amount of installed RAM, in Megabytes. For example: <code>2048</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:rate_limit dcterms:title "Rate Limit" ;
	a owl:DatatypeProperty ;
	rdfs:label "rate_limit" ;
	rdfs:range xsd:integer ;
	skos:definition "The rate limit for a rate-based rule." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:raw_data dcterms:title "Raw Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "raw_data" ;
	rdfs:range xsd:string ;
	skos:definition "The original event/finding data as received from the source, before normalization into OCSF. Populate this with the verbatim log line, JSON payload, or other native format for forensic and debugging purposes. This field is not intended for structured querying - use the normalized OCSF attributes instead." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:raw_data_hash dcterms:title "Raw Data Hash" ;
	a owl:ObjectProperty ;
	rdfs:label "raw_data_hash" ;
	rdfs:range ocsf:OcsfFingerprint ;
	skos:definition "A fingerprint (hash) of the <code>raw_data</code> content. Use this to verify the integrity of the original event data or to deduplicate events." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:raw_data_size dcterms:title "Raw Data Size" ;
	a owl:DatatypeProperty ;
	rdfs:label "raw_data_size" ;
	rdfs:range xsd:integer ;
	skos:definition "The size of the original event data (as captured in <code>raw_data</code>) in bytes, before OCSF normalization. Useful for metering and capacity planning." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:raw_header dcterms:title "Raw Header" ;
	a owl:DatatypeProperty ;
	rdfs:label "raw_header" ;
	rdfs:range xsd:string ;
	skos:definition "The email authentication header." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:rcode dcterms:title "Response Code" ;
	a owl:DatatypeProperty ;
	rdfs:label "rcode" ;
	rdfs:range xsd:string ;
	skos:definition "The server response code, normalized to the caption of the rcode_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:rcode_id dcterms:title "Response Code ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "rcode_id" ;
	rdfs:range _:c14n3601 ;
	skos:definition "The normalized identifier of the server response code. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "rcode" .
ocsf:rdata dcterms:title "DNS RData" ;
	a owl:DatatypeProperty ;
	rdfs:label "rdata" ;
	rdfs:range xsd:string ;
	skos:definition "The data describing the DNS resource. The meaning of this data depends on the type and class of the resource record." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:read_count dcterms:title "Read Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "read_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The read count. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:record_index_in_array dcterms:title "Record Index in Array" ;
	a owl:DatatypeProperty ;
	rdfs:label "record_index_in_array" ;
	rdfs:range xsd:integer ;
	skos:definition "The index of the record in the array of records." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:records dcterms:title "DNS Resource Records" ;
	a owl:ObjectProperty ;
	rdfs:label "records" ;
	rdfs:range ocsf:OcsfDnsResourceRecord ;
	skos:definition "The resource records in a DNS message section. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:references dcterms:title "References" ;
	a owl:DatatypeProperty ;
	rdfs:label "references" ;
	rdfs:range xsd:string ;
	skos:definition "A list of reference URLs supporting the finding/detection." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:referrer dcterms:title "HTTP Referrer" ;
	a owl:DatatypeProperty ;
	rdfs:label "referrer" ;
	rdfs:range xsd:string ;
	skos:definition "The request header that identifies the address of the previous web page, which is linked to the current web page or resource being requested." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:reg_binary_data dcterms:title "Registry Binary Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "reg_binary_data" ;
	rdfs:range xsd:string ;
	skos:definition "The data of the registry value when <code>type_id</code> is <code>REG_BINARY</code> or <code>REG_NONE</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:reg_integer_data dcterms:title "Registry Integer Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "reg_integer_data" ;
	rdfs:range xsd:integer ;
	skos:definition "The data of the registry value when <code>type_id</code> is <code>REG_DWORD</code>, <code>REG_DWORD_BIG_ENDIAN</code>, or <code>REG_QWORD</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:reg_key dcterms:title "Registry Key" ;
	a owl:ObjectProperty ;
	rdfs:label "reg_key" ;
	rdfs:range ocsf:OcsfWinRegKey ;
	skos:definition "The registry key." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_extension "win" .
ocsf:reg_string_data dcterms:title "Registry String Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "reg_string_data" ;
	rdfs:range xsd:string ;
	skos:definition "The data of the registry value when <code>type_id</code> is <code>REG_SZ</code>, <code>REG_EXPAND_SZ</code>, or <code>REG_LINK</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:reg_string_list_data dcterms:title "Registry String List Data" ;
	a owl:DatatypeProperty ;
	rdfs:label "reg_string_list_data" ;
	rdfs:range xsd:string ;
	skos:definition "The data of the registry value when <code>type_id</code> is <code>REG_MULTI_SZ</code>." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:reg_value dcterms:title "Registry Value" ;
	a owl:ObjectProperty ;
	rdfs:label "reg_value" ;
	rdfs:range ocsf:OcsfWinRegValue ;
	skos:definition "The registry value." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_extension "win" .
ocsf:region dcterms:title "Region" ;
	a owl:DatatypeProperty ;
	rdfs:label "region" ;
	rdfs:range xsd:string ;
	skos:definition "The name or the code of a region. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:registrar dcterms:title "Domain Registrar" ;
	a owl:DatatypeProperty ;
	rdfs:label "registrar" ;
	rdfs:range xsd:string ;
	skos:definition "The domain registrar." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:related_analytics dcterms:title "Related Analytics" ;
	a owl:ObjectProperty ;
	rdfs:label "related_analytics" ;
	rdfs:range ocsf:OcsfAnalytic ;
	skos:definition "Describes analytics related to the analytic of a finding or detection as identified by the security product." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:related_component dcterms:title "Related Component" ;
	a owl:DatatypeProperty ;
	rdfs:label "related_component" ;
	rdfs:range xsd:string ;
	skos:definition "The package URL (PURL) of the component that this software component has a relationship with." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:related_cves dcterms:title "Related CVEs" ;
	a owl:ObjectProperty ;
	rdfs:label "related_cves" ;
	rdfs:range ocsf:OcsfCve ;
	rdfs:seeAlso <https://cve.mitre.org/> ;
	skos:definition "Describes Common Vulnerabilities and Exposures entries that are related to an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:related_cwes dcterms:title "Related CWEs" ;
	a owl:ObjectProperty ;
	rdfs:label "related_cwes" ;
	rdfs:range ocsf:OcsfCwe ;
	rdfs:seeAlso <https://cwe.mitre.org/> ;
	skos:definition "Describes Common Weakness Enumeration entries that are related to an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:related_events dcterms:title "Related Events/Findings" ;
	a owl:ObjectProperty ;
	rdfs:label "related_events" ;
	rdfs:range ocsf:OcsfRelatedEvent ;
	skos:definition "Describes events and/or other findings related to the finding as identified by the security product. Note that these events may or may not be in OCSF." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:related_events_count dcterms:title "Related Events/Findings Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "related_events_count" ;
	rdfs:range xsd:integer ;
	skos:definition "Number of related events or findings." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:related_vulnerabilities dcterms:title "Related Vulnerability IDs" ;
	a owl:DatatypeProperty ;
	rdfs:label "related_vulnerabilities" ;
	rdfs:range xsd:string ;
	skos:definition "List of vulnerability IDs (e.g. CVE ID) that are related to this vulnerability." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:relation dcterms:title "Relation" ;
	a owl:DatatypeProperty ;
	rdfs:label "relation" ;
	rdfs:range xsd:string ;
	skos:definition "The relationship between two entities. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:relationship dcterms:title "Relationship" ;
	a owl:DatatypeProperty ;
	rdfs:label "relationship" ;
	rdfs:range xsd:string ;
	skos:definition "The relationship between two software components, normalized to the caption of the <code>relationship_id</code> value. In the case of 'Other', it is defined by the source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:relationship_id dcterms:title "Relationship ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "relationship_id" ;
	rdfs:range _:c14n1051 ;
	skos:definition "The normalized identifier of the relationship between two software components." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "relationship" .
ocsf:relay dcterms:title "Relay" ;
	a owl:ObjectProperty ;
	rdfs:label "relay" ;
	rdfs:range ocsf:OcsfNetworkInterface ;
	skos:definition "The network relay that is associated with the event." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:release dcterms:title "Software Release Details" ;
	a owl:DatatypeProperty ;
	rdfs:label "release" ;
	rdfs:range xsd:string ;
	skos:definition "Release is the number of times a version of the software has been packaged." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:remediation dcterms:title "Remediation Guidance" ;
	a owl:ObjectProperty ;
	rdfs:label "remediation" ;
	rdfs:range ocsf:OcsfRemediation ;
	skos:definition "Describes the recommended remediation steps to address identified issue(s)." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:remote_display dcterms:title "Remote Display" ;
	a owl:ObjectProperty ;
	rdfs:label "remote_display" ;
	rdfs:range ocsf:OcsfDisplay ;
	skos:definition "The remote display affiliated with the event" ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:reply_to dcterms:title "Reply To" ;
	a owl:DatatypeProperty ;
	rdfs:label "reply_to" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The machine-readable email header Reply-To value, as defined by RFC 5322. For example <code>example.user@usersdomain.com</code>" ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.4.0" ;
	ocsf:ocsf_superseded_by "reply_to_list" .
ocsf:reply_to_list dcterms:title "Reply To List" ;
	a owl:DatatypeProperty ;
	rdfs:label "reply_to_list" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The machine-readable email header Reply-To values, as defined by RFC 5322. For example <code>example.user@usersdomain.com</code>" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:reply_to_mailboxes dcterms:title "Reply To Mailboxes" ;
	a owl:DatatypeProperty ;
	rdfs:label "reply_to_mailboxes" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322#section-3.4> ;
	skos:definition "The human-readable email header Reply To Mailbox values. For example <code>'Example User &lt;example.user@usersdomain.com&gt;'</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:reporter dcterms:title "Reporter" ;
	a owl:ObjectProperty ;
	rdfs:label "reporter" ;
	rdfs:range ocsf:OcsfReporter ;
	skos:definition "The entity from which an event or finding was first reported. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:reputation dcterms:title "Reputation Scores" ;
	a owl:ObjectProperty ;
	rdfs:label "reputation" ;
	rdfs:range ocsf:OcsfReputation ;
	skos:definition "Contains the original and normalized reputation scores." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:request dcterms:title "API Request Details" ;
	a owl:ObjectProperty ;
	rdfs:label "request" ;
	rdfs:range ocsf:OcsfRequest ;
	skos:definition "General Purpose API Request Object. See specific usage" ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:requested_permissions dcterms:title "Requested Permissions" ;
	a owl:DatatypeProperty ;
	rdfs:label "requested_permissions" ;
	rdfs:range xsd:integer ;
	skos:definition "The permissions mask. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:requirements dcterms:title "Compliance Requirements" ;
	a owl:DatatypeProperty ;
	rdfs:label "requirements" ;
	rdfs:range xsd:string ;
	skos:definition "A list of requirements associated to a specific control in an industry or regulatory framework. e.g. <code>NIST.800-53.r5 AU-10</code>" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:resource dcterms:title "Resource" ;
	a owl:ObjectProperty ;
	rdfs:label "resource" ;
	rdfs:range ocsf:OcsfResourceDetails ;
	skos:definition "The target resource." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:resource_relationship dcterms:title "Resource Relationship" ;
	a owl:ObjectProperty ;
	rdfs:label "resource_relationship" ;
	rdfs:range ocsf:OcsfGraph ;
	skos:definition "Describes entities related to the resource, using a graph structure. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:resource_type dcterms:title "Resource Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "resource_type" ;
	rdfs:range xsd:string ;
	skos:definition "The resource type as defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:resources dcterms:title "Resources Array" ;
	a owl:ObjectProperty ;
	rdfs:label "resources" ;
	rdfs:range ocsf:OcsfResourceDetails ;
	skos:definition "Describes details about resources that were affected by the activity/event." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:resources_result dcterms:title "Resource Results Array" ;
	a owl:ObjectProperty ;
	rdfs:label "resources_result" ;
	rdfs:range ocsf:OcsfResourceDetails ;
	skos:definition "Updated resources after an activity/event." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_superseded_by "updated_resources" .
ocsf:response dcterms:title "API Response Details" ;
	a owl:ObjectProperty ;
	rdfs:label "response" ;
	rdfs:range ocsf:OcsfResponse ;
	skos:definition "General Purpose API Response Object. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:response_additional dcterms:title "DNS Response Additional Section" ;
	a owl:ObjectProperty ;
	rdfs:label "response_additional" ;
	rdfs:range ocsf:OcsfDnsSection ;
	skos:definition "The Additional section of the DNS response message sent by the server, containing supplementary resource records and an optional TSIG record. A DNS message has at most one TSIG record; for a transaction with both query and response, the query TSIG is in <code>query_additional.tsig</code> and the response TSIG is in <code>response_additional.tsig</code>." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:response_text dcterms:title "Response Text" ;
	a owl:DatatypeProperty ;
	rdfs:label "response_text" ;
	rdfs:range xsd:string ;
	skos:definition "The text of the model's response generated for this message. For agent-mediated operations, this is the content returned by the assistant, tool, or agent." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:response_time dcterms:title "Response Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "response_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The Domain Name System (DNS) response time." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:response_time_dt dcterms:title "Response Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "response_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The Domain Name System (DNS) response time." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:return_path dcterms:title "Return Path" ;
	a owl:DatatypeProperty ;
	rdfs:label "return_path" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc5321#section-4.4> , <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The address found in the 'Return-Path' header, which indicates where bounce messages (non-delivery reports) should be sent. This address is often set by the sending system and may differ from the 'From' or 'Sender' addresses. For example, <code>mailer-daemon@senderserver.com</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:return_value dcterms:title "Return Value" ;
	a owl:DatatypeProperty ;
	rdfs:label "return_value" ;
	rdfs:range xsd:string ;
	skos:definition "The value returned from a function." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:risk_details dcterms:title "Risk Details" ;
	a owl:DatatypeProperty ;
	rdfs:label "risk_details" ;
	rdfs:range xsd:string ;
	skos:definition "Describes the risk associated with the finding." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:risk_level dcterms:title "Risk Level" ;
	a owl:DatatypeProperty ;
	rdfs:label "risk_level" ;
	rdfs:range xsd:string ;
	skos:definition "The risk level, normalized to the caption of the risk_level_id value." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:risk_level_id dcterms:title "Risk Level ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "risk_level_id" ;
	rdfs:range _:c14n9129 ;
	skos:definition "The normalized risk level id." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "risk_level" ;
	ocsf:ocsf_suppress_checks "enum_convention" .
ocsf:risk_score dcterms:title "Risk Score" ;
	a owl:DatatypeProperty ;
	rdfs:label "risk_score" ;
	rdfs:range xsd:integer ;
	skos:definition "The risk score as reported by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:role dcterms:title "Role" ;
	a owl:DatatypeProperty ;
	rdfs:label "role" ;
	rdfs:range xsd:string ;
	skos:definition "The role of an entity in the context of the event or finding, normalized to the caption of the role_id value. In the case of 'Other', it is defined by the event source. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:role_id dcterms:title "Role ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "role_id" ;
	rdfs:range _:c14n4043 ;
	skos:definition "The normalized identifier of an entity's role in the context of the event or finding. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "role" .
ocsf:row_number dcterms:title "Row Number" ;
	a owl:DatatypeProperty ;
	rdfs:label "row_number" ;
	rdfs:range xsd:integer ;
	skos:definition "The row number. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:rpc_interface dcterms:title "Remote Procedure Call Interface" ;
	a owl:ObjectProperty ;
	rdfs:label "rpc_interface" ;
	rdfs:range ocsf:OcsfRpcInterface ;
	skos:definition "The RPC Interface object describes the details pertaining to the remote procedure call interface." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:rssi dcterms:title "RSSI" ;
	a owl:DatatypeProperty ;
	rdfs:label "rssi" ;
	rdfs:range xsd:integer ;
	skos:definition "Received Signal Strength Indicator (RSSI) is a measurement of the power of a radio signal. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:rule dcterms:title "Rule" ;
	a owl:ObjectProperty ;
	rdfs:label "rule" ;
	rdfs:range ocsf:OcsfRule ;
	skos:definition "The rules that reported the events." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:run_count dcterms:title "Run Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "run_count" ;
	rdfs:range xsd:integer ;
	skos:definition "The prefetch file run count." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:run_mode_ids dcterms:title "Run Mode IDs" ;
	a owl:DatatypeProperty ;
	rdfs:label "run_mode_ids" ;
	rdfs:range _:c14n10276 ;
	skos:definition "The list of normalized identifiers that describe application attributes when it is running. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "run_modes" .
ocsf:run_modes dcterms:title "Run Modes" ;
	a owl:DatatypeProperty ;
	rdfs:label "run_modes" ;
	rdfs:range xsd:string ;
	skos:definition "The list of run_modes, normalized to the captions of the run_mode_ids values.  In the case of 'Other', they are defined by the event source. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:run_state dcterms:title "Run State" ;
	a owl:DatatypeProperty ;
	rdfs:label "run_state" ;
	rdfs:range xsd:string ;
	skos:definition "The state of the job or service, normalized to the caption of the run_state_id value. In the case of 'Other', it is defined by the event source. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:run_state_id dcterms:title "Run State ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "run_state_id" ;
	rdfs:range _:c14n10491 ;
	skos:definition "The normalized identifier of the state of the job or service. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "run_state" .
ocsf:runtime dcterms:title "Runtime" ;
	a owl:DatatypeProperty ;
	rdfs:label "runtime" ;
	rdfs:range xsd:string ;
	skos:definition "The backend running the container, such as containerd or cri-o." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:samesite dcterms:title "SameSite" ;
	a owl:DatatypeProperty ;
	rdfs:label "samesite" ;
	rdfs:range xsd:string ;
	skos:definition "The cookie attribute that lets servers specify whether/when cookies are sent with cross-site requests. Values are: Strict, Lax or None" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sandbox dcterms:title "Sandbox" ;
	a owl:DatatypeProperty ;
	rdfs:label "sandbox" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the containment jail (i.e., sandbox). For example, hardened_ps, high_security_ps, oracle_ps, netsvcs_ps, or default_ps." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sans dcterms:title "Subject Alternative Names" ;
	a owl:ObjectProperty ;
	rdfs:label "sans" ;
	rdfs:range ocsf:OcsfSan ;
	skos:definition "The list of subject alternative names that are secured by a specific certificate." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:sbom dcterms:title "Software Bill Of Materials" ;
	a owl:ObjectProperty ;
	rdfs:label "sbom" ;
	rdfs:range ocsf:OcsfSbom ;
	skos:definition "The Software Bill of Materials (SBOM) object describes the characteristics of a generated SBOM for a software package." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:scale_factor dcterms:title "Scale Factor" ;
	a owl:DatatypeProperty ;
	rdfs:label "scale_factor" ;
	rdfs:range xsd:integer ;
	skos:definition "The numeric scale factor of display." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:scan dcterms:title "Scan" ;
	a owl:ObjectProperty ;
	rdfs:label "scan" ;
	rdfs:range ocsf:OcsfScan ;
	skos:definition "The Scan object describes characteristics of a scan.  See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:schedule_uid dcterms:title "Schedule UID" ;
	a owl:DatatypeProperty ;
	rdfs:label "schedule_uid" ;
	rdfs:range xsd:string ;
	skos:definition "The unique identifier of the schedule associated with a scan job." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:scheme dcterms:title "Scheme" ;
	a owl:DatatypeProperty ;
	rdfs:label "scheme" ;
	rdfs:range xsd:string ;
	skos:definition "The scheme portion of the URL. For example: <code>http</code>, <code>https</code>, <code>ftp</code>, or <code>sftp</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:scim dcterms:title "SCIM" ;
	a owl:ObjectProperty ;
	rdfs:label "scim" ;
	rdfs:range ocsf:OcsfScim ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc7643> ;
	skos:definition "The System for Cross-domain Identity Management (SCIM) resource object as defined in RFC 7634 provides a structured set of attributes related to SCIM protocols used for identity provisioning and management across cloud-based platforms. It standardizes user and group provisioning details, enabling identity synchronization and lifecycle management with compatible Identity Providers (IdPs) and applications." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:scim_group_schema dcterms:title "SCIM Group Schema" ;
	a owl:DatatypeProperty ;
	rdfs:label "scim_group_schema" ;
	rdfs:range _:c14n10102 ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc7643> ;
	skos:definition "SCIM provides a schema for representing groups, identified using the following schema URI: <code>urn:ietf:params:scim:schemas:core:2.0:Group</code> as defined in RFC 7634. This attribute will capture key-value pairs for the scheme implemented in a SCIM resource." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:scim_user_schema dcterms:title "SCIM User Schema" ;
	a owl:DatatypeProperty ;
	rdfs:label "scim_user_schema" ;
	rdfs:range _:c14n1403 ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc7643> ;
	skos:definition "SCIM provides a resource type for user resources. The core schema for user is identified using the following schema URI: <code>urn:ietf:params:scim:schemas:core:2.0:User</code> as defined in RFC 7634. This attribute will capture key-value pairs for the scheme implemented in a SCIM resource. This object is inclusive of both the basic and Enterprise User Schema Extension." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:scopes dcterms:title "Scopes" ;
	a owl:DatatypeProperty ;
	rdfs:label "scopes" ;
	rdfs:range xsd:string ;
	skos:definition "Scopes define the specific permissions or actions that the client is allowed to perform on behalf of the user. Each scope represents a different set of permissions, and the user can selectively grant or deny access to specific scopes during the authorization process." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:score dcterms:title "Reputation Score" ;
	a owl:DatatypeProperty ;
	rdfs:label "score" ;
	rdfs:range xsd:string ;
	skos:definition "The reputation score, normalized to the caption of the score_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:score_id dcterms:title "Reputation Score ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "score_id" ;
	rdfs:range _:c14n740 ;
	skos:definition "The normalized reputation score identifier." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "score" .
ocsf:script dcterms:title "Script" ;
	a owl:ObjectProperty ;
	rdfs:label "script" ;
	rdfs:range ocsf:OcsfScript ;
	skos:definition "The script object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:script_content dcterms:title "Script Content" ;
	a owl:ObjectProperty ;
	rdfs:label "script_content" ;
	rdfs:range ocsf:OcsfLongString ;
	skos:definition "The script content, normalized to UTF-8 encoding irrespective of its original encoding. When emitting this attribute, it may be appropriate to truncate large scripts. When consuming this attribute, large scripts should be anticipated." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_observable "36" .
ocsf:section_a dcterms:title "JA4 Section A" ;
	a owl:DatatypeProperty ;
	rdfs:label "section_a" ;
	rdfs:range xsd:string ;
	skos:definition "The 'a' section of the JA4 fingerprint." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:section_b dcterms:title "JA4 Section B" ;
	a owl:DatatypeProperty ;
	rdfs:label "section_b" ;
	rdfs:range xsd:string ;
	skos:definition "The 'b' section of the JA4 fingerprint." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:section_c dcterms:title "JA4 Section C" ;
	a owl:DatatypeProperty ;
	rdfs:label "section_c" ;
	rdfs:range xsd:string ;
	skos:definition "The 'c' section of the JA4 fingerprint." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:section_d dcterms:title "JA4 Section D" ;
	a owl:DatatypeProperty ;
	rdfs:label "section_d" ;
	rdfs:range xsd:string ;
	skos:definition "The 'd' section of the JA4 fingerprint." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:secure dcterms:title "Secure" ;
	a owl:DatatypeProperty ;
	rdfs:label "secure" ;
	rdfs:range xsd:boolean ;
	skos:definition "The cookie attribute to only send cookies to the server with an encrypted request over the HTTPS protocol." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_deprecated_since "1.1.0" ;
	ocsf:ocsf_superseded_by "is_secure" .
ocsf:security_descriptor dcterms:title "Security Descriptor" ;
	a owl:DatatypeProperty ;
	rdfs:label "security_descriptor" ;
	rdfs:range xsd:string ;
	skos:definition "The object security descriptor." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:security_level dcterms:title "Security Level" ;
	a owl:DatatypeProperty ;
	rdfs:label "security_level" ;
	rdfs:range xsd:string ;
	skos:definition "The current security level of the entity" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:security_level_id dcterms:title "Security Level ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "security_level_id" ;
	rdfs:range _:c14n2448 ;
	skos:definition "The current security level of the entity" ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "security_level" .
ocsf:security_questions dcterms:title "Security Questions" ;
	a owl:DatatypeProperty ;
	rdfs:label "security_questions" ;
	rdfs:range xsd:string ;
	skos:definition "The question(s) provided to user for a question-based authentication factor." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:security_states dcterms:title "Security States" ;
	a owl:ObjectProperty ;
	rdfs:label "security_states" ;
	rdfs:range ocsf:OcsfSecurityState ;
	skos:definition "The current security states. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:sender dcterms:title "Sender" ;
	a owl:DatatypeProperty ;
	rdfs:label "sender" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The machine readable email address of the system or server that actually transmitted the email message, extracted from the email headers per RFC 5322. This differs from the <code>from</code> field, which shows the message author. The sender field is most commonly used when multiple addresses appear in the <code> from_list </code> field, or when the transmitting system is different from the message author (such as when sending on behalf of someone else)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sender_mailbox dcterms:title "Sender Mailbox" ;
	a owl:DatatypeProperty ;
	rdfs:label "sender_mailbox" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc5322> ;
	skos:definition "The human readable email address of the system or server that actually transmitted the email message, extracted from the email headers per RFC 5322. This differs from the <code>from_mailbox</code> field, which shows the message author. The sender mailbox field is most commonly used when multiple addresses appear in the <code> from_mailboxes </code> field, or when the transmitting system is different from the message author (such as when sending on behalf of someone else)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sensitivity dcterms:title "Sensitivity" ;
	a owl:DatatypeProperty ;
	rdfs:label "sensitivity" ;
	rdfs:range xsd:string ;
	skos:definition "The sensitivity of the firewall rule in the matched event. For example: HIGH." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sensor_info_list dcterms:title "Sensor Information List" ;
	a owl:ObjectProperty ;
	rdfs:label "sensor_info_list" ;
	rdfs:range ocsf:OcsfSensorInfo ;
	skos:definition "An array of sensor_info objects that describe sensor control points." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:sensor_layer dcterms:title "Sensor Layer" ;
	a owl:DatatypeProperty ;
	rdfs:label "sensor_layer" ;
	rdfs:range xsd:string ;
	skos:definition "The normalized identifier of the sensor layer that emitted the data for the analysis. For example, use this to classify the detection surface (e.g., IPS sensor, endpoint agent, email gateway). When the type is not listed, use <code>99</code> (Other) and populate <code>sensor_layer</code> with the source-specific label." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sensor_layer_id dcterms:title "Sensor Layer ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "sensor_layer_id" ;
	rdfs:range _:c14n9723 ;
	skos:definition "The technology or sensor layer that the event or finding originated from. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "sensor_layer" .
ocsf:sequence dcterms:title "Sequence Number" ;
	a owl:DatatypeProperty ;
	rdfs:label "sequence" ;
	rdfs:range xsd:integer ;
	skos:definition "Sequence number of the event. The sequence number is a value available in some events, to make the exact ordering of events unambiguous, regardless of the event time precision." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sequence_number dcterms:title "Sequence Number" ;
	a owl:DatatypeProperty ;
	rdfs:label "sequence_number" ;
	rdfs:range xsd:integer ;
	skos:definition "The sequence number. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:serial_number dcterms:title "Serial Number" ;
	a owl:DatatypeProperty ;
	rdfs:label "serial_number" ;
	rdfs:range xsd:string ;
	skos:definition "The serial number that pertains to the object. See specific usage." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_observable "37" .
ocsf:serialization dcterms:title "Serialization" ;
	a owl:DatatypeProperty ;
	rdfs:label "serialization" ;
	rdfs:range xsd:string ;
	skos:definition "The canonical serialization or signing-envelope scheme used to produce the deterministic byte sequence that was signed, e.g. <code>JCS</code> (RFC 8785). Normalized to the captions of the <code>serialization_id</code> values." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:serialization_id dcterms:title "Serialization ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "serialization_id" ;
	rdfs:range xsd:integer ;
	skos:definition "The normalized identifier of the canonical serialization or signing-envelope scheme used to produce the signed byte sequence. A verifier must apply the same scheme to reproduce the signing input." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "serialization" .
ocsf:server_ciphers dcterms:title "Server Cipher Suites" ;
	a owl:DatatypeProperty ;
	rdfs:label "server_ciphers" ;
	rdfs:range xsd:string ;
	skos:definition "The server cipher suites that were exchanged during the TLS handshake negotiation." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:server_hassh dcterms:title "Server HASSH" ;
	a owl:ObjectProperty ;
	rdfs:label "server_hassh" ;
	rdfs:range ocsf:OcsfHassh ;
	skos:definition "The Server HASSH fingerprinting object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:service dcterms:title "Service" ;
	a owl:ObjectProperty ;
	rdfs:label "service" ;
	rdfs:range ocsf:OcsfService ;
	skos:definition "The service that pertains to the event." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:service_category dcterms:title "Service Category" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_category" ;
	rdfs:range xsd:string ;
	skos:definition "The service category, normalized to the caption of the service_category_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:service_category_id dcterms:title "Service Category ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_category_id" ;
	rdfs:range _:c14n7165 ;
	skos:definition "The normalized identifier of the service category." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" ;
	ocsf:ocsf_sibling "service_category" .
ocsf:service_dependencies dcterms:title "Service Dependencies" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_dependencies" ;
	rdfs:range xsd:string ;
	skos:definition "The names of other services upon which this service has a dependency." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:service_dll_file dcterms:title "Service DLL" ;
	a owl:ObjectProperty ;
	rdfs:label "service_dll_file" ;
	rdfs:range ocsf:OcsfFile ;
	skos:definition "For a shared user mode service (<code>service_type_id</code> is 4) this is the DLL that gets loaded by the generic service host process (e.g. <code>svchost.exe</code>) to implement the service." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_extension "win" .
ocsf:service_error_control dcterms:title "Service Error Control" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_error_control" ;
	rdfs:range xsd:string ;
	skos:definition "The service error control, normalized to the caption of the <code>service_error_control_id</code> value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:service_error_control_id dcterms:title "Service Error Control ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_error_control_id" ;
	rdfs:range _:c14n6556 ;
	skos:definition "The normalized identifier of the service error control." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" ;
	ocsf:ocsf_sibling "service_error_control" .
ocsf:service_file dcterms:title "Service File" ;
	a owl:ObjectProperty ;
	rdfs:label "service_file" ;
	rdfs:range ocsf:OcsfFile ;
	skos:definition "For a user mode service (<code>service_type_id</code> 3 or 4) this is the executable program that the SCM launches as the service process.<br>For a kernel mode driver (<code>service_type_id</code> 1 or 2) this is the driver file loaded into the kernel at the request of the SCM." ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_extension "win" .
ocsf:service_privilege_analysis dcterms:title "Service Privilege Analysis" ;
	a owl:ObjectProperty ;
	rdfs:label "service_privilege_analysis" ;
	rdfs:range ocsf:OcsfServicePrivilegeAnalysis ;
	skos:definition "Privilege analysis results for a single cloud service or resource namespace." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:service_privilege_analysis_list dcterms:title "Service Privilege Analysis List" ;
	a owl:ObjectProperty ;
	rdfs:label "service_privilege_analysis_list" ;
	rdfs:range ocsf:OcsfServicePrivilegeAnalysis ;
	skos:definition "A list of privilege analysis results grouped by cloud service or namespace." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:service_start_name dcterms:title "Service Start Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_start_name" ;
	rdfs:range xsd:string ;
	skos:definition "For a user mode service, this attribute represents the name of the account under which the service is run. For a kernel mode driver, this attribute represents the object name used to load the driver." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:service_start_type dcterms:title "Service Start Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_start_type" ;
	rdfs:range xsd:string ;
	skos:definition "The service start type, normalized to the caption of the <code>service_start_type_id</code> value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:service_start_type_id dcterms:title "Service Start Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_start_type_id" ;
	rdfs:range _:c14n8266 ;
	skos:definition "The normalized identifier of the service start type." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" ;
	ocsf:ocsf_sibling "service_start_type" .
ocsf:service_type dcterms:title "Service Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_type" ;
	rdfs:range xsd:string ;
	skos:definition "The service type, normalized to the caption of the service_type_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" .
ocsf:service_type_id dcterms:title "Service Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "service_type_id" ;
	rdfs:range _:c14n5150 ;
	skos:definition "The normalized identifier of the service type." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_extension "win" ;
	ocsf:ocsf_sibling "service_type" .
ocsf:session dcterms:title "Session" ;
	a owl:ObjectProperty ;
	rdfs:label "session" ;
	rdfs:range ocsf:OcsfSession ;
	skos:definition "The authenticated user or service session." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:severity dcterms:title "Severity" ;
	a owl:DatatypeProperty ;
	rdfs:label "severity" ;
	rdfs:range xsd:string ;
	skos:definition "The event/finding severity label, normalized to the caption of the <code>severity_id</code> value. When <code>severity_id</code> is <code>99</code> (Other), this attribute <b>must</b> contain the source-specific severity label. For all other values, this should match the caption defined for that <code>severity_id</code> enum value (e.g., <code>\"High\"</code> for <code>severity_id: 4</code>)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:severity_id dcterms:title "Severity ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "severity_id" ;
	rdfs:range _:c14n7670 ;
	skos:definition "<p>The normalized identifier of the event/finding severity.</p>The normalized severity is a measurement the effort and expense required to manage and resolve an event or incident. Smaller numerical values represent lower impact events, and larger numerical values represent higher impact events." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "severity" .
ocsf:share dcterms:title "Share" ;
	a owl:DatatypeProperty ;
	rdfs:label "share" ;
	rdfs:range xsd:string ;
	skos:definition "The share name. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:share_type dcterms:title "Share Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "share_type" ;
	rdfs:range xsd:string ;
	skos:definition "The share type, normalized to the caption of the share_type_id value. In the case of 'Other', it is defined by the event source." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:share_type_id dcterms:title "Share Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "share_type_id" ;
	rdfs:range _:c14n7289 ;
	skos:definition "The normalized identifier of the share type." ;
	skos:inScheme ocsf:ocsf_core ;
	ocsf:ocsf_sibling "share_type" .
ocsf:short_desc dcterms:title "Short Description" ;
	a owl:DatatypeProperty ;
	rdfs:label "short_desc" ;
	rdfs:range xsd:string ;
	skos:definition "The short description that pertains to the object or event. See specific usage." ;
