	skos:definition "The CIS Critical Security Control (CSC) contains information as defined by the Center for Internet Security Critical Security Controls (CIS CSC). Prioritized set of actions to protect your organization and data from cyber-attack vectors." ;
	skos:exactMatch ocsf:OcsfCisCsc ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.5.0" ;
	ocsf:ocsf_key "cis_csc" ;
	ocsf:ocsf_superseded_by "cis_control" .
