ocsf:OcsfScim dcterms:title "SCIM" ;
	a owl:Class ;
	rdfs:label "OcsfScim" ;
	rdfs:seeAlso <https://datatracker.ietf.org/doc/html/rfc7643> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10420 , _:c14n10456 , _:c14n10595 , _:c14n10711 , _:c14n11031 , _:c14n1180 , _:c14n1289 , _:c14n1402 , _:c14n1662 , _:c14n1663 , _:c14n1730 , _:c14n1826 , _:c14n1862 , _:c14n1896 , _:c14n1901 , _:c14n1981 , _:c14n199 , _:c14n2263 , _:c14n2481 , _:c14n2613 , _:c14n2696 , _:c14n2963 , _:c14n3031 , _:c14n3085 , _:c14n3327 , _:c14n34 , _:c14n345 , _:c14n4112 , _:c14n4182 , _:c14n4244 , _:c14n4439 , _:c14n4497 , _:c14n4526 , _:c14n4642 , _:c14n465 , _:c14n4654 , _:c14n4873 , _:c14n4896 , _:c14n5235 , _:c14n5247 , _:c14n5311 , _:c14n5351 , _:c14n5425 , _:c14n5465 , _:c14n5557 , _:c14n562 , _:c14n5640 , _:c14n5957 , _:c14n6104 , _:c14n6335 , _:c14n6686 , _:c14n6852 , _:c14n6858 , _:c14n6893 , _:c14n7109 , _:c14n7188 , _:c14n7246 , _:c14n729 , _:c14n7380 , _:c14n790 , _:c14n8067 , _:c14n8146 , _:c14n8349 , _:c14n8735 , _:c14n9095 , _:c14n923 , _:c14n9579 , _:c14n9869 , _:c14n9898 ;
	skos:definition "The System for Cross-domain Identity Management (SCIM) Configuration object provides a structured set of attributes related to SCIM protocols used for identity provisioning and management across cloud-based platforms. It standardizes user and group provisioning details, enabling identity synchronization and lifecycle management with compatible Identity Providers (IdPs) and applications. SCIM is defined in RFC 7634." ;
	skos:exactMatch ocsf:OcsfScim ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "scim" ;
	ocsf:ocsf_profiles "datetime" .
