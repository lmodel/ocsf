ocsf:signature dcterms:title "Digital Signature" ;
	a owl:ObjectProperty ;
	rdfs:label "signature" ;
	rdfs:range ocsf:OcsfDigitalSignature ;
	skos:definition "The digital signature of the file." ;
	skos:inScheme ocsf:ocsf_objects .
