ocsf:OcsfDnsResourceRecord dcterms:title "DNS Resource Record" ;
	a owl:Class ;
	rdfs:label "OcsfDnsResourceRecord" ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc1035.txt> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10837 , _:c14n1527 , _:c14n2357 , _:c14n283 , _:c14n3436 , _:c14n3637 , _:c14n6166 , _:c14n6784 , _:c14n7487 , _:c14n7814 , _:c14n7936 , _:c14n7954 , _:c14n8586 , _:c14n9645 , _:c14n99 ;
	skos:definition "The DNS Resource Record object represents a single resource record as defined in RFC 1035. It is used in the Answer, Authority, and Additional sections of a DNS message." ;
	skos:exactMatch ocsf:OcsfDnsResourceRecord ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "dns_resource_record" .
ocsf:OcsfDnsSection dcterms:title "DNS Section" ;
	a owl:Class ;
	rdfs:label "OcsfDnsSection" ;
	rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc1035.txt> , <https://www.rfc-editor.org/rfc/rfc2845> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10290 , _:c14n5771 , _:c14n7722 , _:c14n8820 , _:c14n9524 ;
	skos:definition "The DNS Section object represents a DNS message section that carries supplementary resource records alongside an optional TSIG record. It is used for both the client Additional section (<code>query_additional</code>) and the server Additional section (<code>response_additional</code>) of a DNS message. A DNS message has at most one TSIG record, which authenticates the entire message." ;
	skos:exactMatch ocsf:OcsfDnsSection ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "dns_section" .
