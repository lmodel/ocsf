ocsf:is_vpn dcterms:title "VPN Session" ;
	a owl:DatatypeProperty ;
	rdfs:label "is_vpn" ;
	rdfs:range xsd:boolean ;
	skos:definition "The indication of whether the session is a VPN session." ;
