ocsf:OcsfApplication dcterms:title "Application" ;
	a owl:Class ;
	rdfs:label "OcsfApplication" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:Application/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10421 , _:c14n1055 , _:c14n10801 , _:c14n1470 , _:c14n1471 , _:c14n1483 , _:c14n1560 , _:c14n1940 , _:c14n2005 , _:c14n2012 , _:c14n2267 , _:c14n2422 , _:c14n260 , _:c14n2692 , _:c14n2976 , _:c14n3057 , _:c14n3422 , _:c14n3551 , _:c14n3559 , _:c14n377 , _:c14n3815 , _:c14n4045 , _:c14n4306 , _:c14n4386 , _:c14n4406 , _:c14n4660 , _:c14n4669 , _:c14n4772 , _:c14n4788 , _:c14n4961 , _:c14n5144 , _:c14n5145 , _:c14n5299 , _:c14n5317 , _:c14n5586 , _:c14n5737 , _:c14n5807 , _:c14n5935 , _:c14n6194 , _:c14n6310 , _:c14n6366 , _:c14n6371 , _:c14n658 , _:c14n6810 , _:c14n7004 , _:c14n7343 , _:c14n736 , _:c14n7518 , _:c14n7545 , _:c14n7594 , _:c14n8010 , _:c14n851 , _:c14n8566 , _:c14n8662 , _:c14n8783 , _:c14n8953 , _:c14n910 , _:c14n9456 , _:c14n9495 , _:c14n9547 , _:c14n9751 , _:c14n9824 ;
	skos:definition "An Application describes the details for an inventoried application as reported by an Application Security tool or other Developer-centric tooling. Applications can be defined as Kubernetes resources, Containerized resources, or application hosting-specific cloud sources such as AWS Elastic BeanStalk, AWS Lightsail, or Azure Logic Apps." ;
	skos:exactMatch ocsf:OcsfApplication ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:Application ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"uid\", \"name\"]}" ;
	ocsf:ocsf_key "application" ;
	ocsf:ocsf_profiles "data_classification" .
ocsf:OcsfApplicationError dcterms:title "Application Error" ;
	a owl:Class ;
	rdfs:label "OcsfApplicationError" ;
	rdfs:subClassOf ocsf:OcsfApplicationEvent , _:c14n10205 , _:c14n10224 , _:c14n10852 , _:c14n1200 , _:c14n2234 , _:c14n2452 , _:c14n2617 , _:c14n3824 , _:c14n4348 , _:c14n6520 , _:c14n6602 , _:c14n6748 , _:c14n7016 , _:c14n7633 , _:c14n8809 , _:c14n8886 , _:c14n9555 , _:c14n9847 ;
	skos:definition "Application Error events describe issues with an applications. The error message should be put in the event's <code>message</code> attribute. The <code>metadata.product</code> attribute can be used to capture the originating application information. The <code>host</code> profile can used to include the generating device information. This class is helpful for applications that generate or handle OCSF events and can also be used for errors in upstream products and services." ;
	skos:exactMatch ocsf:OcsfApplicationError ;
	skos:inScheme ocsf:ocsf_events_application ;
	ocsf:ocsf_category "application" ;
	ocsf:ocsf_key "application_error" ;
	ocsf:ocsf_profiles "ai_operation cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" .
