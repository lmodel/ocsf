	rdfs:label "source_process" ;
	rdfs:range ocsf:OcsfProcess ;
	skos:definition "The source process object." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:sp_name dcterms:title "OS Service Pack" ;
	a owl:DatatypeProperty ;
	rdfs:label "sp_name" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the latest Service Pack." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sp_ver dcterms:title "OS Service Pack Version" ;
	a owl:DatatypeProperty ;
	rdfs:label "sp_ver" ;
	rdfs:range xsd:integer ;
	skos:definition "The version number of the latest Service Pack." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:span dcterms:title "Span" ;
	a owl:ObjectProperty ;
	rdfs:label "span" ;
	rdfs:range ocsf:OcsfSpan ;
	skos:definition "The information about the span. See specific usage." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:speed dcterms:title "Speed" ;
	a owl:DatatypeProperty ;
	rdfs:label "speed" ;
	rdfs:range xsd:string ;
	skos:definition "Ground speed of flight. This value is provided in meters per second with a minimum resolution of 0.25 m/s. Special Values: <code>Invalid</code>, <code>No Value</code>, or <code>Unknown: 255 m/s</code>." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:speed_accuracy dcterms:title "Speed Accuracy" ;
	a owl:DatatypeProperty ;
	rdfs:label "speed_accuracy" ;
	rdfs:range xsd:string ;
	skos:definition "Provides quality/containment on horizontal ground speed. Measured in meters/second." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:speed_mhz dcterms:title "Compute Unit Speed (MHz)" ;
	a owl:DatatypeProperty ;
	rdfs:label "speed_mhz" ;
	rdfs:range xsd:integer ;
	skos:definition "The nominal clock speed of the unit, expressed in megahertz." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:spf dcterms:title "SPF Status" ;
	a owl:DatatypeProperty ;
	rdfs:label "spf" ;
	rdfs:range xsd:string ;
	skos:definition "The Sender Policy Framework (SPF) status of the email." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:src_endpoint dcterms:title "Source Endpoint" ;
	a owl:ObjectProperty ;
	rdfs:label "src_endpoint" ;
	rdfs:range ocsf:OcsfNetworkEndpoint ;
	skos:definition "The network source endpoint." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:src_url dcterms:title "Source URL" ;
	a owl:DatatypeProperty ;
	rdfs:label "src_url" ;
	rdfs:range xsd:string ;
	skos:definition "The URL pointing towards the source of an entity. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:sso dcterms:title "SSO" ;
	a owl:ObjectProperty ;
	rdfs:label "sso" ;
	rdfs:range ocsf:OcsfSso ;
	skos:definition "The Single Sign-On (SSO) object provides a structure for normalizing SSO attributes, configuration, and/or settings from Identity Providers." ;
	skos:inScheme ocsf:ocsf_objects .
ocsf:standards dcterms:title "Compliance Standards: List" ;
	a owl:DatatypeProperty ;
	rdfs:label "standards" ;
	rdfs:range xsd:string ;
	skos:definition "Compliance standards are a set of criteria organizations can follow to protect sensitive and confidential information. e.g. <code>NIST SP 800-53, CIS AWS Foundations Benchmark v1.4.0, ISO/IEC 27001</code>" ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_address dcterms:title "Start Address" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_address" ;
	rdfs:range xsd:string ;
	skos:definition "The start address of the execution." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_column dcterms:title "Start Column" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_column" ;
	rdfs:range xsd:integer ;
	skos:definition "The start column number. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_line dcterms:title "Start Line" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_line" ;
	rdfs:range xsd:integer ;
	skos:definition "The line number of the first line of code block identified as vulnerable." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_offset dcterms:title "Start Offset" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_offset" ;
	rdfs:range xsd:integer ;
	skos:definition "The starting offset. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_time dcterms:title "Start Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_time" ;
	rdfs:range xsd:integer ;
	skos:definition "The start time of a time period. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_time_dt dcterms:title "Start Time" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_time_dt" ;
	rdfs:range xsd:string ;
	skos:definition "The start time of a time period. See specific usage." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_type dcterms:title "Start Type" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_type" ;
	rdfs:range xsd:string ;
	skos:definition "The start type of a service, driver, or application." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:start_type_id dcterms:title "Start Type ID" ;
	a owl:DatatypeProperty ;
	rdfs:label "start_type_id" ;
	rdfs:range _:c14n6547 ;
	skos:definition "The start type ID of a service or application." ;
	skos:inScheme ocsf:ocsf_core ;
