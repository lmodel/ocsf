ocsf:isp dcterms:title "ISP Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "isp" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the Internet Service Provider (ISP)." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:isp_org dcterms:title "ISP Org" ;
	a owl:DatatypeProperty ;
	rdfs:label "isp_org" ;
	rdfs:range xsd:string ;
	skos:definition "The organization name of the Internet Service Provider (ISP). This represents the parent organization or company that owns/operates the ISP. For example, Comcast Corporation would be the ISP org for Xfinity internet service. This attribute helps identify the ultimate provider when ISPs operate under different brand names." ;
	skos:inScheme ocsf:ocsf_core .
ocsf:issuer dcterms:title "Issuer Details" ;
	a owl:DatatypeProperty ;
	rdfs:label "issuer" ;
	rdfs:range xsd:string ;
	skos:definition "The identifier of the issuer. See specific usage." ;
