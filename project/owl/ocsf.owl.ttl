ocsf:OcsfContainer dcterms:title "Container" ;
	a owl:Class ;
	rdfs:label "OcsfContainer" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:ContainerProcess/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n1021 , _:c14n10211 , _:c14n1026 , _:c14n1071 , _:c14n1341 , _:c14n1452 , _:c14n1935 , _:c14n2774 , _:c14n3382 , _:c14n3838 , _:c14n3943 , _:c14n4070 , _:c14n417 , _:c14n4731 , _:c14n5119 , _:c14n5186 , _:c14n5217 , _:c14n5306 , _:c14n5492 , _:c14n5707 , _:c14n5758 , _:c14n6219 , _:c14n6367 , _:c14n6442 , _:c14n6554 , _:c14n6622 , _:c14n7093 , _:c14n7568 , _:c14n7832 , _:c14n7922 , _:c14n7977 , _:c14n8044 , _:c14n8963 , _:c14n9467 , _:c14n9871 ;
	skos:definition "The Container object describes an instance of a specific container. A container is a prepackaged, portable system image that runs isolated on an existing system using a container runtime like containerd." ;
