ocsf:OcsfBaseline dcterms:title "Baseline" ;
	a owl:Class ;
	rdfs:label "OcsfBaseline" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10048 , _:c14n118 , _:c14n2304 , _:c14n4381 , _:c14n4799 , _:c14n6152 , _:c14n7122 , _:c14n7398 , _:c14n7597 , _:c14n8789 , _:c14n9454 ;
	skos:definition "Describes the baseline or expected behavior of a system, service, or component based on historical observations and measurements. It establishes reference points for comparison to detect anomalies, trends, and deviations from typical patterns." ;
	skos:exactMatch ocsf:OcsfBaseline ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "baseline" .
ocsf:OcsfCampaign dcterms:title "Campaign" ;
	a owl:Class ;
	rdfs:label "OcsfCampaign" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n7596 , _:c14n9509 , _:c14n9591 ;
	skos:definition "Campaign represent organized efforts by threat actors to achieve malicious objectives over a period, often characterized by shared tactics, techniques, and procedures (TTPs)." ;
	skos:exactMatch ocsf:OcsfCampaign ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "campaign" .
ocsf:OcsfCertificate dcterms:title "Digital Certificate" ;
	a owl:Class ;
	rdfs:label "OcsfCertificate" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:Certificate/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10059 , _:c14n10064 , _:c14n10079 , _:c14n1022 , _:c14n1083 , _:c14n1544 , _:c14n1823 , _:c14n1890 , _:c14n2090 , _:c14n3396 , _:c14n3614 , _:c14n3988 , _:c14n4625 , _:c14n5384 , _:c14n6304 , _:c14n6327 , _:c14n6354 , _:c14n6683 , _:c14n6751 , _:c14n6791 , _:c14n721 , _:c14n7297 , _:c14n7308 , _:c14n7725 , _:c14n7745 , _:c14n7756 , _:c14n7765 , _:c14n8122 , _:c14n8243 , _:c14n8344 , _:c14n9253 , _:c14n9626 , _:c14n9674 , _:c14n9959 ;
	skos:definition "The Digital Certificate, also known as a Public Key Certificate, object contains information about the ownership and usage of a public key. It serves as a means to establish trust in the authenticity and integrity of the public key and the associated entity." ;
	skos:exactMatch ocsf:OcsfCertificate ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:Certificate ;
	ocsf:ocsf_key "certificate" ;
	ocsf:ocsf_profiles "datetime" .
ocsf:OcsfCheck dcterms:title "Check" ;
	a owl:Class ;
	rdfs:label "OcsfCheck" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10559 , _:c14n10809 , _:c14n1171 , _:c14n1181 , _:c14n1939 , _:c14n2525 , _:c14n265 , _:c14n2778 , _:c14n477 , _:c14n4794 , _:c14n4900 , _:c14n4991 , _:c14n5577 , _:c14n5956 , _:c14n6017 , _:c14n6285 , _:c14n642 , _:c14n6480 , _:c14n6730 , _:c14n7080 , _:c14n7404 , _:c14n8302 , _:c14n8502 , _:c14n9231 , _:c14n9321 , _:c14n9465 , _:c14n9613 , _:c14n9697 , _:c14n9826 ;
	skos:definition "The check object defines a specific, testable compliance verification point that evaluates a target device against a standard, framework, or custom requirement. While checks are typically associated with formal standards (like CIS, NIST, or ISO), they can also represent custom or organizational requirements. When mapped to controls, checks can evaluate specific control_parameters to determine compliance status, but neither the control mapping nor control_parameters are required for a valid check." ;
	skos:exactMatch ocsf:OcsfCheck ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "check" ;
	ocsf:ocsf_profiles "cloud container data_classification" .
ocsf:OcsfCisBenchmark dcterms:title "CIS Benchmark" ;
	a owl:Class ;
	rdfs:label "OcsfCisBenchmark" ;
	rdfs:seeAlso <https://www.cisecurity.org/cis-benchmarks/> , <https://www.cisecurity.org/insights/blog/getting-to-know-the-cis-benchmarks> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10084 , _:c14n1279 , _:c14n2419 , _:c14n4970 , _:c14n6920 , _:c14n7833 , _:c14n8821 , _:c14n9226 ;
	skos:definition "The CIS Benchmark object describes best practices for securely configuring IT systems, software, networks, and cloud infrastructure as defined by the Center for Internet Security. See also Getting to Know the CIS Benchmarks." ;
	skos:exactMatch ocsf:OcsfCisBenchmark ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.5.0" ;
	ocsf:ocsf_key "cis_benchmark" ;
	ocsf:ocsf_superseded_by "compliance.checks" .
ocsf:OcsfCisBenchmarkResult dcterms:title "CIS Benchmark Result" ;
	a owl:Class ;
	rdfs:label "OcsfCisBenchmarkResult" ;
	rdfs:seeAlso <https://www.cisecurity.org/cis-benchmarks/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n1565 , _:c14n1716 , _:c14n300 , _:c14n3191 , _:c14n5002 , _:c14n6069 , _:c14n6576 , _:c14n7242 , _:c14n8008 , _:c14n8198 , _:c14n8531 , _:c14n8741 ;
	skos:definition "The CIS Benchmark Result object contains information as defined by the Center for Internet Security (CIS) benchmark result. CIS Benchmarks are a collection of best practices for securely configuring IT systems, software, networks, and cloud infrastructure." ;
	skos:exactMatch ocsf:OcsfCisBenchmarkResult ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_deprecated_since "1.5.0" ;
	ocsf:ocsf_key "cis_benchmark_result" ;
	ocsf:ocsf_profiles "data_classification" ;
	ocsf:ocsf_superseded_by "compliance.checks" .
ocsf:OcsfCisControl dcterms:title "CIS Control" ;
	a owl:Class ;
	rdfs:label "OcsfCisControl" ;
	rdfs:seeAlso <https://www.cisecurity.org/controls> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n2432 , _:c14n2725 , _:c14n4105 , _:c14n4653 , _:c14n6286 , _:c14n6626 , _:c14n7106 , _:c14n734 , _:c14n9063 ;
	skos:definition "The CIS Control (aka Critical Security Control) object describes a prioritized set of actions to protect your organization and data from cyber-attack vectors. The CIS Controls are defined by the Center for Internet Security." ;
	skos:exactMatch ocsf:OcsfCisControl ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "cis_control" .
ocsf:OcsfCisCsc dcterms:title "CIS CSC" ;
	a owl:Class ;
