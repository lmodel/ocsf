xsd:boolean a rdfs:Datatype .
xsd:float a rdfs:Datatype .
xsd:integer a rdfs:Datatype ;
	owl:equivalentClass _:c14n6737 .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n45342 , _:c14n45344 , _:c14n45346 , _:c14n45348 , _:c14n45350 , _:c14n45352 .
<https://w3id.org/lmodel/ocsf.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/ocsf/ocsf-schema/tree/1.9.0> ;
	dcterms:title "Open Cybersecurity Schema Framework (OCSF)" ;
	pav:version "1.9.0" ;
	<http://schema.org/keywords> "OCSF" , "event normalisation" , "observability" , "security events" , "security telemetry" ;
	a owl:Ontology ;
	rdfs:label "ocsf" ;
	rdfs:seeAlso <https://lmodel.github.io/ocsf> , <https://schema.ocsf.io/1.9.0/> ;
	skos:definition "A LinkML model of the Open Cybersecurity Schema Framework, the open standard for normalising security events that the OCSF project publishes. It renders OCSF 1.9.0 with OCSF's own keys and integer values, so a real event validates unchanged against the class its class_uid names." ;
	skos:note "The version is OCSF's own. upstream/ holds the tag's files and the compiler's output, scripts/ocsf_to_linkml.py writes these modules from them, tests/test_coverage.py holds the schema to them both ways, and scripts/check_upstream_release.py reports when the tag moves." .
ocsf:OcsfAccessAnalysisResult dcterms:title "Access Analysis Result" ;
	a owl:Class ;
	rdfs:label "OcsfAccessAnalysisResult" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10101 , _:c14n10238 , _:c14n10826 , _:c14n2913 , _:c14n3218 , _:c14n4265 , _:c14n4993 , _:c14n5042 , _:c14n527 , _:c14n5685 , _:c14n6840 , _:c14n8831 , _:c14n9089 , _:c14n9423 ;
	skos:definition "The Access Analysis Result object describes access relationships and pathways between identities, resources, focusing on who can access what and through which mechanisms. This evaluates access levels (read/write/admin), access types (direct, cross-account, public, federated), and the conditions under which access is granted. Use this for resource-centric security assessments such as external access discovery, public exposure analysis, etc." ;
	skos:exactMatch ocsf:OcsfAccessAnalysisResult ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "access_analysis_result" .
ocsf:OcsfAccount dcterms:title "Account" ;
	a owl:Class ;
	rdfs:label "OcsfAccount" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:CloudUserAccount/> , <https://d3fend.mitre.org/dao/artifact/d3f:UserAccount/> ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n101 , _:c14n10825 , _:c14n1239 , _:c14n1913 , _:c14n343 , _:c14n3477 , _:c14n3768 , _:c14n4080 , _:c14n4733 , _:c14n4742 , _:c14n506 , _:c14n5977 , _:c14n6434 , _:c14n6630 , _:c14n6967 , _:c14n7015 , _:c14n7021 , _:c14n7098 , _:c14n723 , _:c14n7354 , _:c14n8309 , _:c14n8649 , _:c14n9449 , _:c14n9503 , _:c14n9855 , _:c14n9964 ;
	skos:definition "The Account object contains details about the account that initiated or performed a specific activity within a system or application. Additionally, the Account object refers to logical Cloud and Software-as-a-Service (SaaS) based containers such as AWS Accounts, Azure Subscriptions, Oracle Cloud Compartments, Google Cloud Projects, and otherwise." ;
	skos:exactMatch ocsf:OcsfAccount ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:CloudUserAccount , d3f:UserAccount ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "account" .
ocsf:OcsfAccountChange dcterms:title "Account Change" ;
	a owl:Class ;
	rdfs:label "OcsfAccountChange" ;
	rdfs:subClassOf ocsf:OcsfIamEvent , _:c14n10174 , _:c14n10208 , _:c14n10630 , _:c14n10749 , _:c14n10880 , _:c14n1653 , _:c14n2562 , _:c14n2701 , _:c14n405 , _:c14n4260 , _:c14n4426 , _:c14n4681 , _:c14n5506 , _:c14n561 , _:c14n6849 , _:c14n7463 , _:c14n7507 , _:c14n7523 , _:c14n7602 , _:c14n7654 , _:c14n8048 , _:c14n8278 , _:c14n8546 , _:c14n8657 , _:c14n9088 , _:c14n9214 , _:c14n9372 , _:c14n9537 ;
	skos:definition "Account Change events report when specific user account management tasks are performed, such as a user/role being created or role assigned, changed, deleted, renamed, disabled, enabled, locked out or unlocked." ;
	skos:exactMatch ocsf:OcsfAccountChange ;
	skos:inScheme ocsf:ocsf_events_iam ;
	skos:relatedMatch d3f:UserAccountEvent ;
	ocsf:ocsf_category "iam" ;
	ocsf:ocsf_deprecated_since "1.9.0" ;
	ocsf:ocsf_key "account_change" ;
	ocsf:ocsf_profiles "ai_operation cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" ;
	ocsf:ocsf_superseded_by "user_management" .
ocsf:OcsfActor dcterms:title "Actor" ;
	a owl:Class ;
	rdfs:label "OcsfActor" ;
	rdfs:seeAlso <https://next.d3fend.mitre.org/agent/d3f:Agent/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10090 , _:c14n10128 , _:c14n10348 , _:c14n10416 , _:c14n10573 , _:c14n1303 , _:c14n2021 , _:c14n2784 , _:c14n2797 , _:c14n3021 , _:c14n3424 , _:c14n3542 , _:c14n3545 , _:c14n4277 , _:c14n4367 , _:c14n4421 , _:c14n4724 , _:c14n518 , _:c14n5207 , _:c14n610 , _:c14n6215 , _:c14n7325 , _:c14n7506 , _:c14n7580 , _:c14n7855 , _:c14n8305 , _:c14n8980 , _:c14n9243 , _:c14n9464 , _:c14n9830 ;
	skos:definition "The Actor object contains details about the user, role, application, service, or process that initiated or performed a specific activity. Note that Actor is not the threat actor of a campaign but may be part of a campaign. When the initiator of the activity is an autonomous AI agent, apply the <code>ai_operation</code> profile and populate <code>ai_operation.ai_agent</code> rather than describing the agent here." ;
	skos:exactMatch ocsf:OcsfActor ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:Agent ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"process\", \"user\", \"iam_role\", \"invoked_by\", \"session\", \"application\", \"app_name\", \"app_uid\"]}" ;
	ocsf:ocsf_key "actor" ;
	ocsf:ocsf_profiles "cloud container data_classification linux/linux_users macos/macos_users" .
ocsf:OcsfAdditionalRestriction dcterms:title "Additional Restriction" ;
	a owl:Class ;
	rdfs:label "OcsfAdditionalRestriction" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n1159 , _:c14n2626 , _:c14n271 , _:c14n2935 , _:c14n812 , _:c14n8152 , _:c14n9092 , _:c14n9733 , _:c14n9905 ;
	skos:definition "The Additional Restriction object describes supplementary access controls and guardrails that constrain or limit granted permissions beyond the primary policy. These restrictions are typically applied through hierarchical policy frameworks, organizational controls, or conditional access mechanisms. Examples include AWS Service Control Policies (SCPs), Resource Control Policies (RCPs), Azure Management Group policies, GCP Organization policies, conditional access policies, IP restrictions, time-based constraints, and MFA requirements." ;
	skos:exactMatch ocsf:OcsfAdditionalRestriction ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "additional_restriction" .
ocsf:OcsfAdminGroupQuery dcterms:title "Admin Group Query" ;
	a owl:Class ;
	rdfs:label "OcsfAdminGroupQuery" ;
	rdfs:subClassOf ocsf:OcsfDiscoveryResultEvent , _:c14n1045 , _:c14n1311 , _:c14n1493 , _:c14n3505 , _:c14n3653 , _:c14n3723 , _:c14n4736 , _:c14n4927 , _:c14n4997 , _:c14n5159 , _:c14n5942 , _:c14n6361 , _:c14n7007 , _:c14n7229 , _:c14n7644 , _:c14n7881 , _:c14n8535 , _:c14n8541 , _:c14n8645 , _:c14n871 ;
	skos:definition "Admin Group Query events report information about administrative groups." ;
	skos:exactMatch ocsf:OcsfAdminGroupQuery ;
	skos:inScheme ocsf:ocsf_events_discovery ;
	ocsf:ocsf_category "discovery" ;
	ocsf:ocsf_deprecated_since "1.5.0" ;
	ocsf:ocsf_key "admin_group_query" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" ;
	ocsf:ocsf_superseded_by "evidence_info" .
ocsf:OcsfAdvisory dcterms:title "Advisory" ;
	a owl:Class ;
	rdfs:label "OcsfAdvisory" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10215 , _:c14n10364 , _:c14n10835 , _:c14n1220 , _:c14n1231 , _:c14n1256 , _:c14n1271 , _:c14n1315 , _:c14n2140 , _:c14n2330 , _:c14n2460 , _:c14n3 , _:c14n3407 , _:c14n3599 , _:c14n4025 , _:c14n4211 , _:c14n4307 , _:c14n4408 , _:c14n4774 , _:c14n4846 , _:c14n495 , _:c14n5130 , _:c14n5457 , _:c14n563 , _:c14n5702 , _:c14n5886 , _:c14n5952 , _:c14n598 , _:c14n6032 , _:c14n6147 , _:c14n6158 , _:c14n6253 , _:c14n6278 , _:c14n6529 , _:c14n6561 , _:c14n6616 , _:c14n6648 , _:c14n6680 , _:c14n6715 , _:c14n6914 , _:c14n6940 , _:c14n7339 , _:c14n74 , _:c14n8183 , _:c14n8354 , _:c14n8378 , _:c14n8422 , _:c14n8443 , _:c14n9026 , _:c14n9210 , _:c14n9395 , _:c14n9450 , _:c14n9491 , _:c14n9640 , _:c14n9664 , _:c14n9791 , _:c14n9907 ;
	skos:definition "The Advisory object represents publicly disclosed cybersecurity vulnerabilities defined in a Security advisory. e.g. <code> Microsoft KB Article</code>, <code>Apple Security Advisory</code>, or a <code>GitHub Security Advisory (GHSA)</code>" ;
	skos:exactMatch ocsf:OcsfAdvisory ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "advisory" ;
	ocsf:ocsf_profiles "data_classification datetime" .
ocsf:OcsfAffectedCode dcterms:title "Affected Code" ;
	a owl:Class ;
	rdfs:label "OcsfAffectedCode" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n1388 , _:c14n3204 , _:c14n3580 , _:c14n4605 , _:c14n4610 , _:c14n4937 , _:c14n5282 , _:c14n5494 , _:c14n5575 , _:c14n5684 , _:c14n6500 , _:c14n6677 , _:c14n6736 , _:c14n6865 , _:c14n6942 , _:c14n7101 , _:c14n7873 , _:c14n8773 , _:c14n8999 , _:c14n9000 , _:c14n9105 , _:c14n9172 , _:c14n9623 , _:c14n9765 ;
	skos:definition "The Affected Code object describes details about a code block identified as vulnerable." ;
	skos:exactMatch ocsf:OcsfAffectedCode ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "affected_code" ;
	ocsf:ocsf_profiles "container data_classification" .
ocsf:OcsfAffectedPackage dcterms:title "Affected Software Package" ;
	a owl:Class ;
	rdfs:label "OcsfAffectedPackage" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:SoftwarePackage/> ;
	rdfs:subClassOf ocsf:OcsfPackage , _:c14n10428 , _:c14n10646 , _:c14n1538 , _:c14n2611 , _:c14n375 , _:c14n4071 , _:c14n4420 , _:c14n480 , _:c14n8254 ;
	skos:definition "The Affected Package object describes details about a software package identified as affected by a vulnerability/vulnerabilities." ;
	skos:exactMatch ocsf:OcsfAffectedPackage ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:SoftwarePackage ;
	ocsf:ocsf_key "affected_package" ;
	ocsf:ocsf_profiles "data_classification" .
ocsf:OcsfAgent dcterms:title "Agent" ;
	a owl:Class ;
	rdfs:label "OcsfAgent" ;
	rdfs:seeAlso <https://d3fend.mitre.org/dao/artifact/d3f:Sensor/> ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10039 , _:c14n10347 , _:c14n10587 , _:c14n1435 , _:c14n1850 , _:c14n3081 , _:c14n4038 , _:c14n4215 , _:c14n4510 , _:c14n5319 , _:c14n5855 , _:c14n5932 , _:c14n6325 , _:c14n6400 , _:c14n6501 , _:c14n6991 , _:c14n7709 , _:c14n7909 , _:c14n7994 , _:c14n8262 , _:c14n828 , _:c14n9077 , _:c14n9904 , _:c14n9950 ;
	skos:definition "An Agent (also known as a Sensor) is typically installed on an Operating System (OS) and serves as a specialized software component that can be designed to monitor, detect, collect, archive, or take action. These activities and possible actions are defined by the upstream system controlling the Agent and its intended purpose. For instance, an Agent can include Endpoint Detection & Response (EDR) agents, backup/disaster recovery sensors, Application Performance Monitoring or profiling sensors, and similar software." ;
	skos:exactMatch ocsf:OcsfAgent ;
	skos:inScheme ocsf:ocsf_objects ;
	skos:relatedMatch d3f:Sensor ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"uid\", \"name\"]}" ;
	ocsf:ocsf_key "agent" .
ocsf:OcsfAiAgent dcterms:title "AI Agent" ;
	a owl:Class ;
	rdfs:label "OcsfAiAgent" ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n10099 , _:c14n10358 , _:c14n139 , _:c14n1486 , _:c14n2890 , _:c14n3621 , _:c14n3668 , _:c14n3783 , _:c14n4033 , _:c14n4266 , _:c14n4871 , _:c14n5221 , _:c14n5447 , _:c14n5820 , _:c14n6661 , _:c14n6668 , _:c14n6945 , _:c14n6960 , _:c14n7011 , _:c14n7148 , _:c14n7436 , _:c14n8164 , _:c14n8733 , _:c14n8975 , _:c14n9917 ;
	skos:definition "An autonomous AI agent that performs tasks under delegated authority. Distinguished from the OCSF agent object (which describes security sensors such as EDR and DLP tools) and from human principals. An AI agent has a stable logical identity across runs and a restart-sensitive instance identity. The agent owns its model; the ai_model attribute captures which model was backing the agent at the time of action." ;
	skos:exactMatch ocsf:OcsfAiAgent ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "ai_agent" ;
	ocsf:ocsf_profiles "container data_classification" .
ocsf:OcsfAiModel dcterms:title "AI Model" ;
	a owl:Class ;
	rdfs:label "OcsfAiModel" ;
	rdfs:seeAlso <https://huggingface.co/docs/hub/models> , <https://platform.openai.com/docs/models> ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n10650 , _:c14n1912 , _:c14n356 , _:c14n4301 , _:c14n4557 , _:c14n5854 , _:c14n7372 , _:c14n7427 , _:c14n8286 , _:c14n8836 , _:c14n9567 , _:c14n9673 , _:c14n9763 ;
	skos:definition "The AI Model object describes the characteristics of an AI/ML model. Examples include language models like GPT-4, embedding models like text-embedding-ada-002, and computer vision models like CLIP." ;
	skos:exactMatch ocsf:OcsfAiModel ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "ai_model" .
ocsf:OcsfAiOperationProfile dcterms:title "AI Operation" ;
	a owl:Class ;
	rdfs:label "OcsfAiOperationProfile" ;
	rdfs:subClassOf _:c14n1876 , _:c14n2405 , _:c14n3999 , _:c14n4535 , _:c14n5039 , _:c14n5332 , _:c14n600 , _:c14n6311 , _:c14n6842 , _:c14n6895 , _:c14n7791 , _:c14n9160 ;
	skos:definition "AI-specific attributes for model operations, retrieval systems, and agent activities. e.g. model_name, total_token_counts etc." ;
	skos:exactMatch ocsf:OcsfAiOperationProfile ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "ai_operation" .
ocsf:OcsfAirborneBroadcastActivity dcterms:title "Airborne Broadcast Activity" ;
	a owl:Class ;
	rdfs:label "OcsfAirborneBroadcastActivity" ;
	rdfs:seeAlso <https://www.ecfr.gov/current/title-14/chapter-I/subchapter-F/part-91#91.225> , <https://www.faa.gov/about/office_org/headquarters_offices/avs/offices/afx/afs/afs400/afs410/ads-b> ;
	rdfs:subClassOf ocsf:OcsfUnmannedSystemsEvent , _:c14n10123 , _:c14n10217 , _:c14n10324 , _:c14n10450 , _:c14n10498 , _:c14n10900 , _:c14n1411 , _:c14n1416 , _:c14n1790 , _:c14n20 , _:c14n2015 , _:c14n3345 , _:c14n3425 , _:c14n3457 , _:c14n3616 , _:c14n3670 , _:c14n3867 , _:c14n4303 , _:c14n4655 , _:c14n4981 , _:c14n5101 , _:c14n517 , _:c14n5560 , _:c14n5582 , _:c14n6176 , _:c14n6382 , _:c14n659 , _:c14n6688 , _:c14n6756 , _:c14n6959 , _:c14n7262 , _:c14n7790 , _:c14n8414 , _:c14n8432 , _:c14n8806 , _:c14n8971 , _:c14n915 , _:c14n9188 , _:c14n9263 , _:c14n9342 , _:c14n9386 , _:c14n9519 , _:c14n9698 ;
	skos:definition "Airborne Broadcast Activity events report the activity of any aircraft or unmanned system as reported and tracked by Automatic Dependent Surveillance - Broadcast (ADS-B) receivers. Based on the ADS-B standards described in Code of Federal Regulations (CFR) Title 14 Chapter I Subchapter F Part 91 and in other general Federal Aviation Administration (FAA) supplemental orders and guidance." ;
	skos:exactMatch ocsf:OcsfAirborneBroadcastActivity ;
	skos:inScheme ocsf:ocsf_events_unmanned_systems ;
	ocsf:ocsf_category "unmanned_systems" ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"aircraft\", \"unmanned_aerial_system\", \"unmanned_system_operating_area\"]}" ;
	ocsf:ocsf_key "airborne_broadcast_activity" ;
	ocsf:ocsf_profiles "cloud container data_classification datetime host linux/linux_users macos/macos_users osint record_integrity security_control" .
ocsf:OcsfAircraft dcterms:title "Aircraft" ;
	a owl:Class ;
	rdfs:label "OcsfAircraft" ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n10070 , _:c14n10132 , _:c14n10184 , _:c14n10256 , _:c14n10553 , _:c14n10725 , _:c14n10986 , _:c14n1250 , _:c14n1515 , _:c14n2184 , _:c14n3045 , _:c14n3792 , _:c14n4925 , _:c14n4935 , _:c14n5158 , _:c14n526 , _:c14n5460 , _:c14n657 , _:c14n7069 , _:c14n7166 , _:c14n7204 , _:c14n7618 , _:c14n7880 , _:c14n7978 , _:c14n8013 , _:c14n8651 , _:c14n8668 , _:c14n908 , _:c14n9604 , _:c14n9610 , _:c14n9762 ;
	skos:definition "The Aircraft object represents any aircraft or otherwise airborne asset such as an unmanned system, airplane, balloon, spacecraft, or otherwise. The Aircraft object is intended to normalized data captured or otherwise logged from active radar, passive radar, multi-spectral systems, or the Automatic Dependant Broadcast - Surveillance (ADS-B), and/or Mode S systems." ;
	skos:exactMatch ocsf:OcsfAircraft ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"serial_number\", \"uid\", \"uid_alt\"]}" ;
	ocsf:ocsf_key "aircraft" .
ocsf:OcsfAnalysisTarget dcterms:title "Analysis Target" ;
	a owl:Class ;
	rdfs:label "OcsfAnalysisTarget" ;
	rdfs:subClassOf _:c14n5252 , _:c14n5357 , _:c14n5407 , _:c14n7358 , _:c14n7785 , _:c14n8471 ;
	skos:definition "The analysis target defines the scope of monitored activities, specifying what entity, system or process is analyzed for activity patterns." ;
	skos:exactMatch ocsf:OcsfAnalysisTarget ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "analysis_target" .
ocsf:OcsfAnalytic dcterms:title "Analytic" ;
	a owl:Class ;
	rdfs:label "OcsfAnalytic" ;
	rdfs:subClassOf ocsf:OcsfEntity , _:c14n1020 , _:c14n10856 , _:c14n1252 , _:c14n132 , _:c14n1322 , _:c14n1570 , _:c14n1586 , _:c14n1668 , _:c14n1875 , _:c14n2308 , _:c14n2505 , _:c14n254 , _:c14n2824 , _:c14n3009 , _:c14n3013 , _:c14n305 , _:c14n3098 , _:c14n4047 , _:c14n4240 , _:c14n4316 , _:c14n4318 , _:c14n474 , _:c14n5178 , _:c14n5183 , _:c14n5509 , _:c14n5772 , _:c14n6993 , _:c14n8191 , _:c14n8420 , _:c14n8742 , _:c14n9012 , _:c14n9219 , _:c14n966 , _:c14n9696 , _:c14n9803 ;
	skos:definition "The Analytic object contains details about the analytic technique used to analyze and derive insights from the data or information that led to the creation of a finding or conclusion." ;
	skos:exactMatch ocsf:OcsfAnalytic ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_constraints "{\"at_least_one\": [\"name\", \"uid\"]}" ;
	ocsf:ocsf_key "analytic" .
ocsf:OcsfAnomaly dcterms:title "Anomaly" ;
	a owl:Class ;
	rdfs:label "OcsfAnomaly" ;
	rdfs:subClassOf ocsf:OcsfObjectBase , _:c14n10995 , _:c14n2022 , _:c14n2274 , _:c14n2471 , _:c14n4137 , _:c14n4836 , _:c14n595 , _:c14n6247 , _:c14n6607 , _:c14n6670 , _:c14n792 ;
	skos:definition "Describes an anomaly or deviation detected in a system. Anomalies are unexpected activity patterns that could indicate potential issues needing attention." ;
	skos:exactMatch ocsf:OcsfAnomaly ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "anomaly" .
ocsf:OcsfAnomalyAnalysis dcterms:title "Anomaly Analysis" ;
	a owl:Class ;
	rdfs:label "OcsfAnomalyAnalysis" ;
	rdfs:subClassOf _:c14n10394 , _:c14n1803 , _:c14n3117 , _:c14n3876 , _:c14n5565 , _:c14n85 ;
	skos:definition "Describes the analysis of activity patterns and anomalies of target entities to identify potential security threats, performance issues, or other deviations from established baselines. This includes monitoring and analyzing user interactions, API usage, resource utilization, access patterns and other measured indicators." ;
	skos:exactMatch ocsf:OcsfAnomalyAnalysis ;
	skos:inScheme ocsf:ocsf_objects ;
	ocsf:ocsf_key "anomaly_analysis" .
